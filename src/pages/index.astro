---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layouts/Header/Header.astro';
import StickyRail from '@/components/layouts/StickyRail.astro';
import Footer from '@/components/layouts/Footer.astro';
import HeroSection from '@/components/features/home/Hero.astro';
import AboutSection from '@/components/features/home/About.astro';
import WorksSection from '@/components/features/home/Works.astro';
import InsightsSection from '@/components/features/home/Insights.astro';
import QASection from '@/components/features/home/QA.astro';
import CTASection from '@/components/features/home/CTA.astro';
import { interfaceContent } from '@/data/content';
---

<BaseLayout>
  <a href="#main-content" class="fixed left-4 top-4 z-skip-link -translate-y-24 bg-brand-soft px-4 py-3 text-sm font-semibold text-on-brand transition-transform focus:translate-y-0">
    {interfaceContent.skipToContent}
  </a>
  <Header />
  <StickyRail />
  <main id="main-content" tabindex="-1">
    <HeroSection />
    <AboutSection />
    <WorksSection />
    <InsightsSection />
    <QASection />
    <CTASection />
  </main>
  <Footer />
</BaseLayout>
