<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Nguyen Kim Thu — UI/UX Designer portfolio: web, product, dashboard, mobile and e-commerce interfaces." /><meta name="theme-color" content="#f3f1eb" /><title>Nguyen Kim Thu — UI/UX Designer</title>
<style>
:root{--paper:#f3f1eb;--ink:#101010;--muted:#6e6b65;--line:#d6d2c8;--acid:#3357ff;--dark:#11131a;--max:1500px}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--paper)}body{margin:0;color:var(--ink);background:var(--paper);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:inherit;text-decoration:none}button{font:inherit}img{display:block;max-width:100%}.wrap{width:min(calc(100% - 40px),var(--max));margin-inline:auto}.nav{position:sticky;top:0;z-index:40;border-bottom:1px solid rgba(16,16,16,.1);backdrop-filter:blur(18px);background:rgba(243,241,235,.84)}.nav-inner{height:74px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;gap:11px;align-items:center;font-weight:800;letter-spacing:-.03em}.brand-dot{width:12px;height:12px;border-radius:50%;background:var(--acid);box-shadow:15px 0 0 var(--ink);margin-right:15px}.nav-links{display:flex;gap:24px;font-size:13px;color:#3a3936}.nav-mail{border:1px solid var(--ink);border-radius:999px;padding:10px 15px;font-size:13px}.hero{min-height:calc(100vh - 74px);padding:70px 0 52px;display:grid;grid-template-columns:1.08fr .92fr;gap:60px;align-items:center}.kicker{display:inline-flex;gap:10px;align-items:center;border:1px solid var(--line);border-radius:999px;padding:8px 11px;background:rgba(255,255,255,.48);font-size:12px}.kicker i{width:8px;height:8px;border-radius:50%;background:var(--acid)}h1{margin:25px 0 26px;font-size:clamp(60px,8vw,126px);line-height:.87;letter-spacing:-.075em;font-weight:800}h1 em{font-style:normal;color:var(--acid)}.hero-copy{max-width:680px;font-size:18px;line-height:1.68;color:#474640}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}.pill{display:inline-flex;align-items:center;gap:9px;padding:13px 18px;border-radius:999px;border:1px solid var(--ink);font-size:13px}.pill.dark{background:var(--ink);color:#fff}.hero-panel{background:linear-gradient(145deg,#fff,#e7e9ff);border:1px solid var(--line);border-radius:34px;padding:22px;display:grid;gap:12px}.statement{min-height:460px;border-radius:24px;background:var(--dark);color:#fff;padding:30px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}.statement:after{content:"";position:absolute;width:260px;height:260px;right:-80px;bottom:-80px;border-radius:50%;background:var(--acid)}.statement .micro{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#aeb3c3}.statement strong{font-size:clamp(36px,4vw,60px);line-height:.95;letter-spacing:-.05em;position:relative;z-index:1}.statement p{margin:0;max-width:500px;color:#b6bac6;line-height:1.6;position:relative;z-index:1}.triad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.triad div{border:1px solid var(--line);border-radius:16px;padding:14px;background:#fff}.triad span{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}.triad b{font-size:13px}section{padding:88px 0;border-top:1px solid var(--line)}.head{display:grid;grid-template-columns:220px minmax(0,1fr);gap:44px;margin-bottom:42px}.section-no{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}h2{margin:0;font-size:clamp(40px,5vw,76px);line-height:.94;letter-spacing:-.055em}.lead{margin:18px 0 0;max-width:780px;font-size:17px;line-height:1.65;color:#55534e}.featured{display:grid;grid-template-columns:1.15fr .85fr;gap:16px}.f-card{background:#fff;border:1px solid var(--line);border-radius:26px;overflow:hidden}.f-card .media{aspect-ratio:4/3;overflow:hidden;background:#dedbd3}.f-card.large .media{aspect-ratio:1.28/1}.f-card img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .5s ease}.f-card:hover img{transform:scale(1.02)}.f-copy{padding:20px 22px 23px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.f-copy h3{margin:0;font-size:25px;letter-spacing:-.035em}.f-copy p{margin:5px 0 0;font-size:13px;color:var(--muted)}.stack{display:grid;gap:16px}.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:26px}.filter{appearance:none;border:1px solid var(--line);border-radius:999px;padding:9px 13px;background:transparent;cursor:pointer;color:#3d3b37}.filter.active{background:var(--ink);color:#fff;border-color:var(--ink)}.gallery{columns:3 320px;column-gap:14px}.work{break-inside:avoid;margin:0 0 14px;background:#fff;border:1px solid var(--line);border-radius:19px;padding:9px;transition:transform .22s ease,box-shadow .22s ease}.work:hover{transform:translateY(-3px);box-shadow:0 14px 35px rgba(0,0,0,.07)}.work.hidden{display:none}.shot{width:100%;border:0;padding:0;border-radius:13px;overflow:hidden;background:#e5e2da;cursor:zoom-in;position:relative}.shot img{width:100%;height:auto}.view{position:absolute;right:10px;bottom:10px;padding:7px 10px;border-radius:999px;background:rgba(15,15,15,.86);color:#fff;font-size:11px;opacity:0;transform:translateY(5px);transition:.2s}.shot:hover .view{opacity:1;transform:none}.meta{padding:12px 6px 5px;display:flex;justify-content:space-between;gap:16px;align-items:end}.meta h3{margin:0;font-size:16px;letter-spacing:-.02em}.meta p{margin:0;font-size:11px;color:var(--muted);text-align:right}.process{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.step{min-height:245px;padding:20px;border:1px solid var(--line);border-radius:20px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.step .n{font-size:11px;color:var(--acid);letter-spacing:.12em}.step h3{margin:0 0 9px;font-size:24px;letter-spacing:-.035em}.step p{margin:0;color:var(--muted);line-height:1.55;font-size:14px}.about{display:grid;grid-template-columns:1fr 1fr;gap:15px}.about-card{min-height:360px;padding:28px;border-radius:25px;border:1px solid var(--line);background:#fff;display:flex;flex-direction:column;justify-content:space-between}.about-card.dark{background:var(--dark);color:#fff;border-color:var(--dark)}.about-card h3{margin:0;font-size:38px;letter-spacing:-.045em}.about-card p{max-width:620px;margin:20px 0 0;line-height:1.68;color:var(--muted)}.about-card.dark p{color:#b8bcc7}.tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:22px}.tag{border:1px solid currentColor;border-radius:999px;padding:8px 10px;font-size:11px;opacity:.75}.contact{background:var(--acid);color:#fff;border-radius:34px;padding:42px;display:grid;grid-template-columns:1fr auto;gap:28px;align-items:end}.contact h2{font-size:clamp(46px,6vw,88px)}.contact p{max-width:650px;color:#dfe4ff;line-height:1.6}.contact .pill{border-color:#fff;color:#fff}footer{padding:30px 0 46px;display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:12px}dialog{width:min(96vw,1500px);height:92vh;padding:0;border:0;border-radius:22px;background:#111;overflow:hidden;box-shadow:0 30px 110px rgba(0,0,0,.4)}dialog::backdrop{background:rgba(0,0,0,.72);backdrop-filter:blur(6px)}.modal-head{height:56px;padding:0 15px 0 19px;background:#111;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:14px;position:sticky;top:0;z-index:2}.modal-head button{border:1px solid #404040;border-radius:999px;background:#1b1b1b;color:#fff;padding:7px 10px;cursor:pointer}.modal-body{height:calc(92vh - 56px);overflow:auto;background:#d7d7d7}.modal-body img{width:100%;height:auto}@media(max-width:980px){.nav-links{display:none}.hero{grid-template-columns:1fr;min-height:auto}.head{grid-template-columns:1fr;gap:10px}.featured,.about{grid-template-columns:1fr}.process{grid-template-columns:repeat(2,1fr)}.contact{grid-template-columns:1fr}}@media(max-width:640px){.wrap{width:min(calc(100% - 22px),var(--max))}.nav-inner{height:64px}.nav-mail{display:none}.hero{padding-top:42px;gap:28px}h1{font-size:54px}.statement{min-height:380px}.triad{grid-template-columns:1fr}section{padding:66px 0}.process{grid-template-columns:1fr}.contact{padding:26px;border-radius:24px}footer{flex-direction:column}}
</style>
</head><body><header class="nav"><div class="wrap nav-inner"><a class="brand" href="#top"><span class="brand-dot"></span>Nguyen Kim Thu</a><nav class="nav-links"><a href="#selected">Selected</a><a href="#archive">All work</a><a href="#approach">Approach</a><a href="#about">About</a></nav><a class="nav-mail" href="mailto:thunk.work.91@gmail.com">Email ↗</a></div></header><main id="top"><div class="wrap hero"><div><span class="kicker"><i></i> UI/UX Designer · Web & Product Interfaces</span><h1>Designing systems people can <em>see</em>, understand & use.</h1><p class="hero-copy">Web, product, dashboard, mobile và e-commerce UI — kết hợp visual design với khả năng đọc requirement và kinh nghiệm frontend để thiết kế không dừng ở một tấm mockup đẹp.</p><div class="hero-actions"><a class="pill dark" href="#archive">Explore all work ↓</a><a class="pill" href="#about">Why frontend matters</a></div></div><aside class="hero-panel"><div class="statement"><span class="micro">Positioning / 2026</span><strong>UI/UX first.<br/>Frontend-aware.<br/>Business-minded.</strong><p>Hierarchy, responsive behavior, states, components và handoff được nghĩ từ lúc thiết kế — không đẩy vấn đề sang developer ở bước cuối.</p></div><div class="triad"><div><span>Range</span><b>Web · Product · Mobile</b></div><div><span>Strength</span><b>Layout · Systems · Handoff</b></div><div><span>Background</span><b>Frontend · Requirements</b></div></div></aside></div><section id="selected"><div class="wrap"><div class="head"><div class="section-no">01 / Selected Work</div><div><h2>Different problems.<br/>Different visual systems.</h2><p class="lead">Không ép mọi brief vào cùng một pattern. Mỗi interface bắt đầu từ content, business goal và loại người dùng trước khi chọn visual direction.</p></div></div><div class="featured"><article class="f-card large"><div class="media"><img src="/uiux/2c53485d-35f0-4509-b170-5f127b696032.webp" alt="Dye Chem ERP dashboard" loading="eager"/></div><div class="f-copy"><div><h3>Dye Chem ERP</h3><p>Enterprise dashboard · operational hierarchy</p></div><span>01 ↗</span></div></article><div class="stack"><article class="f-card"><div class="media"><img src="/uiux/0a833337-a443-45b7-95fa-c42888e29949.webp" alt="Beme English Center" loading="lazy"/></div><div class="f-copy"><div><h3>Beme</h3><p>Education · brand + conversion</p></div><span>02 ↗</span></div></article><article class="f-card"><div class="media"><img src="/uiux/4871c05c-e584-4e48-a724-513a8376c61c.webp" alt="Mậu Jewelry" loading="lazy"/></div><div class="f-copy"><div><h3>Mậu Jewelry</h3><p>Luxury commerce · editorial rhythm</p></div><span>03 ↗</span></div></article></div></div></div></section><section id="archive"><div class="wrap"><div class="head"><div class="section-no">02 / Full Archive</div><div><h2>Everything stays visible.</h2><p class="lead">Portfolio này show toàn bộ range thay vì giấu phần còn lại sau vài case study. Case study sâu và link Figma có thể bổ sung dần mà không làm mất archive hiện tại.</p></div></div><div class="filters" role="group" aria-label="Project filters">{filters.map(([key,label],i) => <button class:list={['filter',{active:i===0}]} data-filter={key}>{label}</button>)}</div><div class="gallery">{projects.map((project,index) => <article class="work" data-group={project.group}><button class="shot" data-title={project.title} data-image={project.image} aria-label={`View ${project.title} full layout`}><img src={project.image} alt={project.title} loading="lazy" decoding="async"/><span class="view">Full layout ↗</span></button><div class="meta"><div><h3>{String(index+1).padStart(2,'0')} · {project.title}</h3></div><p>{project.type}</p></div></article>)}</div></div></section><section id="approach"><div class="wrap"><div class="head"><div class="section-no">03 / Approach</div><div><h2>Direction → system → handoff.</h2><p class="lead">Frontend là lợi thế hỗ trợ UI/UX, không phải vai chính. Nó giúp tôi nhìn sớm những điểm thường vỡ khi thiết kế đi vào implementation.</p></div></div><div class="process"><article class="step"><span class="n">01 / UNDERSTAND</span><div><h3>Read the brief</h3><p>Business goal, audience, content, existing brand và technical constraints trước visual.</p></div></article><article class="step"><span class="n">02 / STRUCTURE</span><div><h3>Build hierarchy</h3><p>User flow, information architecture, page rhythm và component logic trước polish.</p></div></article><article class="step"><span class="n">03 / DESIGN</span><div><h3>Create the system</h3><p>Typography, spacing, visual language, responsive layout và interaction states theo context.</p></div></article><article class="step"><span class="n">04 / HANDOFF</span><div><h3>Make it buildable</h3><p>Auto Layout, components, naming, states và breakpoint behavior để dev không phải đoán.</p></div></article></div></div></section><section id="about"><div class="wrap"><div class="head"><div class="section-no">04 / About</div><div><h2>Design is the role.<br/>Technical context is the edge.</h2></div></div><div class="about"><article class="about-card"><div><h3>UI/UX Designer</h3><p>Tập trung vào web, product interface, e-commerce và dashboard. Có nền Truyền thông đa phương tiện tại Arena Multimedia, cùng kinh nghiệm làm việc với responsive interface và content structure trong môi trường web thật.</p></div><div class="tags"><span class="tag">Figma</span><span class="tag">Auto Layout</span><span class="tag">Components</span><span class="tag">Responsive UI</span><span class="tag">Typography</span><span class="tag">Spacing</span></div></article><article class="about-card dark"><div><h3>Frontend-aware</h3><p>React/Next.js, WordPress và production web giúp tôi nhìn UI qua breakpoint, state, content variation và implementation constraints. Requirement thinking giúp chuyển business rule thành flow rõ thay vì chỉ trang trí màn hình.</p></div><div class="tags"><span class="tag">React / Next.js</span><span class="tag">HTML / CSS</span><span class="tag">Design → Code</span><span class="tag">User Flow</span><span class="tag">Requirement Thinking</span></div></article></div></div></section><section style="border-top:0;padding-top:20px"><div class="wrap contact"><div><h2>Have a direction?<br/>I’ll turn it into a system.</h2><p>Available for UI/UX Designer, Web Designer và product-interface collaboration. Figma links sẽ được gắn trực tiếp vào từng project khi public.</p></div><a class="pill" href="mailto:thunk.work.91@gmail.com">thunk.work.91@gmail.com ↗</a></div></section></main><footer class="wrap"><span>© 2026 Nguyen Kim Thu — UI/UX Portfolio</span><span>Ho Chi Minh City · Vietnam</span></footer><dialog id="viewer"><div class="modal-head"><strong id="viewer-title">Project</strong><button id="viewer-close">Close ✕</button></div><div class="modal-body"><img id="viewer-image" src="" alt=""/></div></dialog><script is:inline>const filters=[...document.querySelectorAll('.filter')],cards=[...document.querySelectorAll('.work')];filters.forEach(btn=>btn.addEventListener('click',()=>{filters.forEach(x=>x.classList.remove('active'));btn.classList.add('active');const f=btn.dataset.filter;cards.forEach(card=>card.classList.toggle('hidden',f!=='all'&&card.dataset.group!==f));}));const viewer=document.getElementById('viewer'),image=document.getElementById('viewer-image'),title=document.getElementById('viewer-title');document.querySelectorAll('.shot').forEach(btn=>btn.addEventListener('click',()=>{image.src=btn.dataset.image;image.alt=btn.dataset.title;title.textContent=btn.dataset.title;viewer.showModal();}));document.getElementById('viewer-close').addEventListener('click',()=>viewer.close());viewer.addEventListener('click',e=>{if(e.target===viewer)viewer.close();});</script></body></html>