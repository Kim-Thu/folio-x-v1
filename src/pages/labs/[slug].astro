---
import LabDetailPage from "@/components/pages/lab-detail/LabDetailPage.astro";
import {
	getLabDetailPageData,
	getLabDetailPaths,
} from "@/data/pages/getLabDetailPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = getLabDetailPaths;

interface Props {
	slug: string;
}

const { slug } = Astro.props as Props;
const [layout, data] = await Promise.all([
	getLayoutData(),
	getLabDetailPageData(slug),
]);
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.lab.title} | ${layout.title}`}
	description={data.lab.summary}
>
	<LabDetailPage {data} />
</BaseLayout>
