---
import LabsPage from "@/components/pages/labs/LabsPage.astro";
import {
	getLabsPageData,
	getLabTechnologyPaths,
} from "@/data/pages/getLabsPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = getLabTechnologyPaths;

interface Props {
	technology: string;
}

const { technology } = Astro.props as Props;
const [layout, data] = await Promise.all([
	getLayoutData(),
	getLabsPageData({ technology }),
]);
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.metadata.title} | ${layout.title}`}
	description={data.metadata.description}
>
	<LabsPage {data} />
</BaseLayout>
