---
import PublicationDetailPage from "@/components/pages/publication-detail/PublicationDetailPage.astro";
import { getPublicationDetailPageData, getPublicationDetailPaths } from "@/data/pages/getPublicationDetailPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
	return getPublicationDetailPaths("comics");
}

const slug = Astro.params.slug ?? "";
const [layout, data] = await Promise.all([
	getLayoutData(),
	getPublicationDetailPageData("comics", slug),
]);
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.entry.title} | ${layout.title}`}
	description={data.entry.summary}
>
	<PublicationDetailPage {data} />
</BaseLayout>
