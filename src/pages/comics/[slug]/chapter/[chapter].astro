---
import ReaderPage from "@/components/pages/reader/ReaderPage.astro";
import { getPublicationReaderPageData, getPublicationReaderPaths } from "@/data/pages/getPublicationReaderPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
	return getPublicationReaderPaths("comics");
}

const slug = Astro.params.slug ?? "";
const chapter = Astro.params.chapter ?? "";
const [layout, data] = await Promise.all([
	getLayoutData(),
	getPublicationReaderPageData("comics", slug, chapter),
]);
---

<BaseLayout {...layout} tone="light" title={`${data.metadata.title} | ${layout.title}`} description={data.metadata.description}>
	<ReaderPage {data} />
</BaseLayout>
