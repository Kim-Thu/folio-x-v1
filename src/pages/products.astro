---
import ProductsPage from "@/components/pages/products/ProductsPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLayoutData } from "@/data/pages/getLayoutData";
import { getProductsPageData } from "@/data/pages/getProductsPageData";

const layout = await getLayoutData();
const data = await getProductsPageData();
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.page.meta.title} | ${layout.title}`}
	description={data.page.meta.description ?? ""}
>
	<ProductsPage {data} />
</BaseLayout>
