---
import PolicyPage from "@/components/pages/policy/PolicyPage.astro";
import { getPolicyPageData } from "@/data/pages/getPolicyPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

const [layout, data] = await Promise.all([
	getLayoutData(),
	getPolicyPageData("privacy-policy"),
]);
---

<BaseLayout {...layout} tone="light" title={`${data.page.meta.title} | ${layout.title}`} description={data.page.meta.description ?? ""}>
	<PolicyPage {data} />
</BaseLayout>
