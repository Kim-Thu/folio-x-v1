---
import WorksPage from "@/components/pages/works/WorksPage.astro";
import { getLayoutData } from "@/data/pages/getLayoutData";
import {
	getWorksPageData,
	getWorksTagPaths,
} from "@/data/pages/getWorksPageData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = getWorksTagPaths;

interface Props {
	tagSlug: string;
}

const { tagSlug } = Astro.props;
const [layoutData, data] = await Promise.all([
	getLayoutData(),
	getWorksPageData({ tagSlug }),
]);
---

<BaseLayout
	{...layoutData}
	title={`${data.metadata.title} | ${layoutData.title}`}
	description={data.metadata.description}
>
	<WorksPage {data} />
</BaseLayout>
