---
import WorkDetailPage from "@/components/pages/work-detail/WorkDetailPage.astro";
import {
	getWorkDetailPageData,
	getWorkDetailPaths,
} from "@/data/pages/getWorkDetailPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = getWorkDetailPaths;

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const [layoutData, data] = await Promise.all([
	getLayoutData(),
	getWorkDetailPageData(slug),
]);
---

<BaseLayout
	{...layoutData}
	title={`${data.project.title} | ${layoutData.title}`}
	description={data.project.summary}
	seo={{
		image: { src: data.project.image, alt: data.project.alt },
		breadcrumbs: [
			{ label: "Home", href: "/" },
			{ label: "Projects", href: "/projects" },
			{ label: data.project.title, href: `/projects/${data.project.slug}` },
		],
		entity: {
			kind: "creative-work",
			name: data.project.title,
			description: data.project.summary,
			image: { src: data.project.image, alt: data.project.alt },
			keywords: [data.project.category, ...data.project.tags.map((tag) => tag.label)],
		},
	}}
>
	<WorkDetailPage {data} />
</BaseLayout>
