---
import InsightsPage from "@/components/pages/insights/InsightsPage.astro";
import { getInsightsPageData } from "@/data/pages/getInsightsPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

const [layout, data] = await Promise.all([
	getLayoutData(),
	getInsightsPageData(),
]);
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.metadata.title} | ${layout.title}`}
	description={data.metadata.description}
>
	<InsightsPage {data} />
</BaseLayout>
