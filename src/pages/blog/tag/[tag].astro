---
import InsightsPage from "@/components/pages/insights/InsightsPage.astro";
import {
	getInsightsPageData,
	getInsightTagPaths,
} from "@/data/pages/getInsightsPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = getInsightTagPaths;

interface Props {
	tagSlug: string;
}

const { tagSlug } = Astro.props as Props;
const [layout, data] = await Promise.all([
	getLayoutData(),
	getInsightsPageData({ tagSlug }),
]);
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.page.meta.title} | ${layout.title}`}
	description={data.page.meta.description ?? ""}
>
	<InsightsPage {data} />
</BaseLayout>
