---
import InsightsPage from "@/components/pages/insights/InsightsPage.astro";
import {
	getInsightCategoryPaths,
	getInsightsPageData,
} from "@/data/pages/getInsightsPageData";
import { getLayoutData } from "@/data/pages/getLayoutData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = getInsightCategoryPaths;

interface Props {
	categorySlug: string;
}

const { categorySlug } = Astro.props as Props;
const [layout, data] = await Promise.all([
	getLayoutData(),
	getInsightsPageData({ category: categorySlug }),
]);
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.metadata.title} | ${layout.title}`}
	description={data.metadata.description}
>
	<InsightsPage {data} />
</BaseLayout>
