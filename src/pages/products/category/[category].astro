---
import ProductsPage from "@/components/pages/products/ProductsPage.astro";
import { getLayoutData } from "@/data/pages/getLayoutData";
import {
	getProductCategoryPaths,
	getProductsPageData,
} from "@/data/pages/getProductsPageData";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = getProductCategoryPaths;

interface Props {
	categorySlug: string;
}

const { categorySlug } = Astro.props as Props;
const [layout, data] = await Promise.all([
	getLayoutData(),
	getProductsPageData({ categorySlug }),
]);
---

<BaseLayout
	{...layout}
	tone="light"
	title={`${data.page.meta.title} | ${layout.title}`}
	description={data.page.meta.description ?? ""}
>
	<ProductsPage {data} />
</BaseLayout>
