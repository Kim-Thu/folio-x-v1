---
import SystemStatePage from "@/components/pages/system-state/SystemStatePage.astro";
import { getLayoutData } from "@/data/pages/getLayoutData";
import { getSystemStatePageData } from "@/data/pages/getSystemStatePageData";
import { emptyContent } from "@/data/system-states";
import BaseLayout from "@/layouts/BaseLayout.astro";

const layoutData = await getLayoutData();
const data = getSystemStatePageData(emptyContent);
---

<BaseLayout
	{...layoutData}
	title={emptyContent.metadataTitle}
	description={emptyContent.metadataDescription}
	seo={{ robots: { index: false, follow: false } }}
>
	<SystemStatePage {data} />
</BaseLayout>
