---
import { getSvgImageAttributes } from '@/components/primitives/SvgImage/variants/getSvgImageAttributes';
import type { SvgImageProps } from '@/types/ui';

type Props = SvgImageProps;

const {
  src,
  variant = 'default',
  class: className,
  x,
  y,
  width,
  height,
  preserveAspectRatio,
} = Astro.props;

const defaults = getSvgImageAttributes(variant);
---

<image
  href={src}
  x={x ?? defaults.x}
  y={y ?? defaults.y}
  width={width ?? defaults.width}
  height={height ?? defaults.height}
  preserveAspectRatio={preserveAspectRatio ?? defaults.preserveAspectRatio}
  class={className}
/>
