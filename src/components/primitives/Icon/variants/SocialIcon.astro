---
import { GithubIcon, Linkedin01Icon } from '@hugeicons/core-free-icons';
import type { SocialIconName } from '@/types/navigation';
import type { SocialIconProps } from '@/types/ui';
import { cn } from '@/utils/cn';

type IconNode = readonly [string, Readonly<Record<string, string | number>>];

const { name, class: className = '' } = Astro.props as SocialIconProps;
const icons = {
  github: GithubIcon,
  linkedin: Linkedin01Icon,
} satisfies Record<SocialIconName, readonly IconNode[]>;

const normalizeAttributes = (attributes: Readonly<Record<string, string | number>>) =>
  Object.fromEntries(
    Object.entries(attributes)
      .filter(([attribute]) => attribute !== 'key')
      .map(([attribute, value]) => [attribute.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`), value]),
  );
---

<svg class={cn('size-icon-social', className)} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {(icons[name] as readonly IconNode[]).map(([element, attributes]: IconNode) => {
    const Element = element;
    return <Element {...normalizeAttributes(attributes)} />;
  })}
</svg>
