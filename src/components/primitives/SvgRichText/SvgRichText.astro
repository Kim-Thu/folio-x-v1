---
import type { SvgRichTextProps } from '@/types/ui';
import { cn } from '@/utils/cn';

type Props = SvgRichTextProps;

const {
  id,
  viewBox = '0 0 2686 400',
  class: className = '',
  innerClass = '',
} = Astro.props;
---

<svg
  id={id}
  class={cn('block h-auto w-full overflow-visible', className)}
  viewBox={viewBox}
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
>
  <foreignObject width="100%" height="100%" class="overflow-visible origin-center">
    <div class={cn('size-full', innerClass)}>
      <slot />
    </div>
  </foreignObject>
  <slot name="media" />
</svg>
