---
import type { TextProps } from '@/types/ui';
import { cn } from '@/utils/cn';
import { getTextClasses } from '@/components/primitives/Text/variants/getTextClasses';

type Props = TextProps;

const { as: Tag = 'p', variant = 'body', size = 'inherit', class: className = '', ...attributes }: Props = Astro.props;
---

<Tag {...attributes} class={cn(getTextClasses(variant, size), className)}>
  <slot />
</Tag>
