---
import ButtonContent from '@/components/primitives/Button/ButtonContent.astro';
import { getButtonClasses } from '@/components/primitives/Button/variants/getButtonClasses';
import { getButtonIconMotionClass } from '@/components/primitives/Button/variants/getButtonIconMotionClass';
import Link from '@/components/primitives/Link/Link.astro';
import type { ButtonProps } from '@/types/ui';
import { cn } from '@/utils/cn';
import type { HTMLAttributes } from 'astro/types';

type Props = ButtonProps;

const {
  label,
  icon,
  iconPosition = 'end',
  variant = 'primary',
  size = 'md',
  tone = 'dark',
  class: className = '',
  ariaLabel,
  iconOnly = false,
  href,
  type = 'button',
  ...attributes
} = Astro.props;

const linkAttributes = attributes as HTMLAttributes<'a'>;
const buttonAttributes = attributes as HTMLAttributes<'button'>;
const buttonClasses = getButtonClasses({ iconOnly, size, tone, variant });
const iconClass = icon ? cn('transition-transform duration-interaction', getButtonIconMotionClass(icon)) : '';
const mergedClasses = cn(buttonClasses, icon && !iconOnly && 'gap-xs', className);
---

{href ? (
  <Link
    {...linkAttributes}
    href={href}
    aria-label={ariaLabel}
    class={mergedClasses}
  >
    {iconOnly ? <slot /> : <ButtonContent label={label} icon={icon} iconPosition={iconPosition} iconClass={iconClass} />}
  </Link>
) : (
  <button
    {...buttonAttributes}
    type={type}
    aria-label={ariaLabel}
    class={mergedClasses}
  >
    {iconOnly ? <slot /> : <ButtonContent label={label} icon={icon} iconPosition={iconPosition} iconClass={iconClass} />}
  </button>
)}
