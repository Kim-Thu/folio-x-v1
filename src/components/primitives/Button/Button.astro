---
import type { ButtonProps } from '@/types/ui';
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/utils/cn';
import { getButtonClasses } from '@/components/primitives/Button/variants/getButtonClasses';
import ButtonContent from '@/components/primitives/Button/ButtonContent.astro';

type Props = ButtonProps;

const {
  label,
  icon,
  iconPosition = 'end',
  variant = 'primary',
  size = 'md',
  tone = 'dark',
  class: className = '',
  ariaLabel,
  iconOnly = false,
  href,
  type = 'button',
  ...attributes
} = Astro.props;

const linkAttributes = attributes as HTMLAttributes<'a'>;
const buttonAttributes = attributes as HTMLAttributes<'button'>;
const buttonClasses = getButtonClasses({ iconOnly, size, tone, variant });
const iconMotionClasses = {
  arrowUpRight: 'group-hover/button:translate-x-1 group-hover/button:-translate-y-1',
  arrowRight: 'group-hover/button:translate-x-1',
  arrowLeft: 'group-hover/button:-translate-x-1',
  arrowUp: 'group-hover/button:-translate-y-1',
  bars3: '',
  xMark: '',
};
const iconClass = icon ? `transition-transform duration-(--duration-interaction) ${iconMotionClasses[icon]}` : '';
const mergedClasses = cn(buttonClasses, className);
---

{href ? (
  <a
    {...linkAttributes}
    href={href}
    aria-label={ariaLabel}
    class={mergedClasses}
  >
    {iconOnly ? <slot /> : <ButtonContent label={label} icon={icon} iconPosition={iconPosition} iconClass={iconClass} />}
  </a>
) : (
  <button
    {...buttonAttributes}
    type={type}
    aria-label={ariaLabel}
    class={mergedClasses}
  >
    {iconOnly ? <slot /> : <ButtonContent label={label} icon={icon} iconPosition={iconPosition} iconClass={iconClass} />}
  </button>
)}
