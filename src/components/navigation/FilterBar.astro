---
import type { FilterBarProps } from '../../types/ui';
import Button from '../ui/Button.astro';

type Props = FilterBarProps;

const { categories, allLabel, label, theme = 'dark' } = Astro.props;
---

<div data-filter-bar role="group" aria-label={label} class="flex flex-wrap gap-xs">
  <Button label={allLabel} variant="outline" size="sm" tone={theme} data-filter-value="all" aria-pressed="true" />
  {categories.map((category) => (
    <Button label={category.label} variant="outline" size="sm" tone={theme} data-filter-value={category.slug} aria-pressed="false" />
  ))}
</div>
