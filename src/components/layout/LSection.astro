---
import LContainer from "@/components/layout/LContainer.astro";
import type { LSectionProps } from "@/types/components/layout/LSection.types";
import { cn } from "@/utils/cn";
import {
	sectionBaseClass,
	sectionContentSpacingClasses,
	sectionSpacingClasses,
	sectionThemeClasses,
} from "@/variants/components/layout/LSection.variants";

type Props = LSectionProps;

const {
	class: className,
	theme = "canvas",
	spacing = "default",
	container = "none",
	...attributes
} = Astro.props;

const classes = cn(
	sectionBaseClass,
	sectionThemeClasses[theme],
	sectionSpacingClasses[spacing],
	className,
);
const contentClasses = sectionContentSpacingClasses[spacing];
---

<section {...attributes} class={classes}>
	{container === "none" ? (
		contentClasses ? (
			<div class={contentClasses}>
				<slot />
			</div>
		) : (
			<slot />
		)
	) : (
		<LContainer size={container} class={contentClasses}>
			<slot />
		</LContainer>
	)}
</section>
