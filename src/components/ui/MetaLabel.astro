---
import type { MetaLabelProps } from '../../types/ui';

type Props = MetaLabelProps;

const props = Astro.props as Props;
const {
  as = 'p',
  class: className = '',
  variant = 'default',
} = props;

const Tag = as;
const variantClass = variant === 'eyebrow' ? 'tracking-eyebrow' : '';
const sizeClass = variant === 'eyebrow' ? 'text-label' : '';
---

<Tag class:list={['font-mono uppercase', variantClass, sizeClass, className]}>
  <slot />
</Tag>
