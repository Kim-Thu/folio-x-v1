---
import type { ButtonContentProps } from '../../types/ui';
import HeroIcon from './HeroIcon.astro';

type Props = ButtonContentProps;

const { label, icon, iconPosition } = Astro.props;
---

{icon && iconPosition === 'start' && <HeroIcon name={icon} class="button-control__icon" />}
<span>{label}</span>
{icon && iconPosition === 'end' && <HeroIcon name={icon} class="button-control__icon" />}
