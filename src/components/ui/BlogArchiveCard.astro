---
import type { BlogArchiveCardProps } from '../../types/ui';
import Article from './Article.astro';
import CardLink from './CardLink.astro';
import MetaLabel from './MetaLabel.astro';

type Props = BlogArchiveCardProps;

const { post } = Astro.props;
---

<div data-filter-category={post.categorySlug}>
  <Article class="h-full border-t-hairline border-line-light py-7">
    <CardLink href={post.href} ariaLabel={post.title} class="group grid gap-lg md:grid-cols-12">
      <MetaLabel class="text-on-light-subtle md:col-span-2">{post.index}</MetaLabel>
      <div class="md:col-span-7">
        <MetaLabel class="text-on-light-subtle">{post.category} · <time datetime={post.publishedAt}>{post.publishedLabel}</time></MetaLabel>
        <h2 class="mt-3 text-h3 font-semibold">{post.title}</h2>
        <p class="mt-4 text-sm leading-7 text-on-light-muted">{post.excerpt}</p>
      </div>
      <div class="flex items-end md:col-span-3 md:justify-end">
        <p class="font-mono text-caption uppercase tracking-meta text-on-light-subtle">{post.readTime}</p>
      </div>
    </CardLink>
  </Article>
</div>
