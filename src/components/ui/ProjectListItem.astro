---
import type { ProjectListItemProps } from '../../types/ui';
import Article from './Article.astro';
import CardLink from './CardLink.astro';
import HeroIcon from './HeroIcon.astro';
import MetaLabel from './MetaLabel.astro';

type Props = ProjectListItemProps;

const { project, linkLabel, outcomeLabel } = Astro.props;
---

<Article class="reveal border-t-hairline border-line-dark last:border-b-hairline">
  <CardLink href={project.href} ariaLabel={project.title} class="group grid gap-lg py-7 transition-colors hover:bg-surface-hover md:grid-cols-12 md:items-center md:px-4">
    <MetaLabel class="text-on-dark-faint md:col-span-1">{project.number}</MetaLabel>

    <figure class="aspect-editorial overflow-hidden rounded-card md:col-span-3">
      <img class="h-full w-full object-cover transition duration-reveal group-hover:scale-media" src={project.image} alt={project.alt} loading="lazy" />
    </figure>

    <div class="md:col-span-5">
      <MetaLabel class="text-brand">{project.client} {project.year}</MetaLabel>
      <h3 class="mt-3 text-h3 font-semibold text-balance">{project.title}</h3>
      <p class="mt-4 text-sm leading-6 text-on-dark-muted">{project.summary}</p>
    </div>

    <div class="flex items-end justify-between gap-md md:col-span-3 md:flex-col md:items-end">
      <p class="text-right text-sm text-on-dark-muted"><span class="sr-only">{outcomeLabel} </span>{project.outcome}</p>
      <span class="inline-flex items-center gap-xs text-sm font-medium">{linkLabel}<HeroIcon name="arrowUpRight" /></span>
    </div>
  </CardLink>
</Article>
