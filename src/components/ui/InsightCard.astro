---
import { interfaceContent } from '../../data/content';
import type { InsightCardProps } from '../../types/ui';
import Article from './Article.astro';
import CardLink from './CardLink.astro';
import MetaLabel from './MetaLabel.astro';

type Props = InsightCardProps;

const { insight, variant = 'compact', featuredLabel, featuredImageAlt } = Astro.props;
---

{variant === 'featured' ? (
  <Article class="reveal lg:col-span-7">
    <CardLink href={insight.href} class="group block" ariaLabel={insight.title}>
      <figure class="relative aspect-editorial overflow-hidden rounded-card bg-surface-dark">
        <img class="h-full w-full object-cover grayscale transition duration-reveal group-hover:scale-media group-hover:grayscale-0" src={insight.image} alt={featuredImageAlt} loading="lazy" />
        <figcaption class="absolute left-5 top-5 bg-brand px-3 py-2 font-mono text-caption uppercase tracking-meta text-on-brand">{featuredLabel}</figcaption>
      </figure>
      <MetaLabel class="mt-5 text-label tracking-meta text-on-light-subtle">{insight.category} {interfaceContent.separators.dot} <time datetime={insight.duration}>{insight.readTime}</time></MetaLabel>
      <h3 class="mt-4 text-h3 font-semibold">{insight.title}</h3>
      <p class="mt-5 text-base leading-7 text-on-light-muted">{insight.excerpt}</p>
    </CardLink>
  </Article>
) : (
  <Article class="reveal border-b-hairline border-line-light py-7 last:border-b-0">
    <CardLink href={insight.href} class="group relative grid grid-cols-index-content gap-md" ariaLabel={insight.title}>
      {insight.image && (
        <figure class="pointer-events-none absolute right-full top-1/2 z-30 mr-6 hidden w-72 -translate-y-1/2 overflow-hidden rounded-card opacity-0 transition duration-interaction group-hover:opacity-100 group-focus-visible:opacity-100 lg:block" aria-hidden="true">
          <img class="aspect-editorial w-full object-cover" src={insight.image} alt="" loading="lazy" />
        </figure>
      )}
      <span class="font-mono text-label text-on-light-subtle">{insight.index}</span>
      <div>
        <MetaLabel class="text-caption tracking-meta text-on-light-subtle">{insight.category} {interfaceContent.separators.dot} <time datetime={insight.duration}>{insight.readTime}</time></MetaLabel>
        <h3 class="mt-3 text-h3 font-semibold">{insight.title}</h3>
        <p class="mt-4 text-sm leading-6 text-on-light-muted">{insight.excerpt}</p>
      </div>
    </CardLink>
  </Article>
)}
