---
import type { FooterColumnProps } from '../../types/ui';
import FooterNav from '../navigation/FooterNav.astro';
import SocialNav from '../navigation/SocialNav.astro';
import MetaLabel from './MetaLabel.astro';

type Props = FooterColumnProps;

const { column } = Astro.props;
const Tag = column.kind === 'location' ? 'address' : 'div';
---

<Tag class:list={['not-italic', column.kind === 'contact' ? 'md:col-span-4' : 'md:col-span-2']}>
  <MetaLabel variant="eyebrow" class="mb-4 text-on-dark-faint">
    {column.label}
  </MetaLabel>

  {column.kind === 'contact' && (
    <a class="inline-flex text-sm text-on-dark-muted transition-colors hover:text-on-dark" href={`mailto:${column.email}`}>
      {column.email}
    </a>
  )}

  {column.kind === 'navigation' && <FooterNav items={column.items} label={column.label} />}

  {column.kind === 'social' && <SocialNav links={column.links} variant="footer" />}

  {column.kind === 'location' && (
    <>
      <p class="text-sm leading-6 text-on-dark-muted">{column.location}</p>
      <a class="mt-3 inline-flex text-sm text-on-dark-muted transition-colors hover:text-on-dark" href={`mailto:${column.email}`}>
        {column.email}
      </a>
    </>
  )}
</Tag>
