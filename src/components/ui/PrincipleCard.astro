---
import type { PrincipleCardProps } from '../../types/ui';
import Article from './Article.astro';
import CardLink from './CardLink.astro';
import MetaLabel from './MetaLabel.astro';
import PrincipleTitle from './PrincipleTitle.astro';

type Props = PrincipleCardProps;

const {
  index,
  href,
  label,
  title,
  variant,
  description,
  image,
  imageAlt = '',
} = Astro.props;

const titleLines = Array.isArray(title) ? title : [title];
---

{variant === 'statement' && (
  <Article class="reveal md:col-span-5">
    <CardLink href={href} class="flex min-h-100 flex-col justify-between rounded-card bg-surface-dark p-7 text-on-dark md:p-9" ariaLabel={titleLines.join(' ')}>
      <MetaLabel as="span" class="text-label tracking-eyebrow text-brand-soft">{index} / {label}</MetaLabel>
      <div>
        <PrincipleTitle>
          {titleLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}
        </PrincipleTitle>
        {description && <p class="mt-6 text-sm leading-6 text-on-dark-muted">{description}</p>}
      </div>
    </CardLink>
  </Article>
)}

{variant === 'graphic' && (
  <Article class="reveal md:col-span-3">
    <CardLink href={href} class="relative block min-h-100 overflow-hidden rounded-card bg-brand p-7 text-on-brand md:p-9" ariaLabel={titleLines.join(' ')}>
      <div class="absolute -right-16 -top-16 size-72 rounded-full border-principle-orbit border-surface-dark/90" aria-hidden="true"></div>
      <div class="absolute right-10 top-10 size-24 rounded-full bg-brand-soft blur-2xl" aria-hidden="true"></div>
      <MetaLabel as="span" class="relative text-label tracking-eyebrow">{index} / {label}</MetaLabel>
      <PrincipleTitle class="absolute bottom-8 left-7 right-7 md:left-9">
        {titleLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}
      </PrincipleTitle>
    </CardLink>
  </Article>
)}

{variant === 'image' && (
  <Article class="reveal md:col-span-4">
    <CardLink href={href} class="relative block min-h-100 overflow-hidden rounded-card" ariaLabel={titleLines.join(' ')}>
      <img class="absolute inset-0 h-full w-full object-cover grayscale" src={image} alt={imageAlt} loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20" aria-hidden="true"></div>
      <MetaLabel as="span" class="absolute left-7 top-7 text-label tracking-eyebrow text-on-dark">{index} / {label}</MetaLabel>
      <PrincipleTitle class="absolute bottom-8 left-7 right-7 text-on-dark">
        {titleLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}
      </PrincipleTitle>
    </CardLink>
  </Article>
)}
