---
import { interfaceContent } from '../../data/content';
import type { ProjectCardProps } from '../../types/ui';
import Article from './Article.astro';
import CardLink from './CardLink.astro';
import HeroIcon from './HeroIcon.astro';
import MetaLabel from './MetaLabel.astro';

type Props = ProjectCardProps;

const { project, reverse = false, linkLabel, outcomeLabel } = Astro.props;
const cardClass = [
  'group grid overflow-hidden rounded-card border-hairline border-line-dark bg-surface-dark transition-colors hover:bg-surface-hover lg:grid-cols-12',
  reverse ? 'lg:[&>.project-visual]:order-2' : '',
].filter(Boolean).join(' ');
---

<Article class="reveal">
  <CardLink href={project.href} class={cardClass} ariaLabel={project.title}>
    <figure class="project-visual relative min-h-95 overflow-hidden lg:col-span-7 lg:min-h-160">
      <img class="absolute inset-0 h-full w-full object-cover transition duration-reveal group-hover:scale-media" src={project.image} alt={project.alt} loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent" aria-hidden="true"></div>
      <figcaption class="absolute bottom-6 left-6 text-5xl font-semibold text-on-dark md:text-7xl">
        <span class="sr-only">{outcomeLabel} </span>{project.outcome}
      </figcaption>
    </figure>
    <div class="flex min-h-105 flex-col p-7 lg:col-span-5 lg:min-h-0 lg:p-10">
      <MetaLabel class="flex items-center justify-between text-label tracking-meta text-on-dark-faint">
        <span>{project.number} {interfaceContent.separators.slash} {project.category}</span><span>{project.year}</span>
      </MetaLabel>
      <div class="my-auto py-2xl">
        <p class="mb-4 text-sm text-brand">{project.client}</p>
        <h3 class="text-h3 font-semibold text-balance">{project.title}</h3>
        <p class="mt-7 text-sm leading-7 text-on-dark-muted md:text-base">{project.summary}</p>
      </div>
      <span class="flex items-center justify-between border-t-hairline border-line-dark pt-5 text-sm font-medium">
        {linkLabel}<HeroIcon name="arrowUpRight" />
      </span>
    </div>
  </CardLink>
</Article>
