---
import type { ProjectArchiveCardProps } from '../../types/ui';
import Article from './Article.astro';
import CardLink from './CardLink.astro';
import MetaLabel from './MetaLabel.astro';

type Props = ProjectArchiveCardProps;

const { project } = Astro.props;
---

<div data-filter-category={project.categorySlug}>
  <Article class="h-full">
    <CardLink href={project.href} ariaLabel={project.title} class="group grid h-full overflow-hidden rounded-card border-hairline border-line-dark bg-surface-dark transition-colors hover:bg-surface-hover md:grid-cols-2">
      <figure class="relative min-h-95 overflow-hidden">
        <img src={project.image} alt={project.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-reveal group-hover:scale-media" />
      </figure>
      <div class="flex min-h-105 flex-col p-7 md:p-9">
        <MetaLabel class="flex justify-between text-on-dark-faint"><span>{project.number} / {project.category}</span><span>{project.year}</span></MetaLabel>
        <div class="my-auto py-8">
          <p class="text-sm text-brand">{project.client}</p>
          <h2 class="mt-4 text-h3 font-semibold">{project.title}</h2>
          <p class="mt-5 text-sm leading-7 text-on-dark-muted">{project.summary}</p>
        </div>
        <p class="border-t-hairline border-line-dark pt-5 text-sm text-on-dark-muted">{project.outcome}</p>
      </div>
    </CardLink>
  </Article>
</div>
