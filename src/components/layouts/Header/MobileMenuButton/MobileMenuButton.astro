---
import { interfaceContent } from '@/data/content';
import Button from '@/components/primitives/Button/Button.astro';
import Icon from '@/components/primitives/Icon/Icon.astro';
---

<Button id="menu-button" label={interfaceContent.openMenu} iconOnly variant="ghost" size="md" class="lg:hidden" aria-expanded="false" aria-controls="mobile-menu">
  <Icon name="bars3" class="menu-icon-open size-6" />
  <Icon name="xMark" class="menu-icon-close invisible absolute size-6" />
</Button>
