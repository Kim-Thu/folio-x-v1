---
import { headerContent } from '@/data/content';
import { site } from '@/data/site';
import type { HeaderContactProps } from '@/types/layout';
import Button from '@/components/primitives/Button/Button.astro';
import { getHeaderContactClasses } from '@/components/layouts/Header/HeaderContact/variants/getHeaderContactClasses';

type Props = HeaderContactProps;

const { variant } = Astro.props;
---

<Button
  href={`mailto:${site.email}`}
  label={variant === 'menu' ? site.email : headerContent.contactLabel}
  icon="arrowUpRight"
  variant="text"
  class={getHeaderContactClasses(variant)}
/>
