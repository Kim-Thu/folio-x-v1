---
import { navItems } from '@/data/site';
import PrimaryNav from '@/components/patterns/Navigation/PrimaryNav/PrimaryNav.astro';
import HeaderContact from '@/components/layouts/Header/HeaderContact/HeaderContact.astro';
---

<div id="mobile-menu" class="invisible fixed inset-0 z-40 flex -translate-y-3 flex-col justify-between bg-surface-dark px-6 pb-10 pt-28 opacity-0 transition-all duration-(--duration-interaction) lg:hidden" aria-hidden="true" inert>
  <PrimaryNav items={navItems} variant="mobile" />
  <HeaderContact variant="menu" />
</div>
