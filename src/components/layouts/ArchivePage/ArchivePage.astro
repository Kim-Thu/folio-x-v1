---
import { site } from '@/data/site';
import type { ArchivePageProps } from '@/types/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layouts/Footer.astro';
import Header from '@/components/layouts/Header/Header.astro';
import Container from '@/components/layouts/Container.astro';
import Cards from '@/components/patterns/Cards/Cards.astro';
import FilterBar from '@/components/patterns/Navigation/FilterBar/FilterBar.astro';
import Text from '@/components/primitives/Text/Text.astro';
import { getArchivePageListClasses, getArchivePageThemeClasses } from '@/components/layouts/ArchivePage/variants/getArchivePageClasses';
import { cn } from '@/utils/cn';

type Props = ArchivePageProps;

const {
  eyebrow,
  title,
  description,
  categories = [],
  filterLabel = '',
  allLabel = '',
  emptyLabel,
  theme = 'light',
  listVariant = 'grid',
} = Astro.props;
const hasFilter = categories.length > 0;
const themeClasses = getArchivePageThemeClasses(theme);
const listClasses = getArchivePageListClasses(listVariant);
const mainClasses = cn('pb-3xl pt-6xl md:pb-5xl lg:pb-6xl', themeClasses.main);
const headerClasses = cn('grid border-b-hairline pb-12 lg:grid-cols-12', themeClasses.border);
const eyebrowClasses = cn('lg:col-span-12', themeClasses.eyebrow);
const descriptionClasses = cn('mt-7 leading-7 md:text-lg lg:col-span-7', themeClasses.description);
const emptyClasses = cn('py-3xl text-center', themeClasses.empty);
---

<BaseLayout title={`${title} — ${site.name}`} description={description}>
  <Header solid />
  <main class={mainClasses} data-filter-root>
    <Container>
      <header class={headerClasses}>
        <Text variant="eyebrow" class={eyebrowClasses}>{eyebrow}</Text>
        <Text as="h1" variant="heading" size="h1" class="mt-6 lg:col-span-10">{title}</Text>
        <Text size="base" class={descriptionClasses}>{description}</Text>
        {hasFilter && (
          <div class="mt-10 lg:col-span-12">
            <FilterBar categories={categories} allLabel={allLabel} label={filterLabel} theme={theme} />
          </div>
        )}
      </header>
      <Cards class={listClasses} aria-live="polite"><slot /></Cards>
      <Text data-filter-empty hidden class={emptyClasses}>{emptyLabel}</Text>
    </Container>
  </main>
  <Footer />
</BaseLayout>
