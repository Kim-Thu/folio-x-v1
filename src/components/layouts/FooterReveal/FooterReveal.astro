---
import { closingProfileContent } from '@/data/content';
import Footer from '@/components/layouts/Footer.astro';
import ClosingProfile from '@/components/patterns/ClosingProfile/ClosingProfile.astro';
---

<div class="relative isolate grid" data-footer-reveal>
  <div class="relative z-footer-surface col-start-1 row-start-1 bg-surface-dark">
    <slot />
    <Footer />
  </div>
  <div class="col-start-1 row-start-2" data-footer-reveal-space data-section aria-hidden="true"></div>
  <div class="fixed inset-x-0 bottom-0 z-footer-reveal" data-footer-reveal-panel>
    <ClosingProfile content={closingProfileContent} />
  </div>
</div>
