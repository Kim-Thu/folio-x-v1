---
import Container from '@/components/layouts/Container.astro';
import FooterBrand from '@/components/patterns/Footer/FooterBrand/FooterBrand.astro';
import FooterColumn from '@/components/patterns/Footer/FooterColumn/FooterColumn.astro';
import FooterNewsletter from '@/components/patterns/Footer/FooterNewsletter/FooterNewsletter.astro';
import { footerContent } from '@/data/content';
import { footerColumns } from '@/data/footer';
import { site, socialLinks } from '@/data/site';
---

<footer class="border-t-hairline border-line-dark bg-surface-dark text-on-dark">
  <Container>
    <div class="grid gap-x-xl gap-y-2xl py-2xl md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <FooterBrand
          description={footerContent.brandDescription ?? ''}
          socialLinks={socialLinks}
          socialDisplay={footerContent.socialDisplay}
        />
      </div>
      <div class="grid grid-cols-2 gap-x-lg gap-y-xl sm:grid-cols-3 md:col-span-1 lg:col-span-5">
        {footerColumns.map((column) => <FooterColumn column={column} />)}
      </div>
      {footerContent.newsletter && (
        <div class="md:col-span-2 lg:col-span-4">
          <FooterNewsletter content={footerContent.newsletter} />
        </div>
      )}
    </div>

    <div class="border-t-hairline border-line-dark py-7 font-mono text-caption uppercase tracking-meta text-on-dark-faint text-center">
      <p>{footerContent.copyrightSymbol} {new Date().getFullYear()} {site.name}</p>
    </div>
  </Container>
</footer>
