---
import { interfaceContent } from '@/data/content';
import { socialLinks } from '@/data/site';
import SocialNav from '@/components/patterns/Navigation/SocialNav/SocialNav.astro';
import Icon from '@/components/primitives/Icon/Icon.astro';
import Button from '@/components/primitives/Button/Button.astro';
---

<aside class="pointer-events-none fixed bottom-24 right-7 top-28 z-30 hidden flex-col items-center xl:flex" aria-label={interfaceContent.progress.railLabel}>
  <span id="section-count" class="font-mono text-label text-on-dark-muted">{interfaceContent.progress.initialSection}</span>
  <progress id="reading-progress" class="sr-only" max="100" value="0" aria-label={interfaceContent.progress.readingLabel}>{interfaceContent.progress.initialValue}</progress>
  <div class="relative my-4 h-full w-px overflow-hidden bg-line-dark" aria-hidden="true">
    <span id="scroll-progress-bar" class="absolute inset-x-0 top-0 h-0 bg-brand"></span>
  </div>
  <SocialNav links={socialLinks} variant="rail" display={interfaceContent.navigation.railSocialDisplay} />
</aside>

<Button id="back-to-top" label={interfaceContent.backToTop} iconOnly variant="outline" size="lg" class="fixed bottom-5 right-5 z-40 translate-y-4 opacity-0 md:bottom-7 md:right-7" inert>
  <span id="progress-ring" class="absolute inset-0 rounded-full" aria-hidden="true"></span>
  <Icon name="arrowUp" class="size-5" />
</Button>
