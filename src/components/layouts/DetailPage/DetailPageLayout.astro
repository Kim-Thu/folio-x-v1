---
import type { DetailPageLayoutProps } from '@/types/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layouts/Container.astro';
import Button from '@/components/primitives/Button/Button.astro';
import Image from '@/components/primitives/Image/Image.astro';
import TaxonomyLinks from '@/components/patterns/Navigation/TaxonomyLinks/TaxonomyLinks.astro';
import { getDetailPageClasses } from '@/components/layouts/DetailPage/variants/getDetailPageClasses';

type Props = DetailPageLayoutProps;

const {
  title,
  description,
  backHref,
  backLabel,
  tone,
  image,
  taxonomyTerms,
  taxonomyBasePath,
  taxonomyLabel,
} = Astro.props;
const classes = getDetailPageClasses(tone);
---

<BaseLayout title={title} description={description}>
  <main class={classes.main}>
    <Container>
      <Button href={backHref} label={backLabel} icon="arrowLeft" iconPosition="start" variant="text" tone={tone} />
      <article>
        <slot name="header" />
        {image && (
          <figure class="mt-12 overflow-hidden rounded-card">
            <Image src={image.src} alt={image.alt} variant="editorial" />
          </figure>
        )}
        <div class="grid gap-2xl py-3xl md:py-5xl lg:grid-cols-12 lg:py-6xl">
          <div class="lg:col-span-3">
            <TaxonomyLinks terms={taxonomyTerms} basePath={taxonomyBasePath} label={taxonomyLabel} tone={tone} />
          </div>
          <div class="space-y-14 lg:col-span-8 lg:col-start-5">
            <slot />
          </div>
        </div>
      </article>
    </Container>
  </main>
</BaseLayout>
