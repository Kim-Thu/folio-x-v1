---
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import CRow from "@/components/object/component/CRow.astro";
import CTabList from "@/components/object/component/CTabList.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import PStatement from "@/components/object/project/statement/PStatement.astro";
import type { PageCollectionRegion } from "@/types/components/pages/builder/PageCollectionRegion.types";

type Props = { region: PageCollectionRegion };
const { region } = Astro.props as Props;
const {
	template = "stack",
	header,
	tabs,
	cardGroups,
	action,
	statement,
	behavior,
} = region.props;
---

<CColumns
	columns="one"
	gap="xl"
	data-tabbed-collection={behavior === "tabbed" ? "" : undefined}
>
	{header && <PSectionHeader {...header} />}
	{tabs && <CTabList {...tabs} />}

	<CColumns
		columns={template === "split" ? "twelve" : "one"}
		gap="xl"
		data-collection-panel={behavior === "tabbed" ? "" : undefined}
	>
		{cardGroups.map((cards, index) => (
			<CGridItem lgSpan={template === "split" ? (index === 0 ? 7 : 5) : "full"}>
				<PCard {...cards} />
			</CGridItem>
		))}
	</CColumns>

	{statement && <PStatement {...statement} />}

	{action && (
		<CRow>
			<CButton {...action} />
		</CRow>
	)}
</CColumns>
