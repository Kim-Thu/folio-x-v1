---
import LPage from "@/components/layout/LPage.astro";
import PageRegionView from "@/components/pages/builder/PageRegion.astro";
import {
	getInsights,
	getLabs,
	getProductCategories,
	getProducts,
	getProjects,
	getPublications,
} from "@/data/cms";
import {
	mapInsightToCard,
	mapLabToCard,
	mapProductToCard,
	mapProjectToCard,
	mapPublicationToCard,
} from "@/data/mappers/card";
import type {
	ArchiveRegion,
	PageBuilderConfig,
	PageBuilderProps,
	PageRegion,
	PageRegionPlacement,
	PageSectionData,
} from "@/types/components/pages/builder/PageBuilder.types";
import type { LSectionSpacing, LSectionTheme } from "@/types/components/layout/LSection.types";
import type { PArticleProps } from "@/types/components/object/project/article/PArticle.types";
import type { PCardData, PCardProps } from "@/types/components/object/project/card/PCard.types";
import type { PCtaProps } from "@/types/components/object/project/cta/PCta.types";
import type { PHeroProps } from "@/types/components/object/project/hero/PHero.types";
import type { PPageHeaderProps } from "@/types/components/object/project/page-header/PPageHeader.types";
import type { PSectionHeaderProps } from "@/types/components/object/project/section-header/PSectionHeader.types";

const props = Astro.props as PageBuilderProps;
const context = "page" in props ? (props.context ?? {}) : {};

type RecordValue = Record<string, unknown>;

const asRecord = (value: unknown): RecordValue =>
	value && typeof value === "object" && !Array.isArray(value)
		? (value as RecordValue)
		: {};

const asString = (value: unknown, fallback = ""): string =>
	typeof value === "string" ? value : fallback;

const asNumber = (value: unknown, fallback: number): number =>
	typeof value === "number" ? value : fallback;

const asArray = (value: unknown): unknown[] =>
	Array.isArray(value) ? value : [];

const optionList = (value: unknown) =>
	asArray(value)
		.map(asRecord)
		.filter((option) => typeof option.label === "string" && typeof option.value === "string")
		.map((option) => ({
			label: asString(option.label),
			value: asString(option.value),
		}));

const sectionFrame = (section: PageSectionData) => {
	const settings = asRecord(section.settings);
	return {
		id: section.id,
		theme: asString(settings.theme, "light") as LSectionTheme,
		spacing: asString(settings.spacing, "compact") as LSectionSpacing,
		container: asString(settings.container, "site") as "site" | "content" | "none",
	};
};

const sectionHeader = (section: PageSectionData): PSectionHeaderProps => {
	const heading = asRecord(asRecord(section.content).heading);
	const action = asRecord(heading.action);
	const rawTitle = heading.title;

	return {
		data: {
			number: asString(heading.number),
			label: asString(heading.label),
			title:
				typeof rawTitle === "string"
					? rawTitle
					: asArray(rawTitle).filter(
							(value): value is string => typeof value === "string",
						),
			description: asString(heading.description),
		},
		action: action.href
			? {
					href: asString(action.href),
					label: asString(action.label),
					icon: "arrowRight",
					iconPosition: "end",
					variant: "text",
					tone: "light",
					size: "sm",
			  }
			: undefined,
	};
};

const cardConfig = (
	section: PageSectionData,
	items: PCardData[],
	overrides: Partial<PCardProps> = {},
): PCardProps => {
	const content = asRecord(section.content);
	const cards = asRecord(content.cards);
	const settings = asRecord(section.settings);

	return {
		template: asString(cards.template, asString(section.template, "overlay")) as PCardProps["template"],
		layout: asString(cards.layout, asString(settings.layout, "grid")) as PCardProps["layout"],
		columns: (cards.columns ?? settings.columns ?? 1) as PCardProps["columns"],
		gap: asString(cards.gap, asString(settings.gap, "sm")) as PCardProps["gap"],
		mediaRatio: (cards.mediaRatio ?? settings.mediaRatio) as PCardProps["mediaRatio"],
		separator: (cards.separator ?? settings.separator) as PCardProps["separator"],
		headingLevel: (cards.headingLevel ?? 3) as PCardProps["headingLevel"],
		slots: asRecord(cards.slots) as PCardProps["slots"],
		items,
		...overrides,
	};
};

const resolveCollectionItems = async (
	section: PageSectionData,
): Promise<PCardData[]> => {
	const content = asRecord(section.content);
	const staticItems = asArray(content.items);

	if (staticItems.length > 0) return staticItems as PCardData[];

	const source = asRecord(content.source);
	const collection = asString(source.collection);
	const limit = asNumber(source.limit, 4);

	switch (collection) {
		case "products":
			return (await getProducts()).slice(0, limit).map(mapProductToCard);
		case "projects":
			return (await getProjects())
				.slice(0, limit)
				.map((item) => mapProjectToCard(item, "View case direction", "·"));
		case "labs":
			return (await getLabs()).slice(0, limit).map(mapLabToCard);
		case "blog":
			return (await getInsights())
				.slice(0, limit)
				.map((item) => mapInsightToCard(item, "·"));
		case "comics":
			return (await getPublications("comics"))
				.slice(0, limit)
				.map((item) => mapPublicationToCard(item, "comics"));
		case "novels":
			return (await getPublications("novels"))
				.slice(0, limit)
				.map((item) => mapPublicationToCard(item, "novels"));
		case "publications": {
			const [novels, comics] = await Promise.all([
				getPublications("novels"),
				getPublications("comics"),
			]);
			return [
				...novels.map((item) => mapPublicationToCard(item, "novels")),
				...comics.map((item) => mapPublicationToCard(item, "comics")),
			].slice(0, limit);
		}
		default:
			return [];
	}
};

const archiveBase = (content: RecordValue) => {
	const pagination = asRecord(content.pagination);
	return {
		pagination,
		pageSize: asNumber(pagination.pageSize, 9),
		emptyLabel: asString(content.emptyLabel),
	};
};

const buildProjectsArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const toolbar = asRecord(content.toolbar);
	const sort = asRecord(toolbar.sort);
	const view = asRecord(toolbar.view);
	const cards = asRecord(content.cards);
	const taxonomy = asRecord(content.taxonomy);
	const { pagination, pageSize, emptyLabel } = archiveBase(content);
	const projects = await getProjects();
	const visibleProjects = projects.filter((project) => {
		if (context.categorySlug) return project.categorySlug === context.categorySlug;
		if (context.tagSlug) return project.tags.some((tag) => tag.slug === context.tagSlug);
		return true;
	});
	const categories = Array.from(
		new Map(
			projects.map((project) => [
				project.categorySlug,
				{ label: project.category, value: project.categorySlug },
			]),
		).values(),
	);

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "taxonomy",
			toolbar: {
				data: {
					filter: {
						label: asString(toolbar.filterLabel),
						activeValue: context.categorySlug ?? "all",
						tabs: [
							{ label: asString(toolbar.allLabel, "All"), value: "all" },
							...categories,
						],
					},
					sort: {
						label: asString(sort.label, asString(toolbar.sortLabel, "Sort")),
						value: asString(sort.value, "newest"),
						options: optionList(sort.options ?? toolbar.sortOptions),
					},
					view: {
						label: asString(view.label, asString(toolbar.viewLabel, "View")),
						gridLabel: asString(view.gridLabel, asString(toolbar.gridViewLabel, "Grid view")),
						listLabel: asString(view.listLabel, asString(toolbar.listViewLabel, "List view")),
					},
				},
			},
			cards: {
				template: asString(cards.template, "overlay") as PCardProps["template"],
				layout: asString(cards.layout, "mosaic") as PCardProps["layout"],
				gap: asString(cards.gap, "sm") as PCardProps["gap"],
				items: visibleProjects.map((project, index) =>
					mapProjectToCard(
						project,
						asString(cards.actionLabel, "View project"),
						"·",
						index % 4 === 0 || index % 4 === 3 ? "wide" : "standard",
						asString(taxonomy.tagPrefix),
					),
				),
			},
			emptyLabel,
			pagination: {
				label: asString(pagination.label),
				previousLabel: asString(pagination.previousLabel),
				nextLabel: asString(pagination.nextLabel),
				pageSize,
				totalPages: Math.max(1, Math.ceil(visibleProjects.length / pageSize)),
			},
		},
	};
};

const buildLabsArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const toolbar = asRecord(content.toolbar);
	const search = asRecord(toolbar.search);
	const sort = asRecord(toolbar.sort);
	const view = asRecord(toolbar.view);
	const sidebar = asRecord(content.sidebar);
	const categoryCopy = asRecord(sidebar.category);
	const technologyCopy = asRecord(sidebar.technology);
	const cards = asRecord(content.cards);
	const { pagination, pageSize, emptyLabel } = archiveBase(content);
	const labs = await getLabs();
	const visibleLabs = labs.filter((lab) =>
		(!context.categorySlug || lab.category.slug === context.categorySlug) &&
		(!context.technologySlug || lab.technologies.some((technology) => technology.slug === context.technologySlug)),
	);
	const categories = Array.from(
		new Map(labs.map((lab) => [lab.category.slug, lab.category])).values(),
	);
	const technologies = Array.from(
		new Map(
			labs.flatMap((lab) => lab.technologies.map((technology) => [technology.slug, technology] as const)),
		).values(),
	);

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: {
				data: {
					search: {
						id: asString(search.id, "labs-search"),
						label: asString(search.label),
						name: asString(search.name, "search"),
						placeholder: asString(search.placeholder),
					},
					selects: asArray(toolbar.selects).map(asRecord).map((select) => ({
						control: asString(select.control),
						id: asString(select.id),
						label: asString(select.label),
						value: asString(select.value, "all"),
						options: optionList(select.options),
					})),
					sort: {
						label: asString(sort.label),
						value: asString(sort.value, "newest"),
						options: optionList(sort.options),
					},
					view: {
						label: asString(view.label),
						gridLabel: asString(view.gridLabel),
						listLabel: asString(view.listLabel),
					},
				},
			},
			sidebar: {
				label: asString(sidebar.label),
				filter: {
					data: {
						filterLabel: asString(sidebar.filterLabel),
						category: {
							appearance: "navigation",
							control: "category",
							legend: asString(categoryCopy.legend),
							name: asString(categoryCopy.name, "labs-category"),
							type: "radio",
							options: [
								{
									label: asString(categoryCopy.allLabel, "All"),
									value: "all",
									href: "/labs",
									count: labs.length,
									checked: !context.categorySlug,
								},
								...categories.map((category) => ({
									label: category.label,
									value: category.slug,
									href: `/labs/category/${category.slug}`,
									count: labs.filter((lab) => lab.category.slug === category.slug).length,
									checked: context.categorySlug === category.slug,
								})),
							],
						},
						groups: [
							{
								appearance: "navigation",
								control: "technology",
								legend: asString(technologyCopy.legend),
								name: asString(technologyCopy.name, "labs-technology"),
								type: "checkbox",
								options: technologies.map((technology) => ({
									label: technology.label,
									value: technology.slug,
									href: `/labs/technology/${technology.slug}`,
									count: labs.filter((lab) => lab.technologies.some((item) => item.slug === technology.slug)).length,
									checked: context.technologySlug === technology.slug,
								})),
							},
						],
					},
				},
			},
			result: {
				count: visibleLabs.length,
				label: asString(content.resultLabel),
			},
			cards: {
				template: asString(cards.template, "media-metrics") as PCardProps["template"],
				layout: asString(cards.layout, "grid") as PCardProps["layout"],
				columns: (cards.columns ?? 3) as PCardProps["columns"],
				gap: asString(cards.gap, "md") as PCardProps["gap"],
				items: visibleLabs.map(mapLabToCard),
			},
			emptyLabel,
			pagination: {
				label: asString(pagination.label),
				previousLabel: asString(pagination.previousLabel),
				nextLabel: asString(pagination.nextLabel),
				pageSize,
				totalPages: Math.max(1, Math.ceil(visibleLabs.length / pageSize)),
			},
		},
	};
};

const buildProductsArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const toolbar = asRecord(content.toolbar);
	const search = asRecord(toolbar.search);
	const categoryControl = asRecord(toolbar.category);
	const platformControl = asRecord(toolbar.platform);
	const sort = asRecord(toolbar.sort);
	const view = asRecord(toolbar.view);
	const sidebar = asRecord(content.sidebar);
	const categoryCopy = asRecord(sidebar.category);
	const platformCopy = asRecord(sidebar.platform);
	const price = asRecord(sidebar.price);
	const license = asRecord(sidebar.license);
	const ratings = asRecord(sidebar.ratings);
	const advertisement = asRecord(sidebar.advertisement);
	const cards = asRecord(content.cards);
	const result = asRecord(content.result);
	const { pagination, pageSize, emptyLabel } = archiveBase(content);
	const [products, categoryFilters] = await Promise.all([
		getProducts(),
		getProductCategories(),
	]);
	const visibleProducts = context.categorySlug
		? products.filter((product) => product.categorySlug === context.categorySlug)
		: products;
	const platformValues = asArray(platformControl.options).filter(
		(value): value is string => typeof value === "string",
	);

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: {
				data: {
					search: {
						id: asString(search.id, "product-search"),
						label: asString(search.label),
						name: asString(search.name, "search"),
						placeholder: asString(search.placeholder),
					},
					selects: [
						{
							control: asString(categoryControl.control, "category"),
							id: asString(categoryControl.id, "product-category"),
							label: asString(categoryControl.label),
							value: context.categorySlug ?? "all",
							options: categoryFilters.map((option) => ({
								label: option.value === "all" ? asString(categoryControl.allLabel, option.label) : option.label,
								value: option.value,
							})),
						},
						{
							control: asString(platformControl.control, "platform"),
							id: asString(platformControl.id, "product-platform"),
							label: asString(platformControl.label),
							value: "all",
							options: [
								{ label: asString(platformControl.allLabel, "All platforms"), value: "all" },
								...platformValues.map((value) => ({ label: value, value })),
							],
						},
					],
					sort: {
						label: asString(sort.label),
						value: asString(sort.value, "newest"),
						options: optionList(sort.options),
					},
					view: {
						label: asString(view.label),
						gridLabel: asString(view.gridLabel),
						listLabel: asString(view.listLabel),
					},
				},
			},
			sidebar: {
				label: asString(sidebar.label),
				filter: {
					data: {
						category: {
							appearance: "navigation",
							control: "category",
							legend: asString(categoryCopy.legend),
							name: "product-category",
							type: "radio",
							options: categoryFilters.map((option) => ({
								label: option.label,
								value: option.value,
								href: option.value === "all" ? "/products" : `/products/category/${option.value}`,
								count: option.value === "all" ? products.length : products.filter((product) => product.categorySlug === option.value).length,
								checked: context.categorySlug ? context.categorySlug === option.value : option.value === "all",
							})),
						},
						platform: {
							appearance: "controls",
							control: "platform",
							legend: asString(platformCopy.legend),
							name: "product-platforms",
							type: "checkbox",
							options: platformValues.map((value) => ({
								label: value,
								value,
								count: products.filter((product) => product.platform === value).length,
							})),
						},
						range: {
							id: asString(price.id, "product-price"),
							label: asString(price.label),
							name: asString(price.name, "price"),
							min: asNumber(price.min, 0),
							max: asNumber(price.max, 99),
							value: asNumber(price.value, 99),
							maxSuffix: asString(price.maxSuffix),
							prefix: asString(price.prefix),
						},
						license: {
							appearance: "controls",
							control: "license",
							legend: asString(license.legend),
							name: "product-license",
							type: "checkbox",
							options: [
								{ label: asString(license.freeLabel), value: "free", count: 0 },
								{ label: asString(license.proLabel), value: "pro", count: products.length },
							],
						},
						ratings: {
							legend: asString(ratings.legend),
							name: "product-ratings",
							options: [5, 4, 3, 2, 1].map((value) => ({
								value,
								count: products.filter((product) => product.rating >= value).length,
							})),
						},
					},
				},
				advertisement: Object.keys(advertisement).length
					? { data: advertisement as unknown as ArchiveRegion["props"]["sidebar"] extends infer S ? S extends { advertisement?: infer A } ? A extends { data: infer D } ? D : never : never : never }
					: undefined,
			},
			result: {
				count: visibleProducts.length,
				label: asString(result.label),
			},
			cards: {
				template: asString(cards.template, "media-details") as PCardProps["template"],
				layout: asString(cards.layout, "grid") as PCardProps["layout"],
				columns: (cards.columns ?? 3) as PCardProps["columns"],
				gap: asString(cards.gap, "md") as PCardProps["gap"],
				items: visibleProducts.map(mapProductToCard),
			},
			emptyLabel,
			pagination: {
				label: asString(pagination.label),
				previousLabel: asString(pagination.previousLabel),
				nextLabel: asString(pagination.nextLabel),
				pageSize,
				totalPages: Math.max(1, Math.ceil(visibleProducts.length / pageSize)),
			},
		},
	};
};

const buildBlogArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const toolbar = asRecord(content.toolbar);
	const search = asRecord(toolbar.search);
	const categoryControl = asRecord(toolbar.category);
	const sort = asRecord(toolbar.sort);
	const view = asRecord(toolbar.view);
	const sidebar = asRecord(content.sidebar);
	const filter = asRecord(sidebar.filter);
	const featured = asRecord(sidebar.featured);
	const featuredCards = asRecord(featured.cards);
	const newsletter = asRecord(sidebar.newsletter);
	const result = asRecord(content.result);
	const cards = asRecord(content.cards);
	const taxonomy = asRecord(content.taxonomy);
	const { pagination, pageSize, emptyLabel } = archiveBase(content);
	const insights = await getInsights();
	const visibleInsights = insights.filter((insight) =>
		(!context.categorySlug || insight.categorySlug === context.categorySlug) &&
		(!context.tagSlug || insight.tags.some((tag) => tag.slug === context.tagSlug)),
	);
	const categories = Array.from(
		new Map(insights.map((insight) => [insight.categorySlug, { label: insight.category, slug: insight.categorySlug }])).values(),
	);
	const separator = asString(taxonomy.separator, "·");
	const featuredLimit = asNumber(featured.limit, 4);

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: {
				data: {
					search: {
						id: asString(search.id, "insights-search"),
						label: asString(search.label),
						name: asString(search.name, "search"),
						placeholder: asString(search.placeholder),
					},
					selects: [
						{
							control: asString(categoryControl.control, "category"),
							id: asString(categoryControl.id, "insights-category"),
							label: asString(categoryControl.label),
							value: context.categorySlug ?? "all",
							options: [
								{ label: asString(categoryControl.allLabel), value: "all" },
								...categories.map((category) => ({ label: category.label, value: category.slug })),
							],
						},
					],
					sort: {
						label: asString(sort.label),
						value: asString(sort.value, "newest"),
						options: optionList(sort.options),
					},
					view: {
						label: asString(view.label),
						gridLabel: asString(view.gridLabel),
						listLabel: asString(view.listLabel),
					},
				},
			},
			sidebar: {
				label: asString(sidebar.label),
				filter: {
					data: {
						groups: [
							{
								appearance: "navigation",
								control: "category",
								legend: asString(filter.legend),
								name: "insight-category",
								type: "radio",
								options: [
									{
										label: asString(filter.allLabel, "All"),
										value: "all",
										href: "/blog",
										count: insights.length,
										checked: !context.categorySlug,
									},
									...categories.map((category) => ({
										label: category.label,
										value: category.slug,
										href: `/blog/category/${category.slug}`,
										count: insights.filter((insight) => insight.categorySlug === category.slug).length,
										checked: context.categorySlug === category.slug,
									})),
								],
							},
						],
					},
				},
				cardsHeader: {
					data: { title: asString(featured.title) },
					appearance: "compact",
					headingLevel: 2,
				},
				cards: {
					template: asString(featuredCards.template, "compact-media") as PCardProps["template"],
					layout: asString(featuredCards.layout, "list") as PCardProps["layout"],
					columns: (featuredCards.columns ?? 1) as PCardProps["columns"],
					gap: asString(featuredCards.gap, "sm") as PCardProps["gap"],
					items: insights.slice(0, featuredLimit).map((insight) => mapInsightToCard(insight, separator)),
					slots: asRecord(featuredCards.slots) as PCardProps["slots"],
				},
				advertisement: Object.keys(newsletter).length
					? {
						template: asString(newsletter.template, "form-first") as "form-first" | "media-first",
						data: {
							title: asString(newsletter.title),
							description: asString(newsletter.description),
							image: asRecord(newsletter.image) as unknown as { src: string; alt: string; width: number; height: number },
							action: asRecord(newsletter.action) as unknown as { href: string; label: string },
							form: asRecord(newsletter.form) as unknown as { formName: string; inputId: string; inputLabel: string; placeholder: string; submitLabel: string },
						},
					  }
					: undefined,
			},
			result: {
				header: {
					data: { title: asString(result.title) },
					appearance: "compact",
					headingLevel: 2,
				},
			},
			cards: {
				template: asString(cards.template, "editorial") as PCardProps["template"],
				layout: asString(cards.layout, "grid") as PCardProps["layout"],
				columns: (cards.columns ?? 3) as PCardProps["columns"],
				gap: asString(cards.gap, "sm") as PCardProps["gap"],
				items: visibleInsights.map((insight) => mapInsightToCard(insight, separator)),
				slots: asRecord(cards.slots) as PCardProps["slots"],
			},
			emptyLabel,
			pagination: {
				label: asString(pagination.label),
				previousLabel: asString(pagination.previousLabel),
				nextLabel: asString(pagination.nextLabel),
				pageSize,
				totalPages: Math.max(1, Math.ceil(visibleInsights.length / pageSize)),
			},
		},
	};
};

const buildArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const collection = asString(asRecord(content.source).collection);
	switch (collection) {
		case "projects":
			return buildProjectsArchive(section, content);
		case "labs":
			return buildLabsArchive(section, content);
		case "products":
			return buildProductsArchive(section, content);
		case "blog":
			return buildBlogArchive(section, content);
		default:
			throw new Error(`Unsupported CMS archive source: ${collection}`);
	}
};

const regionFromSection = async (section: PageSectionData): Promise<PageRegion> => {
	const content = asRecord(section.content);
	const frame = sectionFrame(section);

	switch (section.type) {
		case "hero":
			return {
				key: section.id,
				component: "hero",
				section: frame,
				props: {
					template: asString(section.template, "split-media") as PHeroProps["template"],
					data: content as unknown as PHeroProps["data"],
				},
			};

		case "page-header":
			return {
				key: section.id,
				component: "page-header",
				placement: "header",
				section: frame,
				props: {
					template: asString(section.template, "split-media"),
					data: content,
				} as unknown as PPageHeaderProps,
			};

		case "article":
			return {
				key: section.id,
				component: "article",
				section: frame,
				props: content as unknown as PArticleProps,
			};

		case "cta":
			return {
				key: section.id,
				component: "cta",
				placement: "cta",
				section: frame,
				props: {
					template: asString(section.template, "callout") as PCtaProps["template"],
					data: content as unknown as PCtaProps["data"],
				},
			};

		case "archive":
			return buildArchive(section, content);

		case "collection": {
			const items = await resolveCollectionItems(section);

			if (section.template === "cards") {
				return {
					key: section.id,
					component: "cards",
					section: frame,
					props: { cards: cardConfig(section, items) },
				};
			}

			if (section.template === "split") {
				return {
					key: section.id,
					component: "collection",
					section: frame,
					props: {
						template: "split",
						header: { ...sectionHeader(section), template: "split" },
						cardGroups: [
							cardConfig(section, items.slice(0, 1)),
							cardConfig(section, items.slice(1), {
								template: "stacked",
								layout: "list",
								separator: "light",
								slots: {
									media: false,
									icon: false,
									metadata: true,
									tags: false,
									metrics: false,
									title: true,
									excerpt: true,
									action: false,
								},
							}),
						],
					},
				};
			}

			const header = sectionHeader(section);
			const headerTitle = typeof header.data.title === "string"
				? header.data.title
				: (header.data.title?.join(" ") ?? section.id);
			return {
				key: section.id,
				component: "group",
				section: frame,
				props: {
					template: "sidebar",
					asideLabel: headerTitle,
					asidePosition: "start",
					regions: [
						{
							key: `${section.id}-heading`,
							component: "section-header",
							section: false,
							placement: "aside",
							props: header,
						},
						{
							key: `${section.id}-cards`,
							component: "cards",
							section: false,
							props: { cards: cardConfig(section, items) },
						},
					],
				},
			};
		}

		default:
			throw new Error(`Unsupported CMS page section type: ${section.type}`);
	}
};

let config: PageBuilderConfig;

if ("page" in props && props.page) {
	config = {
		layout: { template: "fluid", containerSize: "site" },
		regions: await Promise.all(props.page.content.sections.map(regionFromSection)),
	};
} else {
	config = props.config;
}

const enabledRegions = config.regions.filter((region) => region.enabled !== false);
const regionsFor = (placement: PageRegionPlacement) =>
	enabledRegions.filter((region) => (region.placement ?? "main") === placement);

const headerRegions = regionsFor("header");
const mainRegions = regionsFor("main");
const asideRegions = regionsFor("aside");
const ctaRegions = regionsFor("cta");
---

<LPage {...config.layout} id="main-content" tabindex="-1">
	{headerRegions.length > 0 && (
		<Fragment slot="header">
			{headerRegions.map((region) => <PageRegionView {region} />)}
		</Fragment>
	)}

	{mainRegions.map((region) => <PageRegionView {region} />)}

	{asideRegions.length > 0 && (
		<Fragment slot="aside">
			{asideRegions.map((region) => <PageRegionView {region} />)}
		</Fragment>
	)}

	{ctaRegions.length > 0 && (
		<Fragment slot="cta">
			{ctaRegions.map((region) => <PageRegionView {region} />)}
		</Fragment>
	)}
</LPage>
