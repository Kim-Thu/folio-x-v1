---
import LPage from "@/components/layout/LPage.astro";
import PageRegionView from "@/components/pages/builder/PageRegion.astro";
import {
	getInsights,
	getLabs,
	getProductCategories,
	getProducts,
	getProjects,
	getPublications,
} from "@/data/cms";
import {
	mapInsightToCard,
	mapLabToCard,
	mapProductToCard,
	mapProjectToCard,
	mapPublicationToCard,
} from "@/data/mappers/card";
import type {
	ArchiveRegion,
	PageBuilderConfig,
	PageBuilderProps,
	PageRegion,
	PageRegionPlacement,
	PageSectionData,
} from "@/types/components/pages/builder/PageBuilder.types";
import type { LSectionSpacing, LSectionTheme } from "@/types/components/layout/LSection.types";
import type { PArticleProps } from "@/types/components/object/project/article/PArticle.types";
import type { PCardData, PCardProps } from "@/types/components/object/project/card/PCard.types";
import type { PCtaProps } from "@/types/components/object/project/cta/PCta.types";
import type { PHeroProps } from "@/types/components/object/project/hero/PHero.types";
import type { PPageHeaderProps } from "@/types/components/object/project/page-header/PPageHeader.types";
import type { PSectionHeaderProps } from "@/types/components/object/project/section-header/PSectionHeader.types";

const props = Astro.props as PageBuilderProps;
const context = "page" in props ? (props.context ?? {}) : {};

type RecordValue = Record<string, unknown>;

const asRecord = (value: unknown): RecordValue =>
	value && typeof value === "object" && !Array.isArray(value)
		? (value as RecordValue)
		: {};

const asString = (value: unknown): string =>
	typeof value === "string" ? value : "";

const asNumber = (value: unknown): number | undefined =>
	typeof value === "number" ? value : undefined;

const asArray = (value: unknown): unknown[] =>
	Array.isArray(value) ? value : [];

const optionList = (value: unknown) =>
	asArray(value)
		.map(asRecord)
		.filter((option) => typeof option.label === "string" && typeof option.value === "string")
		.map((option) => ({
			label: asString(option.label),
			value: asString(option.value),
		}));

const sectionFrame = (section: PageSectionData) => {
	const settings = asRecord(section.settings);
	return {
		id: section.id,
		theme: asString(settings.theme) as LSectionTheme,
		spacing: asString(settings.spacing) as LSectionSpacing,
		container: asString(settings.container) as "site" | "content" | "none",
	};
};

const sectionHeader = (section: PageSectionData): PSectionHeaderProps => {
	const heading = asRecord(asRecord(section.content).heading);
	const action = asRecord(heading.action);
	const rawTitle = heading.title;

	return {
		data: {
			number: asString(heading.number),
			label: asString(heading.label),
			title:
				typeof rawTitle === "string"
					? rawTitle
					: asArray(rawTitle).filter((value): value is string => typeof value === "string"),
			description: asString(heading.description),
		},
		action: action.href
			? {
					href: asString(action.href),
					label: asString(action.label),
					icon: action.icon as any,
					iconPosition: action.iconPosition as any,
					variant: action.variant as any,
					tone: action.tone as any,
					size: action.size as any,
			  }
			: undefined,
	};
};

const cardConfig = (
	section: PageSectionData,
	items: PCardData[],
	overrides: Partial<PCardProps> = {},
): PCardProps => {
	const content = asRecord(section.content);
	const cards = asRecord(content.cards);
	const settings = asRecord(section.settings);

	return {
		template: (cards.template ?? section.template) as PCardProps["template"],
		layout: (cards.layout ?? settings.layout) as PCardProps["layout"],
		columns: (cards.columns ?? settings.columns) as PCardProps["columns"],
		gap: (cards.gap ?? settings.gap) as PCardProps["gap"],
		mediaRatio: (cards.mediaRatio ?? settings.mediaRatio) as PCardProps["mediaRatio"],
		separator: (cards.separator ?? settings.separator) as PCardProps["separator"],
		headingLevel: cards.headingLevel as PCardProps["headingLevel"],
		slots: asRecord(cards.slots) as PCardProps["slots"],
		items,
		...overrides,
	};
};

const resolveCollectionItems = async (section: PageSectionData): Promise<PCardData[]> => {
	const content = asRecord(section.content);
	const staticItems = asArray(content.items);
	if (staticItems.length > 0) return staticItems as PCardData[];

	const source = asRecord(content.source);
	const collection = asString(source.collection);
	const limit = asNumber(source.limit);
	const take = <T,>(items: T[]) => limit === undefined ? items : items.slice(0, limit);

	switch (collection) {
		case "products":
			return take(await getProducts()).map(mapProductToCard);
		case "projects":
			return take(await getProjects()).map((item) => mapProjectToCard(item, "", ""));
		case "labs":
			return take(await getLabs()).map(mapLabToCard);
		case "blog":
			return take(await getInsights()).map((item) => mapInsightToCard(item, ""));
		case "comics":
			return take(await getPublications("comics")).map((item) => mapPublicationToCard(item, "comics"));
		case "novels":
			return take(await getPublications("novels")).map((item) => mapPublicationToCard(item, "novels"));
		case "publications": {
			const [novels, comics] = await Promise.all([
				getPublications("novels"),
				getPublications("comics"),
			]);
			return take([
				...novels.map((item) => mapPublicationToCard(item, "novels")),
				...comics.map((item) => mapPublicationToCard(item, "comics")),
			]);
		}
		default:
			return [];
	}
};

const archiveBase = (content: RecordValue) => {
	const pagination = asRecord(content.pagination);
	return {
		pagination,
		pageSize: asNumber(pagination.pageSize) ?? 0,
		emptyLabel: asString(content.emptyLabel),
	};
};

const buildProjectsArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const toolbar = asRecord(content.toolbar);
	const cards = asRecord(content.cards);
	const taxonomy = asRecord(content.taxonomy);
	const routes = asRecord(content.routes);
	const { pagination, pageSize, emptyLabel } = archiveBase(content);
	const allValue = asString(toolbar.allValue);
	const projects = await getProjects();
	const visibleProjects = projects.filter((project) => {
		if (context.categorySlug) return project.categorySlug === context.categorySlug;
		if (context.tagSlug) return project.tags.some((tag) => tag.slug === context.tagSlug);
		return true;
	});
	const categories = Array.from(
		new Map(
			projects.map((project) => [
				project.categorySlug,
				{
					label: project.category,
					value: project.categorySlug,
					href: `${asString(routes.categoryBase)}${project.categorySlug}`,
				},
			]),
		).values(),
	);

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "taxonomy",
			toolbar: {
				data: {
					filter: {
						label: asString(toolbar.filterLabel),
						activeValue: context.categorySlug ?? allValue,
						tabs: [
							{ label: asString(toolbar.allLabel), value: allValue, href: asString(routes.base) },
							...categories,
						],
					},
					sort: {
						label: asString(toolbar.sortLabel),
						value: asString(toolbar.sortValue),
						options: optionList(toolbar.sortOptions),
					},
					view: {
						label: asString(toolbar.viewLabel),
						gridLabel: asString(toolbar.gridViewLabel),
						listLabel: asString(toolbar.listViewLabel),
					},
				},
			},
			cards: {
				template: cards.template as PCardProps["template"],
				layout: cards.layout as PCardProps["layout"],
				gap: cards.gap as PCardProps["gap"],
				items: visibleProjects.map((project) =>
					mapProjectToCard(
						project,
						asString(cards.actionLabel),
						"",
						undefined,
						asString(taxonomy.tagPrefix),
					),
				),
			},
			emptyLabel,
			pagination: {
				label: asString(pagination.label),
				previousLabel: asString(pagination.previousLabel),
				nextLabel: asString(pagination.nextLabel),
				pageSize,
				totalPages: pageSize > 0 ? Math.max(1, Math.ceil(visibleProjects.length / pageSize)) : 1,
			},
		},
	};
};

const buildLabsArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const toolbar = asRecord(content.toolbar);
	const search = asRecord(toolbar.search);
	const sort = asRecord(toolbar.sort);
	const view = asRecord(toolbar.view);
	const sidebar = asRecord(content.sidebar);
	const categoryCopy = asRecord(sidebar.category);
	const technologyCopy = asRecord(sidebar.technology);
	const cards = asRecord(content.cards);
	const routes = asRecord(content.routes);
	const { pagination, pageSize, emptyLabel } = archiveBase(content);
	const labs = await getLabs();
	const visibleLabs = labs.filter((lab) =>
		(!context.categorySlug || lab.category.slug === context.categorySlug) &&
		(!context.technologySlug || lab.technologies.some((technology) => technology.slug === context.technologySlug)),
	);
	const categories = Array.from(new Map(labs.map((lab) => [lab.category.slug, lab.category])).values());
	const technologies = Array.from(
		new Map(labs.flatMap((lab) => lab.technologies.map((technology) => [technology.slug, technology] as const))).values(),
	);

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: {
				data: {
					search: {
						id: asString(search.id),
						label: asString(search.label),
						name: asString(search.name),
						placeholder: asString(search.placeholder),
					},
					selects: asArray(toolbar.selects).map(asRecord).map((select) => ({
						control: asString(select.control),
						id: asString(select.id),
						label: asString(select.label),
						value: asString(select.value),
						options: optionList(select.options),
					})),
					sort: {
						label: asString(sort.label),
						value: asString(sort.value),
						options: optionList(sort.options),
					},
					view: {
						label: asString(view.label),
						gridLabel: asString(view.gridLabel),
						listLabel: asString(view.listLabel),
					},
				},
			},
			sidebar: {
				label: asString(sidebar.label),
				filter: {
					data: {
						filterLabel: asString(sidebar.filterLabel),
						category: {
							appearance: categoryCopy.appearance as any,
							control: asString(categoryCopy.control),
							legend: asString(categoryCopy.legend),
							name: asString(categoryCopy.name),
							type: categoryCopy.type as any,
							options: [
								{
									label: asString(categoryCopy.allLabel),
									value: asString(categoryCopy.allValue),
									href: asString(categoryCopy.allHref),
									count: labs.length,
									checked: !context.categorySlug,
								},
								...categories.map((category) => ({
									label: category.label,
									value: category.slug,
									href: `${asString(routes.categoryBase)}${category.slug}`,
									count: labs.filter((lab) => lab.category.slug === category.slug).length,
									checked: context.categorySlug === category.slug,
								})),
							],
						},
						groups: [
							{
								appearance: technologyCopy.appearance as any,
								control: asString(technologyCopy.control),
								legend: asString(technologyCopy.legend),
								name: asString(technologyCopy.name),
								type: technologyCopy.type as any,
								options: technologies.map((technology) => ({
									label: technology.label,
									value: technology.slug,
									href: `${asString(routes.technologyBase)}${technology.slug}`,
									count: labs.filter((lab) => lab.technologies.some((item) => item.slug === technology.slug)).length,
									checked: context.technologySlug === technology.slug,
								})),
							},
						],
					},
				},
			},
			result: {
				count: visibleLabs.length,
				label: asString(content.resultLabel),
			},
			cards: {
				template: cards.template as PCardProps["template"],
				layout: cards.layout as PCardProps["layout"],
				columns: cards.columns as PCardProps["columns"],
				gap: cards.gap as PCardProps["gap"],
				items: visibleLabs.map(mapLabToCard),
			},
			emptyLabel,
			pagination: {
				label: asString(pagination.label),
				previousLabel: asString(pagination.previousLabel),
				nextLabel: asString(pagination.nextLabel),
				pageSize,
				totalPages: pageSize > 0 ? Math.max(1, Math.ceil(visibleLabs.length / pageSize)) : 1,
			},
		},
	};
};

const buildProductsArchive = async (
	section: PageSectionData,
	content: RecordValue,
): Promise<ArchiveRegion> => {
	const toolbar = asRecord(content.toolbar);
	const search = asRecord(toolbar.search);
	const categoryControl = asRecord(toolbar.category);
	const platformControl = asRecord(toolbar.platform);
	const sort = asRecord(toolbar.sort);
	const view = asRecord(toolbar.view);
	const sidebar = asRecord(content.sidebar);
	const categoryCopy = asRecord(sidebar.category);
	const platformCopy = asRecord(sidebar.platform);
	const advertisement = asRecord(sidebar.advertisement);
	const cards = asRecord(content.cards);
	const result = asRecord(content.result);
	const routes = asRecord(content.routes);
	const { pagination, pageSize, emptyLabel } = archiveBase(content);
	const [products, categories] = await Promise.all([getProducts(), getProductCategories()]);
	const visibleProducts = context.categorySlug
		? products.filter((product) => product.categorySlug === context.categorySlug)
		: products;
	const categoryFilters = [
		{
			label: asString(categoryControl.allLabel),
			value: asString(categoryControl.allValue),
			href: asString(routes.base),
			checked: !context.categorySlug,
		},
		...categories.map((category) => ({
			...category,
			href: `${asString(routes.categoryBase)}${category.value}`,
			checked: context.categorySlug === category.value,
		})),
	];
	const platformFilters = asArray(platformControl.options)
		.map(asRecord)
		.filter((option) => typeof option.label === "string" && typeof option.value === "string")
		.map((option) => ({
			label: asString(option.label),
			value: asString(option.value),
			checked: asString(option.value) === asString(platformControl.value),
		}));

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: {
				data: {
					search: {
						id: asString(search.id),
						label: asString(search.label),
						name: asString(search.name),
						placeholder: asString(search.placeholder),
					},
					selects: [
						{
							control: asString(categoryControl.control),
							id: asString(categoryControl.id),
							label: asString(categoryControl.label),
							value: context.categorySlug ?? asString(categoryControl.value),
							options: categoryFilters,
						},
						{
							control: asString(platformControl.control),
							id: asString(platformControl.id),
							label: asString(platformControl.label),
							value: asString(platformControl.value),
							options: platformFilters,
						},
					],
					sort: {
						label: asString(sort.label),
						value: asString(sort.value),
						options: optionList(sort.options),
					},
					view: {
						label: asString(view.label),
						gridLabel: asString(view.gridLabel),
						listLabel: asString(view.listLabel),
					},
				},
			},
			sidebar: {
				label: asString(sidebar.label),
				filter: {
					data: {
						filterLabel: asString(sidebar.filterLabel),
						category: {
							appearance: categoryCopy.appearance as any,
							control: asString(categoryCopy.control),
							legend: asString(categoryCopy.legend),
							name: asString(categoryCopy.name),
							type: categoryCopy.type as any,
							options: categoryFilters,
						},
						groups: [
							{
								appearance: platformCopy.appearance as any,
								control: asString(platformCopy.control),
								legend: asString(platformCopy.legend),
								name: asString(platformCopy.name),
								type: platformCopy.type as any,
								options: platformFilters,
							},
						],
					},
				},
				advertisement: advertisement.title
					? {
							title: asString(advertisement.title),
							description: asString(advertisement.description),
							action: advertisement.action as any,
							image: advertisement.image as any,
						  }
					: undefined,
			},
			result: {
				count: visibleProducts.length,
				label: asString(result.label),
			},
			cards: {
				template: cards.template as PCardProps["template"],
				layout: cards.layout as PCardProps["layout"],
				columns: cards.columns as PCardProps["columns"],
				gap: cards.gap as PCardProps["gap"],
				items: visibleProducts.map(mapProductToCard),
			},
			emptyLabel,
			pagination: {
				label: asString(pagination.label),
				previousLabel: asString(pagination.previousLabel),
				nextLabel: asString(pagination.nextLabel),
				pageSize,
				totalPages: pageSize > 0 ? Math.max(1, Math.ceil(visibleProducts.length / pageSize)) : 1,
			},
		},
	};
};

const regions: PageRegion[] = "config" in props
	? props.config.regions
	: await Promise.all(
		props.page.content.sections.map(async (section): Promise<PageRegion> => {
			const content = asRecord(section.content);
			const frame = sectionFrame(section);

			switch (section.type) {
				case "hero":
					return { key: section.id, component: "hero", section: frame, props: { template: section.template as PHeroProps["template"], data: content as PHeroProps["data"] } };
				case "page-header":
					return { key: section.id, component: "page-header", section: frame, props: { template: section.template as PPageHeaderProps["template"], data: content as PPageHeaderProps["data"] } };
				case "article":
					return { key: section.id, component: "article", section: frame, props: { blocks: asArray(content.blocks) as PArticleProps["blocks"] } };
				case "cta":
					return { key: section.id, component: "cta", section: frame, props: { template: section.template as PCtaProps["template"], data: content as PCtaProps["data"] } };
				case "collection": {
					const items = await resolveCollectionItems(section);
					return {
						key: section.id,
						component: "collection",
						section: frame,
						props: {
							template: section.template as "stack" | "split",
							header: content.heading ? sectionHeader(section) : undefined,
							cardGroups: [cardConfig(section, items)],
						},
					};
				}
				case "archive": {
					const source = asRecord(content.source);
					switch (asString(source.collection)) {
						case "projects": return buildProjectsArchive(section, content);
						case "labs": return buildLabsArchive(section, content);
						case "products": return buildProductsArchive(section, content);
						default: throw new Error(`Unsupported archive collection: ${asString(source.collection)}`);
					}
				}
				default:
					return { key: section.id, component: section.type as PageRegion["component"], section: frame, props: content as never } as PageRegion;
			}
		}),
	);

const config: PageBuilderConfig = "config" in props
	? props.config
	: {
		layout: { template: "fluid" },
		regions,
	};

const grouped = regions.reduce<Record<PageRegionPlacement, PageRegion[]>>(
	(acc, region) => {
		acc[region.placement ?? "main"].push(region);
		return acc;
	},
	{ header: [], main: [], aside: [], cta: [] },
);
---

<LPage {...config.layout}>
	{grouped.header.map((region) => <PageRegionView region={region} />)}
	{grouped.main.map((region) => <PageRegionView region={region} />)}
	{grouped.aside.map((region) => <PageRegionView region={region} />)}
	{grouped.cta.map((region) => <PageRegionView region={region} />)}
</LPage>
