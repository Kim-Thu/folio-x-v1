---
import LPage from "@/components/layout/LPage.astro";
import PageRegionView from "@/components/pages/builder/PageRegion.astro";
import {
	getInsights,
	getLabs,
	getProductCategories,
	getProducts,
	getProjects,
	getPublications,
} from "@/data/cms";
import {
	mapInsightToCard,
	mapLabToCard,
	mapProductToCard,
	mapProjectToCard,
	mapPublicationToCard,
	type InsightCardPresentation,
	type LabCardPresentation,
	type ProductCardPresentation,
	type ProjectCardPresentation,
	type PublicationCardPresentation,
} from "@/data/mappers/card";
import type {
	ArchiveRegion,
	PageBuilderConfig,
	PageBuilderProps,
	PageRegion,
	PageRegionPlacement,
	PageSectionData,
} from "@/types/components/pages/builder/PageBuilder.types";
import type { PArticleProps } from "@/types/components/object/project/article/PArticle.types";
import type { PCardData, PCardProps } from "@/types/components/object/project/card/PCard.types";
import type { PCtaProps } from "@/types/components/object/project/cta/PCta.types";
import type { PHeroProps } from "@/types/components/object/project/hero/PHero.types";
import type { PPageHeaderProps } from "@/types/components/object/project/page-header/PPageHeader.types";
import type { PSectionHeaderProps } from "@/types/components/object/project/section-header/PSectionHeader.types";

const props = Astro.props as PageBuilderProps;
const context = "page" in props ? (props.context ?? {}) : {};

type CollectionSection = Extract<PageSectionData, { type: "collection" }>;
type ArchiveSection = Extract<PageSectionData, { type: "archive" }>;

const sectionFrame = (section: PageSectionData) => ({
	id: section.id,
	theme: section.settings.theme,
	spacing: section.settings.spacing,
	container: section.settings.container,
});

const sectionHeader = (section: CollectionSection): PSectionHeaderProps | undefined => {
	const heading = section.content.heading;
	if (!heading) return undefined;

	return {
		data: {
			number: heading.number,
			label: heading.label,
			title: heading.title,
			description: heading.description,
		},
		action: heading.action,
	};
};

const cardConfig = (
	section: CollectionSection,
	items: PCardData[],
	overrides: Partial<PCardProps> = {},
): PCardProps => {
	const cards = section.content.cards;
	return {
		template: cards?.template ?? section.template,
		layout: cards?.layout ?? section.settings.layout,
		columns: cards?.columns ?? section.settings.columns,
		gap: cards?.gap ?? section.settings.gap,
		mediaRatio: cards?.mediaRatio ?? section.settings.mediaRatio,
		separator: cards?.separator ?? section.settings.separator,
		headingLevel: cards?.headingLevel,
		slots: cards?.slots,
		items,
		...overrides,
	};
};

const resolveCollectionItems = async (section: CollectionSection): Promise<PCardData[]> => {
	if (section.content.items?.length) return section.content.items as PCardData[];

	const source = section.content.source;
	if (!source) return [];

	const take = <T,>(items: T[]) => source.limit === undefined ? items : items.slice(0, source.limit);
	const presentation = section.content.itemPresentation;

	switch (source.collection) {
		case "products":
			return take(await getProducts()).map((item) => mapProductToCard(item, presentation as ProductCardPresentation));
		case "projects":
			return take(await getProjects()).map((item) => mapProjectToCard(item, presentation as ProjectCardPresentation));
		case "labs":
			return take(await getLabs()).map((item) => mapLabToCard(item, presentation as LabCardPresentation));
		case "blog":
			return take(await getInsights()).map((item) => mapInsightToCard(item, presentation as InsightCardPresentation));
		case "comics":
			return take(await getPublications("comics")).map((item) => mapPublicationToCard(item, "comics", presentation as PublicationCardPresentation));
		case "novels":
			return take(await getPublications("novels")).map((item) => mapPublicationToCard(item, "novels", presentation as PublicationCardPresentation));
		case "publications": {
			const [novels, comics] = await Promise.all([getPublications("novels"), getPublications("comics")]);
			const groupedPresentation = presentation as {
				novels: PublicationCardPresentation;
				comics: PublicationCardPresentation;
			};
			return take([
				...novels.map((item) => mapPublicationToCard(item, "novels", groupedPresentation.novels)),
				...comics.map((item) => mapPublicationToCard(item, "comics", groupedPresentation.comics)),
			]);
		}
	}
};

const archiveBase = (section: ArchiveSection) => ({
	pagination: section.content.pagination,
	pageSize: section.content.pagination.pageSize,
	emptyLabel: section.content.emptyLabel,
});

const buildProjectsArchive = async (section: ArchiveSection): Promise<ArchiveRegion> => {
	const content = section.content;
	const toolbar = content.toolbar as {
		filterLabel: string;
		allLabel: string;
		allValue: string;
		sortLabel: string;
		sortValue: string;
		sortOptions: Array<{ label: string; value: string }>;
		viewLabel: string;
		gridViewLabel: string;
		listViewLabel: string;
	};
	const cards = content.cards;
	const routes = content.routes as { base: string; categoryBase: string; tagBase?: string };
	const itemPresentation = content.itemPresentation as ProjectCardPresentation;
	const { pagination, pageSize, emptyLabel } = archiveBase(section);
	const projects = await getProjects();
	const visibleProjects = projects.filter((project) => {
		if (context.categorySlug) return project.categorySlug === context.categorySlug;
		if (context.tagSlug) return project.tags.some((tag) => tag.slug === context.tagSlug);
		return true;
	});
	const categories = Array.from(new Map(projects.map((project) => [project.categorySlug, {
		label: project.category,
		value: project.categorySlug,
		href: `${routes.categoryBase}${project.categorySlug}`,
	}])).values());

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "taxonomy",
			toolbar: { data: {
				filter: { label: toolbar.filterLabel, activeValue: context.categorySlug ?? toolbar.allValue, tabs: [{ label: toolbar.allLabel, value: toolbar.allValue, href: routes.base }, ...categories] },
				sort: { label: toolbar.sortLabel, value: toolbar.sortValue, options: toolbar.sortOptions },
				view: { label: toolbar.viewLabel, gridLabel: toolbar.gridViewLabel, listLabel: toolbar.listViewLabel },
			} },
			cards: {
				template: cards?.template,
				layout: cards?.layout,
				columns: cards?.columns,
				gap: cards?.gap,
				items: visibleProjects.map((project) => mapProjectToCard(project, itemPresentation)),
			},
			emptyLabel,
			pagination: { ...pagination, pageSize, totalPages: Math.max(1, Math.ceil(visibleProjects.length / pageSize)) },
		},
	};
};

const buildLabsArchive = async (section: ArchiveSection): Promise<ArchiveRegion> => {
	const content = section.content;
	const toolbar = content.toolbar as {
		search: { id: string; label: string; name: string; placeholder: string };
		selects: Array<{ control: string; id: string; label: string; value: string; options: Array<{ label: string; value: string }> }>;
		sort: { label: string; value: string; options: Array<{ label: string; value: string }> };
		view: { label: string; gridLabel: string; listLabel: string };
	};
	const sidebar = content.sidebar as {
		label: string;
		filterLabel: string;
		category: { appearance: "navigation" | "filter"; control: string; legend: string; name: string; type: "radio" | "checkbox"; allLabel: string; allValue: string; allHref: string };
		technology: { appearance: "navigation" | "filter"; control: string; legend: string; name: string; type: "radio" | "checkbox" };
	};
	const routes = content.routes as { categoryBase: string; technologyBase: string };
	const cards = content.cards;
	const itemPresentation = content.itemPresentation as LabCardPresentation;
	const { pagination, pageSize, emptyLabel } = archiveBase(section);
	const labs = await getLabs();
	const visibleLabs = labs.filter((lab) => (!context.categorySlug || lab.category.slug === context.categorySlug) && (!context.technologySlug || lab.technologies.some((technology) => technology.slug === context.technologySlug)));
	const categories = Array.from(new Map(labs.map((lab) => [lab.category.slug, lab.category])).values());
	const technologies = Array.from(new Map(labs.flatMap((lab) => lab.technologies.map((technology) => [technology.slug, technology] as const))).values());

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: { data: {
				search: toolbar.search,
				selects: toolbar.selects,
				sort: toolbar.sort,
				view: toolbar.view,
			} },
			sidebar: { label: sidebar.label, filter: { data: {
				filterLabel: sidebar.filterLabel,
				category: {
					appearance: sidebar.category.appearance,
					control: sidebar.category.control,
					legend: sidebar.category.legend,
					name: sidebar.category.name,
					type: sidebar.category.type,
					options: [{ label: sidebar.category.allLabel, value: sidebar.category.allValue, href: sidebar.category.allHref, count: labs.length, checked: !context.categorySlug }, ...categories.map((category) => ({ label: category.label, value: category.slug, href: `${routes.categoryBase}${category.slug}`, count: labs.filter((lab) => lab.category.slug === category.slug).length, checked: context.categorySlug === category.slug }))],
				},
				groups: [{
					appearance: sidebar.technology.appearance,
					control: sidebar.technology.control,
					legend: sidebar.technology.legend,
					name: sidebar.technology.name,
					type: sidebar.technology.type,
					options: technologies.map((technology) => ({ label: technology.label, value: technology.slug, href: `${routes.technologyBase}${technology.slug}`, count: labs.filter((lab) => lab.technologies.some((item) => item.slug === technology.slug)).length, checked: context.technologySlug === technology.slug })),
				}],
			} } },
			result: { count: visibleLabs.length, label: content.resultLabel },
			cards: { template: cards?.template, layout: cards?.layout, columns: cards?.columns, gap: cards?.gap, items: visibleLabs.map((lab) => mapLabToCard(lab, itemPresentation)) },
			emptyLabel,
			pagination: { ...pagination, pageSize, totalPages: Math.max(1, Math.ceil(visibleLabs.length / pageSize)) },
		},
	};
};

const buildProductsArchive = async (section: ArchiveSection): Promise<ArchiveRegion> => {
	const content = section.content;
	const toolbar = content.toolbar as {
		search: { id: string; label: string; name: string; placeholder: string };
		category: { control: string; id: string; label: string; value: string; allLabel: string; allValue: string };
		platform: { control: string; id: string; label: string; value: string; options: Array<{ label: string; value: string }> };
		sort: { label: string; value: string; options: Array<{ label: string; value: string }> };
		view: { label: string; gridLabel: string; listLabel: string };
	};
	const sidebar = content.sidebar as {
		label: string;
		filterLabel: string;
		category: { appearance: "navigation" | "filter"; control: string; legend: string; name: string; type: "radio" | "checkbox" };
		platform: { appearance: "navigation" | "filter"; control: string; legend: string; name: string; type: "radio" | "checkbox" };
		advertisement?: { title: string; description: string; action: PAdvertisementProps["action"]; image: PAdvertisementProps["image"] };
	};
	const routes = content.routes as { base: string; categoryBase: string };
	const cards = content.cards;
	const itemPresentation = content.itemPresentation as ProductCardPresentation;
	const { pagination, pageSize, emptyLabel } = archiveBase(section);
	const [products, categories] = await Promise.all([getProducts(), getProductCategories()]);
	const visibleProducts = context.categorySlug ? products.filter((product) => product.categorySlug === context.categorySlug) : products;
	const categoryFilters = [{ label: toolbar.category.allLabel, value: toolbar.category.allValue, href: routes.base, checked: !context.categorySlug }, ...categories.map((category) => ({ ...category, href: `${routes.categoryBase}${category.value}`, checked: context.categorySlug === category.value }))];
	const platformFilters = toolbar.platform.options.map((option) => ({ ...option, checked: option.value === toolbar.platform.value }));

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: { data: {
				search: toolbar.search,
				selects: [
					{ control: toolbar.category.control, id: toolbar.category.id, label: toolbar.category.label, value: context.categorySlug ?? toolbar.category.value, options: categoryFilters },
					{ control: toolbar.platform.control, id: toolbar.platform.id, label: toolbar.platform.label, value: toolbar.platform.value, options: platformFilters },
				],
				sort: toolbar.sort,
				view: toolbar.view,
			} },
			sidebar: {
				label: sidebar.label,
				filter: { data: {
					filterLabel: sidebar.filterLabel,
					category: { ...sidebar.category, options: categoryFilters },
					groups: [{ ...sidebar.platform, options: platformFilters }],
				} },
				advertisement: sidebar.advertisement,
			},
			result: { count: visibleProducts.length, label: (content.result as { label: string }).label },
			cards: { template: cards?.template, layout: cards?.layout, columns: cards?.columns, gap: cards?.gap, items: visibleProducts.map((product) => mapProductToCard(product, itemPresentation)) },
			emptyLabel,
			pagination: { ...pagination, pageSize, totalPages: Math.max(1, Math.ceil(visibleProducts.length / pageSize)) },
		},
	};
};

const regions: PageRegion[] = "config" in props
	? props.config.regions
	: await Promise.all(props.page.content.sections.map(async (section): Promise<PageRegion> => {
		const frame = sectionFrame(section);
		switch (section.type) {
			case "hero":
				return { key: section.id, component: "hero", section: frame, props: { template: section.template as PHeroProps["template"], data: section.content as PHeroProps["data"] } };
			case "page-header":
				return { key: section.id, component: "page-header", section: frame, props: { template: section.template as PPageHeaderProps["template"], data: section.content as PPageHeaderProps["data"] } };
			case "article":
				return { key: section.id, component: "article", section: frame, props: { blocks: (section.content as { blocks: PArticleProps["blocks"] }).blocks } };
			case "cta":
				return { key: section.id, component: "cta", section: frame, props: { template: section.template as PCtaProps["template"], data: section.content as PCtaProps["data"] } };
			case "collection": {
				const items = await resolveCollectionItems(section);
				return { key: section.id, component: "collection", section: frame, props: { template: section.template as "stack" | "split", header: sectionHeader(section), cardGroups: [cardConfig(section, items)] } };
			}
			case "archive":
				switch (section.content.source.collection) {
					case "projects": return buildProjectsArchive(section);
					case "labs": return buildLabsArchive(section);
					case "products": return buildProductsArchive(section);
					default: throw new Error(`Unsupported archive collection: ${section.content.source.collection}`);
				}
		}
	}));

const config: PageBuilderConfig = "config" in props ? props.config : { layout: props.page.content.layout, regions };
const grouped = regions.reduce<Record<PageRegionPlacement, PageRegion[]>>((acc, region) => {
	acc[region.placement ?? "main"].push(region);
	return acc;
}, { header: [], main: [], aside: [], cta: [] });
---

<LPage {...config.layout}>
	{grouped.header.map((region) => <PageRegionView region={region} />)}
	{grouped.main.map((region) => <PageRegionView region={region} />)}
	{grouped.aside.map((region) => <PageRegionView region={region} />)}
	{grouped.cta.map((region) => <PageRegionView region={region} />)}
</LPage>