---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import CPagination from "@/components/object/component/CPagination.astro";
import CProfile from "@/components/object/component/CProfile.astro";
import CRow from "@/components/object/component/CRow.astro";
import CTabList from "@/components/object/component/CTabList.astro";
import CText from "@/components/object/component/CText.astro";
import CTOC from "@/components/object/component/CTOC.astro";
import PAdvertisement from "@/components/object/project/advertisement/PAdvertisement.astro";
import PArchiveToolbar from "@/components/object/project/archive-toolbar/PArchiveToolbar.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PCta from "@/components/object/project/cta/PCta.astro";
import PEntryIndex from "@/components/object/project/entry-index/PEntryIndex.astro";
import PFilterPanel from "@/components/object/project/filter-panel/PFilterPanel.astro";
import PGallery from "@/components/object/project/gallery/PGallery.astro";
import PHero from "@/components/object/project/hero/PHero.astro";
import PPage from "@/components/object/project/page/PPage.astro";
import PPageDetails from "@/components/object/project/page/PPageDetails.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PPostNavigation from "@/components/object/project/post-navigation/PPostNavigation.astro";
import PReader from "@/components/object/project/reader/PReader.astro";
import PReviews from "@/components/object/project/reviews/PReviews.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import PStatement from "@/components/object/project/statement/PStatement.astro";
import PStatus from "@/components/object/project/status/PStatus.astro";
import {
	getInsights,
	getLabs,
	getProductCategories,
	getProducts,
	getProjects,
	getPublications,
} from "@/data/cms";
import type {
	PageBuilderProps,
	PageSectionData,
} from "@/types/components/pages/builder/PageBuilder.types";
import type { PageArchiveRegion } from "@/types/components/object/project/page/PageArchiveRegion.types";
import type { PageRegion } from "@/types/components/object/project/page/PageRegion.types";
import type { CIconName } from "@/types/components/object/component/CIcon.types";
import type {
	CCardConfig,
	CCardItemData,
	CCardPresentation,
	CCardSource,
	InsightCardPresentation,
} from "@/types/components/object/component/card/CCard.types";
import type { PAdvertisementData } from "@/types/components/object/project/advertisement/PAdvertisement.types";
import type { PCardProps } from "@/types/components/object/project/card/PCard.types";
import type { PFilterChoiceGroupData } from "@/types/components/object/project/filter-panel/PFilterPanel.types";
import type { PSectionHeaderProps } from "@/types/components/object/project/section-header/PSectionHeader.types";

const props = Astro.props as PageBuilderProps;
const context = "page" in props ? (props.context ?? {}) : {};

type CollectionSection = Extract<PageSectionData, { type: "collection" }>;
type CollectionContent = CollectionSection["content"];
type SourcedCollectionContent = Extract<CollectionContent, { source: unknown }>;
type ProductsCollectionContent = Extract<SourcedCollectionContent, { source: { collection: "products" } }>;
type ProjectsCollectionContent = Extract<SourcedCollectionContent, { source: { collection: "projects" } }>;
type LabsCollectionContent = Extract<SourcedCollectionContent, { source: { collection: "labs" } }>;
type BlogCollectionContent = Extract<SourcedCollectionContent, { source: { collection: "blog" } }>;
type ComicsCollectionContent = Extract<SourcedCollectionContent, { source: { collection: "comics" } }>;
type NovelsCollectionContent = Extract<SourcedCollectionContent, { source: { collection: "novels" } }>;
type PublicationsCollectionContent = Extract<SourcedCollectionContent, { source: { collection: "publications" } }>;

type ArchiveSection = Extract<PageSectionData, { type: "archive" }>;
type ArchiveContent = ArchiveSection["content"];
type ProjectsArchiveContent = Extract<ArchiveContent, { source: { collection: "projects" } }>;
type LabsArchiveContent = Extract<ArchiveContent, { source: { collection: "labs" } }>;
type ProductsArchiveContent = Extract<ArchiveContent, { source: { collection: "products" } }>;
type BlogArchiveContent = Extract<ArchiveContent, { source: { collection: "blog" } }>;
type ProjectsArchiveSection = Omit<ArchiveSection, "content"> & { content: ProjectsArchiveContent };
type LabsArchiveSection = Omit<ArchiveSection, "content"> & { content: LabsArchiveContent };
type ProductsArchiveSection = Omit<ArchiveSection, "content"> & { content: ProductsArchiveContent };
type BlogArchiveSection = Omit<ArchiveSection, "content"> & { content: BlogArchiveContent };
type RawCardConfig = NonNullable<CollectionSection["content"]["cards"]>;
type RawSectionSettings = CollectionSection["settings"];

type ResolvedCollectionItems = {
	items: CCardItemData[];
	source: CCardSource;
	presentation?: CCardPresentation;
};

type HeroRegionProps = Extract<PageRegion, { component: "hero" }>["props"];
type PageHeaderRegionProps = Extract<PageRegion, { component: "page-header" }>["props"];
type ArticleRegionProps = Extract<PageRegion, { component: "article" }>["props"];
type CtaRegionProps = Extract<PageRegion, { component: "cta" }>["props"];

const sectionFrame = (section: PageSectionData) => ({
	id: section.id,
	theme: section.settings.theme,
	spacing: section.settings.spacing,
	container: section.settings.container,
});

const sectionHeader = (section: CollectionSection): PSectionHeaderProps | undefined => {
	const heading = section.content.heading;
	if (!heading) return undefined;

	return {
		data: {
			number: heading.number,
			label: heading.label,
			title: heading.title,
			description: heading.description,
		},
		action: heading.action as PSectionHeaderProps["action"],
	};
};

const resolvePCardTemplate = (
	template?: RawCardConfig["layout"] | RawSectionSettings["layout"],
): PCardProps["template"] => {
	if (template === "carousel") return "slider";
	return (template ?? "grid") as PCardProps["template"];
};

const buildCardProps = (
	cards: RawCardConfig | undefined,
	items: CCardItemData[],
	defaults?: RawSectionSettings,
	source: CCardSource = "static",
	presentation?: CCardPresentation,
): PCardProps => ({
	template: resolvePCardTemplate(cards?.layout ?? defaults?.layout),
	columns: (cards?.columns ?? defaults?.columns) as PCardProps["columns"],
	gap: (cards?.gap ?? defaults?.gap) as PCardProps["gap"],
	separator: (cards?.separator ?? defaults?.separator) as PCardProps["separator"],
	card: {
		template: cards?.template as CCardConfig["template"],
		mediaRatio: (cards?.mediaRatio ?? defaults?.mediaRatio) as CCardConfig["mediaRatio"],
		headingLevel: cards?.headingLevel as CCardConfig["headingLevel"],
		slots: cards?.slots as CCardConfig["slots"],
		source,
		presentation,
	},
	items,
});

const cardConfig = (
	section: CollectionSection,
	resolved: ResolvedCollectionItems,
): PCardProps =>
	buildCardProps(
		section.content.cards,
		resolved.items,
		section.settings,
		resolved.source,
		resolved.presentation,
	);

const take = <T,>(items: T[], limit?: number) =>
	limit === undefined ? items : items.slice(0, limit);

const resolveCollectionItems = async (
	section: CollectionSection,
): Promise<ResolvedCollectionItems> => {
	const content = section.content;
	if ("items" in content) {
		return {
			items: content.items as unknown as CCardItemData[],
			source: "static",
		};
	}
	if (!("source" in content)) {
		return { items: [], source: "static" };
	}

	switch (content.source.collection) {
		case "products": {
			const typed = content as ProductsCollectionContent;
			return {
				items: take(await getProducts(), typed.source.limit),
				source: "products",
				presentation: typed.itemPresentation as CCardPresentation,
			};
		}
		case "projects": {
			const typed = content as ProjectsCollectionContent;
			return {
				items: take(await getProjects(), typed.source.limit),
				source: "projects",
				presentation: typed.itemPresentation as CCardPresentation,
			};
		}
		case "labs": {
			const typed = content as LabsCollectionContent;
			return {
				items: take(await getLabs(), typed.source.limit),
				source: "labs",
				presentation: typed.itemPresentation as CCardPresentation,
			};
		}
		case "blog": {
			const typed = content as BlogCollectionContent;
			return {
				items: take(await getInsights(), typed.source.limit),
				source: "blog",
				presentation: typed.itemPresentation as CCardPresentation,
			};
		}
		case "comics": {
			const typed = content as ComicsCollectionContent;
			return {
				items: take(await getPublications("comics"), typed.source.limit),
				source: "comics",
				presentation: typed.itemPresentation as CCardPresentation,
			};
		}
		case "novels": {
			const typed = content as NovelsCollectionContent;
			return {
				items: take(await getPublications("novels"), typed.source.limit),
				source: "novels",
				presentation: typed.itemPresentation as CCardPresentation,
			};
		}
		case "publications": {
			const typed = content as PublicationsCollectionContent;
			const [novels, comics] = await Promise.all([
				getPublications("novels"),
				getPublications("comics"),
			]);
			return {
				items: take([...novels, ...comics], typed.source.limit),
				source: "publications",
				presentation: typed.itemPresentation as CCardPresentation,
			};
		}
	}
};

const buildProjectsArchive = async (section: ProjectsArchiveSection): Promise<PageArchiveRegion> => {
	const { toolbar, cards, routes, itemPresentation, pagination, emptyLabel } = section.content;
	const projects = await getProjects();
	const visibleProjects = projects.filter((project) => {
		if (context.categorySlug) return project.categorySlug === context.categorySlug;
		if (context.tagSlug) return project.tags.some((tag) => tag.slug === context.tagSlug);
		return true;
	});
	const categories = Array.from(new Map(projects.map((project) => [project.categorySlug, {
		label: project.category,
		value: project.categorySlug,
		href: `${routes.categoryBase}${project.categorySlug}`,
	}])).values());

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section as PageSectionData),
		props: {
			mode: "taxonomy",
			toolbar: { data: {
				filter: { label: toolbar.filterLabel, activeValue: context.categorySlug ?? toolbar.allValue, tabs: [{ label: toolbar.allLabel, value: toolbar.allValue, href: routes.base }, ...categories] },
				sort: { label: toolbar.sortLabel, value: toolbar.sortValue, options: toolbar.sortOptions },
				view: { label: toolbar.viewLabel, gridLabel: toolbar.gridViewLabel, listLabel: toolbar.listViewLabel },
			} },
			cards: buildCardProps(
				cards,
				visibleProjects,
				undefined,
				"projects",
				itemPresentation as CCardPresentation,
			),
			emptyLabel,
			pagination: { ...pagination, totalPages: Math.max(1, Math.ceil(visibleProjects.length / pagination.pageSize)) },
		},
	};
};

const buildLabsArchive = async (section: LabsArchiveSection): Promise<PageArchiveRegion> => {
	const { toolbar, sidebar, routes, cards, itemPresentation, pagination, emptyLabel, resultLabel } = section.content;
	const labs = await getLabs();
	const visibleLabs = labs.filter((lab) => (!context.categorySlug || lab.category.slug === context.categorySlug) && (!context.technologySlug || lab.technologies.some((technology) => technology.slug === context.technologySlug)));
	const categories = Array.from(new Map(labs.map((lab) => [lab.category.slug, lab.category])).values());
	const technologies = Array.from(new Map(labs.flatMap((lab) => lab.technologies.map((technology) => [technology.slug, technology] as const))).values());
	const categoryFilter: PFilterChoiceGroupData = {
		appearance: sidebar.category.appearance as PFilterChoiceGroupData["appearance"],
		control: sidebar.category.control as PFilterChoiceGroupData["control"],
		legend: sidebar.category.legend,
		name: sidebar.category.name,
		type: sidebar.category.type,
		options: [{ label: sidebar.category.allLabel, value: sidebar.category.allValue, href: sidebar.category.allHref, count: labs.length, checked: !context.categorySlug }, ...categories.map((category) => ({ label: category.label, value: category.slug, href: `${routes.categoryBase}${category.slug}`, count: labs.filter((lab) => lab.category.slug === category.slug).length, checked: context.categorySlug === category.slug }))],
	};
	const technologyFilter: PFilterChoiceGroupData = {
		appearance: sidebar.technology.appearance as PFilterChoiceGroupData["appearance"],
		control: sidebar.technology.control as PFilterChoiceGroupData["control"],
		legend: sidebar.technology.legend,
		name: sidebar.technology.name,
		type: sidebar.technology.type,
		options: technologies.map((technology) => ({ label: technology.label, value: technology.slug, href: `${routes.technologyBase}${technology.slug}`, count: labs.filter((lab) => lab.technologies.some((item) => item.slug === technology.slug)).length, checked: context.technologySlug === technology.slug })),
	};

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section as PageSectionData),
		props: {
			mode: "faceted",
			toolbar: { data: { search: toolbar.search, selects: toolbar.selects, sort: toolbar.sort, view: toolbar.view } },
			sidebar: { label: sidebar.label, filter: { data: {
				filterLabel: sidebar.filterLabel,
				category: categoryFilter,
				groups: [technologyFilter],
			} } },
			result: { count: visibleLabs.length, label: resultLabel },
			cards: buildCardProps(
				cards,
				visibleLabs,
				undefined,
				"labs",
				itemPresentation as CCardPresentation,
			),
			emptyLabel,
			pagination: { ...pagination, totalPages: Math.max(1, Math.ceil(visibleLabs.length / pagination.pageSize)) },
		},
	};
};

const buildProductsArchive = async (section: ProductsArchiveSection): Promise<PageArchiveRegion> => {
	const { toolbar, sidebar, routes, cards, itemPresentation, pagination, emptyLabel, result } = section.content;
	const [products, categories] = await Promise.all([getProducts(), getProductCategories()]);
	const visibleProducts = context.categorySlug ? products.filter((product) => product.categorySlug === context.categorySlug) : products;
	const categoryFilters = [
		{
			label: toolbar.category.allLabel,
			value: toolbar.category.allValue,
			href: routes.base,
			count: products.length,
			checked: !context.categorySlug,
		},
		...categories.map((category) => ({
			...category,
			href: `${routes.categoryBase}${category.value}`,
			count: products.filter((product) => product.categorySlug === category.value).length,
			checked: context.categorySlug === category.value,
		})),
	];
	const platformFilters = toolbar.platform.options
		.filter((option) => option.value !== toolbar.platform.allValue)
		.map((option) => ({
			...option,
			count: products.filter((product) => product.platform === option.value).length,
			checked: false,
		}));
	const categoryFilter: PFilterChoiceGroupData = {
		...sidebar.category,
		appearance: sidebar.category.appearance as PFilterChoiceGroupData["appearance"],
		control: sidebar.category.control as PFilterChoiceGroupData["control"],
		options: categoryFilters,
	};
	const platformFilter: PFilterChoiceGroupData = {
		...sidebar.platform,
		appearance: sidebar.platform.appearance as PFilterChoiceGroupData["appearance"],
		control: sidebar.platform.control as PFilterChoiceGroupData["control"],
		options: platformFilters,
	};
	const licenseValue = itemPresentation.license;
	const licenseFilter: PFilterChoiceGroupData = {
		appearance: "controls",
		control: "license",
		legend: sidebar.license.legend,
		name: "product-license",
		type: "checkbox",
		options: [
			{
				label: sidebar.license.freeLabel,
				value: "free",
				count: licenseValue === "free" ? products.length : 0,
			},
			{
				label: sidebar.license.proLabel,
				value: "pro",
				count: licenseValue === "pro" ? products.length : 0,
			},
		],
	};
	const ratings = {
		legend: sidebar.ratings.legend,
		name: "product-rating",
		options: [5, 4, 3, 2, 1].map((value) => ({
			value,
			count: products.filter((product) => product.rating >= value).length,
		})),
	};
	const advertisement: PAdvertisementData = {
		title: sidebar.advertisement.title,
		description: sidebar.advertisement.description,
		image: sidebar.advertisement.image,
		action: {
			href: sidebar.advertisement.action.href,
			label: sidebar.advertisement.action.label,
			icon: sidebar.advertisement.action.icon as CIconName | undefined,
		},
	};

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section as PageSectionData),
		props: {
			mode: "faceted",
			toolbar: { data: {
				search: toolbar.search,
				selects: [
					{
						control: toolbar.category.control,
						id: toolbar.category.id,
						label: toolbar.category.label,
						value: context.categorySlug ?? toolbar.category.value,
						options: categoryFilters,
					},
					{
						control: toolbar.platform.control,
						id: toolbar.platform.id,
						label: toolbar.platform.label,
						value: toolbar.platform.value,
						options: toolbar.platform.options,
					},
				],
				sort: toolbar.sort,
				view: toolbar.view,
			} },
			sidebar: {
				label: sidebar.label,
				filter: {
					data: {
						filterLabel: sidebar.filterLabel,
						category: categoryFilter,
						platform: platformFilter,
						range: sidebar.price,
						license: licenseFilter,
						ratings,
					},
				},
				advertisement: { data: advertisement },
			},
			result: { count: visibleProducts.length, label: result.label },
			cards: buildCardProps(
				cards,
				visibleProducts,
				undefined,
				"products",
				itemPresentation as CCardPresentation,
			),
			emptyLabel,
			pagination: { ...pagination, totalPages: Math.max(1, Math.ceil(visibleProducts.length / pagination.pageSize)) },
		},
	};
};

const buildBlogArchive = async (section: BlogArchiveSection): Promise<PageArchiveRegion> => {
	const { toolbar, sidebar, itemPresentation, result, cards, pagination, emptyLabel } = section.content;
	const insights = await getInsights();
	const visibleInsights = insights.filter((insight) =>
		(!context.categorySlug || insight.categorySlug === context.categorySlug) &&
		(!context.tagSlug || insight.tags.some((tag) => tag.slug === context.tagSlug)),
	);
	const categories = Array.from(new Map(insights.map((insight) => [insight.categorySlug, {
		label: insight.category,
		slug: insight.categorySlug,
	}])).values());
	const presentation = itemPresentation as InsightCardPresentation;
	const categoryFilter: PFilterChoiceGroupData = {
		appearance: sidebar.filter.appearance as PFilterChoiceGroupData["appearance"],
		control: sidebar.filter.control as PFilterChoiceGroupData["control"],
		legend: sidebar.filter.legend,
		name: sidebar.filter.name,
		type: sidebar.filter.type,
		options: [
			{
				label: sidebar.filter.allLabel,
				value: toolbar.category.allValue,
				href: presentation.routes.base,
				count: insights.length,
				checked: !context.categorySlug,
			},
			...categories.map((category) => ({
				label: category.label,
				value: category.slug,
				href: `${presentation.routes.categoryBase}${category.slug}`,
				count: insights.filter((insight) => insight.categorySlug === category.slug).length,
				checked: context.categorySlug === category.slug,
			})),
		],
	};
	const newsletter: PAdvertisementData = {
		title: sidebar.newsletter.title,
		description: sidebar.newsletter.description,
		image: sidebar.newsletter.image,
		action: {
			href: sidebar.newsletter.action.href,
			label: sidebar.newsletter.action.label,
			icon: sidebar.newsletter.action.icon as CIconName | undefined,
		},
		form: sidebar.newsletter.form,
	};

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section as PageSectionData),
		props: {
			mode: "faceted",
			toolbar: { data: {
				search: toolbar.search,
				selects: [{
					control: toolbar.category.control,
					id: toolbar.category.id,
					label: toolbar.category.label,
					value: context.categorySlug ?? toolbar.category.allValue,
					options: [
						{ label: toolbar.category.allLabel, value: toolbar.category.allValue },
						...categories.map((category) => ({ label: category.label, value: category.slug })),
					],
				}],
				sort: toolbar.sort,
				view: toolbar.view,
			} },
			sidebar: {
				label: sidebar.label,
				filter: { data: { groups: [categoryFilter] } },
				cardsHeader: {
					data: { title: sidebar.featured.title },
					...(sidebar.featured.header && {
						appearance: sidebar.featured.header.appearance as PSectionHeaderProps["appearance"],
						headingLevel: sidebar.featured.header.headingLevel as PSectionHeaderProps["headingLevel"],
					}),
				},
				cards: buildCardProps(
					sidebar.featured.cards,
					insights.slice(0, sidebar.featured.limit),
					undefined,
					"blog",
					presentation,
				),
				advertisement: { template: sidebar.newsletter.template, data: newsletter },
			},
			result: {
				header: {
					data: { title: result.title },
					...(result.header && {
						appearance: result.header.appearance as PSectionHeaderProps["appearance"],
						headingLevel: result.header.headingLevel as PSectionHeaderProps["headingLevel"],
					}),
				},
			},
			cards: buildCardProps(
				cards,
				visibleInsights,
				undefined,
				"blog",
				presentation,
			),
			emptyLabel,
			pagination: { ...pagination, totalPages: Math.max(1, Math.ceil(visibleInsights.length / pagination.pageSize)) },
		},
	};
};

const regions: PageRegion[] = "regions" in props ? props.regions : await Promise.all(props.page.content.sections.map(async (section): Promise<PageRegion> => {
	const frame = sectionFrame(section);
	switch (section.type) {
		case "hero":
			return { key: section.id, component: "hero", section: frame, props: { template: section.template, data: section.content } as unknown as HeroRegionProps };
		case "page-header":
			return { key: section.id, component: "page-header", section: frame, props: { template: section.template, data: section.content } as unknown as PageHeaderRegionProps };
		case "article":
			return { key: section.id, component: "article", section: frame, props: { content: section.content } as unknown as ArticleRegionProps };
		case "cta":
			return { key: section.id, component: "cta", section: frame, props: { template: section.template, data: section.content } as unknown as CtaRegionProps };
		case "collection": {
			const resolved = await resolveCollectionItems(section);
			return { key: section.id, component: "collection", section: frame, props: { template: section.template as "stack" | "split" | undefined, header: sectionHeader(section), cardGroups: [cardConfig(section, resolved)] } };
		}
		case "archive": {
			const archiveContent = section.content;
			switch (archiveContent.source.collection) {
				case "projects":
					return buildProjectsArchive({ ...section, content: archiveContent as ProjectsArchiveContent });
				case "labs":
					return buildLabsArchive({ ...section, content: archiveContent as LabsArchiveContent });
				case "products":
					return buildProductsArchive({ ...section, content: archiveContent as ProductsArchiveContent });
				case "blog":
					return buildBlogArchive({ ...section, content: archiveContent as BlogArchiveContent });
			}
		}
	}
}));
const pageTemplate = "page" in props
	? props.page.content.layout.template
	: props.pageTemplate;
const isHome = "page" in props && props.page.slug === "/";
---

{isHome ? (
	<LPage data-page-template="home">
		{regions.map((region) => {
			const section = region.section === false ? undefined : region.section;
			return (
			<LSection
				id={section?.id}
				theme={section?.theme ?? "none"}
				spacing={section?.spacing ?? "none"}
				container={section?.container ?? "none"}
				data-page-region={region.key}
			>
			{region.component === "page-header" && <PPageHeader {...region.props} />}
			{region.component === "hero" && <PHero {...region.props} />}
			{region.component === "section-header" && <PSectionHeader {...region.props} />}
			{region.component === "article" && <PArticle {...region.props} />}
			{region.component === "reviews" && <PReviews {...region.props} />}
			{region.component === "cards" && (
				<CBox surface={region.props.panel ? "glass" : "plain"} radius={region.props.panel ? "md" : "none"} spacing={region.props.panel ? "sm" : "none"}>
					<CColumns columns="one" gap="md">
						{region.props.header && region.props.headerAction ? (
							<CRow justify="between" align="end">
								<PSectionHeader {...region.props.header} />
								<CButton {...region.props.headerAction} variant={region.props.headerAction.variant ?? "text"} />
							</CRow>
						) : (
							region.props.header && <PSectionHeader {...region.props.header} />
						)}
						<PCard {...region.props.cards} />
						{region.props.action && (
							<CRow justify="center">
								<CButton {...region.props.action} />
							</CRow>
						)}
					</CColumns>
				</CBox>
			)}
			{region.component === "cta" && <PCta {...region.props} />}
			{region.component === "post-navigation" && <PPostNavigation {...region.props} />}
			{region.component === "collection" && (
				<CColumns columns="one" gap="lg" data-tabbed-collection={region.props.behavior === "tabbed" ? "" : undefined}>
					{region.props.header && <PSectionHeader {...region.props.header} />}
					{region.props.tabs && <CTabList {...region.props.tabs} />}
					<CColumns columns={region.props.template === "split" ? "twelve" : "one"} gap="lg" data-collection-panel={region.props.behavior === "tabbed" ? "" : undefined}>
						{region.props.cardGroups.map((cards, index) => (
							<CGridItem lgSpan={region.props.template === "split" ? (index === 0 ? 7 : 5) : "full"}>
								<PCard {...cards} />
							</CGridItem>
						))}
					</CColumns>
					{region.props.statement && <PStatement {...region.props.statement} />}
					{region.props.action && (
						<CRow>
							<CButton {...region.props.action} />
						</CRow>
					)}
				</CColumns>
			)}
			{region.component === "archive" && (
				<CColumns columns="one" gap="md" data-filter-root={region.props.mode === "taxonomy" ? "" : undefined} data-filter-mode={region.props.mode} data-pagination-page-size={region.props.pagination.pageSize}>
					<PArchiveToolbar {...region.props.toolbar} />
					{region.props.mode === "faceted" && region.props.sidebar ? (
						<LSidebar label={region.props.sidebar.label} sticky>
							<CColumns slot="sidebar" columns="one" gap="md">
								<PFilterPanel {...region.props.sidebar.filter} />
								{region.props.sidebar.cards && (
									<CBox surface="glass" radius="md" spacing="sm">
										<CColumns columns="one" gap="sm">
											{region.props.sidebar.cardsHeader && <PSectionHeader {...region.props.sidebar.cardsHeader} />}
											<PCard {...region.props.sidebar.cards} />
										</CColumns>
									</CBox>
								)}
								{region.props.sidebar.advertisement && <PAdvertisement {...region.props.sidebar.advertisement} />}
							</CColumns>
							<CColumns columns="one" gap="md" data-archive-results>
								{region.props.result?.header && <PSectionHeader {...region.props.result.header} />}
								{region.props.result?.count !== undefined && region.props.result.label && (
									<CText variant="caption" tone="subtle">
										<CText as="span" variant="caption" tone="inherit" data-result-count>{region.props.result.count}</CText>{" "}
										{region.props.result.label}
									</CText>
								)}
								<PCard {...region.props.cards} />
								<CText data-product-empty data-facet-empty hidden tone="muted">{region.props.emptyLabel}</CText>
								<CPagination label={region.props.pagination.label} previousLabel={region.props.pagination.previousLabel} nextLabel={region.props.pagination.nextLabel} totalPages={region.props.pagination.totalPages} />
							</CColumns>
						</LSidebar>
					) : (
						<CColumns columns="one" gap="md">
							<PCard {...region.props.cards} />
							<CText data-filter-empty hidden tone="muted">{region.props.emptyLabel}</CText>
							<CPagination label={region.props.pagination.label} previousLabel={region.props.pagination.previousLabel} nextLabel={region.props.pagination.nextLabel} totalPages={region.props.pagination.totalPages} />
						</CColumns>
					)}
				</CColumns>
			)}
			{region.component === "status" && <PStatus {...region.props} />}
			{region.component === "tabs" && <CTabList {...region.props} />}
			{region.component === "gallery" && <PGallery {...region.props} />}
			{region.component === "entry-index" && <PEntryIndex {...region.props} />}
			{region.component === "reader" && <PReader {...region.props} />}
			{region.component === "details" && <PPageDetails {...region.props} />}
			{region.component === "profile" && <CProfile {...region.props} />}
			{region.component === "toc" && <CTOC {...region.props} />}
			{region.component === "advertisement" && <PAdvertisement {...region.props} />}
			</LSection>
			);
		})}
	</LPage>
) : (
	<PPage template={pageTemplate} {regions} />
)}
