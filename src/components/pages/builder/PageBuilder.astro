---
import LPage from "@/components/layout/LPage.astro";
import PageRegionView from "@/components/pages/builder/PageRegion.astro";
import {
	getInsights,
	getLabs,
	getProductCategories,
	getProducts,
	getProjects,
	getPublications,
} from "@/data/cms";
import {
	mapInsightToCard,
	mapLabToCard,
	mapProductToCard,
	mapProjectToCard,
	mapPublicationToCard,
} from "@/data/mappers/card";
import type {
	InsightCardPresentation,
	LabCardPresentation,
	ProductCardPresentation,
	ProjectCardPresentation,
	PublicationCardPresentation,
} from "@/data/mappers/card";
import type {
	ArchiveRegion,
	PageBuilderProps,
	PageRegion,
	PageSectionData,
} from "@/types/components/pages/builder/PageBuilder.types";
import type { PCardData, PCardProps } from "@/types/components/object/project/card/PCard.types";
import type { PSectionHeaderProps } from "@/types/components/object/project/section-header/PSectionHeader.types";

const props = Astro.props as PageBuilderProps;
const context = props.context ?? {};

type CollectionSection = Extract<PageSectionData, { type: "collection" }>;
type ProductsCollectionSection = Extract<CollectionSection, { content: { source: { collection: "products" } } }>;
type ProjectsCollectionSection = Extract<CollectionSection, { content: { source: { collection: "projects" } } }>;
type LabsCollectionSection = Extract<CollectionSection, { content: { source: { collection: "labs" } } }>;
type BlogCollectionSection = Extract<CollectionSection, { content: { source: { collection: "blog" } } }>;
type ComicsCollectionSection = Extract<CollectionSection, { content: { source: { collection: "comics" } } }>;
type NovelsCollectionSection = Extract<CollectionSection, { content: { source: { collection: "novels" } } }>;
type PublicationsCollectionSection = Extract<CollectionSection, { content: { source: { collection: "publications" } } }>;

type ArchiveSection = Extract<PageSectionData, { type: "archive" }>;
type ProjectsArchiveSection = Extract<ArchiveSection, { content: { source: { collection: "projects" } } }>;
type LabsArchiveSection = Extract<ArchiveSection, { content: { source: { collection: "labs" } } }>;
type ProductsArchiveSection = Extract<ArchiveSection, { content: { source: { collection: "products" } } }>;

type HeroRegionProps = Extract<PageRegion, { component: "hero" }>["props"];
type PageHeaderRegionProps = Extract<PageRegion, { component: "page-header" }>["props"];
type ArticleRegionProps = Extract<PageRegion, { component: "article" }>["props"];
type CtaRegionProps = Extract<PageRegion, { component: "cta" }>["props"];

const isCollectionSource = <T extends "products" | "projects" | "labs" | "blog" | "comics" | "novels" | "publications">(
	section: CollectionSection,
	collection: T,
): section is Extract<CollectionSection, { content: { source: { collection: T } } }> =>
	"source" in section.content && section.content.source.collection === collection;

const isArchiveSource = <T extends "projects" | "labs" | "products">(
	section: ArchiveSection,
	collection: T,
): section is Extract<ArchiveSection, { content: { source: { collection: T } } }> =>
	section.content.source.collection === collection;

const sectionFrame = (section: PageSectionData) => ({
	id: section.id,
	theme: section.settings.theme,
	spacing: section.settings.spacing,
	container: section.settings.container,
});

const sectionHeader = (section: CollectionSection): PSectionHeaderProps | undefined => {
	const heading = section.content.heading;
	if (!heading) return undefined;

	return {
		data: {
			number: heading.number,
			label: heading.label,
			title: heading.title,
			description: heading.description,
		},
		action: heading.action as PSectionHeaderProps["action"],
	};
};

const cardConfig = (section: CollectionSection, items: PCardData[]): PCardProps => {
	const cards = section.content.cards;
	return {
		template: (cards?.template ?? section.template) as PCardProps["template"],
		layout: (cards?.layout ?? section.settings.layout) as PCardProps["layout"],
		columns: (cards?.columns ?? section.settings.columns) as PCardProps["columns"],
		gap: (cards?.gap ?? section.settings.gap) as PCardProps["gap"],
		mediaRatio: (cards?.mediaRatio ?? section.settings.mediaRatio) as PCardProps["mediaRatio"],
		separator: (cards?.separator ?? section.settings.separator) as PCardProps["separator"],
		headingLevel: cards?.headingLevel as PCardProps["headingLevel"],
		slots: cards?.slots as PCardProps["slots"],
		items,
	};
};

const take = <T,>(items: T[], limit?: number): T[] =>
	limit === undefined ? items : items.slice(0, limit);

const resolveCollectionItems = async (section: CollectionSection): Promise<PCardData[]> => {
	if ("items" in section.content) {
		return section.content.items as unknown as PCardData[];
	}

	if (isCollectionSource(section, "products")) {
		const content: ProductsCollectionSection["content"] = section.content;
		return take(await getProducts(), content.source.limit).map((item) =>
			mapProductToCard(item, content.itemPresentation as ProductCardPresentation),
		);
	}

	if (isCollectionSource(section, "projects")) {
		const content: ProjectsCollectionSection["content"] = section.content;
		return take(await getProjects(), content.source.limit).map((item) =>
			mapProjectToCard(item, content.itemPresentation as ProjectCardPresentation),
		);
	}

	if (isCollectionSource(section, "labs")) {
		const content: LabsCollectionSection["content"] = section.content;
		return take(await getLabs(), content.source.limit).map((item) =>
			mapLabToCard(item, content.itemPresentation as LabCardPresentation),
		);
	}

	if (isCollectionSource(section, "blog")) {
		const content: BlogCollectionSection["content"] = section.content;
		return take(await getInsights(), content.source.limit).map((item) =>
			mapInsightToCard(item, content.itemPresentation as InsightCardPresentation),
		);
	}

	if (isCollectionSource(section, "comics")) {
		const content: ComicsCollectionSection["content"] = section.content;
		return take(await getPublications("comics"), content.source.limit).map((item) =>
			mapPublicationToCard(item, "comics", content.itemPresentation as PublicationCardPresentation),
		);
	}

	if (isCollectionSource(section, "novels")) {
		const content: NovelsCollectionSection["content"] = section.content;
		return take(await getPublications("novels"), content.source.limit).map((item) =>
			mapPublicationToCard(item, "novels", content.itemPresentation as PublicationCardPresentation),
		);
	}

	if (isCollectionSource(section, "publications")) {
		const content: PublicationsCollectionSection["content"] = section.content;
		const [novels, comics] = await Promise.all([
			getPublications("novels"),
			getPublications("comics"),
		]);
		return take([
			...novels.map((item) =>
				mapPublicationToCard(
					item,
					"novels",
					content.itemPresentation.novels as PublicationCardPresentation,
				),
			),
			...comics.map((item) =>
				mapPublicationToCard(
					item,
					"comics",
					content.itemPresentation.comics as PublicationCardPresentation,
				),
			),
		], content.source.limit);
	}

	return [];
};

const buildProjectsArchive = async (section: ProjectsArchiveSection): Promise<ArchiveRegion> => {
	const { toolbar, cards, routes, itemPresentation, pagination, emptyLabel } = section.content;
	const projects = await getProjects();
	const visibleProjects = projects.filter((project) => {
		if (context.categorySlug) return project.categorySlug === context.categorySlug;
		if (context.tagSlug) return project.tags.some((tag) => tag.slug === context.tagSlug);
		return true;
	});
	const categories = Array.from(new Map(projects.map((project) => [project.categorySlug, {
		label: project.category,
		value: project.categorySlug,
		href: `${routes.categoryBase}${project.categorySlug}`,
	}])).values());

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "taxonomy",
			toolbar: { data: {
				filter: { label: toolbar.filterLabel, activeValue: context.categorySlug ?? toolbar.allValue, tabs: [{ label: toolbar.allLabel, value: toolbar.allValue, href: routes.base }, ...categories] },
				sort: { label: toolbar.sortLabel, value: toolbar.sortValue, options: toolbar.sortOptions },
				view: { label: toolbar.viewLabel, gridLabel: toolbar.gridViewLabel, listLabel: toolbar.listViewLabel },
			} },
			cards: {
				template: cards.template as PCardProps["template"],
				layout: cards.layout as PCardProps["layout"],
				columns: cards.columns as PCardProps["columns"],
				gap: cards.gap as PCardProps["gap"],
				items: visibleProjects.map((project) =>
					mapProjectToCard(project, itemPresentation as ProjectCardPresentation),
				),
			},
			emptyLabel,
			pagination: { ...pagination, totalPages: Math.max(1, Math.ceil(visibleProjects.length / pagination.pageSize)) },
		},
	};
};

const buildLabsArchive = async (section: LabsArchiveSection): Promise<ArchiveRegion> => {
	const { toolbar, sidebar, routes, cards, itemPresentation, pagination, emptyLabel, resultLabel } = section.content;
	const labs = await getLabs();
	const visibleLabs = labs.filter((lab) => (!context.categorySlug || lab.category.slug === context.categorySlug) && (!context.technologySlug || lab.technologies.some((technology) => technology.slug === context.technologySlug)));
	const categories = Array.from(new Map(labs.map((lab) => [lab.category.slug, lab.category])).values());
	const technologies = Array.from(new Map(labs.flatMap((lab) => lab.technologies.map((technology) => [technology.slug, technology] as const))).values());

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: { data: { search: toolbar.search, selects: toolbar.selects, sort: toolbar.sort, view: toolbar.view } },
			sidebar: { label: sidebar.label, filter: { data: {
				filterLabel: sidebar.filterLabel,
				category: {
					appearance: sidebar.category.appearance as "navigation",
					control: sidebar.category.control,
					legend: sidebar.category.legend,
					name: sidebar.category.name,
					type: sidebar.category.type,
					options: [{ label: sidebar.category.allLabel, value: sidebar.category.allValue, href: sidebar.category.allHref, count: labs.length, checked: !context.categorySlug }, ...categories.map((category) => ({ label: category.label, value: category.slug, href: `${routes.categoryBase}${category.slug}`, count: labs.filter((lab) => lab.category.slug === category.slug).length, checked: context.categorySlug === category.slug }))],
				},
				groups: [{
					appearance: sidebar.technology.appearance as "navigation",
					control: sidebar.technology.control,
					legend: sidebar.technology.legend,
					name: sidebar.technology.name,
					type: sidebar.technology.type,
					options: technologies.map((technology) => ({ label: technology.label, value: technology.slug, href: `${routes.technologyBase}${technology.slug}`, count: labs.filter((lab) => lab.technologies.some((item) => item.slug === technology.slug)).length, checked: context.technologySlug === technology.slug })),
				}],
			} } },
			result: { count: visibleLabs.length, label: resultLabel },
			cards: {
				template: cards.template as PCardProps["template"],
				layout: cards.layout as PCardProps["layout"],
				columns: cards.columns as PCardProps["columns"],
				gap: cards.gap as PCardProps["gap"],
				items: visibleLabs.map((lab) => mapLabToCard(lab, itemPresentation as LabCardPresentation)),
			},
			emptyLabel,
			pagination: { ...pagination, totalPages: Math.max(1, Math.ceil(visibleLabs.length / pagination.pageSize)) },
		},
	};
};

const buildProductsArchive = async (section: ProductsArchiveSection): Promise<ArchiveRegion> => {
	const { toolbar, sidebar, routes, cards, itemPresentation, pagination, emptyLabel, result } = section.content;
	const [products, categories] = await Promise.all([getProducts(), getProductCategories()]);
	const visibleProducts = context.categorySlug ? products.filter((product) => product.categorySlug === context.categorySlug) : products;
	const categoryFilters = [{ label: toolbar.category.allLabel, value: toolbar.category.allValue, href: routes.base, checked: !context.categorySlug }, ...categories.map((category) => ({ ...category, href: `${routes.categoryBase}${category.value}`, checked: context.categorySlug === category.value }))];
	const platformFilters = toolbar.platform.options.map((option) => ({ ...option, checked: option.value === toolbar.platform.value }));

	return {
		key: section.id,
		component: "archive",
		section: sectionFrame(section),
		props: {
			mode: "faceted",
			toolbar: { data: {
				search: toolbar.search,
				selects: [
					{ control: toolbar.category.control, id: toolbar.category.id, label: toolbar.category.label, value: context.categorySlug ?? toolbar.category.value, options: categoryFilters },
					{ control: toolbar.platform.control, id: toolbar.platform.id, label: toolbar.platform.label, value: toolbar.platform.value, options: platformFilters },
				],
				sort: toolbar.sort,
				view: toolbar.view,
			} },
			sidebar: {
				label: sidebar.label,
				filter: { data: { filterLabel: sidebar.filterLabel, category: { ...sidebar.category, appearance: sidebar.category.appearance as "navigation", options: categoryFilters }, groups: [{ ...sidebar.platform, appearance: sidebar.platform.appearance as "navigation", options: platformFilters }] } },
				advertisement: { data: sidebar.advertisement },
			},
			result: { count: visibleProducts.length, label: result.label },
			cards: {
				template: cards.template as PCardProps["template"],
				layout: cards.layout as PCardProps["layout"],
				columns: cards.columns as PCardProps["columns"],
				gap: cards.gap as PCardProps["gap"],
				items: visibleProducts.map((product) =>
					mapProductToCard(product, itemPresentation as ProductCardPresentation),
				),
			},
			emptyLabel,
			pagination: { ...pagination, totalPages: Math.max(1, Math.ceil(visibleProducts.length / pagination.pageSize)) },
		},
	};
};

const regions: PageRegion[] = await Promise.all(props.page.content.sections.map(async (section): Promise<PageRegion> => {
	const frame = sectionFrame(section);
	switch (section.type) {
		case "hero":
			return { key: section.id, component: "hero", section: frame, props: { template: section.template, data: section.content } as HeroRegionProps };
		case "page-header":
			return { key: section.id, component: "page-header", section: frame, props: { template: section.template, data: section.content } as PageHeaderRegionProps };
		case "article":
			return { key: section.id, component: "article", section: frame, props: { blocks: section.content.blocks } as ArticleRegionProps };
		case "cta":
			return { key: section.id, component: "cta", section: frame, props: { template: section.template, data: section.content } as CtaRegionProps };
		case "collection": {
			const items = await resolveCollectionItems(section);
			return { key: section.id, component: "collection", section: frame, props: { template: section.template as "stack" | "split" | undefined, header: sectionHeader(section), cardGroups: [cardConfig(section, items)] } };
		}
		case "archive":
			if (isArchiveSource(section, "projects")) return buildProjectsArchive(section);
			if (isArchiveSource(section, "labs")) return buildLabsArchive(section);
			if (isArchiveSource(section, "products")) return buildProductsArchive(section);
	}
}));
---

<LPage {...props.page.content.layout}>
	{regions.map((region) => <PageRegionView region={region} />)}
</LPage>