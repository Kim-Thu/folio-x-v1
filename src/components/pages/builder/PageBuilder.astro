---
import LPage from "@/components/layout/LPage.astro";
import PPage from "@/components/object/project/page/PPage.astro";
import PageRegion from "@/components/pages/builder/PageRegion.astro";
import { getPageBuilderData } from "@/data/pages/getPageBuilderData";
import type { PageBuilderProps } from "@/types/components/pages/builder/PageBuilder.types";
import type { PageRegion as PageRegionData } from "@/types/components/pages/builder/PageRegion.types";
import type { PPageTemplate } from "@/types/components/object/project/page/PPage.types";

const props = Astro.props as PageBuilderProps;

const resolved = "page" in props
	? await getPageBuilderData(props.page, props.context)
	: { ...props, isHome: false };

const { isHome, pageTemplate, regions } = resolved;
const enabledRegions = regions.filter((region) => region.enabled !== false);

const isLead = (region: PageRegionData) =>
	region.component === "page-header" || region.component === "hero";

const isNavigation = (region: PageRegionData, template: PPageTemplate) =>
	(template === "lead-content-navigation" && region.component === "post-navigation") ||
	(template === "lead-navigation-content" && region.component === "tabs");

const isClosing = (region: PageRegionData, template: PPageTemplate) =>
	template === "lead-content-closing" && region.component === "cta";

const leadRegions = pageTemplate === "stacked"
	? []
	: enabledRegions.filter(isLead);
const navigationRegions = enabledRegions.filter((region) =>
	isNavigation(region, pageTemplate),
);
const closingRegions = enabledRegions.filter((region) =>
	isClosing(region, pageTemplate),
);
const contentRegions = pageTemplate === "stacked"
	? enabledRegions
	: enabledRegions.filter(
		(region) =>
			!isLead(region) &&
			!isNavigation(region, pageTemplate) &&
			!isClosing(region, pageTemplate),
	);
---

{isHome ? (
	<LPage data-page-template="home">
		{enabledRegions.map((region) => <PageRegion {region} />)}
	</LPage>
) : (
	<PPage template={pageTemplate}>
		{leadRegions.length > 0 && (
			<Fragment slot="lead">
				{leadRegions.map((region) => <PageRegion {region} />)}
			</Fragment>
		)}
		{navigationRegions.length > 0 && (
			<Fragment slot="navigation">
				{navigationRegions.map((region) => <PageRegion {region} />)}
			</Fragment>
		)}
		{contentRegions.map((region) => <PageRegion {region} />)}
		{closingRegions.length > 0 && (
			<Fragment slot="closing">
				{closingRegions.map((region) => <PageRegion {region} />)}
			</Fragment>
		)}
	</PPage>
)}
