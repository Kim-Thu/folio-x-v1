---
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import PArchiveToolbar from "@/components/object/project/archive-toolbar/PArchiveToolbar.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PFilterPanel from "@/components/object/project/filter-panel/PFilterPanel.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import { getPublicationCatalogSettings } from "@/data/cms";
import type { PublicationEntry } from "@/types/content";
import type { PageSectionData } from "@/types/components/pages/builder/PageBuilder.types";
import type { PCardData, PCardProps } from "@/types/components/object/project/card/PCard.types";
import type { CIconName } from "@/types/components/object/component/CIcon.types";

type PublicationCatalogSection = Extract<
	PageSectionData,
	{
		type: "collection";
		content: { source: { collection: "comics" | "novels" } };
	}
>;

type Props = {
	catalog: "novels" | "comics";
	entries: PublicationEntry[];
	presentation: PublicationCatalogSection["content"]["itemPresentation"];
};

const { catalog, entries, presentation } = Astro.props as Props;
const settings = await getPublicationCatalogSettings();
const cards: PCardData[] = entries.map((entry) => ({
	href: `${presentation.routes.base}${entry.slug}`,
	ariaLabel: `${presentation.ariaLabelPrefix}${entry.title}`,
	title: [entry.title],
	excerpt: entry.summary,
	media: entry.cover,
	metadata: {
		items: entry.genres.map((genre) => ({
			type: "category",
			label: genre.label,
			href: `${presentation.routes.categoryBase}${genre.slug}`,
			display: presentation.categoryDisplay,
		})),
	},
	tags: entry.genres.map((genre) => ({
		label: genre.label,
		href: `${presentation.routes.categoryBase}${genre.slug}`,
	})),
	tagsLabel: `${entry.title}${presentation.tagsLabelSuffix}`,
	metrics: [{ icon: presentation.viewsIcon, label: entry.views }],
	rating: { value: entry.rating },
	facets: {
		genre: entry.genres.map((genre) => genre.slug),
		status: [entry.status],
	},
	searchValue: [
		entry.title,
		entry.summary,
		entry.author,
		...entry.genres.map((genre) => genre.label),
	].join(" "),
	sortValue: String(entry.order).padStart(4, "0"),
}));
const featuredCards = cards.slice(0, settings.main.featuredLimit);
const latestCards = cards.slice(0, settings.main.latestLimit);
const trendingCards = cards.slice(0, settings.sidebar.trendingLimit);

const genreMap = new Map<string, { label: string; slug: string; count: number }>();
for (const entry of entries) {
	for (const genre of entry.genres) {
		const existing = genreMap.get(genre.slug);
		genreMap.set(genre.slug, {
			label: genre.label,
			slug: genre.slug,
			count: (existing?.count ?? 0) + 1,
		});
	}
}
const genres = [...genreMap.values()].sort((a, b) => b.count - a.count);
const genreIcons = settings.main.genreIcons as CIconName[];
const formatCount = (template: string, count: number) => template.replace("{count}", String(count));
const popularGenreCards: PCardData[] = genres.slice(0, settings.main.popularGenresLimit).map((genre, index) => ({
	href: `${presentation.routes.categoryBase}${genre.slug}`,
	ariaLabel: genre.label,
	title: [genre.label],
	excerpt: formatCount(settings.main.genreWorksTemplate, genre.count),
	icon: genreIcons[index % genreIcons.length],
}));

const toolbar = {
	data: {
		search: {
			id: `${catalog}-search`,
			label: settings.toolbar.searchLabel,
			name: "search",
			placeholder: settings.toolbar.searchPlaceholder,
		},
		selects: [
			{
				control: "genre",
				id: `${catalog}-genre`,
				label: settings.toolbar.genreLabel,
				value: "all",
				options: [
					{ label: settings.toolbar.allGenresLabel, value: "all" },
					...genres.map((genre) => ({ label: genre.label, value: genre.slug })),
				],
			},
			{
				control: "status",
				id: `${catalog}-status`,
				label: settings.toolbar.statusLabel,
				value: "all",
				options: [
					{ label: settings.toolbar.allStatusesLabel, value: "all" },
					{ label: settings.toolbar.ongoingLabel, value: "ongoing" },
					{ label: settings.toolbar.completeLabel, value: "complete" },
				],
			},
		],
		sort: {
			label: settings.toolbar.sortLabel,
			value: settings.toolbar.sortValue,
			options: settings.toolbar.sortOptions,
		},
		view: {
			label: settings.toolbar.viewLabel,
			gridLabel: settings.toolbar.gridViewLabel,
			listLabel: settings.toolbar.listViewLabel,
		},
	},
};

const cardProps = (config: typeof settings.main.featuredCards, items: PCardData[]): PCardProps => ({
	template: config.template as PCardProps["template"],
	layout: config.layout as PCardProps["layout"],
	columns: config.columns as PCardProps["columns"],
	gap: config.gap as PCardProps["gap"],
	mediaRatio: config.mediaRatio as PCardProps["mediaRatio"],
	slots: config.slots,
	items,
});
---

<CBox data-collection-filter-root>
	<CColumns columns="one" gap="md">
		<PArchiveToolbar {...toolbar} />

		<LSidebar
			label={settings.sidebar.labelTemplate.replace("{catalog}", catalog)}
			position={settings.sidebar.position}
			sticky={settings.sidebar.sticky}
		>
			<CColumns slot="sidebar" columns="one" gap="md">
				<CBox surface={settings.sidebar.panel.surface} radius={settings.sidebar.panel.radius} spacing={settings.sidebar.panel.spacing}>
					<PFilterPanel
						data={{
							groups: [
								{
									appearance: "controls",
									control: "genre",
									legend: settings.sidebar.genresLegend,
									name: `${catalog}-genres`,
									type: "radio",
									options: [
										{ label: settings.sidebar.allGenresShortLabel, value: "all", count: entries.length, checked: true },
										...genres.map((genre) => ({
											label: genre.label,
											value: genre.slug,
											count: genre.count,
										})),
									],
								},
							],
						}}
					/>
				</CBox>

				<CBox surface={settings.sidebar.panel.surface} radius={settings.sidebar.panel.radius} spacing={settings.sidebar.panel.spacing}>
					<CColumns columns="one" gap="sm">
						<PSectionHeader data={{ title: settings.sidebar.trendingTitle }} appearance="compact" headingLevel={2} />
						<PCard {...cardProps(settings.sidebar.listCards, trendingCards)} />
					</CColumns>
				</CBox>
			</CColumns>

			<CColumns columns="one" gap="lg">
				<CColumns columns="one" gap="sm">
					<PSectionHeader data={{ title: settings.main.featuredTitle }} appearance="compact" headingLevel={2} />
					<PCard {...cardProps(settings.main.featuredCards, featuredCards)} />
				</CColumns>

				<CColumns columns="one" gap="sm">
					<PSectionHeader data={{ title: settings.main.latestTitle }} appearance="compact" headingLevel={2} />
					<PCard {...cardProps(settings.main.latestCards, latestCards)} />
				</CColumns>

				<CBox surface={settings.sidebar.panel.surface} radius={settings.sidebar.panel.radius} spacing={settings.sidebar.panel.spacing}>
					<CColumns columns="one" gap="sm">
						<PSectionHeader data={{ title: settings.main.popularGenresTitle }} appearance="compact" headingLevel={2} />
						<PCard {...cardProps(settings.main.genreCards, popularGenreCards)} />
					</CColumns>
				</CBox>
			</CColumns>
		</LSidebar>
	</CColumns>
</CBox>
