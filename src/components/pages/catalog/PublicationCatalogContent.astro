---
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import PArchiveToolbar from "@/components/object/project/archive-toolbar/PArchiveToolbar.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PCta from "@/components/object/project/cta/PCta.astro";
import PFilterPanel from "@/components/object/project/filter-panel/PFilterPanel.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import { getPublicationCatalogSettings } from "@/data/cms";
import type { PublicationEntry } from "@/types/content";
import type {
	CCardConfig,
	CCardData,
	CCardItemData,
	CCardSlotOptions,
	PublicationCardPresentation,
} from "@/types/components/object/component/card/CCard.types";
import type { PCardProps } from "@/types/components/object/project/card/PCard.types";
import type { PCtaProps } from "@/types/components/object/project/cta/PCta.types";
import type { CIconName } from "@/types/components/object/component/CIcon.types";
import type { PageSectionData } from "@/types/components/pages/builder/PageBuilder.types";

type CtaSection = Extract<PageSectionData, { type: "cta" }>;

type Props = {
	catalog: "novels" | "comics";
	entries: PublicationEntry[];
	presentation: PublicationCardPresentation;
	closing?: CtaSection;
};

const { catalog, entries, presentation, closing } = Astro.props as Props;
const settings = await getPublicationCatalogSettings();
const featuredCards = entries.slice(0, settings.main.featuredLimit);
const latestCards = entries.slice(0, settings.main.latestLimit);
const trendingCards = entries.slice(0, settings.sidebar.trendingLimit);

const genreMap = new Map<string, { label: string; slug: string; count: number }>();
for (const entry of entries) {
	for (const genre of entry.genres) {
		const existing = genreMap.get(genre.slug);
		genreMap.set(genre.slug, {
			label: genre.label,
			slug: genre.slug,
			count: (existing?.count ?? 0) + 1,
		});
	}
}
const genres = [...genreMap.values()].sort((a, b) => b.count - a.count);
const popularGenres = genres.slice(0, settings.main.popularGenresLimit);
const genreIcons = settings.main.genreIcons as CIconName[];
const formatCount = (template: string, count: number) =>
	template.replace("{count}", String(count));
const popularGenreCards: CCardData[] = popularGenres.map((genre, index) => ({
	href: `${presentation.routes.categoryBase}${genre.slug}`,
	ariaLabel: genre.label,
	title: [genre.label],
	excerpt: formatCount(settings.main.genreWorksTemplate, genre.count),
	icon: genreIcons[index % genreIcons.length],
}));
const genreStoryGroups = popularGenres.map((genre) => ({
	genre,
	items: entries.filter((entry) =>
		entry.genres.some((entryGenre) => entryGenre.slug === genre.slug),
	),
}));

const authorCounts = new Map<string, number>();
for (const entry of entries) {
	authorCounts.set(entry.author, (authorCounts.get(entry.author) ?? 0) + 1);
}
const authorCards: CCardData[] = [...authorCounts.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, settings.sidebar.authorLimit)
	.map(([name, works]) => ({
		href: "#catalog",
		ariaLabel: name,
		title: [name],
		excerpt: formatCount(settings.main.authorWorksTemplate, works),
		media: {
			src: settings.sidebar.authorPlaceholder.src,
			alt: name,
			width: settings.sidebar.authorPlaceholder.width,
			height: settings.sidebar.authorPlaceholder.height,
		},
	}));

const toolbar = {
	data: {
		search: {
			id: `${catalog}-search`,
			label: settings.toolbar.searchLabel,
			name: "search",
			placeholder: settings.toolbar.searchPlaceholder,
		},
		selects: [
			{
				control: "genre",
				id: `${catalog}-genre`,
				label: settings.toolbar.genreLabel,
				value: "all",
				options: [
					{ label: settings.toolbar.allGenresLabel, value: "all" },
					...genres.map((genre) => ({ label: genre.label, value: genre.slug })),
				],
			},
			{
				control: "status",
				id: `${catalog}-status`,
				label: settings.toolbar.statusLabel,
				value: "all",
				options: [
					{ label: settings.toolbar.allStatusesLabel, value: "all" },
					{ label: settings.toolbar.ongoingLabel, value: "ongoing" },
					{ label: settings.toolbar.completeLabel, value: "complete" },
				],
			},
		],
		sort: {
			label: settings.toolbar.sortLabel,
			value: settings.toolbar.sortValue,
			options: settings.toolbar.sortOptions,
		},
		view: {
			label: settings.toolbar.viewLabel,
			gridLabel: settings.toolbar.gridViewLabel,
			listLabel: settings.toolbar.listViewLabel,
		},
	},
};

type CatalogCardConfig = typeof settings.main.featuredCards;
type CardSourceConfig = Pick<CCardConfig, "source" | "presentation">;

const resolveTemplate = (layout: string): PCardProps["template"] =>
	(layout === "carousel" ? "slider" : layout) as PCardProps["template"];

const cardProps = (
	config: CatalogCardConfig,
	items: CCardItemData[],
	slots?: CCardSlotOptions,
	sourceConfig?: CardSourceConfig,
): PCardProps => ({
	template: resolveTemplate(config.layout),
	columns: config.columns as PCardProps["columns"],
	gap: config.gap as PCardProps["gap"],
	card: {
		template: config.template as CCardConfig["template"],
		mediaRatio: config.mediaRatio as CCardConfig["mediaRatio"],
		slots: { ...config.slots, ...slots },
		...sourceConfig,
	},
	items,
});

const publicationSource: CardSourceConfig = {
	source: catalog,
	presentation,
};

const genreStoryCardConfig: CatalogCardConfig = {
	template: "media-banner",
	layout: "grid",
	columns: 4,
	gap: "sm",
	mediaRatio: "portrait",
	slots: {
		media: true,
		metadata: true,
		title: true,
		excerpt: true,
		tags: false,
		metrics: false,
		action: true,
	},
};
---

<CBox data-collection-filter-root>
	<CColumns columns="one" gap="md">
		<PArchiveToolbar {...toolbar} />

		<LSidebar
			label={settings.sidebar.labelTemplate.replace("{catalog}", catalog)}
			position={settings.sidebar.position}
			sticky={settings.sidebar.sticky}
		>
			<CColumns slot="sidebar" columns="one" gap="md">
				<CBox
					surface={settings.sidebar.panel.surface}
					radius={settings.sidebar.panel.radius}
					spacing={settings.sidebar.panel.spacing}
				>
					<PFilterPanel
						data={{
							groups: [
								{
									appearance: "navigation",
									control: "genre",
									legend: settings.sidebar.genresLegend,
									name: `${catalog}-genres`,
									type: "radio",
									options: [
										{
											label: settings.sidebar.allGenresShortLabel,
											value: "all",
											count: entries.length,
											checked: true,
										},
										...genres.map((genre) => ({
											label: genre.label,
											value: genre.slug,
											count: genre.count,
										})),
									],
								},
							],
						}}
					/>
				</CBox>

				<CBox
					surface={settings.sidebar.panel.surface}
					radius={settings.sidebar.panel.radius}
					spacing={settings.sidebar.panel.spacing}
				>
					<CColumns columns="one" gap="sm">
						<PSectionHeader
							data={{ title: settings.sidebar.trendingTitle }}
							appearance="compact"
							headingLevel={2}
						/>
						<PCard
							{...cardProps(
								settings.sidebar.listCards,
								trendingCards,
								undefined,
								publicationSource,
							)}
						/>
					</CColumns>
				</CBox>

				<CBox
					surface={settings.sidebar.panel.surface}
					radius={settings.sidebar.panel.radius}
					spacing={settings.sidebar.panel.spacing}
				>
					<CColumns columns="one" gap="sm">
						<PSectionHeader
							data={{ title: settings.sidebar.popularAuthorsTitle }}
							appearance="compact"
							headingLevel={2}
						/>
						<PCard
							{...cardProps(settings.sidebar.listCards, authorCards, {
								metadata: false,
								tags: false,
								metrics: false,
								action: false,
							})}
						/>
					</CColumns>
				</CBox>
			</CColumns>

			<CColumns columns="one" gap="lg">
				<CColumns columns="one" gap="sm">
					<PSectionHeader
						data={{ title: settings.main.featuredTitle }}
						appearance="compact"
						headingLevel={2}
					/>
					<PCard
						{...cardProps(
							settings.main.featuredCards,
							featuredCards,
							undefined,
							publicationSource,
						)}
					/>
				</CColumns>

				<CColumns columns="one" gap="sm">
					<PSectionHeader
						data={{ title: settings.main.latestTitle }}
						appearance="compact"
						headingLevel={2}
					/>
					<PCard
						{...cardProps(
							settings.main.latestCards,
							latestCards,
							undefined,
							publicationSource,
						)}
					/>
				</CColumns>

				<CBox
					surface={settings.sidebar.panel.surface}
					radius={settings.sidebar.panel.radius}
					spacing={settings.sidebar.panel.spacing}
				>
					<CColumns columns="one" gap="sm">
						<PSectionHeader
							data={{ title: settings.main.popularGenresTitle }}
							appearance="compact"
							headingLevel={2}
						/>
						<PCard
							{...cardProps(settings.main.genreCards, popularGenreCards)}
						/>
					</CColumns>
				</CBox>

				{genreStoryGroups.map(({ genre, items }) => (
					<CColumns columns="one" gap="sm">
						<PSectionHeader
							data={{ title: genre.label }}
							appearance="compact"
							headingLevel={2}
						/>
						<PCard
							{...cardProps(
								genreStoryCardConfig,
								items,
								undefined,
								publicationSource,
							)}
						/>
					</CColumns>
				))}

				{closing && (
					<PCta
						{...({
							template: closing.template,
							data: closing.content,
						} as unknown as PCtaProps)}
					/>
				)}
			</CColumns>
		</LSidebar>
	</CColumns>
</CBox>
