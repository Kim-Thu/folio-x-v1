---
import LContainer from "@/components/layout/LContainer.astro";
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PublicationCatalogContent from "@/components/pages/catalog/PublicationCatalogContent.astro";
import { getPublications } from "@/data/cms";
import type {
	PublicationCardPresentation,
} from "@/types/components/object/component/card/CCard.types";
import type { CatalogPageProps } from "@/types/components/pages/catalog/CatalogPage.types";
import type { PageSectionData } from "@/types/components/pages/builder/PageBuilder.types";
import type { PPageHeaderProps } from "@/types/components/object/project/page-header/PPageHeader.types";

const { data } = Astro.props as CatalogPageProps;
const catalog = data.page.slug === "/comics" ? "comics" : "novels";
const entries = await getPublications(catalog);

type CollectionSection = Extract<PageSectionData, { type: "collection" }>;
type PublicationCatalogSection = CollectionSection & {
	content: CollectionSection["content"] & {
		source: { collection: "comics" | "novels"; limit?: number };
		itemPresentation: PublicationCardPresentation;
	};
};

type CtaSection = Extract<PageSectionData, { type: "cta" }>;

const isPublicationCatalogSection = (
	section: PageSectionData,
): section is PublicationCatalogSection =>
	section.type === "collection" &&
	section.id === "catalog" &&
	"source" in section.content &&
	(section.content.source.collection === "comics" ||
		section.content.source.collection === "novels");

const hero = data.page.content.sections.find((section) => section.type === "page-header");
const catalogSection = data.page.content.sections.find(
	(section): section is PublicationCatalogSection =>
		isPublicationCatalogSection(section) &&
		section.content.source.collection === catalog,
);
const newsletter = data.page.content.sections.find(
	(section): section is CtaSection => section.type === "cta",
);
---

<LPage {...data.page.content.layout} id="main-content" tabindex="-1">
	{hero && (
		<LSection
			id={hero.id}
			theme={hero.settings.theme}
			spacing="none"
			class="pb-8 md:pb-12"
		>
			<PPageHeader
				{...({ template: hero.template, data: hero.content } as unknown as PPageHeaderProps)}
			/>
		</LSection>
	)}

	{catalogSection && (
		<LSection
			id={catalogSection.id}
			theme={catalogSection.settings.theme}
			spacing={catalogSection.settings.spacing}
		>
			<LContainer
				size={catalogSection.settings.container === "none"
					? "site"
					: catalogSection.settings.container}
			>
				<PublicationCatalogContent
					{catalog}
					{entries}
					presentation={catalogSection.content.itemPresentation}
					closing={newsletter}
				/>
			</LContainer>
		</LSection>
	)}
</LPage>
