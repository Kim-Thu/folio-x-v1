---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import CTabList from "@/components/object/component/CTabList.astro";
import LSidebar from "@/components/layout/LSidebar.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import PEntryIndex from "@/components/object/project/entry-index/PEntryIndex.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CTags from "@/components/object/component/CTags.astro";
import type { PublicationDetailPageProps } from "@/types/components/pages/publication-detail/PublicationDetailPage.types";

const { data } = Astro.props as PublicationDetailPageProps;
const { entry, collection } = data;
const detail = entry.detail;
if (!detail) throw new Error(`Missing CMS publication detail: ${collection}/${entry.slug}`);
const page = detail.page;

const chapterSection = page.sections.find((section) => section.type === "entry-index");
const configuredChapters = [...(detail.reader ?? [])].sort((a, b) => b.number - a.number);
const chapterItems = chapterSection
	? configuredChapters.map((chapter) => ({
		order: chapter.number,
		number: `${chapterSection.content.numberPrefix}${chapter.number}`,
		title: chapter.title,
		publishedAt: chapter.publishedAt,
		publishedLabel: chapter.publishedLabel,
		views: chapter.views,
		href: `/${collection}/${entry.slug}/chapter/${chapter.number}`,
		action: chapterSection.content.itemAction,
	}))
	: [];
---

<LPage template={page.template}>
	{page.sections.map((section) => {
		if (section.type === "page-header") {
			const { content } = section;
			return (
				<LSection id={section.id} {...section.settings}>
					<PPageHeader
						template={section.template}
						data={{
							breadcrumb: {
								label: content.breadcrumbLabel,
								items: [{ label: content.collectionLabel, href: `/${collection}` }],
								current: entry.title,
							},
							cover: entry.cover,
							tagsLabel: content.tagsLabel,
							tags: entry.genres.map((genre) => ({ label: genre.label, href: `/${collection}/category/${genre.slug}` })),
							title: entry.title,
							author: { label: content.authorLabel, name: entry.author },
							metrics: [
								{ label: content.metrics.ratingLabel, value: String(entry.rating), icon: "star" },
								{ label: content.metrics.readsLabel, value: entry.views, icon: "eye" },
								{ label: content.metrics.chaptersLabel, value: String(entry.chapters), icon: "bookOpen" },
								{ label: content.metrics.followersLabel, value: detail.followers, icon: "bookmark" },
							],
							actionsLabel: content.actionsLabel,
							actions: [{ label: content.primaryActionLabel, href: "#chapters", icon: "bookOpen", variant: "primary", size: "md" }],
							description: detail.description,
							facts: {
								title: content.factsTitle,
								items: [
									{ label: content.facts.authorLabel, value: entry.author },
									{ label: content.facts.genresLabel, value: entry.genres.map((genre) => genre.label).join(", ") },
									{ label: content.facts.languageLabel, value: detail.language },
									{ label: content.facts.statusLabel, value: entry.status === "ongoing" ? content.facts.ongoingLabel : content.facts.completeLabel },
									{ label: content.facts.updatedLabel, value: entry.updatedLabel },
									{ label: content.facts.viewsLabel, value: entry.views },
								],
							},
						}}
					/>
				</LSection>
			);
		}

		if (section.type === "tabs") {
			return (
				<LSection id={section.id} {...section.settings}>
					<CTabList {...section.content} />
				</LSection>
			);
		}

		if (section.type === "entry-index") {
			const { content } = section;
			return (
				<LSection id={section.id} {...section.settings}>
					<LSidebar label={content.asideLabel}>
						<CColumns slot="sidebar" columns="one" gap="md">
							<CDescriptionList items={[{ label: content.introductionLabel, value: detail.description[0] }]} />
							{detail.tags.length ? (
								<CTags label={content.tagsLabel} items={detail.tags.map((tag) => ({ label: tag.label, href: `/${collection}/tag/${tag.slug}` }))} />
							) : null}
						</CColumns>
						<PEntryIndex
							id={section.id}
							label={content.chapterIndexLabel}
							title={content.title}
							sort={content.sort}
							listViewLabel={content.listViewLabel}
							items={chapterItems}
							visibleCount={chapterItems.length}
						/>
					</LSidebar>
				</LSection>
			);
		}

		return null;
	})}
</LPage>
