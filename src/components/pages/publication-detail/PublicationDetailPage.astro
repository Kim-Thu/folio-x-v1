---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import CTabList from "@/components/object/component/CTabList.astro";
import LSidebar from "@/components/layout/LSidebar.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import PEntryIndex from "@/components/object/project/entry-index/PEntryIndex.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CTags from "@/components/object/component/CTags.astro";
import type { PublicationDetailPageProps } from "@/types/components/pages/publication-detail/PublicationDetailPage.types";
import type { LSectionSpacing, LSectionTheme } from "@/types/components/layout/LSection.types";

const { data } = Astro.props as PublicationDetailPageProps;
const { entry, collection } = data;
const detail = entry.detail;
const page = detail?.page;
if (!page) throw new Error(`Missing CMS publication detail page: ${collection}/${entry.slug}`);

type RecordValue = Record<string, unknown>;
const asRecord = (value: unknown): RecordValue => value && typeof value === "object" && !Array.isArray(value) ? value as RecordValue : {};
const asString = (value: unknown, fallback = "") => typeof value === "string" ? value : fallback;
const asArray = (value: unknown) => Array.isArray(value) ? value : [];
const frame = (section: (typeof page.sections)[number]) => {
	const settings = asRecord(section.settings);
	return {
		id: section.id,
		theme: asString(settings.theme, "canvas") as LSectionTheme,
		spacing: asString(settings.spacing, "compact") as LSectionSpacing,
		container: asString(settings.container, "site") as "site" | "content" | "none",
	};
};

const chapterSection = page.sections.find((section) => section.type === "entry-index");
const chapterConfig = asRecord(chapterSection?.content);
const configuredChapters = [...(detail?.reader ?? [])].sort((a, b) => b.number - a.number);
const chapterItems = configuredChapters.map((chapter) => ({
	order: chapter.number,
	number: `${asString(chapterConfig.numberPrefix)}${chapter.number}`,
	title: chapter.title,
	publishedAt: chapter.publishedAt,
	publishedLabel: chapter.publishedLabel,
	views: chapter.views,
	href: `/${collection}/${entry.slug}/chapter/${chapter.number}`,
	status: "available" as const,
}));
---

<LPage template={page.template}>
	{page.sections.map((section) => {
		const content = asRecord(section.content);
		if (section.type === "page-header") {
			const metrics = asRecord(content.metrics);
			const facts = asRecord(content.facts);
			return (
				<LSection {...frame(section)}>
					<PPageHeader
						template={section.template as "cover-summary"}
						data={{
							breadcrumb: {
								label: asString(content.breadcrumbLabel),
								items: [{ label: asString(content.collectionLabel), href: `/${collection}` }],
								current: entry.title,
							},
							cover: entry.cover,
							tagsLabel: asString(content.tagsLabel),
							tags: entry.genres.map((genre) => ({ label: genre.label, href: `/${collection}/category/${genre.slug}` })),
							title: entry.title,
							author: { label: asString(content.authorLabel), name: entry.author },
							metrics: [
								{ label: asString(metrics.ratingLabel), value: String(entry.rating), icon: "star" },
								{ label: asString(metrics.readsLabel), value: entry.views, icon: "eye" },
								{ label: asString(metrics.chaptersLabel), value: String(entry.chapters), icon: "bookOpen" },
								...(detail ? [{ label: asString(metrics.followersLabel), value: detail.followers, icon: "bookmark" as const }] : []),
							],
							actionsLabel: asString(content.actionsLabel),
							actions: [{ label: asString(content.primaryActionLabel), href: "#chapters", icon: "bookOpen", variant: "primary", size: "md" }],
							description: detail?.description ?? [entry.summary],
							facts: {
								title: asString(content.factsTitle),
								items: [
									{ label: asString(facts.authorLabel), value: entry.author },
									{ label: asString(facts.genresLabel), value: entry.genres.map((genre) => genre.label).join(", ") },
									{ label: asString(facts.languageLabel), value: detail?.language ?? "" },
									{ label: asString(facts.statusLabel), value: entry.status === "ongoing" ? asString(facts.ongoingLabel) : asString(facts.completeLabel) },
									{ label: asString(facts.updatedLabel), value: entry.updatedLabel },
									{ label: asString(facts.viewsLabel), value: entry.views },
								],
							},
						}}
					/>
				</LSection>
			);
		}

		if (section.type === "tabs") {
			return (
				<LSection {...frame(section)}>
					<CTabList
						label={asString(content.label)}
						appearance={asString(content.appearance, "underline") as "underline"}
						tone={asString(content.tone, "light") as "light"}
						activeValue={asString(content.activeValue)}
						tabs={asArray(content.tabs) as Array<{ label: string; value: string; href: string }>}
					/>
				</LSection>
			);
		}

		if (section.type === "entry-index") {
			const sort = asRecord(content.sort);
			return (
				<LSection {...frame(section)}>
					<LSidebar label={asString(content.asideLabel)}>
						<CColumns slot="sidebar" columns="one" gap="md">
							<CDescriptionList items={[{ label: asString(content.introductionLabel), value: detail?.description[0] ?? entry.summary }]} />
							{detail?.tags?.length ? (
								<CTags label={asString(content.tagsLabel)} items={detail.tags.map((tag) => ({ label: tag.label, href: `/${collection}/tag/${tag.slug}` }))} />
							) : null}
						</CColumns>
						<PEntryIndex
							id={section.id}
							label={asString(content.chapterIndexLabel)}
							title={asString(content.title)}
							sort={{ id: asString(sort.id), label: asString(sort.label), value: asString(sort.value), options: asArray(sort.options) as Array<{ label: string; value: string }> }}
							listViewLabel={asString(content.listViewLabel)}
							items={chapterItems}
							visibleCount={chapterItems.length}
						/>
					</LSidebar>
				</LSection>
			);
		}

		return null;
	})}
</LPage>
