---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import type { ProductDetailPageProps } from "@/types/components/pages/product-detail/ProductDetailPage.types";

const { data } = Astro.props as ProductDetailPageProps;
const { product } = data;
const page = product.detail.page;

const price = {
	current: `$${product.price}`,
	previous: product.oldPrice ? `$${product.oldPrice}` : undefined,
	discount: product.oldPrice ? `-${Math.round((1 - product.price / product.oldPrice) * 100)}%` : undefined,
};
---

<LPage template={page.template}>
	{page.sections.map((section) => {
		if (section.type === "page-header") {
			const { content, settings } = section;
			return (
				<LSection id={section.id} theme={settings.theme} spacing={settings.spacing} container={settings.container}>
					<PPageHeader
						template={section.template}
						data={{
							breadcrumb: {
								label: content.breadcrumbLabel,
								items: [
									{ label: content.productsLabel, href: "/products" },
									{ label: product.category, href: `/products/category/${product.categorySlug}` },
								],
								current: product.title,
							},
							category: { label: product.category, href: `/products/category/${product.categorySlug}` },
							title: product.title,
							description: product.description,
							badge: product.badge,
							images: [{ src: product.image, alt: content.galleryLabel, width: 900, height: 562 }],
							galleryLabel: content.galleryLabel,
							thumbnailLabel: content.thumbnailLabel,
							rating: { value: product.rating, maximum: 5, count: product.reviews, salesLabel: content.salesLabel },
							price,
							features: content.features,
							facts: content.facts,
							actionsLabel: content.actionsLabel,
							actions: content.actions,
							paymentLabel: content.paymentLabel,
							paymentMethods: content.paymentMethods,
						}}
					/>
				</LSection>
			);
		}

		if (section.type === "article") {
			const { content, settings } = section;
			return (
				<LSection id={section.id} theme={settings.theme} spacing={settings.spacing} container={settings.container}>
					<PArticle blocks={content.blocks} />
				</LSection>
			);
		}

		return null;
	})}
</LPage>
