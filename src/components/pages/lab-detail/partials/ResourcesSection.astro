---
import LSection from "@/components/layout/LSection.astro";
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CIcon from "@/components/object/component/CIcon.astro";
import CRow from "@/components/object/component/CRow.astro";
import CText from "@/components/object/component/CText.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { LabDetailPageData } from "@/types/components/pages/lab-detail/LabDetailPage.types";

type Props = {
	data: LabDetailPageData;
};

const { data } = Astro.props as Props;
const { presentation, resources } = data;
const resourcesGridClass = "grid gap-3 md:grid-cols-2 xl:grid-cols-4";
const resourcesIconClass = "flex size-10 items-center justify-center rounded-md bg-black text-white";
---

<LSection id={presentation.resources.id} {...presentation.resources.settings}>
	<CColumns {...presentation.resources.stack}>
		<PSectionHeader
			data={{ title: presentation.resources.title }}
			appearance={presentation.resources.header.appearance}
			headingLevel={presentation.resources.header.headingLevel}
		/>
		<div class={resourcesGridClass}>
			{resources.map((resource) => (
				<CBox
					as="article"
					surface={presentation.resources.card.surface}
					radius={presentation.resources.card.radius}
					spacing={presentation.resources.card.spacing}
				>
					<CColumns {...presentation.resources.card.stack}>
						<CRow {...presentation.resources.row}>
							<span class={resourcesIconClass}>
								<CIcon
									name={resource.icon}
									size={presentation.resources.iconSize}
								/>
							</span>
							<CButton
								href={resource.href}
								label={resource.actionLabel}
								icon={presentation.resources.actionIcon}
								{...presentation.resources.action}
							/>
						</CRow>
						<CColumns {...presentation.resources.copy.stack}>
							<CHeading
								level={presentation.resources.copy.headingLevel}
								variant={presentation.resources.copy.headingVariant}
							>
								{resource.title}
							</CHeading>
							<CText
								variant={presentation.resources.copy.bodyVariant}
								tone={presentation.resources.copy.bodyTone}
							>
								{resource.description}
							</CText>
						</CColumns>
					</CColumns>
				</CBox>
			))}
		</div>
	</CColumns>
</LSection>
