---
import LSection from "@/components/layout/LSection.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CFeature from "@/components/object/component/CFeature.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRow from "@/components/object/component/CRow.astro";
import CText from "@/components/object/component/CText.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { LabDetailPageData } from "@/types/components/pages/lab-detail/LabDetailPage.types";

type Props = {
	data: LabDetailPageData;
};

const { data } = Astro.props as Props;
const { presentation, relatedItems } = data;
const relatedGridClass = "grid gap-4 sm:grid-cols-2 xl:grid-cols-4";
const relatedLinkClass = "group block h-full";
const relatedCardClass = "h-full transition-transform duration-300 group-hover:-translate-y-1";
const relatedContentClass = "border-t border-black/10 p-4";
---

<LSection id={presentation.related.id} {...presentation.related.settings}>
	<CColumns {...presentation.related.stack}>
		<PSectionHeader
			data={{ title: presentation.related.title }}
			action={{
				label: presentation.related.actionLabel,
				href: presentation.header.routes.base,
				icon: presentation.related.actionIcon,
			}}
			appearance={presentation.related.header.appearance}
			headingLevel={presentation.related.header.headingLevel}
		/>
		<div class={relatedGridClass}>
			{relatedItems.map((item) => (
				<CLink
					href={item.href}
					aria-label={item.ariaLabel}
					class={relatedLinkClass}
				>
					<CBox
						as="article"
						surface={presentation.related.card.surface}
						radius={presentation.related.card.radius}
						overflow={presentation.related.card.overflow}
						class={relatedCardClass}
					>
						<CMedia ratio={presentation.related.mediaRatio}>
							<CImage
								{...item.image}
								variant={presentation.related.imageVariant}
							/>
						</CMedia>
						<div class={relatedContentClass}>
							<CColumns {...presentation.related.copy.stack}>
								<CRow
									justify={presentation.related.metaRow.justify}
									align={presentation.related.metaRow.align}
									gap={presentation.related.metaRow.gap}
								>
									<CMetadata
										data={{
											items: [
												{
													type: "category",
													label: item.category.label,
													href: item.category.href,
													display: presentation.related.metaRow.metadataDisplay,
												},
											],
										}}
										tone={presentation.related.metaRow.metadataTone}
									/>
									<CFeature
										icon={presentation.related.metricIcon}
										label={item.stars}
										appearance={presentation.related.metaRow.metricAppearance}
									/>
								</CRow>
								<CHeading
									level={presentation.related.copy.headingLevel}
									variant={presentation.related.copy.headingVariant}
								>
									{item.title}
								</CHeading>
								<CText
									variant={presentation.related.copy.bodyVariant}
									tone={presentation.related.copy.bodyTone}
								>
									{item.summary}
								</CText>
							</CColumns>
						</div>
					</CBox>
				</CLink>
			))}
		</div>
	</CColumns>
</LSection>
