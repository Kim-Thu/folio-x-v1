---
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import type { LabDetailPageData } from "@/types/components/pages/lab-detail/LabDetailPage.types";

type Props = {
	data: LabDetailPageData;
};

const { data } = Astro.props as Props;
---

<LSection id={data.presentation.header.id} {...data.presentation.header.settings}>
	<PPageHeader
		template={data.presentation.header.template}
		data={data.header}
	/>
</LSection>
