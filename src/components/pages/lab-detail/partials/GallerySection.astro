---
import LSection from "@/components/layout/LSection.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CText from "@/components/object/component/CText.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { LabDetailPageData } from "@/types/components/pages/lab-detail/LabDetailPage.types";

type Props = {
	data: LabDetailPageData;
};

const { data } = Astro.props as Props;
const { galleryItems, presentation } = data;
const galleryGridClass = "grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-5";
const galleryLinkClass = "group block overflow-hidden rounded-md bg-black/5";
const galleryImageClass = "transition-transform duration-300 group-hover:scale-[1.02]";
const galleryCaptionClass = "border-t border-black/10 px-3 py-2";
---

<LSection id={presentation.gallery.id} {...presentation.gallery.settings}>
	<CColumns {...presentation.gallery.stack}>
		<PSectionHeader
			data={{ title: presentation.gallery.title }}
			appearance={presentation.gallery.header.appearance}
			headingLevel={presentation.gallery.header.headingLevel}
		/>
		<div class={galleryGridClass}>
			{galleryItems.map((item) => (
				<CLink
					href={item.href}
					aria-label={item.ariaLabel}
					class={galleryLinkClass}
				>
					<CMedia ratio={presentation.gallery.mediaRatio}>
						<CImage
							{...item.image}
							variant={presentation.gallery.imageVariant}
							class={galleryImageClass}
						/>
					</CMedia>
					{item.title && (
						<div class={galleryCaptionClass}>
							<CText
								variant={presentation.gallery.captionVariant}
								tone={presentation.gallery.captionTone}
							>
								{item.title}
							</CText>
						</div>
					)}
				</CLink>
			))}
		</div>
	</CColumns>
</LSection>
