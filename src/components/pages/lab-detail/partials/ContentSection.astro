---
import LSection from "@/components/layout/LSection.astro";
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CTags from "@/components/object/component/CTags.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { LabDetailPageData } from "@/types/components/pages/lab-detail/LabDetailPage.types";

type Props = {
	data: LabDetailPageData;
};

const { data } = Astro.props as Props;
const { lab, presentation, sidebar } = data;
const articleFrameClass = "min-w-0 max-w-3xl";
const sidebarDividerClass = "border-t border-black/10 pt-4";
---

<LSection id={presentation.content.id} {...presentation.content.settings}>
	<LSidebar
		label={sidebar.label}
		position={presentation.sidebar.position}
		sticky={presentation.sidebar.sticky}
	>
		<CColumns slot="sidebar" {...presentation.sidebar.stack}>
			<CBox
				surface={presentation.sidebar.panel.surface}
				radius={presentation.sidebar.panel.radius}
				spacing={presentation.sidebar.panel.spacing}
			>
				<CColumns {...presentation.sidebar.panel.stack}>
					<PSectionHeader
						data={{ title: presentation.sidebar.labels.projectInformation }}
						appearance={presentation.sidebar.header.appearance}
						headingLevel={presentation.sidebar.header.headingLevel}
					/>
					<div class={sidebarDividerClass}>
						<CDescriptionList items={sidebar.facts} />
					</div>
					<div class={sidebarDividerClass}>
						<CTags
							label={sidebar.technologyLabel}
							items={sidebar.technologies}
						/>
					</div>
				</CColumns>
			</CBox>
		</CColumns>

		<div class={articleFrameClass}>
			<PArticle
				template={presentation.content.article.template}
				content={lab.content}
			/>
		</div>
	</LSidebar>
</LSection>
