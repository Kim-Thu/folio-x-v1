---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CTags from "@/components/object/component/CTags.astro";
import type { LabDetailPageProps } from "@/types/components/pages/lab-detail/LabDetailPage.types";
import type { PCardProps } from "@/types/components/object/project/card/PCard.types";

const { data } = Astro.props as LabDetailPageProps;
const { lab } = data;
const page = lab.detail?.page;
if (!page) throw new Error(`Missing CMS lab detail: ${lab.slug}`);

const summarySection = page.sections.find((section) => section.type === "page-header");
const contentSection = page.sections.find((section) => section.type === "article");
const featuresSection = page.sections.find((section) => section.type === "collection" && section.id === "features");
const gallerySection = page.sections.find((section) => section.type === "collection" && section.id === "gallery");
const articleBlocks = lab.sections.map((section, index) => ({
	id: index === 0 ? "overview" : section.title.toLowerCase().replace(/\s+/g, "-"),
	title: section.title,
	paragraphs: section.paragraphs,
}));

const summaryLabels = summarySection?.content.labels;
const actions = summaryLabels
	? [
			...(lab.liveUrl ? [{ label: summaryLabels.live, href: lab.liveUrl, icon: "arrowUpRight" as const, variant: "primary" as const }] : []),
			...(lab.sourceUrl ? [{ label: summaryLabels.source, href: lab.sourceUrl, icon: "github" as const, variant: "outline" as const }] : []),
		]
	: [];
---

<LPage template={page.template}>
	{summarySection && summaryLabels && (
		<LSection id={summarySection.id} {...summarySection.settings}>
			<PPageHeader
				template={summarySection.template}
				data={{
					breadcrumb: {
						label: summaryLabels.breadcrumb,
						items: [
							{ label: "Labs", href: "/labs" },
							{ label: lab.category.label, href: `/labs/category/${lab.category.slug}` },
						],
						current: lab.title,
					},
					image: lab.image,
					category: { label: lab.category.label, href: `/labs/category/${lab.category.slug}` },
					badge: lab.statusLabel,
					title: lab.title,
					description: lab.summary,
					metrics: [
						{ icon: "star", label: String(lab.stars) },
						{ icon: "github", label: String(lab.forks) },
						{ icon: "clock01", label: lab.updatedLabel },
					],
					actionsLabel: summaryLabels.actions,
					actions,
				}}
			/>
		</LSection>
	)}

	{contentSection && summaryLabels && (
		<LSection id={contentSection.id} {...contentSection.settings}>
			<CColumns columns="twelve" gap="lg">
				<div class="lg:col-span-8">
					<PArticle appearance={contentSection.content.appearance} blocks={articleBlocks} />
				</div>
				<aside class="lg:col-span-4">
					<CColumns columns="one" gap="md">
						<CDescriptionList items={lab.facts} />
						<CTags
							label={summaryLabels.technology}
							items={lab.technologies.map((technology) => ({
								label: technology.label,
								href: `/labs/technology/${technology.slug}`,
							}))}
						/>
					</CColumns>
				</aside>
			</CColumns>
		</LSection>
	)}

	{featuresSection && lab.features.length > 0 && (
		<LSection id={featuresSection.id} {...featuresSection.settings}>
			<CColumns columns="one" gap="md">
				<PSectionHeader data={{ title: featuresSection.content.heading.title }} headingLevel={2} appearance="compact" />
				<PCard
					template={featuresSection.content.cards.template as PCardProps["template"]}
					layout={featuresSection.content.cards.layout as PCardProps["layout"]}
					columns={featuresSection.content.cards.columns as PCardProps["columns"]}
					gap={featuresSection.content.cards.gap as PCardProps["gap"]}
					items={lab.features.map((feature) => ({
						href: `#${featuresSection.id}`,
						ariaLabel: feature.title,
						title: [feature.title],
						excerpt: feature.description,
						icon: feature.icon,
					}))}
				/>
			</CColumns>
		</LSection>
	)}

	{gallerySection && gallerySection.content.labels && lab.gallery.length > 0 && (
		<LSection id={gallerySection.id} {...gallerySection.settings}>
			<CColumns columns="one" gap="md">
				<PSectionHeader data={{ title: gallerySection.content.heading.title }} headingLevel={2} appearance="compact" />
				<PCard
					template={gallerySection.content.cards.template as PCardProps["template"]}
					layout={gallerySection.content.cards.layout as PCardProps["layout"]}
					columns={gallerySection.content.cards.columns as PCardProps["columns"]}
					gap={gallerySection.content.cards.gap as PCardProps["gap"]}
					items={lab.gallery.map((image, index) => ({
						href: image.src,
						ariaLabel: `${gallerySection.content.labels?.openImage} ${index + 1}`,
						title: [`${gallerySection.content.labels?.imageTitle} ${index + 1}`],
						media: image,
					}))}
				/>
			</CColumns>
		</LSection>
	)}
</LPage>
