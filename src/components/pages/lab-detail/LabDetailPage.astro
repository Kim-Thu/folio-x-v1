---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CFeature from "@/components/object/component/CFeature.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CIcon from "@/components/object/component/CIcon.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRow from "@/components/object/component/CRow.astro";
import CTabList from "@/components/object/component/CTabList.astro";
import CTags from "@/components/object/component/CTags.astro";
import CText from "@/components/object/component/CText.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { LabDetailPageProps } from "@/types/components/pages/lab-detail/LabDetailPage.types";

const { data } = Astro.props as LabDetailPageProps;
const {
	lab,
	presentation,
	header,
	tabs,
	sidebar,
	galleryItems,
	resources,
	relatedItems,
} = data;
---

<LPage template={presentation.page.template}>
	<LSection id={presentation.header.id} {...presentation.header.settings}>
		<PPageHeader template={presentation.header.template} data={header} />
	</LSection>

	{tabs.length > 0 && (
		<LSection {...presentation.navigation.settings}>
			<div class="border-y border-black/10 bg-white">
				<CTabList
					label={presentation.navigation.labelTemplate.replace("{title}", lab.title)}
					appearance={presentation.navigation.appearance}
					activeValue={tabs[0]?.value}
					tone={presentation.navigation.tone}
					{tabs}
				/>
			</div>
		</LSection>
	)}

	<LSection id={presentation.content.id} {...presentation.content.settings}>
		<LSidebar
			label={sidebar.label}
			position={presentation.sidebar.position}
			sticky={presentation.sidebar.sticky}
		>
			<CColumns slot="sidebar" {...presentation.sidebar.stack}>
				<CBox
					surface={presentation.sidebar.panel.surface}
					radius={presentation.sidebar.panel.radius}
					spacing={presentation.sidebar.panel.spacing}
				>
					<CColumns {...presentation.sidebar.panel.stack}>
						<PSectionHeader
							data={{ title: presentation.sidebar.labels.projectInformation }}
							appearance={presentation.sidebar.header.appearance}
							headingLevel={presentation.sidebar.header.headingLevel}
						/>
						<div class="border-t border-black/10 pt-4">
							<CDescriptionList items={sidebar.facts} />
						</div>
						<div class="border-t border-black/10 pt-4">
							<CTags label={sidebar.technologyLabel} items={sidebar.technologies} />
						</div>
					</CColumns>
				</CBox>
			</CColumns>

			<div class="min-w-0 max-w-3xl">
				<PArticle template={presentation.content.article.template} content={lab.content} />
			</div>
		</LSidebar>
	</LSection>

	{galleryItems.length > 0 && (
		<LSection id={presentation.gallery.id} {...presentation.gallery.settings}>
			<CColumns {...presentation.gallery.stack}>
				<PSectionHeader
					data={{ title: presentation.gallery.title }}
					appearance={presentation.gallery.header.appearance}
					headingLevel={presentation.gallery.header.headingLevel}
				/>
				<div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-5">
					{galleryItems.map((item) => (
						<CLink href={item.href} aria-label={item.ariaLabel} class="group block overflow-hidden rounded-md bg-black/5">
							<CMedia ratio="editorial">
								<CImage {...item.image} variant="fill" class="transition-transform duration-300 group-hover:scale-[1.02]" />
							</CMedia>
							{item.title && (
								<div class="border-t border-black/10 px-3 py-2">
									<CText variant="caption" tone="muted">{item.title}</CText>
								</div>
							)}
						</CLink>
					))}
				</div>
			</CColumns>
		</LSection>
	)}

	{resources.length > 0 && (
		<LSection id={presentation.resources.id} {...presentation.resources.settings}>
			<CColumns {...presentation.resources.stack}>
				<PSectionHeader
					data={{ title: presentation.resources.title }}
					appearance={presentation.resources.header.appearance}
					headingLevel={presentation.resources.header.headingLevel}
				/>
				<div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
					{resources.map((resource) => (
						<CBox as="article" surface="bordered" radius="md" spacing="md">
							<CColumns columns="one" gap="md">
								<CRow align="center" justify="between" gap="md">
									<span class="flex size-10 items-center justify-center rounded-md bg-black text-white">
										<CIcon name={resource.icon} size="sm" />
									</span>
									<CButton
										href={resource.href}
										label={resource.actionLabel}
										icon={presentation.resources.actionIcon}
										iconOnly
										size="xs"
										variant="outline"
										tone="light"
									/>
								</CRow>
								<CColumns columns="one" gap="xs">
									<CHeading level={3} variant="h5">{resource.title}</CHeading>
									<CText variant="body-sm" tone="muted">{resource.description}</CText>
								</CColumns>
							</CColumns>
						</CBox>
					))}
				</div>
			</CColumns>
		</LSection>
	)}

	{relatedItems.length > 0 && (
		<LSection id={presentation.related.id} {...presentation.related.settings}>
			<CColumns {...presentation.related.stack}>
				<PSectionHeader
					data={{ title: presentation.related.title }}
					action={{
						label: presentation.related.actionLabel,
						href: presentation.header.routes.base,
						icon: presentation.related.actionIcon,
					}}
					appearance={presentation.related.header.appearance}
					headingLevel={presentation.related.header.headingLevel}
				/>
				<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
					{relatedItems.map((item) => (
						<CLink href={item.href} aria-label={item.ariaLabel} class="group block h-full">
							<CBox as="article" surface="bordered" radius="md" overflow="hidden" class="h-full transition-transform duration-300 group-hover:-translate-y-1">
								<CMedia ratio="editorial">
									<CImage {...item.image} variant="fill" />
								</CMedia>
								<div class="border-t border-black/10 p-4">
									<CColumns columns="one" gap="sm">
										<CRow justify="between" align="center" gap="sm">
											<CMetadata data={{ items: [{ type: "category", label: item.category.label, href: item.category.href, display: "text" }] }} tone="brand" />
											<CFeature icon={presentation.related.metricIcon} label={item.stars} appearance="caption" />
										</CRow>
										<CHeading level={3} variant="h5">{item.title}</CHeading>
										<CText variant="body-sm" tone="muted">{item.summary}</CText>
									</CColumns>
								</div>
							</CBox>
						</CLink>
					))}
				</div>
			</CColumns>
		</LSection>
	)}
</LPage>
