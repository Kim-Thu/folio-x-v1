---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CFeature from "@/components/object/component/CFeature.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CIcon from "@/components/object/component/CIcon.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRow from "@/components/object/component/CRow.astro";
import CTabList from "@/components/object/component/CTabList.astro";
import CTags from "@/components/object/component/CTags.astro";
import CText from "@/components/object/component/CText.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { LabDetailPageProps } from "@/types/components/pages/lab-detail/LabDetailPage.types";

const { data } = Astro.props as LabDetailPageProps;
const { lab, presentation, header, tabs, sidebar, galleryItems, resources, relatedItems } = data;

const classes = {
	navigationFrame: "border-y border-black/10 bg-white",
	articleFrame: "min-w-0",
	sidebarDivider: "border-t border-black/10 pt-4",
	galleryGrid: "grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-5",
	galleryLink: "group block overflow-hidden rounded-md bg-black/5",
	galleryImage: "transition-transform duration-300 group-hover:scale-[1.02]",
	galleryCaption: "border-t border-black/10 px-3 py-2",
	resourcesGrid: "grid gap-3 md:grid-cols-2 xl:grid-cols-4",
	resourcesIcon: "flex size-10 items-center justify-center rounded-md bg-black text-white",
	relatedGrid: "grid gap-4 sm:grid-cols-2 xl:grid-cols-4",
	relatedLink: "group block h-full",
	relatedCard: "h-full transition-transform duration-300 group-hover:-translate-y-1",
	relatedContent: "border-t border-black/10 p-4",
} as const;
---

<LPage template={presentation.page.template}>
	<LSection id={presentation.header.id} {...presentation.header.settings}>
		<PPageHeader template={presentation.header.template} data={header} />
	</LSection>

	{tabs.length > 0 && (
		<LSection {...presentation.navigation.settings}>
			<div class={classes.navigationFrame}>
				<CTabList label={presentation.navigation.labelTemplate.replace("{title}", lab.title)} appearance={presentation.navigation.appearance} activeValue={tabs[0]?.value} tone={presentation.navigation.tone} {tabs} />
			</div>
		</LSection>
	)}

	<LSection id={presentation.content.id} {...presentation.content.settings}>
		<LSidebar label={sidebar.label} position={presentation.sidebar.position} sticky={presentation.sidebar.sticky}>
			<CColumns slot="sidebar" {...presentation.sidebar.stack}>
				<CBox surface={presentation.sidebar.panel.surface} radius={presentation.sidebar.panel.radius} spacing={presentation.sidebar.panel.spacing}>
					<CColumns {...presentation.sidebar.panel.stack}>
						<PSectionHeader data={{ title: presentation.sidebar.labels.projectInformation }} appearance={presentation.sidebar.header.appearance} headingLevel={presentation.sidebar.header.headingLevel} />
						<div class={classes.sidebarDivider}><CDescriptionList items={sidebar.facts} /></div>
						<div class={classes.sidebarDivider}><CTags label={sidebar.technologyLabel} items={sidebar.technologies} /></div>
					</CColumns>
				</CBox>
			</CColumns>
			<div class={classes.articleFrame}>
				<PArticle template={presentation.content.article.template} content={lab.content} />
			</div>
		</LSidebar>
	</LSection>

	{galleryItems.length > 0 && (
		<LSection id={presentation.gallery.id} {...presentation.gallery.settings}>
			<CColumns {...presentation.gallery.stack}>
				<PSectionHeader data={{ title: presentation.gallery.title }} appearance={presentation.gallery.header.appearance} headingLevel={presentation.gallery.header.headingLevel} />
				<div class={classes.galleryGrid}>
					{galleryItems.map((item) => (
						<CLink href={item.href} aria-label={item.ariaLabel} class={classes.galleryLink}>
							<CMedia ratio={presentation.gallery.mediaRatio}><CImage {...item.image} variant={presentation.gallery.imageVariant} class={classes.galleryImage} /></CMedia>
							{item.title && <div class={classes.galleryCaption}><CText variant={presentation.gallery.captionVariant} tone={presentation.gallery.captionTone}>{item.title}</CText></div>}
						</CLink>
					))}
				</div>
			</CColumns>
		</LSection>
	)}

	{resources.length > 0 && (
		<LSection id={presentation.resources.id} {...presentation.resources.settings}>
			<CColumns {...presentation.resources.stack}>
				<PSectionHeader data={{ title: presentation.resources.title }} appearance={presentation.resources.header.appearance} headingLevel={presentation.resources.header.headingLevel} />
				<div class={classes.resourcesGrid}>
					{resources.map((resource) => (
						<CBox as="article" surface={presentation.resources.card.surface} radius={presentation.resources.card.radius} spacing={presentation.resources.card.spacing}>
							<CColumns {...presentation.resources.card.stack}>
								<CRow {...presentation.resources.row}>
									<span class={classes.resourcesIcon}><CIcon name={resource.icon} size={presentation.resources.iconSize} /></span>
									<CButton href={resource.href} label={resource.actionLabel} icon={presentation.resources.actionIcon} {...presentation.resources.action} />
								</CRow>
								<CColumns {...presentation.resources.copy.stack}>
									<CHeading level={presentation.resources.copy.headingLevel} variant={presentation.resources.copy.headingVariant}>{resource.title}</CHeading>
									<CText variant={presentation.resources.copy.bodyVariant} tone={presentation.resources.copy.bodyTone}>{resource.description}</CText>
								</CColumns>
							</CColumns>
						</CBox>
					))}
				</div>
			</CColumns>
		</LSection>
	)}

	{relatedItems.length > 0 && (
		<LSection id={presentation.related.id} {...presentation.related.settings}>
			<CColumns {...presentation.related.stack}>
				<PSectionHeader data={{ title: presentation.related.title }} action={{ label: presentation.related.actionLabel, href: presentation.header.routes.base, icon: presentation.related.actionIcon }} appearance={presentation.related.header.appearance} headingLevel={presentation.related.header.headingLevel} />
				<div class={classes.relatedGrid}>
					{relatedItems.map((item) => (
						<CLink href={item.href} aria-label={item.ariaLabel} class={classes.relatedLink}>
							<CBox as="article" surface={presentation.related.card.surface} radius={presentation.related.card.radius} overflow={presentation.related.card.overflow} class={classes.relatedCard}>
								<CMedia ratio={presentation.related.mediaRatio}><CImage {...item.image} variant={presentation.related.imageVariant} /></CMedia>
								<div class={classes.relatedContent}>
									<CColumns {...presentation.related.copy.stack}>
										<CRow justify={presentation.related.metaRow.justify} align={presentation.related.metaRow.align} gap={presentation.related.metaRow.gap}>
											<CMetadata data={{ items: [{ type: "category", label: item.category.label, href: item.category.href, display: presentation.related.metaRow.metadataDisplay }] }} tone={presentation.related.metaRow.metadataTone} />
											<CFeature icon={presentation.related.metricIcon} label={item.stars} appearance={presentation.related.metaRow.metricAppearance} />
										</CRow>
										<CHeading level={presentation.related.copy.headingLevel} variant={presentation.related.copy.headingVariant}>{item.title}</CHeading>
										<CText variant={presentation.related.copy.bodyVariant} tone={presentation.related.copy.bodyTone}>{item.summary}</CText>
									</CColumns>
								</div>
							</CBox>
						</CLink>
					))}
				</div>
			</CColumns>
		</LSection>
	)}
</LPage>
