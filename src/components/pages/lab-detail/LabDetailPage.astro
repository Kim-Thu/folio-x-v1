---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CTabList from "@/components/object/component/CTabList.astro";
import CTags from "@/components/object/component/CTags.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { LabDetailPageProps } from "@/types/components/pages/lab-detail/LabDetailPage.types";
import type { PCardData } from "@/types/components/object/project/card/PCard.types";

const { data } = Astro.props as LabDetailPageProps;
const { lab, relatedLabs, presentation } = data;
const page = lab.detail?.page;
if (!page) throw new Error(`Missing CMS lab detail: ${lab.slug}`);

const summarySection = page.sections.find((section) => section.type === "page-header");
const articleSection = page.sections.find((section) => section.type === "article");
const featureSection = page.sections.find((section) => section.type === "collection" && !section.content.labels);
const gallerySection = page.sections.find((section) => section.type === "collection" && Boolean(section.content.labels));
if (!summarySection || !articleSection) throw new Error(`Incomplete CMS lab detail: ${lab.slug}`);
if (lab.features.length > 0 && !featureSection) throw new Error(`Missing CMS lab feature presentation: ${lab.slug}`);
if (lab.gallery.length > 0 && !gallerySection?.content.labels) throw new Error(`Missing CMS lab gallery presentation: ${lab.slug}`);

const metricValue = (source: "stars" | "forks" | "updatedLabel") =>
	source === "updatedLabel" ? lab.updatedLabel : String(lab[source]);
const formatLabel = (template: string) => template.replace("{title}", lab.title);

const actions = [
	...(lab.liveUrl ? [{ label: summarySection.content.labels.live, href: lab.liveUrl, ...summarySection.content.actions.live }] : []),
	...(lab.sourceUrl ? [{ label: summarySection.content.labels.source, href: lab.sourceUrl, ...summarySection.content.actions.source }] : []),
];

const tabs = [
	...lab.sections.map((section) => ({ label: section.title, value: section.id, href: `#${section.id}` })),
	...(lab.features.length > 0 && featureSection ? [{ label: featureSection.content.heading.title, value: featureSection.id, href: `#${featureSection.id}` }] : []),
	...(lab.gallery.length > 0 && gallerySection ? [{ label: gallerySection.content.heading.title, value: gallerySection.id, href: `#${gallerySection.id}` }] : []),
	...(lab.resources.length > 0 ? [{ label: presentation.resources.title, value: presentation.resources.id, href: `#${presentation.resources.id}` }] : []),
];

const featureCards: PCardData[] = lab.features.map((feature) => ({
	href: `#${featureSection?.id}`,
	ariaLabel: feature.title,
	title: [feature.title],
	excerpt: feature.description,
	icon: feature.icon,
}));

const galleryLabels = gallerySection?.content.labels;
const galleryCards: PCardData[] = lab.gallery.map((image, index) => ({
	href: image.src,
	ariaLabel: `${galleryLabels?.openImage} ${index + 1}`,
	title: [`${galleryLabels?.imageTitle} ${index + 1}`],
	media: image,
}));

const resourceCards: PCardData[] = lab.resources.map((resource) => ({
	href: resource.href,
	ariaLabel: resource.title,
	title: [resource.title],
	excerpt: resource.description,
	icon: resource.icon,
	action: {
		label: resource.title,
		href: resource.href,
		icon: presentation.resources.actionIcon,
	},
}));

const relatedCards: PCardData[] = relatedLabs.map((item) => ({
	href: item.href,
	ariaLabel: item.title,
	title: [item.title],
	excerpt: item.summary,
	media: item.image,
	metadata: {
		items: [{ type: "category", label: item.category.label, href: `${summarySection.content.routes.categoryBase}/${item.category.slug}`, display: "text" }],
	},
	metrics: [{ icon: presentation.related.metricIcon, label: String(item.stars) }],
}));
---

<LPage template={page.template}>
	<LSection id={summarySection.id} {...summarySection.settings}>
		<PPageHeader
			template={summarySection.template}
			data={{
				breadcrumb: {
					label: summarySection.content.labels.breadcrumb,
					items: [
						{ label: summarySection.content.labels.collection, href: summarySection.content.routes.base },
						{ label: lab.category.label, href: `${summarySection.content.routes.categoryBase}/${lab.category.slug}` },
					],
					current: lab.title,
				},
				image: lab.image,
				category: { label: lab.category.label, href: `${summarySection.content.routes.categoryBase}/${lab.category.slug}` },
				badge: lab.statusLabel,
				title: lab.title,
				description: lab.summary,
				metrics: summarySection.content.metrics.map((metric) => ({ icon: metric.icon, label: metricValue(metric.source) })),
				actionsLabel: summarySection.content.labels.actions,
				actions,
			}}
		/>
	</LSection>

	<LSection theme="canvas" spacing="none" container="site">
		<CTabList
			label={formatLabel(presentation.navigation.labelTemplate)}
			appearance="underline"
			activeValue={tabs[0]?.value}
			tone="light"
			{tabs}
		/>
	</LSection>

	<LSection id={articleSection.id} {...articleSection.settings}>
		<LSidebar label={formatLabel(presentation.sidebar.labelTemplate)} position="end" sticky>
			<CColumns slot="sidebar" columns="one" gap="md">
				<CBox surface="glass" radius="md" spacing="md">
					<CColumns columns="one" gap="md">
						<PSectionHeader data={{ title: presentation.sidebar.projectInformationTitle }} appearance="compact" headingLevel={2} />
						<CDescriptionList items={lab.facts} />
						<CTags
							label={summarySection.content.labels.technology}
							items={lab.technologies.map((technology) => ({
								label: technology.label,
								href: `${summarySection.content.routes.technologyBase}/${technology.slug}`,
							}))}
						/>
					</CColumns>
				</CBox>
			</CColumns>

			<CColumns columns="one" gap="xl">
				<PArticle appearance={articleSection.content.appearance} blocks={lab.sections} />

				{featureSection && featureCards.length > 0 && (
					<CColumns id={featureSection.id} columns="one" gap="md">
						<PSectionHeader
							data={{ title: featureSection.content.heading.title }}
							headingLevel={2}
							appearance={featureSection.content.heading.appearance}
						/>
						<PCard
							template={featureSection.content.cards.template}
							layout={featureSection.content.cards.layout}
							columns={featureSection.content.cards.columns}
							gap={featureSection.content.cards.gap}
							items={featureCards}
						/>
					</CColumns>
				)}
			</CColumns>
		</LSidebar>
	</LSection>

	{gallerySection && galleryCards.length > 0 && (
		<LSection id={gallerySection.id} {...gallerySection.settings}>
			<CColumns columns="one" gap="md">
				<PSectionHeader data={{ title: gallerySection.content.heading.title }} appearance={gallerySection.content.heading.appearance} headingLevel={2} />
				<PCard
					template={gallerySection.content.cards.template}
					layout={gallerySection.content.cards.layout}
					columns={gallerySection.content.cards.columns}
					gap={gallerySection.content.cards.gap}
					items={galleryCards}
				/>
			</CColumns>
		</LSection>
	)}

	{resourceCards.length > 0 && (
		<LSection id={presentation.resources.id} {...presentation.resources.settings}>
			<CColumns columns="one" gap="md">
				<PSectionHeader data={{ title: presentation.resources.title }} appearance="compact" headingLevel={2} />
				<PCard {...presentation.resources.cards} items={resourceCards} />
			</CColumns>
		</LSection>
	)}

	{relatedCards.length > 0 && (
		<LSection id={presentation.related.id} {...presentation.related.settings}>
			<CColumns columns="one" gap="md">
				<PSectionHeader
					data={{
						title: presentation.related.title,
						action: { label: presentation.related.actionLabel, href: summarySection.content.routes.base, icon: "arrowRight" },
					}}
					appearance="compact"
					headingLevel={2}
				/>
				<PCard {...presentation.related.cards} items={relatedCards} slots={presentation.related.slots} />
			</CColumns>
		</LSection>
	)}
</LPage>
