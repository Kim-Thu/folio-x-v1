---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CTags from "@/components/object/component/CTags.astro";
import type { LabDetailPageProps } from "@/types/components/pages/lab-detail/LabDetailPage.types";

const { data } = Astro.props as LabDetailPageProps;
const { lab } = data;
const page = lab.detail?.page;
if (!page) throw new Error(`Missing CMS lab detail: ${lab.slug}`);

const metricValue = (source: "stars" | "forks" | "updatedLabel") => source === "updatedLabel" ? lab.updatedLabel : String(lab[source]);

const columnSpanClasses = {
	1: "lg:col-span-1",
	2: "lg:col-span-2",
	3: "lg:col-span-3",
	4: "lg:col-span-4",
	5: "lg:col-span-5",
	6: "lg:col-span-6",
	7: "lg:col-span-7",
	8: "lg:col-span-8",
	9: "lg:col-span-9",
	10: "lg:col-span-10",
	11: "lg:col-span-11",
	12: "lg:col-span-12",
} as const;

const columnSpanClass = (span: number) =>
	columnSpanClasses[span as keyof typeof columnSpanClasses];
---

<LPage template={page.template}>
	{page.sections.map((section) => {
		if (section.type === "page-header") {
			const { content } = section;
			const actions = [
				...(lab.liveUrl ? [{ label: content.labels.live, href: lab.liveUrl, ...content.actions.live }] : []),
				...(lab.sourceUrl ? [{ label: content.labels.source, href: lab.sourceUrl, ...content.actions.source }] : []),
			];

			return (
				<LSection id={section.id} {...section.settings}>
					<PPageHeader
						template={section.template}
						data={{
							breadcrumb: {
								label: content.labels.breadcrumb,
								items: [
									{ label: content.labels.collection, href: content.routes.base },
									{ label: lab.category.label, href: `${content.routes.categoryBase}/${lab.category.slug}` },
								],
								current: lab.title,
							},
							image: lab.image,
							category: { label: lab.category.label, href: `${content.routes.categoryBase}/${lab.category.slug}` },
							badge: lab.statusLabel,
							title: lab.title,
							description: lab.summary,
							metrics: content.metrics.map((metric) => ({ icon: metric.icon, label: metricValue(metric.source) })),
							actionsLabel: content.labels.actions,
							actions,
						}}
					/>
				</LSection>
			);
		}

		if (section.type === "article") {
			const summarySection = page.sections.find((item) => item.type === "page-header");
			if (!summarySection) return null;
			const articleSpanClass = columnSpanClass(section.content.layout.articleSpan);
			const asideSpanClass = columnSpanClass(section.content.layout.asideSpan);
			if (!articleSpanClass || !asideSpanClass) {
				throw new Error(`Invalid CMS lab column span: ${lab.slug}`);
			}

			return (
				<LSection id={section.id} {...section.settings}>
					<CColumns columns={section.content.layout.columns} gap={section.content.layout.gap}>
						<div class={articleSpanClass}>
							<PArticle appearance={section.content.appearance} blocks={lab.sections} />
						</div>
						<aside class={asideSpanClass}>
							<CColumns columns={section.content.layout.asideColumns} gap={section.content.layout.asideGap}>
								<CDescriptionList items={lab.facts} />
								<CTags
									label={summarySection.content.labels.technology}
									items={lab.technologies.map((technology) => ({
										label: technology.label,
										href: `${summarySection.content.routes.technologyBase}/${technology.slug}`,
									}))}
								/>
							</CColumns>
						</aside>
					</CColumns>
				</LSection>
			);
		}

		if (section.type === "collection") {
			const isGallery = Boolean(section.content.labels);
			const items = isGallery
				? lab.gallery.map((image, index) => ({
						href: image.src,
						ariaLabel: `${section.content.labels?.openImage} ${index + 1}`,
						title: [`${section.content.labels?.imageTitle} ${index + 1}`],
						media: image,
					}))
				: lab.features.map((feature) => ({
						href: `#${section.id}`,
						ariaLabel: feature.title,
						title: [feature.title],
						excerpt: feature.description,
						icon: feature.icon,
					}));

			if (items.length === 0) return null;

			return (
				<LSection id={section.id} {...section.settings}>
					<CColumns columns={section.content.layout.columns} gap={section.content.layout.gap}>
						<PSectionHeader
							data={{ title: section.content.heading.title }}
							headingLevel={section.content.heading.level}
							appearance={section.content.heading.appearance}
						/>
						<PCard
							template={section.content.cards.template}
							layout={section.content.cards.layout}
							columns={section.content.cards.columns}
							gap={section.content.cards.gap}
							items={items}
						/>
					</CColumns>
				</LSection>
			);
		}

		return null;
	})}
</LPage>
