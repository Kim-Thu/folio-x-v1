---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PReader from "@/components/object/project/reader/PReader.astro";
import type { ReaderPageProps } from "@/types/components/pages/reader/ReaderPage.types";
import type { LSectionSpacing, LSectionTheme } from "@/types/components/layout/LSection.types";

const { data } = Astro.props as ReaderPageProps;
const { entry, catalogSlug, chapter } = data;
const configuredChapter = entry.detail?.reader?.find((item) => item.number === chapter);
const readerPage = entry.detail?.readerPage;
if (!readerPage) throw new Error(`Missing CMS reader page: ${catalogSlug}/${entry.slug}`);

const config = readerPage.content;
const chapterTitle = configuredChapter?.title ?? `${config.chapterLabel} ${chapter}: ${entry.title}`;
const indexHref = `/${catalogSlug}/${entry.slug}#chapters`;
const chapterHref = (number: number) => `/${catalogSlug}/${entry.slug}/chapter/${number}`;
const previous = chapter > 1 ? chapter - 1 : undefined;
const next = chapter < entry.chapters ? chapter + 1 : undefined;
const content = configuredChapter?.kind === "sequential-media" && configuredChapter.images?.length
	? { kind: "sequential-media" as const, images: configuredChapter.images }
	: configuredChapter?.kind === "prose" && configuredChapter.prose?.length
		? { kind: "prose" as const, items: configuredChapter.prose }
		: catalogSlug === "comics"
			? { kind: "sequential-media" as const, images: [entry.cover] }
			: { kind: "prose" as const, items: [{ text: entry.summary }] };
---

<LPage template={readerPage.template}>
	<LSection
		theme={readerPage.settings.theme as LSectionTheme}
		spacing={readerPage.settings.spacing as LSectionSpacing}
		container={readerPage.settings.container}
	>
		<PReader
			data={{
				breadcrumb: {
					label: config.breadcrumbLabel,
					items: [
						{ label: config.collectionLabel, href: `/${catalogSlug}` },
						{ label: entry.title, href: `/${catalogSlug}/${entry.slug}` },
					],
					current: `${config.chapterLabel} ${chapter}`,
				},
				badge: `${config.chapterLabel} ${chapter}`,
				title: chapterTitle,
				metadata: {
					items: [
						{ type: "datetime", label: configuredChapter?.publishedLabel ?? entry.updatedLabel, datetime: configuredChapter?.publishedAt ?? config.defaultPublishedAt, icon: "calendar03", display: "icon-text" },
						{ type: "reading-time", label: configuredChapter?.readTime ?? config.defaultReadTime, icon: "clock01", display: "icon-text" },
					],
				},
				views: `${configuredChapter?.views ?? entry.views} ${config.viewsSuffix}`,
				content,
				actions: {
					label: config.actionsLabel,
					index: { label: config.chapterListLabel, href: indexHref, icon: "listView", variant: "outline", size: "md" },
					settingsLabel: config.settingsLabel,
					themeLabel: config.themeLabel,
					next: next ? { label: config.nextLabel, href: chapterHref(next), icon: "arrowRight", iconPosition: "end", variant: "primary", size: "md" } : undefined,
				},
				share: { label: config.shareLabel, links: [] },
				reactions: { label: config.reactionsLabel, items: [] },
				bookmarkLabel: config.bookmarkLabel,
				navigation: {
					label: config.navigationLabel,
					previous: previous ? { label: config.previousLabel, href: chapterHref(previous), icon: "arrowLeft", variant: "outline", size: "md" } : undefined,
					index: { label: config.chapterListLabel, href: indexHref, icon: "listView", variant: "outline", size: "md" },
					next: next ? { label: config.nextLabel, href: chapterHref(next), icon: "arrowRight", iconPosition: "end", variant: "primary", size: "md" } : undefined,
				},
			}}
		/>
	</LSection>
</LPage>
