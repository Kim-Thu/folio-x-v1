---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PStatus from "@/components/object/project/status/PStatus.astro";
import type { SystemStatePageProps } from "@/types/components/pages/system-state/SystemStatePage.types";

const { data } = Astro.props as SystemStatePageProps;
---

<LPage template="centered">
	<LSection id={data.content.id} container="wide">
		<PStatus template="split-media" data={data.content} />
	</LSection>
</LPage>
