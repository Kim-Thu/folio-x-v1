---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PReviews from "@/components/object/project/reviews/PReviews.astro";
import PPostNavigation from "@/components/object/project/post-navigation/PPostNavigation.astro";
import type { WorkDetailPageProps } from "@/types/components/pages/work-detail/WorkDetailPage.types";
import type { LSectionSpacing, LSectionTheme } from "@/types/components/layout/LSection.types";

const { data } = Astro.props as WorkDetailPageProps;
const { project, previous, next, routes } = data;
const detail = project.detail;
const page = detail?.page;
const sections = page?.sections ?? [];
const asRecord = (value: unknown) => value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : {};
const asString = (value: unknown, fallback = "") => typeof value === "string" ? value : fallback;
const frame = (section: (typeof sections)[number]) => {
  const settings = asRecord(section.settings);
  return {
    theme: asString(settings.theme, "light") as LSectionTheme,
    spacing: asString(settings.spacing, "compact") as LSectionSpacing,
    container: asString(settings.container, "site") as "site" | "content" | "none",
  };
};
const gallery = detail?.gallery?.length
  ? detail.gallery
  : [{ src: project.image, alt: project.alt, width: 1600, height: 1000 }];
const headerImages = Array.from(new Map([
  { src: project.image, alt: project.alt, width: 1600, height: 1000 },
  ...gallery,
].map((image) => [image.src, image])).values());
const articleBlocks = project.sections.map((section, index) => ({
  id: `project-content-${index + 1}`,
  title: section.title,
  paragraphs: section.paragraphs,
  image: gallery[index % gallery.length],
}));
---

<LPage template={page?.template ?? "fluid"}>
  {sections.map((section) => {
    const content = asRecord(section.content);
    const sectionFrame = frame(section);

    if (section.type === "page-header") {
      const facts = asRecord(content.facts);
      const actions = [
        ...(detail?.liveUrl ? [{ kind: "live" as const, label: asString(content.liveActionLabel), href: detail.liveUrl, icon: "arrowUpRight" as const }] : []),
        ...(detail?.sourceUrl ? [{ kind: "source" as const, label: asString(content.sourceActionLabel), href: detail.sourceUrl, icon: "github" as const }] : []),
      ];
      return (
        <LSection id={section.id} {...sectionFrame}>
          <PPageHeader
            template={(section.template ?? "slider-aside") as "slider-aside"}
            data={{
              backAction: asRecord(content.backAction) as { label: string; href: string },
              category: { label: project.category, href: `${routes.categoryBase}${project.categorySlug}` },
              title: project.title,
              description: project.summary,
              images: headerImages,
              mediaTemplate: headerImages.length > 1 ? "slider" : "grid",
              galleryLabel: asString(content.galleryLabel),
              previousImageLabel: asString(content.previousImageLabel),
              nextImageLabel: asString(content.nextImageLabel),
              tagsLabel: asString(content.tagsLabel),
              actionsLabel: asString(content.actionsLabel),
              tags: project.tags.map((tag) => ({ label: tag.label, href: `${routes.tagBase}${tag.slug}` })),
              actions,
              asideDecoration: asRecord(content.asideDecoration) as { src: string; alt: string; width: number; height: number },
              facts: [
                { label: asString(facts.clientLabel), value: project.client },
                { label: asString(facts.roleLabel), value: detail?.role ?? project.category },
                { label: asString(facts.durationLabel), value: detail?.duration ?? project.year },
              ],
            }}
          />
        </LSection>
      );
    }

    if (section.type === "article") {
      return <LSection id={section.id} {...sectionFrame}><PArticle blocks={articleBlocks} /></LSection>;
    }

    if (section.type === "reviews" && detail?.reviews) {
      return <LSection id={section.id} {...sectionFrame}><PReviews {...detail.reviews} /></LSection>;
    }

    if (section.type === "post-navigation") {
      const navigation = [
        ...(previous ? [{ title: previous.title, href: previous.href, image: previous.image, alt: previous.alt, label: asString(content.previousLabel), icon: "arrowLeft" as const, summary: previous.summary }] : []),
        ...(next ? [{ title: next.title, href: next.href, image: next.image, alt: next.alt, label: asString(content.nextLabel), icon: "arrowRight" as const, summary: next.summary }] : []),
      ];
      return navigation.length > 0 ? (
        <LSection id={section.id} {...sectionFrame}>
          <PPostNavigation template={(section.template ?? "split") as "split"} items={navigation} label={asString(content.label)} />
        </LSection>
      ) : null;
    }

    return null;
  })}
</LPage>
