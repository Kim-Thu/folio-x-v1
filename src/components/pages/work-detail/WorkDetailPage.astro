---
import LPage from "@/components/layout/LPage.astro";
import LSection from "@/components/layout/LSection.astro";
import PPageHeader from "@/components/object/project/page-header/PPageHeader.astro";
import PArticle from "@/components/object/project/article/PArticle.astro";
import PReviews from "@/components/object/project/reviews/PReviews.astro";
import PPostNavigation from "@/components/object/project/post-navigation/PPostNavigation.astro";
import type { WorkDetailPageProps } from "@/types/components/pages/work-detail/WorkDetailPage.types";

const { data } = Astro.props as WorkDetailPageProps;
const { project, previous, next } = data;
const detail = project.detail;
const gallery = detail?.gallery?.length
	? detail.gallery
	: [{ src: project.image, alt: project.alt, width: 1600, height: 1000 }];
const headerImages = Array.from(
	new Map(
		[
			{ src: project.image, alt: project.alt, width: 1600, height: 1000 },
			...gallery,
		].map((image) => [image.src, image]),
	).values(),
);
const articleBlocks = project.sections.map((section, index) => ({
	id: `project-content-${index + 1}`,
	title: section.title,
	paragraphs: section.paragraphs,
	image: gallery[index % gallery.length],
}));
const actions = [
	...(detail?.liveUrl ? [{ kind: "live" as const, label: "Live site", href: detail.liveUrl, icon: "arrowUpRight" as const }] : []),
	...(detail?.sourceUrl ? [{ kind: "source" as const, label: "Source code", href: detail.sourceUrl, icon: "github" as const }] : []),
];
const navigation = [
	...(previous ? [{ title: previous.title, href: previous.href, image: previous.image, alt: previous.alt, label: "Previous", icon: "arrowLeft" as const, summary: previous.summary }] : []),
	...(next ? [{ title: next.title, href: next.href, image: next.image, alt: next.alt, label: "Next", icon: "arrowRight" as const, summary: next.summary }] : []),
];
---

<LPage template="fluid">
	<LSection theme="light" spacing="compact">
		<PPageHeader
			template="slider-aside"
			data={{
				backAction: { label: "Back to projects", href: "/projects" },
				category: { label: project.category, href: `/projects/category/${project.categorySlug}` },
				title: project.title,
				description: project.summary,
				images: headerImages,
				mediaTemplate: headerImages.length > 1 ? "slider" : "grid",
				galleryLabel: `${project.title} gallery`,
				previousImageLabel: "Previous image",
				nextImageLabel: "Next image",
				tagsLabel: `${project.title} technology stack`,
				actionsLabel: `${project.title} actions`,
				tags: project.tags.map((tag) => ({ label: tag.label, href: `/projects/tag/${tag.slug}` })),
				actions,
				asideDecoration: { src: "/uploads/pattern-1.png", alt: "", width: 1536, height: 1536 },
				facts: [
					{ label: "Client", value: project.client },
					{ label: "Role", value: detail?.role ?? project.category },
					{ label: "Duration", value: detail?.duration ?? project.year },
				],
			}}
		/>
	</LSection>

	<LSection theme="light" spacing="body">
		<PArticle blocks={articleBlocks} />
	</LSection>

	{detail?.reviews && (
		<LSection id="customer-reviews" theme="light" spacing="compact">
			<PReviews {...detail.reviews} />
		</LSection>
	)}

	{navigation.length > 0 && (
		<LSection theme="light" spacing="closing">
			<PPostNavigation template="split" items={navigation} label="Previous / Next" />
		</LSection>
	)}
</LPage>
