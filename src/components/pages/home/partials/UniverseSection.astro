---
import LSection from "@/components/layout/LSection.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { HomePageData } from "@/types/components/pages/home/HomePage.types";
import type { PCardData } from "@/types/components/object/project/card/PCard.types";

type PageSection = HomePageData["content"]["sections"][number];
type CollectionSection = Extract<PageSection, { type: "collection" }>;

type Props = {
	data: CollectionSection;
};

const { data } = Astro.props as Props;
const { content } = data;

if (!("items" in content) || !content.heading || !content.cards) {
	throw new Error("Home universe section has an invalid content contract");
}

const items: PCardData[] = content.items.map((item, index) => {
	const title = item.title;
	if (
		typeof item.href !== "string" ||
		typeof item.ariaLabel !== "string" ||
		!Array.isArray(title) ||
		!title.every((line): line is string => typeof line === "string")
	) {
		throw new Error(`Home universe card ${index + 1} is invalid`);
	}

	let media: PCardData["media"];
	if (item.media !== undefined) {
		const raw = item.media;
		if (
			typeof raw !== "object" ||
			raw === null ||
			typeof raw.src !== "string" ||
			typeof raw.alt !== "string" ||
			typeof raw.width !== "number" ||
			typeof raw.height !== "number"
		) {
			throw new Error(`Home universe card ${index + 1} has invalid media`);
		}
		media = {
			src: raw.src,
			alt: raw.alt,
			width: raw.width,
			height: raw.height,
		};
	}

	const appearance = item.appearance;
	if (appearance !== undefined && appearance !== "default" && appearance !== "inverse") {
		throw new Error(`Home universe card ${index + 1} has invalid appearance`);
	}

	return {
		href: item.href,
		ariaLabel: item.ariaLabel,
		title,
		excerpt: typeof item.excerpt === "string" ? item.excerpt : undefined,
		media,
		appearance,
	};
});
---

<LSection id={data.id} {...data.settings}>
	<CColumns columns="one" gap="xl">
		<PSectionHeader
			data={{
				number: content.heading.number,
				label: content.heading.label,
				title: content.heading.title,
				description: content.heading.description,
			}}
			action={content.heading.action}
		/>
		<PCard {...content.cards} items={items} />
	</CColumns>
</LSection>
