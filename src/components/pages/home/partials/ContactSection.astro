---
import LSection from "@/components/layout/LSection.astro";
import PCta from "@/components/object/project/cta/PCta.astro";
import type { HomePageData } from "@/types/components/pages/home/HomePage.types";

type PageSection = HomePageData["content"]["sections"][number];
type CtaSection = Extract<PageSection, { type: "cta" }>;

type Props = {
	data: CtaSection;
};

const { data } = Astro.props as Props;
const { content } = data;

if (typeof content.title !== "string") {
	throw new Error("Home contact section requires a single title");
}

const ctaData = {
	id: content.id ?? data.id,
	title: content.title,
	description: content.description,
	action: content.action
		? { href: content.action.href, label: content.action.label }
		: undefined,
	image: content.image,
};
---

<LSection id={data.id} {...data.settings}>
	<PCta template={data.template} data={ctaData} />
</LSection>
