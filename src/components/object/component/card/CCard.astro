---
import { cCardTemplates } from "@/constants/components/object/component/card/CCard.constants";
import type {
	CCardProps,
	CCardSlots,
} from "@/types/components/object/component/card/CCard.types";

const {
	template = "stacked",
	slots,
	...props
} = Astro.props as CCardProps;

const defaultSlots: CCardSlots = {
	media: true,
	icon: true,
	metadata: true,
	tags: true,
	metrics: true,
	title: true,
	excerpt: true,
	action: true,
};

const resolvedSlots = { ...defaultSlots, ...slots };
const Template = cCardTemplates[template];
---

<Template {...props} slots={resolvedSlots} />
