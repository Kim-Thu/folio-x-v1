---
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CTags from "@/components/object/component/CTags.astro";
import CText from "@/components/object/component/CText.astro";
import type { CCardTemplateProps } from "@/types/components/object/component/card/CCard.types";
import { resolveProjectOverlayCard } from "@/utils/card";
import { cn } from "@/utils/cn";
import {
	cardFillColumnClasses,
	cardPinnedFooterClasses,
} from "@/variants/components/object/component/card/CCard.variants";

const {
	data,
	headingLevel = 3,
	index,
	mediaRatio = "natural",
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const card = resolveProjectOverlayCard({
	data,
	source,
	presentation,
});

const desktopRatioClasses: Record<NonNullable<CCardTemplateProps["mediaRatio"]>, string> = {
	editorial: "lg:aspect-video",
	landscape: "lg:aspect-4/3",
	natural: "lg:aspect-video",
	panoramic: "lg:aspect-3/1",
	portrait: "lg:aspect-2/3",
	square: "lg:aspect-square",
	video: "lg:aspect-video",
};
---

<CBox
	as="article"
	class={cn("w-full", desktopRatioClasses[mediaRatio])}
	surface="dark"
	radius="lg"
	position="relative"
	ratio="natural"
	overflow="hidden"
	data-tab-card={card.filterValue ? "" : undefined}
	data-filter-category={card.filterValue}
	data-sort-value={card.sortValue}
	data-sort-index={index}
>
	{slots.media && card.media && (
		<CMedia
			ratio="natural"
			placement="background"
			href={card.href}
			ariaLabel={card.title}
		>
			<CImage {...card.media} variant="fill" />
		</CMedia>
	)}

	<CBox position="relative" class="h-full p-8">
		<div class={cardFillColumnClasses}>
			<div class="w-full md:w-4/5">
				<CColumns columns="one" gap="sm">
					<CColumns columns="one" gap="xs">
						{slots.metadata && card.metadata && (
							<CMetadata
								data={card.metadata}
								size="caption"
								tone="on-dark"
							/>
						)}

						{slots.title && (
							<CHeading level={headingLevel} variant="h4">
								<CLink href={card.href}>{card.title}</CLink>
							</CHeading>
						)}

						{slots.excerpt && card.excerpt && (
							<CText variant="body-sm" tone="on-dark">
								{card.excerpt}
							</CText>
						)}
					</CColumns>

					{slots.tags && card.tags && card.tags.length > 0 && (
						<CTags
							appearance="outline"
							items={card.tags}
							label={card.tagsLabel ?? `${card.title} tags`}
							tone="inverse"
						/>
					)}
				</CColumns>
			</div>

			{card.action && (
				<div class={cn(cardPinnedFooterClasses, "pt-8")}>
					<CButton
						href={card.action.href}
						label={card.action.label}
						icon={card.action.icon}
						iconPosition={card.action.iconPosition}
						variant="outline"
						tone="dark"
						size="sm"
					/>
				</div>
			)}
		</div>
	</CBox>
</CBox>
