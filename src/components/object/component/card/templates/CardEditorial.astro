---
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CText from "@/components/object/component/CText.astro";
import type { CCardTemplateProps } from "@/types/components/object/component/card/CCard.types";
import { resolveInsightCard } from "@/utils/card";

const {
	data,
	headingLevel = 3,
	index,
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const insightCard = resolveInsightCard({ data, source, presentation });
---

<CBox
	as="article"
	surface="glass"
	radius="md"
	overflow="hidden"
	data-facet-card
	data-facets={JSON.stringify(insightCard.facets ?? {})}
	data-search-value={insightCard.searchValue.toLowerCase()}
	data-sort-value={insightCard.sortValue}
	data-sort-index={index}
>
	{slots.media && insightCard.media && (
		<CMedia ratio="video" href={insightCard.href} ariaLabel={insightCard.title}>
			<CImage {...insightCard.media} variant="fill" />
		</CMedia>
	)}

	<CBox spacing="sm">
		<CColumns columns="one" gap="xs">
			{slots.metadata && insightCard.metadata && (
				<CMetadata data={insightCard.metadata} tone="brand" />
			)}

			{slots.title && (
				<CHeading level={headingLevel} variant="h4">
					<CLink href={insightCard.href}>{insightCard.title}</CLink>
				</CHeading>
			)}

			{slots.excerpt && insightCard.excerpt && (
				<CText variant="body-sm" tone="subtle">{insightCard.excerpt}</CText>
			)}

			{slots.metadata && insightCard.secondaryMetadata && (
				<CMetadata data={insightCard.secondaryMetadata} tone="on-light" class="pt-8" />
			)}
		</CColumns>
	</CBox>
</CBox>
