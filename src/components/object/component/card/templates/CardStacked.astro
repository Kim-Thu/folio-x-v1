---
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CTags from "@/components/object/component/CTags.astro";
import CText from "@/components/object/component/CText.astro";
import type { CCardTemplateProps } from "@/types/components/object/component/card/CCard.types";
import { getCardSourceContext } from "@/utils/card";

const {
	data,
	headingLevel = 3,
	index,
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const {
	item: insight,
	presentation: insightPresentation,
} = getCardSourceContext("blog", {
	data,
	source,
	presentation,
});
const href = insight?.href ?? data.href;
const title = insight?.title ?? data.title.join(" ");
const excerpt = insight?.excerpt ?? data.excerpt;
const media = insight && insightPresentation && insight.image && insight.imageAlt
	? {
		src: insight.image,
		alt: insight.imageAlt,
		width: insightPresentation.imageWidth,
		height: insightPresentation.imageHeight,
	}
	: data.media;
const metadata = insight
	? {
		separator: insightPresentation?.separator,
		items: [
			...(index !== undefined && index > 0
				? [{
					type: "index" as const,
					label: insight.index,
					display: insightPresentation?.metadataDisplay,
				}]
				: []),
			{
				type: "category" as const,
				label: insight.category,
				href: insightPresentation?.routes.categoryBase
					? `${insightPresentation.routes.categoryBase}${insight.categorySlug}`
					: undefined,
				display: insightPresentation?.metadataDisplay,
			},
			{
				type: "reading-time" as const,
				label: insight.readTime,
				display: insightPresentation?.metadataDisplay,
			},
		],
	}
	: data.metadata;
const tags = insight
	? insight.tags.map((tag) => ({
		label: tag.label,
		href: insightPresentation?.routes.tagBase
			? `${insightPresentation.routes.tagBase}${tag.slug}`
			: undefined,
	}))
	: data.tags;
const tagsLabel = insight && insightPresentation?.tagsLabelSuffix
	? `${insight.title}${insightPresentation.tagsLabelSuffix}`
	: data.tagsLabel;
const inverse = data.appearance === "inverse";
---

<CBox
	as="article"
	surface={inverse ? "glass-dark" : "plain"}
	radius="lg"
	overflow="hidden"
>
	{slots.media && media && (
		<CBox radius="lg" overflow="hidden">
			<CMedia ratio="editorial" shape="none" href={href} ariaLabel={title}>
				<CImage {...media} variant="fill" />
			</CMedia>
		</CBox>
	)}

	<CBox spacing="sm">
		<CColumns columns="one" gap="xs">
			{slots.metadata && metadata && (
				<CMetadata data={metadata} tone={inverse ? "on-dark" : "on-light"} />
			)}

			{slots.title && (
				<CHeading level={headingLevel} variant="h3">
					<CLink href={href}>{title}</CLink>
				</CHeading>
			)}

			{slots.excerpt && excerpt && (
				<CText tone={inverse ? "on-dark-muted" : "subtle"}>{excerpt}</CText>
			)}

			{slots.tags && tags && tags.length > 0 && (
				<CTags items={tags} label={tagsLabel ?? `${title} tags`} />
			)}

			{slots.action && data.action && (
				<CButton
					href={data.action.href}
					label={data.action.label}
					icon={data.action.icon}
					iconPosition={data.action.iconPosition}
					variant="text-subtle"
					tone={inverse ? "dark" : "light"}
					size="xs"
				/>
			)}
		</CColumns>
	</CBox>
</CBox>
