---
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CFeature from "@/components/object/component/CFeature.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRow from "@/components/object/component/CRow.astro";
import CText from "@/components/object/component/CText.astro";
import type { CCardTemplateProps } from "@/types/components/object/component/card/CCard.types";
import { resolveInsightCard, resolvePublicationCard } from "@/utils/card";

const {
	data,
	headingLevel = 3,
	index,
	mediaRatio = "square",
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const isInsight = source === "blog";
const insightCard = isInsight
	? resolveInsightCard({ data, source, presentation })
	: undefined;
const publicationCard = isInsight
	? undefined
	: resolvePublicationCard({ data, source, presentation });
const href = insightCard?.href ?? publicationCard?.href ?? data.href;
const title = insightCard?.title ?? publicationCard?.title ?? data.title.join(" ");
const excerpt = insightCard?.excerpt ?? publicationCard?.excerpt ?? data.excerpt;
const media = insightCard?.media ?? publicationCard?.media ?? data.media;
const ariaLabel = insightCard?.title ?? publicationCard?.ariaLabel ?? data.ariaLabel;
const metadata = insightCard?.metadata ?? publicationCard?.metadata ?? data.metadata;
const metrics = isInsight ? data.metrics : publicationCard?.metrics ?? data.metrics;
const facets = insightCard?.facets ?? publicationCard?.facets ?? data.facets;
const searchValue = insightCard?.searchValue
	?? publicationCard?.searchValue
	?? data.searchValue
	?? title;
const sortValue = insightCard?.sortValue ?? publicationCard?.sortValue ?? data.sortValue;
---

<CBox
	as="article"
	data-facet-card={facets ? "" : undefined}
	data-facets={facets ? JSON.stringify(facets) : undefined}
	data-search-value={searchValue.toLowerCase()}
	data-sort-value={sortValue}
	data-sort-index={index}
>
	<CRow align="start" gap="sm" wrap={false}>
		{slots.media && media && (
			<CMedia
				ratio={mediaRatio}
				shape="card"
				size={mediaRatio === "portrait" ? "compact" : "thumbnail"}
				href={href}
				ariaLabel={ariaLabel}
			>
				<CImage {...media} variant="fill" />
			</CMedia>
		)}

		<CColumns columns="one" gap="sm">
			<CColumns columns="one" gap="none">
				{slots.metadata && metadata && <CMetadata data={metadata} tone="on-light" />}

				{slots.title && (
					<CHeading level={headingLevel} variant="h5">
						<CLink href={href}>{title}</CLink>
					</CHeading>
				)}

				{slots.excerpt && excerpt && (
					<CText variant="body-sm" tone="subtle">{excerpt}</CText>
				)}
			</CColumns>

			{slots.metrics && metrics && metrics.length > 0 && (
				<CRow gap="sm">
					{metrics.map((metric) => <CFeature {...metric} appearance="caption" />)}
				</CRow>
			)}
		</CColumns>
	</CRow>
</CBox>
