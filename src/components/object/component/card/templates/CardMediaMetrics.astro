---
import CBadge from "@/components/object/component/CBadge.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CFeature from "@/components/object/component/CFeature.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRating from "@/components/object/component/CRating.astro";
import CRow from "@/components/object/component/CRow.astro";
import CTags from "@/components/object/component/CTags.astro";
import CText from "@/components/object/component/CText.astro";
import type { CCardTemplateProps } from "@/types/components/object/component/card/CCard.types";
import { resolveLabCard, resolvePublicationCard } from "@/utils/card";

const {
	data,
	headingLevel = 3,
	index,
	mediaRatio = "video",
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const labCard = resolveLabCard({ data, source, presentation });
const publicationCard = resolvePublicationCard({ data, source, presentation });
const isLab = Boolean(labCard.lab);
const href = isLab ? labCard.href : publicationCard.href;
const title = isLab ? labCard.title : publicationCard.title;
const excerpt = isLab ? labCard.excerpt : publicationCard.excerpt;
const media = isLab ? labCard.media : publicationCard.media;
const ariaLabel = isLab ? labCard.ariaLabel : publicationCard.ariaLabel;
const metadata = isLab ? labCard.metadata : publicationCard.metadata;
const badge = isLab ? labCard.badge : data.badge;
const tags = isLab ? labCard.tags : publicationCard.tags;
const tagsLabel = isLab ? labCard.tagsLabel : publicationCard.tagsLabel;
const metrics = isLab ? labCard.metrics : publicationCard.metrics;
const rating = publicationCard.rating;
const facets = isLab ? labCard.facets : publicationCard.facets;
const searchValue = isLab ? labCard.searchValue : publicationCard.searchValue;
const sortValue = publicationCard.sortValue;
---

<CBox
	as="article"
	surface="glass"
	radius="md"
	overflow="hidden"
	data-facet-card={facets ? "" : undefined}
	data-facets={facets ? JSON.stringify(facets) : undefined}
	data-search-value={searchValue.toLowerCase()}
	data-sort-value={sortValue}
	data-sort-index={index}
>
	{slots.media && media && (
		<div class="relative">
			<CMedia ratio={mediaRatio} href={href} ariaLabel={ariaLabel}>
				<CImage {...media} variant="fill" />
				{badge && <CBadge placement="top-end" tone={badge.tone}>{badge.label}</CBadge>}
			</CMedia>

			{isLab && slots.tags && tags && tags.length > 0 && (
				<div class="absolute inset-x-4 bottom-4 z-20 flex flex-wrap items-center gap-2">
					<CTags items={tags} label={tagsLabel ?? `${title} tags`} />
				</div>
			)}
		</div>
	)}

	<CBox spacing="sm">
		<CColumns columns="one" gap="md">
			<CColumns columns="one" gap="xs">
				{slots.metadata && metadata && (
					<CMetadata data={metadata} slots={{ icons: false }} tone="brand" />
				)}

				{slots.title && (
					<CHeading level={headingLevel} variant="h4">
						<CLink href={href}>{title}</CLink>
					</CHeading>
				)}

				{slots.excerpt && excerpt && (
					<CText variant="body-sm" tone="subtle">{excerpt}</CText>
				)}

				{!isLab && slots.tags && tags && tags.length > 0 && (
					<CTags items={tags} label={tagsLabel ?? `${title} tags`} />
				)}
			</CColumns>

			{((slots.metrics && metrics && metrics.length > 0) || rating) && (
				<CRow gap="lg">
					{slots.metrics && metrics?.map((metric) => (
						<CFeature {...metric} appearance="caption" />
					))}
					{rating && (
						<CRating
							style="compact"
							value={rating.value}
							maximum={5}
							count={rating.count}
						/>
					)}
				</CRow>
			)}
		</CColumns>
	</CBox>
</CBox>
