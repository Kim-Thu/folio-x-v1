---
import CBadge from "@/components/object/component/CBadge.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CFeature from "@/components/object/component/CFeature.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRating from "@/components/object/component/CRating.astro";
import CRow from "@/components/object/component/CRow.astro";
import CTags from "@/components/object/component/CTags.astro";
import CText from "@/components/object/component/CText.astro";
import type { CCardTemplateProps } from "@/types/components/object/component/card/CCard.types";
import { resolveMultiSourceCard } from "@/utils/card-resolver";

const {
	data,
	headingLevel = 3,
	index,
	mediaRatio = "video",
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const card = resolveMultiSourceCard({ data, source, presentation });
const isLab = Boolean(card.labCard);
const badge = card.labCard?.badge ?? data.badge;
const tags = card.labCard?.tags ?? card.publicationCard?.tags ?? data.tags;
const tagsLabel = card.labCard?.tagsLabel ?? card.publicationCard?.tagsLabel ?? data.tagsLabel;
const metrics = card.labCard?.metrics ?? card.publicationCard?.metrics ?? data.metrics;
const rating = card.labCard ? data.rating : card.publicationCard?.rating ?? data.rating;
---

<CBox
	as="article"
	surface="glass"
	radius="md"
	overflow="hidden"
	data-facet-card={card.facets ? "" : undefined}
	data-facets={card.facets ? JSON.stringify(card.facets) : undefined}
	data-search-value={card.searchValue.toLowerCase()}
	data-sort-value={card.sortValue}
	data-sort-index={index}
>
	{slots.media && card.media && (
		<div class="relative">
			<CMedia ratio={mediaRatio} href={card.href} ariaLabel={card.ariaLabel}>
				<CImage {...card.media} variant="fill" />
				{badge && <CBadge placement="top-end" tone={badge.tone}>{badge.label}</CBadge>}
			</CMedia>

			{isLab && slots.tags && tags && tags.length > 0 && (
				<div class="absolute inset-x-4 bottom-4 z-20 flex flex-wrap items-center gap-2">
					<CTags items={tags} label={tagsLabel ?? `${card.title} tags`} />
				</div>
			)}
		</div>
	)}

	<CBox spacing="sm">
		<CColumns columns="one" gap="md">
			<CColumns columns="one" gap="xs">
				{slots.metadata && card.metadata && (
					<CMetadata data={card.metadata} slots={{ icons: false }} tone="brand" />
				)}

				{slots.title && (
					<CHeading level={headingLevel} variant="h4">
						<CLink href={card.href}>{card.title}</CLink>
					</CHeading>
				)}

				{slots.excerpt && card.excerpt && (
					<CText variant="body-sm" tone="subtle">{card.excerpt}</CText>
				)}

				{!isLab && slots.tags && tags && tags.length > 0 && (
					<CTags items={tags} label={tagsLabel ?? `${card.title} tags`} />
				)}
			</CColumns>

			{((slots.metrics && metrics && metrics.length > 0) || rating) && (
				<CRow gap="lg">
					{slots.metrics && metrics?.map((metric) => (
						<CFeature {...metric} appearance="caption" />
					))}
					{rating && (
						<CRating
							style="compact"
							value={rating.value}
							maximum={5}
							count={rating.count}
						/>
					)}
				</CRow>
			)}
		</CColumns>
	</CBox>
</CBox>
