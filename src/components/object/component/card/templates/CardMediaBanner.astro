---
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CText from "@/components/object/component/CText.astro";
import type {
	CCardTemplateProps,
	PublicationCardPresentation,
	PublicationCollectionPresentation,
} from "@/types/components/object/component/card/CCard.types";
import { getCardSourceContext } from "@/utils/card";

const {
	data,
	headingLevel = 3,
	mediaRatio = "panoramic",
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const publicationContext = source === "publications"
	? getCardSourceContext("publications", { data, source, presentation })
	: source === "comics"
		? getCardSourceContext("comics", { data, source, presentation })
		: source === "novels"
			? getCardSourceContext("novels", { data, source, presentation })
			: { item: undefined, presentation: undefined };
const publication = publicationContext.item;
const publicationPresentation = publication
	? source === "publications"
		? (publicationContext.presentation as PublicationCollectionPresentation | undefined)?.[publication.catalog]
		: publicationContext.presentation as PublicationCardPresentation | undefined
	: undefined;
const href = publication?.href ?? data.href;
const title = publication?.title ?? data.title.join(" ");
const excerpt = publication?.summary ?? data.excerpt;
const media = publication?.cover ?? data.media;
const ariaLabel = publication
	? `${publicationPresentation?.ariaLabelPrefix ?? ""}${publication.title}`
	: data.ariaLabel;
const metadata = publication
	? {
		separator: " · ",
		items: [
			{
				type: "category" as const,
				label: publication.genres[0].label.toUpperCase(),
				href: publicationPresentation?.routes.categoryBase
					? `${publicationPresentation.routes.categoryBase}${publication.genres[0].slug}`
					: undefined,
				display: publicationPresentation?.categoryDisplay,
			},
			{
				type: "author" as const,
				label: publication.author,
				display: publicationPresentation?.categoryDisplay,
			},
			{
				type: "datetime" as const,
				label: `Updated ${publication.updatedLabel}`,
				display: publicationPresentation?.categoryDisplay,
			},
		],
	}
	: data.metadata;
const action = publication
	? {
		label: `${publicationPresentation?.ariaLabelPrefix ?? "Read "}${publication.title}`,
		href,
		icon: undefined,
		iconPosition: undefined,
	}
	: data.action;
---

<CBox
	as="article"
	class="h-full"
	surface="dark"
	position="relative"
	ratio={mediaRatio}
	radius="lg"
	overflow="hidden"
>
	{slots.media && media && (
		<CMedia ratio="natural" placement="background" href={href} ariaLabel={ariaLabel}>
			<CImage {...media} variant="fill" />
		</CMedia>
	)}

	<CBox position="relative" class="h-full p-8">
		<div class="flex h-full flex-col">
			<CColumns columns="one" gap="xs">
				{slots.metadata && metadata && (
					<CMetadata data={metadata} size="xs" tone="on-dark" />
				)}

				{slots.title && (
					<CHeading level={headingLevel} variant="h3">
						<CLink href={href}>{title}</CLink>
					</CHeading>
				)}

				{slots.excerpt && excerpt && (
					<CText variant="body-sm" tone="on-dark-muted">{excerpt}</CText>
				)}
			</CColumns>

			{action && (
				<div class="mt-auto pt-10">
					<CButton
						href={action.href}
						label={action.label}
						icon={action.icon}
						iconPosition={action.iconPosition}
						variant="secondary"
						tone="dark"
						size="sm"
					/>
				</div>
			)}
		</div>
	</CBox>
</CBox>
