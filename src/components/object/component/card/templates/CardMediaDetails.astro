---
import CBadge from "@/components/object/component/CBadge.astro";
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRating from "@/components/object/component/CRating.astro";
import CRow from "@/components/object/component/CRow.astro";
import CText from "@/components/object/component/CText.astro";
import type { CCardTemplateProps } from "@/types/components/object/component/card/CCard.types";
import { getCardSourceContext } from "@/utils/card";
import {
	cardMediaDetailsBodyClasses,
	cardMediaDetailsContentClasses,
	cardMediaDetailsFooterClasses,
	cardMediaDetailsRootClasses,
} from "@/variants/components/object/component/CCard.variants";

const {
	data,
	headingLevel = 3,
	index,
	presentation,
	slots,
	source,
} = Astro.props as CCardTemplateProps;

const {
	item: productSource,
	presentation: productPresentation,
} = getCardSourceContext("products", {
	data,
	source,
	presentation,
});
const product = productSource ?? data.product;
const href = productSource?.href ?? data.href;
const title = productSource?.title ?? data.title.join(" ");
const excerpt = productSource?.description ?? data.excerpt;
const media = productSource && productPresentation
	? {
		src: productSource.image,
		alt: `${productSource.title}${productPresentation.imageAltSuffix}`,
		width: productPresentation.imageWidth,
		height: productPresentation.imageHeight,
	}
	: data.media;
const metadata = productSource
	? {
		items: [
			{
				type: "category" as const,
				label: productSource.category,
				href: productPresentation?.routes.categoryBase
					? `${productPresentation.routes.categoryBase}${productSource.categorySlug}`
					: undefined,
				display: productPresentation?.categoryDisplay,
			},
		],
	}
	: data.metadata;
const actionLabel = productSource && productPresentation
	? `${productPresentation.actionLabelPrefix}${productSource.title}`
	: data.action?.label;
const license = productSource ? productPresentation?.license : data.product?.license;
---

{product && (
	<CBox
		as="article"
		surface="glass"
		radius="md"
		overflow="hidden"
		class={cardMediaDetailsRootClasses}
		data-product-card
		data-title={title.toLowerCase()}
		data-filter-category={product.categorySlug}
		data-license={license}
		data-platform={product.platform}
		data-price={product.price}
		data-rating={product.rating}
		data-sort-index={index}
	>
		{slots.media && media && (
			<CMedia ratio="editorial" href={href} ariaLabel={title}>
				<CImage {...media} variant="fill" />
				{product.badge && <CBadge placement="top-end">{product.badge}</CBadge>}
			</CMedia>
		)}

		<CBox spacing="xs" class={cardMediaDetailsBodyClasses}>
			<CColumns columns="one" gap="md" class={cardMediaDetailsContentClasses}>
				<CColumns columns="one" gap="xs">
					{slots.metadata && metadata && (
						<CMetadata data={metadata} slots={{ icons: false }} tone="brand" />
					)}

					{slots.title && (
						<CHeading level={headingLevel} variant="h4">
							<CLink href={href}>{title}</CLink>
						</CHeading>
					)}

					{slots.excerpt && excerpt && (
						<CText variant="body-sm" tone="subtle">{excerpt}</CText>
					)}
				</CColumns>

				<CRow
					as="footer"
					justify="between"
					align="end"
					gap="md"
					wrap={false}
					class={cardMediaDetailsFooterClasses}
				>
					<CRow gap="sm" align="baseline" wrap={false}>
						<CText as="span" variant="price">${product.price}</CText>
						{product.oldPrice && (
							<CText as="span" variant="price-old" tone="subtle">
								${product.oldPrice}
							</CText>
						)}
					</CRow>

					<CRow gap="sm" align="center" justify="end" wrap={false}>
						{slots.action && actionLabel && (
							<CButton
								label={actionLabel}
								icon="shoppingBag"
								iconOnly
								size="sm"
								tone="light"
								variant="view"
								data-cart-button
								aria-pressed="false"
							/>
						)}
						<CRating style="compact" value={product.rating} maximum={5} count={product.reviews} />
					</CRow>
				</CRow>
			</CColumns>
		</CBox>
	</CBox>
)}
