---
import type {
	CListGap,
	CListProps,
} from "@/types/components/object/component/CList.types";
import { cn } from "@/utils/cn";
import {
	listBaseClasses,
	listDirectionClasses,
	listGapClasses,
} from "@/variants/components/object/component/CList.variants";

type Props = CListProps;

const props = Astro.props as Props;

const {
	class: className,
	as: Element = "ul",
	direction = "row",
	...attributes
} = props;

const gap: CListGap = props.gap ?? "sm";
---

<Element
	{...attributes}
	class={cn(
		listBaseClasses,
		listDirectionClasses[direction],
		listGapClasses[gap],
		className,
	)}
>
	<slot />
</Element>
