---
import CIcon from "@/components/object/component/CIcon.astro";
import CFieldset from "@/components/object/component/CFieldset.astro";
import CLink from "@/components/object/component/CLink.astro";
import CText from "@/components/object/component/CText.astro";
import type { CChoiceGroupProps } from "@/types/components/object/component/CChoiceGroup.types";
import {
	choiceControlClasses,
	choiceControlIconClasses,
	choiceControlWrapClasses,
	choiceCountClasses,
	choiceLabelClasses,
	choiceNavigationClasses,
	choiceNavigationTitleClasses,
	choiceOptionClasses,
} from "@/variants/components/object/component/CChoiceGroup.variants";

const {
	appearance = "controls",
	class: className,
	control,
	legend,
	name,
	options,
	type = "checkbox",
	...attributes
} = Astro.props as CChoiceGroupProps;
---

{appearance === "navigation" ? (
	<nav
		{...attributes}
		class={className}
		aria-label={legend}
		data-choice-navigation
	>
		<CText as="span" variant="caption" class={choiceNavigationTitleClasses}>
			{legend}
		</CText>
		<div class={choiceNavigationClasses}>
			{options.map((option) => (
				option.href ? (
					<CLink
						href={option.href}
						class={choiceOptionClasses.navigation}
						aria-current={option.checked ? "true" : undefined}
						data-choice-link
						data-choice-control={control}
						data-choice-value={option.value}
					>
						<span class={choiceLabelClasses}>{option.label}</span>
						{typeof option.count === "number" && (
							<small class={choiceCountClasses}>{option.count}</small>
						)}
					</CLink>
				) : (
					<button
						type="button"
						class={choiceOptionClasses.navigation}
						aria-pressed={option.checked ? "true" : "false"}
						data-choice-filter
						data-choice-control={control}
						data-choice-value={option.value}
					>
						<span class={choiceLabelClasses}>{option.label}</span>
						{typeof option.count === "number" && (
							<small class={choiceCountClasses}>{option.count}</small>
						)}
					</button>
				)
			))}
		</div>
	</nav>
) : (
	<CFieldset {...attributes} class={className} {legend} gap="sm">
		{options.map((option) => (
			<label class={choiceOptionClasses.controls}>
				<span class={choiceControlWrapClasses}>
					<input
						class={choiceControlClasses.controls}
						type={type}
						name={name}
						value={option.value}
						checked={option.checked}
						data-category-filter={control === "category" ? "" : undefined}
						data-license-filter={control === "license" ? "" : undefined}
						data-platform-filter={control === "platform" ? "" : undefined}
						data-facet-filter
						data-facet-key={control}
					/>
					<CIcon
						name="check"
						size="sm"
						class={choiceControlIconClasses}
					/>
				</span>
				<span class={choiceLabelClasses}>{option.label}</span>
				{typeof option.count === "number" && (
					<small class={choiceCountClasses}>{option.count}</small>
				)}
			</label>
		))}
	</CFieldset>
)}
