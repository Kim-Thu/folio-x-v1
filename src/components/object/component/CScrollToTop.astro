---
import CButton from "@/components/object/component/CButton.astro";
import type { CScrollToTopProps } from "@/types/components/object/component/CScrollToTop.types";

const { label, tone } = Astro.props as CScrollToTopProps;
---

<div class="fixed right-4 bottom-4 z-50 hidden md:right-6 md:bottom-6" data-scroll-to-top>
	<CButton
		label={label}
		icon="arrowUp"
		iconOnly
		size="md"
		variant="secondary"
		{tone}
	/>
</div>
