---
import type { CImageProps } from "@/types/components/object/component/CImage.types";
import { cn } from "@/utils/cn";
import {
	imageBaseClasses,
	imagePositionClasses,
	imageVariantClasses,
} from "@/variants/components/object/component/CImage.variants";

type Props = CImageProps;

const {
	variant = "natural",
	position = "center",
	loading = "lazy",
	decoding = "async",
	class: className,
	...attributes
} = Astro.props;
---

<img
	{...attributes}
	loading={loading}
	decoding={decoding}
	class={cn(
		imageBaseClasses,
		imageVariantClasses[variant],
		imagePositionClasses[position],
		className,
	)}
/>
