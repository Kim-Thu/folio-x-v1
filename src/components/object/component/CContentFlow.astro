---
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CIcon from "@/components/object/component/CIcon.astro";
import CImage from "@/components/object/component/CImage.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CText from "@/components/object/component/CText.astro";
import type { CContentFlowProps } from "@/types/components/object/component/CContentFlow.types";
import { cn } from "@/utils/cn";
import {
	contentFlowClasses,
	contentFlowSpacingClasses,
} from "@/variants/components/object/component/CContentFlow.variants";

const { class: className, items, ...attributes } =
	Astro.props as CContentFlowProps;
---

<article {...attributes} class={cn(contentFlowClasses, className)}>
	{items.map((item) => (
		item.type === "heading" ? (
			<CHeading
				id={item.id}
				level={item.level}
				variant={item.level === 2 ? "h4" : "h5"}
				class={contentFlowSpacingClasses.heading}
				data-article-heading
			>
				{item.text}
			</CHeading>
		) : item.type === "paragraph" ? (
			<CText tone="subtle" class={contentFlowSpacingClasses.paragraph}>
				{item.text}
			</CText>
		) : item.type === "image" ? (
			<figure class={contentFlowSpacingClasses.image}>
				<CMedia ratio="video">
					<CImage {...item.image} variant="fill" />
				</CMedia>
				{item.caption && <figcaption class="mt-2 text-sm text-neutral-500">{item.caption}</figcaption>}
			</figure>
		) : item.type === "feature-grid" ? (
			<section id={item.id} class={contentFlowSpacingClasses["feature-grid"]} data-article-heading>
				<CHeading level={2} variant="h4">{item.title}</CHeading>
				<CColumns columns="two" gap="sm" class="mt-4">
					{item.items.map((feature) => (
						<CBox surface="glass" radius="md" spacing="md">
							<CColumns columns="one" gap="sm">
								<CIcon name={feature.icon} size="sm" />
								<CHeading level={3} variant="h6">{feature.title}</CHeading>
								<CText tone="subtle">{feature.description}</CText>
							</CColumns>
						</CBox>
					))}
				</CColumns>
			</section>
		) : item.type === "list" ? (
			item.style === "ordered" ? (
				<ol class={cn(contentFlowSpacingClasses.list, "list-decimal space-y-2 pl-6 text-neutral-600")}>
					{item.items.map((value) => <li>{value}</li>)}
				</ol>
			) : (
				<ul class={cn(contentFlowSpacingClasses.list, "list-disc space-y-2 pl-6 text-neutral-600")}>
					{item.items.map((value) => <li>{value}</li>)}
				</ul>
			)
		) : item.type === "table" ? (
			<div id={item.id} class={cn(contentFlowSpacingClasses.table, "overflow-x-auto")}>
				<table class="w-full border-collapse text-left text-sm">
					{item.caption && <caption class="mb-3 text-left text-sm text-neutral-500">{item.caption}</caption>}
					<thead>
						<tr>
							{item.columns.map((column) => <th scope="col" class="border-b px-3 py-2 font-semibold">{column.label}</th>)}
						</tr>
					</thead>
					<tbody>
						{item.rows.map((row) => (
							<tr>
								{item.columns.map((column) => <td class="border-b px-3 py-2 text-neutral-600">{row[column.key]}</td>)}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : item.type === "quote" ? (
			<blockquote class={cn(contentFlowSpacingClasses.quote, "border-l-2 pl-5")}>
				<CText>{item.text}</CText>
				{(item.attribution || item.source) && (
					<footer class="mt-3 text-sm text-neutral-500">
						{item.attribution && <span>{item.attribution}</span>}
						{item.attribution && item.source && <span> — </span>}
						{item.sourceUrl && item.source ? <a href={item.sourceUrl}>{item.source}</a> : item.source}
					</footer>
				)}
			</blockquote>
		) : item.type === "callout" ? (
			<CBox class={contentFlowSpacingClasses.callout} surface="glass" radius="md" spacing="md">
				<CColumns columns="one" gap="sm">
					{item.icon && <CIcon name={item.icon} size="sm" />}
					{item.title && <CHeading level={3} variant="h6">{item.title}</CHeading>}
					<CText tone="subtle">{item.text}</CText>
				</CColumns>
			</CBox>
		) : item.type === "code" ? (
			<figure class={contentFlowSpacingClasses.code}>
				{item.filename && <div class="mb-2 text-sm font-medium">{item.filename}</div>}
				<pre class="overflow-x-auto rounded-md bg-neutral-950 p-4 text-sm text-neutral-100"><code data-language={item.language}>{item.code}</code></pre>
				{item.caption && <figcaption class="mt-2 text-sm text-neutral-500">{item.caption}</figcaption>}
			</figure>
		) : item.type === "divider" ? (
			<hr class={cn(contentFlowSpacingClasses.divider, item.style === "dashed" ? "border-dashed" : "border-solid")} />
		) : item.type === "media" ? (
			<figure class={contentFlowSpacingClasses.media}>
				{item.mediaType === "video" ? (
					<video
						src={item.src}
						poster={item.poster?.src}
						controls={item.controls ?? true}
						autoplay={item.autoplay ?? false}
						muted={item.autoplay ?? false}
						playsinline
						class="w-full"
						aria-label={item.title}
					/>
				) : (
					<iframe src={item.src} title={item.title} loading="lazy" class="aspect-video w-full" allowfullscreen />
				)}
				{item.caption && <figcaption class="mt-2 text-sm text-neutral-500">{item.caption}</figcaption>}
			</figure>
		) : item.type === "metric-grid" ? (
			<section id={item.id} class={contentFlowSpacingClasses["metric-grid"]} data-article-heading={item.id ? true : undefined}>
				{item.title && <CHeading level={2} variant="h4">{item.title}</CHeading>}
				<CColumns columns="two" gap="sm" class={item.title ? "mt-4" : undefined}>
					{item.items.map((metric) => (
						<CBox surface="glass" radius="md" spacing="md">
							<CColumns columns="one" gap="sm">
								{metric.icon && <CIcon name={metric.icon} size="sm" />}
								<CText>{metric.value}</CText>
								<CText tone="subtle">{metric.label}</CText>
								{metric.description && <CText tone="subtle">{metric.description}</CText>}
							</CColumns>
						</CBox>
					))}
				</CColumns>
			</section>
		) : null
	))}
</article>
