---
import type { CLinkProps } from "@/types/components/object/component/CLink.types";
import { cn } from "@/utils/cn";
import { isExternalUrl } from "@/utils/url/isExternalUrl";

type Props = CLinkProps;

const {
	href,
	class: className,
	nofollow = false,
	rel: requestedRel,
	target: requestedTarget,
	...attributes
} = Astro.props;

const allowedProtocols = new Set(["http:", "https:", "mailto:", "tel:"]);
let safeHref: string | undefined;

try {
	const resolvedUrl = new URL(href, Astro.site ?? Astro.url);
	if (allowedProtocols.has(resolvedUrl.protocol)) safeHref = href;
} catch {
	safeHref = undefined;
}

const external = safeHref
	? isExternalUrl(safeHref, Astro.site ?? Astro.url)
	: false;
const target = safeHref
	? requestedTarget ?? (external ? "_blank" : undefined)
	: undefined;
const relValues = new Set(requestedRel?.split(/\s+/).filter(Boolean));

if (target === "_blank") {
	relValues.add("noopener");
	relValues.add("noreferrer");
}

if (nofollow) {
	relValues.add("nofollow");
}

const rel = relValues.size > 0 ? [...relValues].join(" ") : undefined;
---

<a {...attributes} href={safeHref} class={cn(className)} target={target} rel={rel}>
	<slot />
</a>
