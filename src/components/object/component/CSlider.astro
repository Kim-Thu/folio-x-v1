---
import CButton from "@/components/object/component/CButton.astro";
import CSliderEmbla from "@/components/object/component/CSliderEmbla";
import type { CSliderProps } from "@/types/components/object/component/CSlider.types";
import { cn } from "@/utils/cn";
import {
	sliderBaseClasses,
	sliderBelowLeftButtonsClasses,
	sliderBelowLeftPreviousClasses,
	sliderButtonsClasses,
	sliderContainerClasses,
	sliderContainerGapClasses,
	sliderControlsClasses,
	sliderDotClasses,
	sliderDotsClasses,
	sliderStatusClasses,
	sliderTrackClasses,
	sliderViewportClasses,
	sliderViewportDraggableClasses,
	sliderViewportShapeClasses,
} from "@/variants/components/object/component/CSlider.variants";

const {
	class: className,
	controls = "overlay",
	gap = "none",
	shape = "card",
	autoplay = false,
	autoplayInterval = 5000,
	draggable = true,
	pauseOnHover = true,
	itemCount,
	label,
	previousLabel,
	nextLabel,
	...attributes
} = Astro.props as CSliderProps;

const belowLeft = controls === "below-left";
const viewportClassName = cn(
	sliderViewportClasses,
	draggable && sliderViewportDraggableClasses,
	sliderViewportShapeClasses[shape],
);
const containerClassName = cn(
	sliderContainerClasses,
	sliderContainerGapClasses[gap],
);
---

<div {...attributes} class={cn(sliderBaseClasses, className)} data-slider>
	<CSliderEmbla
		client:only="react"
		{viewportClassName}
		{containerClassName}
		{label}
		{autoplay}
		{autoplayInterval}
		{draggable}
		{pauseOnHover}
	>
		<slot />
	</CSliderEmbla>

	{
		itemCount > 1 && (
			<div class={sliderControlsClasses[controls]}>
				{controls === "dots" && (
					<div class={sliderDotsClasses} role="group" aria-label={label}>
						{Array.from({ length: itemCount }, (_, index) => (
							<button
								type="button"
								class={sliderDotClasses}
								aria-label={`${label} ${index + 1}`}
								aria-current={index === 0 ? "true" : "false"}
								data-current={index === 0 ? "true" : "false"}
								data-slider-go={index}
							/>
						))}
					</div>
				)}

				{controls === "below" && (
					<p class={sliderStatusClasses} aria-live="polite">
						<span data-slider-current>01</span>
						<span class={sliderTrackClasses} aria-hidden="true" />
						<span data-slider-total>{String(itemCount).padStart(2, "0")}</span>
					</p>
				)}

				{controls !== "dots" && (
					<div
						class={belowLeft ? sliderBelowLeftButtonsClasses : sliderButtonsClasses}
						role="group"
						aria-label={label}
					>
						<CButton
							class={belowLeft ? sliderBelowLeftPreviousClasses : undefined}
							label={previousLabel}
							icon="chevronLeft"
							iconOnly
							size={belowLeft ? "md" : "sm"}
							variant={belowLeft ? "ghost" : "secondary"}
							tone="light"
							disabled
							data-slider-previous
						/>
						<CButton
							label={nextLabel}
							icon="chevronRight"
							iconOnly
							size={belowLeft ? "md" : "sm"}
							variant={belowLeft ? "primary" : "secondary"}
							tone="light"
							data-slider-next
						/>
					</div>
				)}
			</div>
		)
	}
</div>
