---
import type { CBadgeProps } from "@/types/components/object/component/CBadge.types";
import { cn } from "@/utils/cn";
import {
	badgeAppearanceToneClasses,
	badgeBaseClasses,
	badgePlacementClasses,
} from "@/variants/components/object/component/CBadge.variants";

const {
	as: Element = "span",
	appearance = "solid",
	class: className,
	placement = "flow",
	tone = "brand",
	...attributes
} = Astro.props as CBadgeProps;
---

<Element
	{...attributes}
	class={cn(
		badgeBaseClasses,
		badgeAppearanceToneClasses[appearance][tone],
		badgePlacementClasses[placement],
		className,
	)}
>
	<slot />
</Element>
