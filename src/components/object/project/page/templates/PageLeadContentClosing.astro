									data-pagination-page-size={item.props.pagination.pageSize}
								>
									<PArchiveToolbar {...item.props.toolbar} />
									{item.props.mode === "faceted" && item.props.sidebar ? (
										<LSidebar label={item.props.sidebar.label} sticky>
											<CColumns slot="sidebar" columns="one" gap="md">
												<PFilterPanel {...item.props.sidebar.filter} />
												{item.props.sidebar.cards && (
													<CBox surface="glass" radius="md" spacing="sm">
														<CColumns columns="one" gap="sm">
															{item.props.sidebar.cardsHeader && (
																<PSectionHeader {...item.props.sidebar.cardsHeader} />
															)}
															<PCard {...item.props.sidebar.cards} />
														</CColumns>
													</CBox>
												)}
												{item.props.sidebar.advertisement && (
													<PAdvertisement {...item.props.sidebar.advertisement} />
												)}
											</CColumns>
											<CColumns columns="one" gap="none" class="gap-6" data-archive-results>
												{item.props.result?.header && <PSectionHeader {...item.props.result.header} />}
												{item.props.result?.count !== undefined && item.props.result.label && (
													<CText variant="caption" tone="subtle">
														<CText as="span" variant="caption" tone="inherit" data-result-count>
															{item.props.result.count}
														</CText>{" "}
														{item.props.result.label}
													</CText>
												)}
												<PCard {...item.props.cards} />
												<CText data-product-empty data-facet-empty hidden tone="muted">
													{item.props.emptyLabel}
												</CText>
												<CPagination
													label={item.props.pagination.label}
													previousLabel={item.props.pagination.previousLabel}
													nextLabel={item.props.pagination.nextLabel}
													totalPages={item.props.pagination.totalPages}
												/>
											</CColumns>
										</LSidebar>
									) : (
										<CColumns columns="one" gap="md">
											<PCard {...item.props.cards} />
											<CText data-filter-empty hidden tone="muted">{item.props.emptyLabel}</CText>
											<CPagination
												label={item.props.pagination.label}
												previousLabel={item.props.pagination.previousLabel}
												nextLabel={item.props.pagination.nextLabel}
												totalPages={item.props.pagination.totalPages}
											/>
										</CColumns>
									)}
								</CColumns>
							)}
							{item.component === "status" && <PStatus {...item.props} />}
							{item.component === "tabs" && <CTabList {...item.props} />}
							{item.component === "gallery" && <PGallery {...item.props} />}
							{item.component === "entry-index" && <PEntryIndex {...item.props} />}
							{item.component === "reader" && <PReader {...item.props} />}
							{item.component === "details" && (
								<CBox
									surface={item.props.title ? "glass" : "plain"}
									radius={item.props.title ? "md" : "none"}
									spacing={item.props.title ? "md" : "none"}
								>
									<CColumns columns="one" gap="sm">
										{item.props.title && <CHeading level={2} variant="h5">{item.props.title}</CHeading>}
										<CDescriptionList
