										{item.props.tags && (
											<CColumns columns="one" gap="sm">
												<CHeading level={3} variant="h6">{item.props.tags.title}</CHeading>
												<CTags {...item.props.tags.list} />
											</CColumns>
										)}
									</CColumns>
								</CBox>
							)}
							{item.component === "profile" && <CProfile {...item.props} />}
							{item.component === "toc" && <CTOC {...item.props} />}
							{item.component === "advertisement" && <PAdvertisement {...item.props} />}
									</Fragment>
								))}
						</CColumns>
					</LSidebar>
				</CColumns>
			</CBox>
		)}
	</LSection>
	);
})}
