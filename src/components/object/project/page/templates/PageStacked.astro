---
import LSection from "@/components/layout/LSection.astro";
import PageRegionContent from "@/components/object/project/page/parts/PageRegionContent.astro";
import type { PPageTemplateProps } from "@/types/components/object/project/page/PPage.types";

const { regions } = Astro.props as PPageTemplateProps;
const orderedRegions = regions;
---

{orderedRegions.map((region) => {
	const section = region.section === false ? undefined : region.section;
	return (
		<LSection
			id={section?.id}
			theme={section?.theme ?? "none"}
			spacing={section?.spacing ?? "none"}
			container={section?.container ?? "none"}
			data-page-region={region.key}
		>
			<PageRegionContent {region} />
		</LSection>
	);
})}
