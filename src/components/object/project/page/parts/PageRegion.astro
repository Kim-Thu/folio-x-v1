---
import LContainer from "@/components/layout/LContainer.astro";
import LSection from "@/components/layout/LSection.astro";
import PageRegionContent from "@/components/object/project/page/parts/PageRegionContent.astro";
import type {
	PageRegion,
	PageRegionProps,
} from "@/types/components/object/project/page/PageRegion.types";

const { region } = Astro.props as PageRegionProps;
const section = region.section;
const {
	id,
	theme = "none",
	spacing = "none",
	container = "none",
} = section || {};
const contentRegion: PageRegion = { ...region, section: false };
---

{section === false ? (
	<PageRegionContent {region} />
) : (
	<LSection {id} {theme} {spacing} data-page-region={region.key}>
		{container === "none" ? (
			<PageRegionContent region={contentRegion} />
		) : (
			<LContainer size={container}>
				<PageRegionContent region={contentRegion} />
			</LContainer>
		)}
	</LSection>
)}
