---
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import PArchiveToolbar from "@/components/object/project/archive-toolbar/PArchiveToolbar.astro";
import PageRegion from "@/components/object/project/page/parts/PageRegion.astro";
import type { PageGroupRegion } from "@/types/components/object/project/page/PageGroupRegion.types";

type Props = { region: PageGroupRegion };
const { region } = Astro.props as Props;
const {
	asideGap = "md",
	asideLabel,
	asidePosition = "end",
	gap = "lg",
	panel = false,
	regions,
	stickyAside,
	toolbar,
} = region.props;
const enabledRegions = regions.filter((item) => item.enabled !== false);
const mainRegions = enabledRegions.filter(
	(item) => (item.placement ?? "main") === "main",
);
const asideRegions = enabledRegions.filter(
	(item) => item.placement === "aside",
);
---

<CBox
	surface={panel ? "glass" : "plain"}
	radius={panel ? "md" : "none"}
	spacing={panel ? "sm" : "none"}
>
	<CColumns columns="one" gap="md">
		{toolbar && <PArchiveToolbar {...toolbar} />}
		<LSidebar label={asideLabel} position={asidePosition} sticky={stickyAside}>
			<CColumns slot="sidebar" columns="one" gap={asideGap}>
				{asideRegions.map((item) => <PageRegion region={item} />)}
			</CColumns>
			<CColumns columns="one" gap={gap}>
				{mainRegions.map((item) => <PageRegion region={item} />)}
			</CColumns>
		</LSidebar>
	</CColumns>
</CBox>
