---
import {
	buildStructuredData,
	serializeStructuredData,
} from "@/data/seo/buildStructuredData";
import { normalizeSeo } from "@/data/seo/normalizeSeo";
import type { PSeoProps } from "@/types/components/object/project/seo/PSeo.types";

const { site, title, description, language, seo } = Astro.props as PSeoProps;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const page = normalizeSeo({
	site,
	title,
	description,
	language,
	seo,
	currentUrl: Astro.url,
	siteUrl,
});
const structuredData = serializeStructuredData(
	buildStructuredData(page, site, siteUrl),
);
const rssUrl = new URL("/rss.xml", siteUrl).toString();
---

<title>{page.title}</title>
<meta name="description" content={page.description} />
<meta name="robots" content={page.robots} />
<link rel="canonical" href={page.canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={rssUrl} />

<meta property="og:title" content={page.title} />
<meta property="og:description" content={page.description} />
<meta property="og:type" content={page.type} />
<meta property="og:url" content={page.canonicalUrl} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={page.locale} />
{page.image && <meta property="og:image" content={page.image.src} />}
{page.image?.alt && <meta property="og:image:alt" content={page.image.alt} />}
{page.image?.width && <meta property="og:image:width" content={String(page.image.width)} />}
{page.image?.height && <meta property="og:image:height" content={String(page.image.height)} />}

<meta name="twitter:card" content={page.image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={page.title} />
<meta name="twitter:description" content={page.description} />
{page.image && <meta name="twitter:image" content={page.image.src} />}
{page.image?.alt && <meta name="twitter:image:alt" content={page.image.alt} />}

{page.publishedAt && <meta property="article:published_time" content={page.publishedAt} />}
{page.modifiedAt && <meta property="article:modified_time" content={page.modifiedAt} />}
<script type="application/ld+json" is:inline set:html={structuredData}></script>
