---
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import type { PCardCollectionTemplateProps } from "@/types/components/object/project/card/PCard.types";

const {
	CardTemplate,
	items,
	gap,
	mediaRatio,
	headingLevel,
	separator,
	slots,
	productGrid = false,
	...attributes
} = Astro.props as PCardCollectionTemplateProps;

const rows = [
	{ start: 0, firstSpan: 7, secondSpan: 5, ratioItem: 0 },
	{ start: 2, firstSpan: 8, secondSpan: 4, ratioItem: 0 },
	{ start: 4, firstSpan: 5, secondSpan: 7, ratioItem: 1 },
] as const;
---

<CColumns
	{...attributes}
	columns="twelve"
	{gap}
	{separator}
	data-card-collection
	data-product-grid={productGrid ? "" : undefined}
	data-view="grid"
>
	{rows.map((row) => (
		<CGridItem lgSpan={12} align="stretch">
			<CColumns columns="twelve" gap={gap}>
				{items[row.start] && (
					<CGridItem lgSpan={row.firstSpan} align="stretch">
						<CardTemplate
							data={items[row.start]}
							headingLevel={headingLevel}
							index={row.start}
							mediaRatio={row.ratioItem === 0 ? mediaRatio : "natural"}
							slots={slots}
						/>
					</CGridItem>
				)}
				{items[row.start + 1] && (
					<CGridItem lgSpan={row.secondSpan} align="stretch">
						<CardTemplate
							data={items[row.start + 1]}
							headingLevel={headingLevel}
							index={row.start + 1}
							mediaRatio={row.ratioItem === 1 ? mediaRatio : "natural"}
							slots={slots}
						/>
					</CGridItem>
				)}
			</CColumns>
		</CGridItem>
	))}
</CColumns>
