---
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import type { PCardCollectionTemplateProps } from "@/types/components/object/project/card/PCard.types";

const {
	CardTemplate,
	items,
	gap,
	mediaRatio,
	headingLevel,
	separator,
	slots,
	productGrid = false,
	...attributes
} = Astro.props as PCardCollectionTemplateProps;

const getSpan = (size: PCardCollectionTemplateProps["items"][number]["size"]) =>
	size === "wide" ? 6 : 3;
---

<CColumns
	{...attributes}
	columns="twelve"
	{gap}
	{separator}
	data-card-collection
	data-product-grid={productGrid ? "" : undefined}
	data-view="grid"
>
	{items.map((item, index) => (
		<CGridItem lgSpan={getSpan(item.size)}>
			<CardTemplate
				data={item}
				{headingLevel}
				{index}
				{mediaRatio}
				slots={slots}
			/>
		</CGridItem>
	))}
</CColumns>
