---
import CColumns from "@/components/object/component/CColumns.astro";
import type { PCardCollectionTemplateProps } from "@/types/components/object/project/card/PCard.types";

const {
	CardTemplate,
	items,
	columnsTemplate = "one",
	gap,
	mediaRatio,
	headingLevel,
	separator,
	slots,
	productGrid = false,
	...attributes
} = Astro.props as PCardCollectionTemplateProps;
---

<CColumns
	{...attributes}
	columns={columnsTemplate}
	{gap}
	{separator}
	data-card-collection
	data-product-grid={productGrid ? "" : undefined}
	data-view="grid"
>
	{items.map((item, index) => (
		<CardTemplate
			data={item}
			{headingLevel}
			{index}
			{mediaRatio}
			slots={slots}
		/>
	))}
</CColumns>
