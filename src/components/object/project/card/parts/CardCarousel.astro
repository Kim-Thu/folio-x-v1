---
import type { PCardCollectionTemplateProps } from "@/types/components/object/project/card/PCard.types";
import { cn } from "@/utils/cn";
import {
	cardCarouselClasses,
	cardCarouselGapClasses,
	cardCarouselItemClasses,
} from "@/variants/components/object/project/card/PCard.variants";

const {
	CardTemplate,
	items,
	gap,
	mediaRatio,
	headingLevel,
	slots,
	productGrid = false,
	...attributes
} = Astro.props as PCardCollectionTemplateProps;
---

<div
	{...attributes}
	class={cn(cardCarouselClasses, cardCarouselGapClasses[gap])}
	data-card-collection
	data-product-grid={productGrid ? "" : undefined}
	data-view="carousel"
>
	{items.map((item, index) => (
		<div class={cardCarouselItemClasses}>
			<CardTemplate
				data={item}
				{headingLevel}
				{index}
				{mediaRatio}
				slots={slots}
			/>
		</div>
	))}
</div>
