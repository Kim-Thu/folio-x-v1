---
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CTags from "@/components/object/component/CTags.astro";
import CText from "@/components/object/component/CText.astro";
import type { PCardItemProps } from "@/types/components/object/project/card/PCard.types";
import { cn } from "@/utils/cn";

const { data, headingLevel = 3, index, mediaRatio = "natural", slots } =
	Astro.props as PCardItemProps;
const inverse = data.appearance === "inverse";

const desktopRatioClasses: Record<NonNullable<PCardItemProps["mediaRatio"]>, string> = {
	editorial: "lg:aspect-video",
	landscape: "lg:aspect-4/3",
	natural: "",
	panoramic: "lg:aspect-3/1",
	portrait: "lg:aspect-2/3",
	square: "lg:aspect-square",
	video: "lg:aspect-video",
};
---

<CBox
	as="article"
	class={cn("h-full", desktopRatioClasses[mediaRatio])}
	surface={inverse ? "dark" : "plain"}
	radius="lg"
	position="relative"
	ratio="natural"
	overflow="hidden"
	data-tab-card={data.filterValue ? "" : undefined}
	data-filter-category={data.filterValue}
	data-sort-value={data.sortValue}
	data-sort-index={index}
>
	{slots.media && data.media && (
		<CMedia
			ratio="natural"
			placement="background"
			href={data.href}
			ariaLabel={data.ariaLabel}
		>
			<CImage {...data.media} variant="fill" />
		</CMedia>
	)}

	<CBox position="relative" spacing="lg">
		<CColumns columns="one" gap="sm">
			{slots.metadata && data.metadata && (
				<CMetadata data={data.metadata} size="xs" tone={inverse ? "on-dark" : "brand"} />
			)}
			{slots.title && (
				<CHeading level={headingLevel} variant="h3">
					<CLink href={data.href}>{data.title.join(" ")}</CLink>
				</CHeading>
			)}
			{slots.excerpt && data.excerpt && (
				<CText variant="body-sm" tone={inverse ? "on-dark-muted" : "muted"}>
					{data.excerpt}
				</CText>
			)}
			{slots.tags && data.tags && data.tags.length > 0 && (
				<CTags
					items={data.tags}
					label={data.tagsLabel ?? `${data.title.join(" ")} tags`}
				/>
			)}
			{slots.action && data.action && (
				<CButton
					href={data.action.href}
					label={data.action.label}
					icon={data.action.icon}
					iconPosition={data.action.iconPosition}
					variant="outline"
					tone={inverse ? "dark" : "light"}
					size="sm"
				/>
			)}
		</CColumns>
	</CBox>
</CBox>
