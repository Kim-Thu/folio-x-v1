---
import CCard from "@/components/object/component/card/CCard.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import type { PCardTemplateProps } from "@/types/components/object/project/card/PCard.types";

const {
	gap = "lg",
	card,
	items,
	...attributes
} = Astro.props as PCardTemplateProps;

const featured = items[0];
const supporting = items.slice(1, 4);
const cardConfig = card ?? {};
---

<CColumns
	{...attributes}
	columns="twelve"
	gap={gap}
	align="start"
	data-card-collection
	data-product-grid={cardConfig.template === "media-details" ? "" : undefined}
	data-view="content-three-column"
>
	{featured && (
		<CGridItem lgSpan={7} align="start">
			<CCard {...cardConfig} data={featured} index={0} />
		</CGridItem>
	)}

	<CGridItem lgSpan={5} align="start">
		<CColumns columns="one" gap="none" separator="light">
			{supporting.map((item, index) => (
				<CCard
					{...cardConfig}
					template="stacked"
					data={item}
					index={index + 1}
					slots={{
						...cardConfig.slots,
						media: false,
						icon: false,
						tags: false,
						metrics: false,
						action: false,
					}}
				/>
			))}
		</CColumns>
	</CGridItem>
</CColumns>
