---
import CCard from "@/components/object/component/card/CCard.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import type { PCardTemplateProps } from "@/types/components/object/project/card/PCard.types";

const {
	gap = "lg",
	separator = "none",
	card,
	items,
	...attributes
} = Astro.props as PCardTemplateProps;

const rows = [
	{ start: 0, firstSpan: 7, secondSpan: 5, ratioItem: 0 },
	{ start: 2, firstSpan: 8, secondSpan: 4, ratioItem: 0 },
	{ start: 4, firstSpan: 5, secondSpan: 7, ratioItem: 1 },
] as const;
const cardConfig = card ?? {};
---

<CColumns
	{...attributes}
	columns="twelve"
	{gap}
	{separator}
	data-card-collection
	data-product-grid={cardConfig.template === "media-details" ? "" : undefined}
	data-view="grid"
>
	{rows.map((row) => (
		<CGridItem lgSpan={12} align="stretch">
			<CColumns columns="twelve" gap={gap}>
				{items[row.start] && (
					<CGridItem lgSpan={row.firstSpan} align="stretch">
						<CCard
							{...cardConfig}
							data={items[row.start]}
							index={row.start}
							mediaRatio={row.ratioItem === 0 ? cardConfig.mediaRatio : "natural"}
						/>
					</CGridItem>
				)}
				{items[row.start + 1] && (
					<CGridItem lgSpan={row.secondSpan} align="stretch">
						<CCard
							{...cardConfig}
							data={items[row.start + 1]}
							index={row.start + 1}
							mediaRatio={row.ratioItem === 1 ? cardConfig.mediaRatio : "natural"}
						/>
					</CGridItem>
				)}
			</CColumns>
		</CGridItem>
	))}
</CColumns>
