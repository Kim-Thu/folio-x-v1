---
import CBadge from "@/components/object/component/CBadge.astro";
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CMetadata from "@/components/object/component/CMetadata.astro";
import CRating from "@/components/object/component/CRating.astro";
import CRow from "@/components/object/component/CRow.astro";
import CText from "@/components/object/component/CText.astro";
import type { PCardItemProps } from "@/types/components/object/project/card/PCard.types";

const { data, headingLevel = 3, index, slots } =
	Astro.props as PCardItemProps;
const product = data.product;
---

{
	product && (
		<CBox
			as="article"
			surface="glass"
			radius="md"
			overflow="hidden"
			data-product-card
			data-title={data.title.join(" ").toLowerCase()}
			data-filter-category={product.categorySlug}
			data-license={product.license}
			data-platform={product.platform}
			data-price={product.price}
			data-rating={product.rating}
			data-sort-index={index}
		>
			{slots.media && data.media && (
				<CMedia
					ratio="editorial"
					href={data.href}
					ariaLabel={data.ariaLabel}
				>
					<CImage {...data.media} variant="fill" />
					{product.badge && (
						<CBadge placement="top-end">{product.badge}</CBadge>
					)}
				</CMedia>
			)}
			<CBox spacing="xs">
				<CColumns columns="one" gap="sm">
					<CColumns columns="one" gap="sm">
						{slots.metadata && data.metadata && (
							<CMetadata
								data={data.metadata}
								slots={{ icons: false }}
								tone="brand"
							/>
						)}
						{slots.title && (
							<CHeading level={headingLevel} variant="h4">
								<CLink href={data.href}>{data.title.join(" ")}</CLink>
							</CHeading>
						)}
						{slots.excerpt && data.excerpt && (
							<CText variant="body-sm" tone="subtle">
								{data.excerpt}
							</CText>
						)}
					</CColumns>

					<CRow as="footer" justify="between" align="end" gap="md" wrap={false}>
						<CRow gap="md" align="baseline" wrap={false}>
							<CText as="span" variant="price">
								${product.price}
							</CText>
							{product.oldPrice && (
								<CText as="span" variant="price-old" tone="subtle">
									${product.oldPrice}
								</CText>
							)}
						</CRow>

						<CRow gap="md" align="center" justify="end" wrap={false}>
							{slots.action && data.action && (
								<CButton
									label={data.action.label}
									icon="shoppingBag"
									iconOnly
									size="sm"
									tone="light"
									variant="view"
									data-cart-button
									aria-pressed="false"
								/>
							)}
							<CRating
								style="compact"
								value={product.rating}
								maximum={5}
								count={product.reviews}
							/>
						</CRow>
					</CRow>
				</CColumns>
			</CBox>
		</CBox>
	)
}
