---
import CCard from "@/components/object/component/card/CCard.astro";
import CSlider from "@/components/object/component/CSlider.astro";
import type { CCardData, CCardItemData } from "@/types/components/object/component/card/CCard.types";
import type { PCardTemplateProps } from "@/types/components/object/project/card/PCard.types";
import {
	pCardSliderClasses,
	pCardSliderItemClasses,
} from "@/variants/components/object/project/card/PCard.variants";

const {
	template,
	columns = 4,
	gap = "lg",
	separator,
	slider,
	card,
	items,
	...attributes
} = Astro.props as PCardTemplateProps;

void template;
void separator;

const cardConfig = card ?? {};
const itemTitle = (item: CCardItemData) =>
	Array.isArray(item.title) ? item.title.join(" ") : item.title;
const itemAriaLabel = (item: CCardItemData) =>
	"ariaLabel" in item ? (item as CCardData).ariaLabel : itemTitle(item);
const sliderLabel = items.map(itemTitle).join(", ");
const sliderControls = slider?.controls ?? "below-left";
const autoplay = slider?.autoplay ?? true;
const autoplayInterval = slider?.autoplayInterval ?? 5000;
const draggable = slider?.draggable ?? true;
const pauseOnHover = slider?.pauseOnHover ?? true;
---

<CSlider
	{...attributes}
	class={pCardSliderClasses}
	itemCount={items.length}
	label={sliderLabel}
	previousLabel={sliderLabel}
	nextLabel={sliderLabel}
	controls={sliderControls}
	gap={gap}
	shape="none"
	{autoplay}
	{autoplayInterval}
	{draggable}
	{pauseOnHover}
	data-card-collection
	data-product-grid={cardConfig.template === "media-details" ? "" : undefined}
	data-view="carousel"
>
	{items.map((item, index) => (
		<div
			class={pCardSliderItemClasses[columns]}
			aria-label={itemAriaLabel(item)}
			data-slide
		>
			<CCard {...cardConfig} data={item} index={index} />
		</div>
	))}
</CSlider>
