---
import CCard from "@/components/object/component/card/CCard.astro";
import CSlider from "@/components/object/component/CSlider.astro";
import type { PCardTemplateProps } from "@/types/components/object/project/card/PCard.types";
import { pCardSliderItemClasses } from "@/variants/components/object/project/card/PCard.variants";

const {
	template,
	columns = 4,
	gap = "lg",
	separator,
	card,
	items,
	...attributes
} = Astro.props as PCardTemplateProps;

void template;
void separator;

const cardConfig = card ?? {};
const sliderLabel = items.map((item) => item.title.join(" ")).join(", ");
---

<CSlider
	{...attributes}
	itemCount={items.length}
	label={sliderLabel}
	previousLabel={sliderLabel}
	nextLabel={sliderLabel}
	controls="below-left"
	gap={gap}
	shape="none"
	data-card-collection
	data-product-grid={cardConfig.template === "media-details" ? "" : undefined}
	data-view="carousel"
>
	{items.map((item, index) => (
		<div
			class={pCardSliderItemClasses[columns]}
			aria-label={item.ariaLabel}
			data-slide
		>
			<CCard {...cardConfig} data={item} index={index} />
		</div>
	))}
</CSlider>
