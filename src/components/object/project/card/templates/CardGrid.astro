---
import CCard from "@/components/object/component/card/CCard.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import type { PCardTemplateProps } from "@/types/components/object/project/card/PCard.types";
import {
	pCardColumnTemplates,
	pCardProductViewCollectionClass,
	pCardTemplateColumnDefaults,
} from "@/variants/components/object/project/card/PCard.variants";

const {
	template,
	columns = 3,
	gap = "lg",
	separator = "none",
	card,
	items,
	...attributes
} = Astro.props as PCardTemplateProps;

const resolvedColumns = pCardTemplateColumnDefaults[template] ?? columns;
const cardConfig = card ?? {};
const supportsProductViewSwitch =
	cardConfig.source === "products" && cardConfig.template === "media-details";
---

<CColumns
	{...attributes}
	columns={pCardColumnTemplates[resolvedColumns]}
	{gap}
	{separator}
	class={supportsProductViewSwitch ? pCardProductViewCollectionClass : undefined}
	data-card-collection
	data-product-grid={supportsProductViewSwitch ? "" : undefined}
	data-view="grid"
>
	{items.map((item, index) => (
		<CCard {...cardConfig} data={item} index={index} />
	))}
</CColumns>
