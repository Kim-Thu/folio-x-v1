---
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CText from "@/components/object/component/CText.astro";
import type { PSectionHeaderProps } from "@/types/components/object/project/section-header/PSectionHeader.types";

const {
	appearance = "default",
	data,
	headingLevel = 2,
} = Astro.props as Omit<PSectionHeaderProps, "template">;
const headingId = data.id ? `${data.id}-title` : undefined;
const headingVariant = appearance === "compact"
	? "h4"
	: appearance === "catalog"
		? "h3"
		: "h2";
---

<CBox as="header">
	<CColumns columns="one" gap={appearance === "compact" ? "xs" : "sm"}>
		{(data.number || data.label) && (
			<CText variant="caption" tone="subtle">
				{[data.number, data.label].filter(Boolean).join(" / ")}
			</CText>
		)}
		{data.title && (
			<CHeading
				id={headingId}
				level={headingLevel}
				variant={headingVariant}
				lines={Array.isArray(data.title) ? data.title : undefined}
			>
				{Array.isArray(data.title) ? undefined : data.title}
			</CHeading>
		)}
		{data.description && <CText tone="subtle">{data.description}</CText>}
	</CColumns>
</CBox>
