---
import CBox from "@/components/object/component/CBox.astro";
import CImage from "@/components/object/component/CImage.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CSlide from "@/components/object/component/CSlide.astro";
import CSlider from "@/components/object/component/CSlider.astro";
import type { PGalleryProps } from "@/types/components/object/project/gallery/PGallery.types";

type Props = Pick<
	PGalleryProps,
	"items" | "label" | "previousLabel" | "nextLabel" | "sliderControls"
>;
const {
	items,
	label,
	previousLabel,
	nextLabel,
	sliderControls,
} = Astro.props as Props;
---

<CSlider
	itemCount={items.length}
	{label}
	controls={sliderControls}
	previousLabel={previousLabel ?? label}
	nextLabel={nextLabel ?? label}
>
	{
		items.map((item, index) => (
			<CSlide aria-label={`${index + 1} / ${items.length}`}>
				<CBox radius="md" overflow="hidden">
					<CMedia ratio="video">
						<CImage {...item} variant="fill" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} />
					</CMedia>
				</CBox>
			</CSlide>
		))
	}
</CSlider>
