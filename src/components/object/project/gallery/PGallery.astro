---
import GalleryGrid from "@/components/object/project/gallery/templates/GalleryGrid.astro";
import GalleryPreviewStrip from "@/components/object/project/gallery/templates/GalleryPreviewStrip.astro";
import GallerySlider from "@/components/object/project/gallery/templates/GallerySlider.astro";
import type { PGalleryProps } from "@/types/components/object/project/gallery/PGallery.types";

const {
	items,
	label,
	previousLabel,
	nextLabel,
	sliderControls,
	thumbnailLabel,
	template = "grid",
} = Astro.props as PGalleryProps;
---

{
	template === "slider" ? (
		<GallerySlider
			{items}
			{label}
			{previousLabel}
			{nextLabel}
			{sliderControls}
		/>
	) : template === "preview-strip" ? (
		<GalleryPreviewStrip
			{items}
			{label}
			{thumbnailLabel}
		/>
	) : (
		<GalleryGrid {items} {label} />
	)
}
