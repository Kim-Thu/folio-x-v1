---
import CBadge from "@/components/object/component/CBadge.astro";
import CBreadcrumb from "@/components/object/component/CBreadcrumb.astro";
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CFeature from "@/components/object/component/CFeature.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CIconTile from "@/components/object/component/CIconTile.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CRating from "@/components/object/component/CRating.astro";
import CRow from "@/components/object/component/CRow.astro";
import CText from "@/components/object/component/CText.astro";
import PGallery from "@/components/object/project/gallery/PGallery.astro";
import type { CColumnsTemplate } from "@/types/components/object/component/CColumns.types";
import type { PPageHeaderGallerySummaryData } from "@/types/components/object/project/page-header/PPageHeader.types";
import {
	pageHeaderGallerySummaryActionClasses,
	pageHeaderGallerySummaryActionsClasses,
	pageHeaderGallerySummaryCommerceClasses,
	pageHeaderGallerySummaryContentClasses,
	pageHeaderGallerySummaryDescriptionClasses,
	pageHeaderGallerySummaryFactClasses,
	pageHeaderGallerySummaryFeaturesClasses,
	pageHeaderGallerySummaryIdentityClasses,
	pageHeaderGallerySummaryPaymentClasses,
	pageHeaderGallerySummaryPriceClasses,
	pageHeaderGallerySummaryRootClasses,
	pageHeaderGallerySummarySocialClasses,
	pageHeaderGallerySummarySocialDividerClasses,
	pageHeaderGallerySummaryTitleRowClasses,
} from "@/variants/components/object/project/page-header/PPageHeader.variants";

type Props = { data: PPageHeaderGallerySummaryData };
const { data } = Astro.props as Props;

const factsColumns: CColumnsTemplate =
	data.facts.length >= 5
		? "five"
		: data.facts.length === 4
			? "four"
			: data.facts.length === 3
				? "three"
				: data.facts.length === 2
					? "two"
					: "one";
---

<div class={pageHeaderGallerySummaryRootClasses}>
	<CBreadcrumb {...data.breadcrumb} />

	<CColumns columns="twelve" gap="lg" align="start">
		<CGridItem lgSpan={7}>
			<PGallery
				template="slider"
				items={data.images}
				label={data.galleryLabel}
				thumbnailLabel={data.thumbnailLabel}
			/>
		</CGridItem>

		<CGridItem as="header" lgSpan={5}>
			<div class={pageHeaderGallerySummaryContentClasses}>
				<div class={pageHeaderGallerySummaryIdentityClasses}>
					<CLink href={data.category.href}>
						<CText as="span" variant="caption" tone="brand">
							{data.category.label}
						</CText>
					</CLink>

					<div class={pageHeaderGallerySummaryTitleRowClasses}>
						<CRow align="center" gap="sm" wrap={false}>
							<CHeading level={1} variant="h3">{data.title}</CHeading>
							{data.badge && <CBadge tone="neutral">{data.badge}</CBadge>}
						</CRow>
					</div>

					<div class={pageHeaderGallerySummaryDescriptionClasses}>
						<CText tone="muted">{data.description}</CText>
					</div>
				</div>

				<div class={pageHeaderGallerySummarySocialClasses}>
					<CRow align="center" gap="sm" wrap={false}>
						<CRating
							style="stars"
							value={data.rating.value}
							maximum={data.rating.maximum}
							slots={{ count: false, maximum: false, value: false }}
						/>

						<CText as="span" variant="caption" tone="subtle">
							{data.rating.value} ({data.rating.count} reviews)
						</CText>

						<span
							class={pageHeaderGallerySummarySocialDividerClasses}
							aria-hidden="true"
						></span>

						<CText as="span" variant="caption" tone="subtle">
							{data.rating.salesLabel}
						</CText>
					</CRow>
				</div>

				<div class={pageHeaderGallerySummaryCommerceClasses}>
					<div class={pageHeaderGallerySummaryPriceClasses}>
						<CRow align="baseline" gap="sm" wrap={false}>
							<CText as="span" variant="price-display">
								{data.price.current}
							</CText>

							{data.price.previous && (
								<CText as="span" variant="price-old" tone="subtle">
									{data.price.previous}
								</CText>
							)}

							{data.price.discount && (
								<CBadge tone="brand">{data.price.discount}</CBadge>
							)}
						</CRow>
					</div>

					{data.features.length > 0 && (
						<div class={pageHeaderGallerySummaryFeaturesClasses}>
							{data.features.map((feature) => <CFeature {...feature} />)}
						</div>
					)}

					<CColumns
						columns="two"
						gap="sm"
						class={pageHeaderGallerySummaryActionsClasses}
						role="group"
						aria-label={data.actionsLabel}
					>
						{data.actions.map((action) => (
							<CButton
								href={action.href}
								label={action.label}
								icon={action.icon}
								variant={action.variant}
								tone="light"
								size="md"
								wide
								class={pageHeaderGallerySummaryActionClasses}
							/>
						))}
					</CColumns>

					{(data.paymentLabel || data.paymentMethods.length > 0) && (
						<CRow
							align="center"
							gap="sm"
							wrap={false}
							class={pageHeaderGallerySummaryPaymentClasses}
						>
							<CText as="span" variant="caption" tone="subtle">
								{data.paymentLabel}
							</CText>

							{data.paymentMethods.map((method) => (
								<CImage {...method} variant="payment-logo" />
							))}
						</CRow>
					)}
				</div>
			</div>
		</CGridItem>
	</CColumns>

	{data.facts.length > 0 && (
		<CBox surface="bordered" radius="md" spacing="sm">
			<CColumns as="ul" columns={factsColumns} gap="none" align="center">
				{data.facts.map((item) => (
					<li class={pageHeaderGallerySummaryFactClasses}>
						<CRow align="center" gap="sm" wrap={false}>
							{item.icon && (
								<CIconTile icon={item.icon} size="sm" iconSize="sm" />
							)}

							<CColumns columns="one" gap="xs">
								<CText variant="caption" tone="subtle">
									{item.label}
								</CText>

								{item.href ? (
									<CLink href={item.href}>{item.value}</CLink>
								) : (
									<CText variant="body-sm">{item.value}</CText>
								)}
							</CColumns>
						</CRow>
					</li>
				))}
			</CColumns>
		</CBox>
	)}
</div>
