---
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CIcon from "@/components/object/component/CIcon.astro";
import CIconTile from "@/components/object/component/CIconTile.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CList from "@/components/object/component/CList.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CRow from "@/components/object/component/CRow.astro";
import CSlide from "@/components/object/component/CSlide.astro";
import CSlider from "@/components/object/component/CSlider.astro";
import CText from "@/components/object/component/CText.astro";
import type { PPageHeaderImmersiveData } from "@/types/components/object/project/page-header/PPageHeader.types";

const { data } = Astro.props as { data: PPageHeaderImmersiveData };
const headingId = `${data.id}-title`;
const slides = data.slides?.length ? data.slides : [data];
---

<CSlider
	controls="dots"
	shape="none"
	itemCount={slides.length}
	label={`${data.eyebrow} featured titles`}
	previousLabel="Previous featured title"
	nextLabel="Next featured title"
>
	{slides.map((slide, index) => (
		<CSlide>
			<CColumns columns="twelve" gap="none" align="stretch">
				<CGridItem as="header" lgSpan={6} align="center">
					<CBox spacing="lg">
						<CColumns columns="one" gap="md">
							<CRow align="center" gap="xs">
								<CIcon name="archiveBox" size="sm" />
								<CText variant="label" tone="brand">{data.eyebrow}</CText>
							</CRow>

							<CHeading
								id={index === 0 ? headingId : undefined}
								level={index === 0 ? 1 : 2}
								variant="display-3"
							>
								{slide.title}{" "}
								<CText as="span" variant="inherit" tone="brand">
									{slide.accent}
								</CText>
							</CHeading>

							<CText variant="body-responsive" tone="subtle">
								{slide.description}
							</CText>

							<CRow gap="sm" role="group" aria-label={data.actionsLabel}>
								{slide.actions.map((action) => <CButton {...action} />)}
							</CRow>

							<CList direction="row" gap="sm">
								{data.metrics.map((item) => (
									<li>
										<CRow align="center" gap="sm">
											{item.icon && <CIconTile icon={item.icon} size="sm" iconSize="md" />}
											<CColumns columns="one" gap="xs">
												<CText variant="caption" tone="subtle">{item.label}</CText>
												{item.href ? (
													<CLink href={item.href}>{item.value}</CLink>
												) : (
													<CText variant="price">{item.value}</CText>
												)}
											</CColumns>
										</CRow>
									</li>
								))}
							</CList>
						</CColumns>
					</CBox>
				</CGridItem>

				<CGridItem lgSpan={6} align="stretch">
					<CBox position="relative" overflow="hidden">
						<CMedia ratio="video" shape="none">
							<CImage
								{...slide.image}
								variant="fill"
								loading={index === 0 ? "eager" : "lazy"}
								fetchpriority={index === 0 ? "high" : "auto"}
							/>
						</CMedia>

						{slide.quote && (
							<CBox position="overlay-end" surface="glass-dark" radius="md" spacing="md">
								<CColumns columns="one" gap="xs">
									<CText variant="lead" tone="on-dark">{slide.quote}</CText>
									{slide.quoteCredit && (
										<CText variant="caption" tone="on-dark-subtle">
											{slide.quoteCredit}
										</CText>
									)}
								</CColumns>
							</CBox>
						)}
					</CBox>
				</CGridItem>
			</CColumns>
		</CSlide>
	))}
</CSlider>
