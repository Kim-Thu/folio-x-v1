---
import CBreadcrumb from "@/components/object/component/CBreadcrumb.astro";
import CButton from "@/components/object/component/CButton.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CDescriptionList from "@/components/object/component/CDescriptionList.astro";
import CHeading from "@/components/object/component/CHeading.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import CImage from "@/components/object/component/CImage.astro";
import CLink from "@/components/object/component/CLink.astro";
import CMedia from "@/components/object/component/CMedia.astro";
import CRow from "@/components/object/component/CRow.astro";
import CSlide from "@/components/object/component/CSlide.astro";
import CSlider from "@/components/object/component/CSlider.astro";
import CText from "@/components/object/component/CText.astro";
import type { PPageHeaderSliderAsideData } from "@/types/components/object/project/page-header/PPageHeader.types";

type Props = { data: PPageHeaderSliderAsideData };
const { data } = Astro.props as Props;
const gallerySizes = "(min-width: 1024px) 50vw, 100vw";
const asideSizes = "(min-width: 1024px) 25vw, 100vw";
---

<CColumns columns="one" gap="md">
	<CBreadcrumb {...data.breadcrumb} />

	<CColumns columns="twelve" gap="md" align="start">
		<CGridItem as="header" lgSpan={3}>
		<CColumns columns="one" gap="md">
			<CLink href={data.category.href}>
				<CText as="span" variant="caption" tone="brand">
					{data.category.label}
				</CText>
			</CLink>
			<CHeading level={1} variant="page-title">
				{data.title}
			</CHeading>
			<CText tone="muted">{data.description}</CText>

			<CRow gap="xs" aria-label={data.tagsLabel}>
				{data.tags.map((tag) => (
					<CButton
						href={tag.href}
						label={tag.label}
						variant="outline"
						tone="light"
						size="xs"
					/>
				))}
			</CRow>

			{data.actions.length > 0 && (
				<CRow
					gap="xs"
					role="group"
					aria-label={data.actionsLabel}
				>
					{data.actions.map((action) => (
						<CButton
							href={action.href}
							label={action.label}
							icon={action.icon}
							variant={action.kind === "live" ? "secondary" : "outline"}
							tone="light"
							size="sm"
						/>
					))}
				</CRow>
			)}
		</CColumns>
		</CGridItem>

		<CGridItem lgSpan={6}>
		<CColumns columns="one" gap="none">
			{data.images.length > 1 ? (
				<CSlider
					itemCount={data.images.length}
					label={data.galleryLabel}
					previousLabel={data.previousImageLabel}
					nextLabel={data.nextImageLabel}
					controls="below"
				>
					{data.images.map((image) => (
						<CSlide><CMedia ratio="editorial"><CImage {...image} variant="fill" sizes={gallerySizes} /></CMedia></CSlide>
					))}
				</CSlider>
			) : (
				data.images[0] && (
					<CMedia ratio="editorial">
						<CImage {...data.images[0]} variant="fill" sizes={gallerySizes} />
					</CMedia>
				)
			)}
		</CColumns>
		</CGridItem>

		<CGridItem as="aside" lgSpan={3}>
		<CColumns columns="one" gap="md">
			<CImage
				{...data.asideDecoration}
				alt=""
				variant="natural"
				sizes={asideSizes}
				aria-hidden="true"
			/>
			<CDescriptionList items={data.facts} variant="panel" />
		</CColumns>
		</CGridItem>
	</CColumns>
</CColumns>
