---
import PageHeaderEditorial from "@/components/object/project/page-header/templates/PageHeaderEditorial.astro";
import PageHeaderImmersive from "@/components/object/project/page-header/templates/PageHeaderImmersive.astro";
import PageHeaderSplitBenefits from "@/components/object/project/page-header/templates/PageHeaderSplitBenefits.astro";
import PageHeaderGallerySummary from "@/components/object/project/page-header/templates/PageHeaderGallerySummary.astro";
import PageHeaderSliderAside from "@/components/object/project/page-header/templates/PageHeaderSliderAside.astro";
import PageHeaderSplitMedia from "@/components/object/project/page-header/templates/PageHeaderSplitMedia.astro";
import PageHeaderMediaAside from "@/components/object/project/page-header/templates/PageHeaderMediaAside.astro";
import PageHeaderCoverSummary from "@/components/object/project/page-header/templates/PageHeaderCoverSummary.astro";
import type {
	PPageHeaderProps,
	PPageHeaderEditorialData,
	PPageHeaderImmersiveData,
	PPageHeaderSplitBenefitsData,
	PPageHeaderGallerySummaryData,
	PPageHeaderSliderAsideData,
	PPageHeaderSplitMediaData,
	PPageHeaderMediaAsideData,
	PPageHeaderCoverSummaryData,
} from "@/types/components/object/project/page-header/PPageHeader.types";

const props = Astro.props as PPageHeaderProps;
const template = props.template ?? "split-media";
---

{
	template === "editorial" && (
		<PageHeaderEditorial data={props.data as PPageHeaderEditorialData} />
	)
}
{
	template === "cover-summary" && (
		<PageHeaderCoverSummary data={props.data as PPageHeaderCoverSummaryData} />
	)
}
{
	template === "immersive" && (
		<PageHeaderImmersive data={props.data as PPageHeaderImmersiveData} />
	)
}
{
	template === "split-benefits" && (
		<PageHeaderSplitBenefits
			data={props.data as PPageHeaderSplitBenefitsData}
		/>
	)
}
{
	template === "media-aside" && (
		<PageHeaderMediaAside data={props.data as PPageHeaderMediaAsideData} />
	)
}
{
	template === "slider-aside" && (
		<PageHeaderSliderAside
			data={props.data as PPageHeaderSliderAsideData}
		/>
	)
}
{
	template === "gallery-summary" && (
		<PageHeaderGallerySummary
			data={props.data as PPageHeaderGallerySummaryData}
		/>
	)
}
{
	template === "split-media" && (
		<PageHeaderSplitMedia data={props.data as PPageHeaderSplitMediaData} />
	)
}
