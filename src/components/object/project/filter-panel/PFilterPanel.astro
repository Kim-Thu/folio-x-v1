---
import CBox from "@/components/object/component/CBox.astro";
import CButton from "@/components/object/component/CButton.astro";
import CChoiceGroup from "@/components/object/component/CChoiceGroup.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CFieldset from "@/components/object/component/CFieldset.astro";
import CRange from "@/components/object/component/CRange.astro";
import CRating from "@/components/object/component/CRating.astro";
import CText from "@/components/object/component/CText.astro";
import type { PFilterPanelProps } from "@/types/components/object/project/filter-panel/PFilterPanel.types";
import { filterPanelLabelClasses } from "@/variants/components/object/project/filter-panel/PFilterPanel.variants";

const { data } = Astro.props as PFilterPanelProps;
const platform = data.platform ?? data.groups?.find((group) => group.control === "platform");
const extraGroups = (data.groups ?? []).filter((group) => group.control !== "platform");
const showReset = Boolean(
	data.category ||
	platform ||
	data.license ||
	data.range ||
	data.ratings ||
	extraGroups.length,
);
---

<CBox surface="glass" radius="md" spacing="md" data-filter-panel>
	<CColumns columns="one" gap="sm">
		{data.category && <CChoiceGroup {...data.category} />}

		{data.filterLabel && (
			<CText as="span" variant="caption" class={filterPanelLabelClasses}>
				{data.filterLabel}
			</CText>
		)}

		{platform && <CChoiceGroup {...platform} />}

		{data.range && <CRange {...data.range} />}

		{data.license && <CChoiceGroup {...data.license} />}

		{extraGroups.map((group) => (
			<CChoiceGroup {...group} />
		))}

		{data.ratings && (
			<CFieldset legend={data.ratings.legend} gap="xs">
				{data.ratings.options.map((rating) => (
					<CRating
						{...rating}
						style="filter"
						maximum={5}
						name={data.ratings?.name ?? "rating"}
					/>
				))}
			</CFieldset>
		)}

		{showReset && (
			<CButton
				label="Reset all"
				size="sm"
				tone="light"
				variant="text-subtle"
				data-filter-reset
			/>
		)}
	</CColumns>
</CBox>
