---
import CColumns from "@/components/object/component/CColumns.astro";
import CGridItem from "@/components/object/component/CGridItem.astro";
import CTOC from "@/components/object/component/CTOC.astro";
import ArticleFlow from "@/components/object/project/article/templates/ArticleFlow.astro";
import ArticleGrouped from "@/components/object/project/article/templates/ArticleGrouped.astro";
import type {
	PArticleFlowProps,
	PArticleGroupedProps,
	PArticleProps,
} from "@/types/components/object/project/article/PArticle.types";

const props = Astro.props as PArticleProps;
const { toc } = props;
const tocPosition = toc?.position ?? "end";
---

<CColumns columns={toc ? "twelve" : "one"} gap="xl">
	{toc && tocPosition === "start" && (
		<CGridItem as="aside" lgSpan={3}>
		<CTOC
			label={toc.label}
			items={toc.items}
			appearance={toc.appearance}
			sticky={toc.sticky}
		/>
		</CGridItem>
	)}

	<CGridItem lgSpan={toc ? 9 : "full"}>
	{props.template === "flow" ? (
		<ArticleFlow {...props as PArticleFlowProps} />
	) : (
		<ArticleGrouped {...props as PArticleGroupedProps} />
	)}
	</CGridItem>

	{toc && tocPosition === "end" && (
		<CGridItem as="aside" lgSpan={3}>
		<CTOC
			label={toc.label}
			items={toc.items}
			appearance={toc.appearance}
			sticky={toc.sticky}
		/>
		</CGridItem>
	)}
</CColumns>
