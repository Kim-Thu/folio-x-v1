---
import LSidebar from "@/components/layout/LSidebar.astro";
import CBox from "@/components/object/component/CBox.astro";
import CColumns from "@/components/object/component/CColumns.astro";
import CPagination from "@/components/object/component/CPagination.astro";
import CText from "@/components/object/component/CText.astro";
import PAdvertisement from "@/components/object/project/advertisement/PAdvertisement.astro";
import PArchiveToolbar from "@/components/object/project/archive-toolbar/PArchiveToolbar.astro";
import PCard from "@/components/object/project/card/PCard.astro";
import PFilterPanel from "@/components/object/project/filter-panel/PFilterPanel.astro";
import PSectionHeader from "@/components/object/project/section-header/PSectionHeader.astro";
import type { PageArchiveRegion } from "@/types/components/object/project/page/PageArchiveRegion.types";

type Props = { region: PageArchiveRegion };
const { region } = Astro.props as Props;
const { mode, toolbar, sidebar, result, cards, emptyLabel, pagination } =
	region.props;
const paginationProps = {
	label: pagination.label,
	previousLabel: pagination.previousLabel,
	nextLabel: pagination.nextLabel,
	totalPages: pagination.totalPages,
};
---

<CColumns
	columns="one"
	gap="md"
	data-filter-root={mode === "taxonomy" ? "" : undefined}
	data-filter-mode={mode}
	data-pagination-page-size={pagination.pageSize}
>
	<PArchiveToolbar {...toolbar} />

	{mode === "faceted" && sidebar ? (
		<LSidebar label={sidebar.label} sticky>
			<CColumns
				slot="sidebar"
				columns="one"
				gap="md"
			>
				<PFilterPanel {...sidebar.filter} />
				{sidebar.cards && (
					<CBox surface="glass" radius="md" spacing="sm">
						<CColumns columns="one" gap="sm">
							{sidebar.cardsHeader && (
								<PSectionHeader {...sidebar.cardsHeader} />
							)}
							<PCard {...sidebar.cards} />
						</CColumns>
					</CBox>
				)}
				{sidebar.advertisement && (
					<PAdvertisement {...sidebar.advertisement} />
				)}
			</CColumns>

			<CColumns
				columns="one"
				gap="md"
				data-archive-results
			>
				{result?.header && <PSectionHeader {...result.header} />}
				{result?.count !== undefined && result.label && (
					<CText variant="caption" tone="subtle">
						<CText
							as="span"
							variant="caption"
							tone="inherit"
							data-result-count
						>
							{result.count}
						</CText>{" "}
						{result.label}
					</CText>
				)}
				<PCard {...cards} />
				<CText data-product-empty data-facet-empty hidden tone="muted">
					{emptyLabel}
				</CText>
				<CPagination {...paginationProps} />
			</CColumns>
		</LSidebar>
	) : (
		<CColumns columns="one" gap="md">
			<PCard {...cards} />
			<CText data-filter-empty hidden tone="muted">{emptyLabel}</CText>
			<CPagination {...paginationProps} />
		</CColumns>
	)}
</CColumns>
