---
import type { FooterColumn } from '@/types/ui';
import SocialNav from '@/components/patterns/Navigation/SocialNav/SocialNav.astro';
import Text from '@/components/primitives/Text/Text.astro';

interface Props { column: Extract<FooterColumn, { kind: 'social' }> }

const { column }: Props = Astro.props;
---

<div class="min-w-0">
  <Text variant="eyebrow" class="mb-4 text-on-dark-faint">{column.label}</Text>
  <SocialNav links={column.links} variant="footer" />
</div>
