---
import { interfaceContent } from '@/data/content';
import type { SectionHeadingProps } from '@/types/ui';
import { cn } from '@/utils/cn';
import Text from '@/components/primitives/Text/Text.astro';
import { getSectionHeadingToneClasses } from '@/components/patterns/SectionHeading/variants/getSectionHeadingToneClasses';

type Props = SectionHeadingProps;

const { number, label, title, description, dark = true } = Astro.props;
const toneClasses = getSectionHeadingToneClasses(dark);
const descriptionClasses = cn('mt-7 leading-7 md:text-lg lg:col-span-6', toneClasses.description);
---

<header data-reveal class="grid translate-y-6 gap-xl opacity-0 transition duration-(--duration-reveal) ease-reveal data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 motion-reduce:translate-y-0 motion-reduce:opacity-100 lg:grid-cols-12">
  <div class="lg:col-span-3">
    <Text variant="meta" class={toneClasses.kicker}>{number} {interfaceContent.separators.slash} {label}</Text>
  </div>
  <div class="grid lg:col-span-9 lg:grid-cols-9">
    <Text as="h2" variant="heading" size="h2" class="lg:col-span-9">{title}</Text>
    {description && <Text size="base" class={descriptionClasses}>{description}</Text>}
  </div>
</header>
