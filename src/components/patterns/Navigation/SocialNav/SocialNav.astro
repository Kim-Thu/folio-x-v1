---
import type { SocialNavProps } from '@/types/navigation';
import FooterSocialNav from '@/components/patterns/Navigation/SocialNav/variants/FooterSocialNav.astro';
import RailSocialNav from '@/components/patterns/Navigation/SocialNav/variants/RailSocialNav.astro';

type Props = SocialNavProps;

const { links, variant = 'footer' }: Props = Astro.props;
---

{variant === 'rail' ? <RailSocialNav links={links} /> : <FooterSocialNav links={links} />}
