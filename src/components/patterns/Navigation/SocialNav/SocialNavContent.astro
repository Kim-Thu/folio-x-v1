---
import SocialIcon from '@/components/primitives/Icon/variants/SocialIcon.astro';
import type { SocialNavContentProps } from '@/types/navigation';

type Props = SocialNavContentProps;

const { link, display }: Props = Astro.props;
---

{display === 'icon' && link.icon
  ? <SocialIcon name={link.icon} />
  : display === 'label'
    ? link.label
    : link.shortLabel}
