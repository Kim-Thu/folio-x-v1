---
import { interfaceContent } from '@/data/content';
import type { PrimaryNavProps } from '@/types/navigation';
import Link from '@/components/primitives/Link/Link.astro';

type Props = Pick<PrimaryNavProps, 'items'>;

const { items }: Props = Astro.props;
---

<nav aria-label={interfaceContent.navigation.mobileLabel} class="flex flex-col">
  {items.map((item, index) => (
    <Link href={item.href} class="mobile-link flex items-center justify-between border-b-hairline border-line-dark py-5 text-4xl font-semibold">
      {item.label}
      <span class="font-mono text-xs text-on-dark-faint">{String(index + 2).padStart(2, '0')}</span>
    </Link>
  ))}
</nav>
