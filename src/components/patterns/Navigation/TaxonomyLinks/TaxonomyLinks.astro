---
import type { TaxonomyLinksProps } from '@/types/ui';
import Button from '@/components/primitives/Button/Button.astro';
import Text from '@/components/primitives/Text/Text.astro';
import { getTaxonomyLinksLabelClass } from '@/components/patterns/Navigation/TaxonomyLinks/variants/getTaxonomyLinksClasses';

type Props = TaxonomyLinksProps;

const { terms, basePath, label, tone = 'dark' } = Astro.props;
const labelClass = getTaxonomyLinksLabelClass(tone);
---

<aside>
  <Text variant="eyebrow" class={labelClass}>{label}</Text>
  <ul class="flex flex-wrap gap-xs">
    {terms.map((term) => (
      <li><Button href={`${basePath}/${term.slug}`} label={term.label} variant="outline" size="sm" tone={tone} /></li>
    ))}
  </ul>
</aside>
