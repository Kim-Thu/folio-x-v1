---
import Container from "@/components/layouts/Container.astro";
import Section from "@/components/layouts/Section/Section.astro";
import Button from "@/components/primitives/Button/Button.astro";
import Image from "@/components/primitives/Image/Image.astro";
import Text from "@/components/primitives/Text/Text.astro";
import { site } from "@/data/site";
import type { ClosingProfileProps } from "@/types/ui";

type Props = ClosingProfileProps;

const { content } = Astro.props;
---

<Section id={content.id} variant="closing" data-closing-profile>
	<div
		class="pointer-events-none absolute inset-0 bg-grid-dots bg-grid-size opacity-25"
		aria-hidden="true"
	>
	</div>

	<Container class="relative">
		<header
			class="flex flex-col items-start justify-between gap-lg md:flex-row md:items-center"
		>
			<Text variant="eyebrow" class="text-on-dark-muted">
				{content.eyebrow}
			</Text>

			<Button
				href={content.followAction.href}
				label={content.followAction.label}
				icon="arrowUpRight"
				variant="outline"
			/>
		</header>

		<div
			class="relative mt-3xl grid grid-cols-12 items-end md:mt-4xl"
			data-closing-profile-stage
		>
			<div
				class="relative z-0 col-span-full row-start-1 text-center"
				data-closing-profile-track
			>
				<Text
					id={`${content.id}-title`}
					as="h2"
					variant="heading"
					size="inherit"
					class="text-profile-name"
				>
					<span
						class="mx-auto block w-fit whitespace-nowrap will-change-transform"
						data-closing-profile-motion="left"
					>
						{content.nameLines[0]}
					</span>

					<span
						class="mx-auto block w-fit will-change-transform"
						data-closing-profile-motion="right"
					>
						<span class="block whitespace-nowrap">
							{content.nameLines[1]}
						</span>

						<Text
							as="span"
							size="sm"
							class="mt-xs block w-full whitespace-nowrap text-right font-medium leading-none text-brand-soft"
						>
							{content.roleLabel}
						</Text>
					</span>
				</Text>
			</div>

			{
				content.portraits && (
					<figure
						class="pointer-events-none z-20 col-span-6 col-start-4 row-span-2 row-start-1 self-end md:col-span-4 md:col-start-5"
						data-closing-profile-portrait
					>
						<Image
							src={content.portraits.expanded.src}
							alt={content.portraits.expanded.alt}
							width={content.portraits.expanded.width}
							height={content.portraits.expanded.height}
							variant="natural"
						/>
					</figure>
				)
			}

			<div
				class="col-span-full row-start-2 mt-3xl grid gap-xl border-t-hairline border-line-dark py-xl md:grid-cols-2 md:items-end md:justify-between"
			>
				<div class="justify-self-start">
					<Button
						href={`mailto:${site.email}`}
						label={`${content.emailActionLabel}: ${site.email}`}
						icon="arrowUpRight"
						variant="outline"
					/>
				</div>

				<div class="md:text-right">
					<Text
						variant="meta"
						size="caption"
						class="tracking-meta text-on-dark-faint"
					>
						{content.locationLabel}
					</Text>

					<Text size="base" class="mt-xs text-on-dark-muted">
						{site.location}
					</Text>
				</div>
			</div>
		</div>
	</Container>
</Section>
