---
import { headerContent } from '@/data/content';
import { site } from '@/data/site';
import type { BrandLogoProps } from '@/types/branding';
import Link from '@/components/primitives/Link/Link.astro';
import { cn } from '@/utils/cn';

type Props = BrandLogoProps;

const { class: className = '' } = Astro.props;
---

<Link href="/" class={cn('flex items-center gap-sm font-bold', className)} ariaLabel={site.name}>
  <span class="grid size-8 place-items-center rounded-full bg-brand text-label text-on-brand" aria-hidden="true">{site.shortName}</span>
  <span class="hidden text-sm sm:block">{headerContent.brand}</span>
</Link>
