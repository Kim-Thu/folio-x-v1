---
import type { SkeletonProps } from '@/types/ui';
import { cn } from '@/utils/cn';
import { getSkeletonShapeClass } from '@/components/patterns/Feedback/Skeleton/variants/getSkeletonShapeClass';

type Props = SkeletonProps;

const { class: className = '', shape = 'block' } = Astro.props;
---

<span aria-hidden="true" class={cn('block animate-skeleton bg-skeleton bg-skeleton-size', getSkeletonShapeClass(shape), className)}></span>
