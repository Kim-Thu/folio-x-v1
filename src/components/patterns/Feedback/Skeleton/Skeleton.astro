---
import type { SkeletonProps } from '@/types/ui';
import { cn } from '@/utils/cn';
import { getSkeletonShapeClass } from '@/components/patterns/Feedback/Skeleton/variants/getSkeletonShapeClass';

type Props = SkeletonProps;

const { class: className = '', shape = 'block' } = Astro.props;
---

<span aria-hidden="true" class={cn('relative block overflow-hidden bg-skeleton-base', getSkeletonShapeClass(shape), className)}>
  <span class="absolute inset-0 animate-skeleton bg-skeleton will-change-transform"></span>
</span>
