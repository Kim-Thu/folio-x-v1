---
import Section from '@/components/layouts/Section/Section.astro';
import Container from '@/components/layouts/Container.astro';
import Button from '@/components/primitives/Button/Button.astro';
import Image from '@/components/primitives/Image/Image.astro';
import Text from '@/components/primitives/Text/Text.astro';
import type { EmptyStateProps } from '@/types/ui';

type Props = EmptyStateProps;

const { content } = Astro.props;
---

<Section id={content.id} variant="state">
  <Container class="grid grid-cols-12 items-center gap-xl pb-xl pt-20">
    <div class="col-span-12 lg:col-span-5">
    {content.displayCode && (
      <Text variant="heading" size="display" class="mb-lg" aria-hidden="true">{content.displayCode}</Text>
    )}
    <Text variant="eyebrow" class="text-on-light-subtle">{content.eyebrow}</Text>
    <Text id={`${content.id}-title`} as="h1" variant="heading" size="h2" class="mt-lg">
      {content.title}
    </Text>

    <nav aria-label={content.eyebrow} class="mt-lg flex flex-wrap items-center gap-lg">
      <Button
        href={content.primaryAction.href}
        label={content.primaryAction.label}
        icon={content.primaryAction.icon}
        iconPosition="start"
        variant="primary"
        tone="light"
      />
      {content.secondaryAction && (
        <Button
          href={content.secondaryAction.href}
          label={content.secondaryAction.label}
          icon={content.secondaryAction.icon}
          variant="outline"
          tone="light"
        />
      )}
    </nav>
    </div>

    <figure class="col-span-10 col-start-2 sm:col-span-8 sm:col-start-3 lg:col-span-7 lg:col-start-6">
    <Image
      src={content.image.src}
      alt={content.image.alt}
      width={content.image.width}
      height={content.image.height}
      loading="eager"
      fetchpriority="high"
      variant="natural"
    />
    </figure>
  </Container>
</Section>
