---
import Icon from '@/components/primitives/Icon/Icon.astro';
import Image from '@/components/primitives/Image/Image.astro';
import Text from '@/components/primitives/Text/Text.astro';
import type { LoadingScreenProps } from '@/types/ui';
import BrandLogo from '@/components/patterns/BrandLogo/BrandLogo.astro';

type Props = LoadingScreenProps;

const { status, tips = [], holdOpen = false, progressLabel, image } = Astro.props;
const initialTip = tips[0];
---

<div
  id="loading-screen"
  data-loading-screen
  data-hold-open={String(holdOpen)}
  aria-hidden="true"
  class="fixed inset-0 z-loading-screen flex flex-col overflow-hidden bg-surface-light text-on-light opacity-100 transition-opacity duration-loader"
>
  <div class="grid flex-1 grid-cols-12 content-center items-center gap-sm overflow-hidden px-md py-md md:px-xl md:py-lg">
    {image && (
      <figure class="col-span-12 w-loading-visual justify-self-center">
        <Image
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="eager"
          fetchpriority="high"
          variant="natural"
        />
      </figure>
    )}

    <div class="col-span-12 grid justify-items-center gap-xs md:text-center">
      <BrandLogo variant="dark" size="lg" />
      <Text as="p" size="base" class="text-on-light-muted">{status}</Text>
      {initialTip && (
        <div class="mt-4 flex items-center gap-sm text-on-light-muted lg:mt-8">
          <Icon name="lightBulb" class="size-control-sm rounded-full border-hairline border-line-light p-xs" />
          <Text as="p" size="sm" data-loading-tip data-tips={JSON.stringify(tips)}>{initialTip}</Text>
        </div>
      )}
    </div>
  </div>

  <div class="shrink-0 absolute bottom-0 left-0 w-full">
    <div class="flex items-end justify-between gap-lg px-md pb-md md:px-xl md:pb-md">
      <Text as="p" variant="heading" size="display" class="ml-auto shrink-0 font-mono text-6xl leading-none tabular-nums md:text-h1" aria-hidden="true">
        <span data-loading-progress-number>0</span><span class="text-h3">%</span>
      </Text>
    </div>

    <div
      role="progressbar"
      aria-label={progressLabel}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-loading-progress
      class="h-2 w-full overflow-hidden bg-line-light"
    >
      <span
        data-loading-progress-value
        class="block size-full origin-left scale-x-0 bg-brand motion-reduce:transition-none"
      ></span>
    </div>
  </div>
</div>
