---
import type { ContentSectionsProps } from '@/types/ui';
import Section from '@/components/layouts/Section/Section.astro';
import Text from '@/components/primitives/Text/Text.astro';
import { getContentSectionsBodyClasses } from '@/components/patterns/Content/ContentSections/variants/getContentSectionsClasses';

type Props = ContentSectionsProps;

const { sections, tone = 'light', variant = 'article' } = Astro.props;
const bodyClasses = getContentSectionsBodyClasses(tone, variant);
---

{sections.map((section) => (
  <Section>
    <Text as="h2" variant="heading" size="h3">{section.title}</Text>
    <div class={bodyClasses}>
      {section.paragraphs.map((paragraph) => <Text>{paragraph}</Text>)}
    </div>
  </Section>
))}
