---
import type { FaqItemProps } from '@/types/ui';
import Text from '@/components/primitives/Text/Text.astro';

type Props = FaqItemProps;

const { item, index } = Astro.props;
---

<details class="faq group border-t-hairline border-line-dark last:border-b-hairline">
  <summary class="flex cursor-pointer list-none items-center gap-5 py-7 [&::-webkit-details-marker]:hidden">
    <span class="font-mono text-label text-on-dark-faint">{String(index + 1).padStart(2, '0')}</span>
    <Text as="h3" variant="heading" size="h3" class="flex-1">{item.question}</Text>
    <span class="relative size-5 shrink-0" aria-hidden="true">
      <span class="absolute left-0 top-1/2 h-px w-full bg-brand"></span>
      <span class="absolute left-1/2 top-0 h-full w-px bg-brand transition-transform group-open:rotate-90 group-open:opacity-0"></span>
    </span>
  </summary>
  <div class="grid grid-cols-index-content gap-5 pb-8">
    <span aria-hidden="true"></span>
    <div class="grid lg:grid-cols-9">
      <Text size="sm" class="leading-7 text-on-dark-muted md:text-base lg:col-span-6">{item.answer}</Text>
    </div>
  </div>
</details>
