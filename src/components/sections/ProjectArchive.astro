---
import { site } from '../../data/site';
import type { ProjectArchiveProps } from '../../types/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../layout/Footer.astro';
import Header from '../layout/Header.astro';
import FilterBar from '../navigation/FilterBar.astro';
import Container from '../ui/Container.astro';
import MetaLabel from '../ui/MetaLabel.astro';
import ProjectArchiveCard from '../ui/ProjectArchiveCard.astro';
import PSkeletonList from '../object/project/skeleton/PSkeletonList.astro';

type Props = ProjectArchiveProps;

const { eyebrow, title, description, projects, categories = [], filterLabel = '', allLabel = '', emptyLabel } = Astro.props;
const hasFilter = categories.length > 0;
---

<BaseLayout title={`${title} — ${site.name}`} description={description}>
  <Header solid />
  <main class="min-h-viewport bg-surface-dark pb-3xl pt-6xl text-on-dark md:pb-5xl lg:pb-6xl" data-filter-root>
    <Container>
      <header class="grid border-b-hairline border-line-dark pb-12 lg:grid-cols-12">
        <MetaLabel variant="eyebrow" class="text-brand lg:col-span-12">{eyebrow}</MetaLabel>
        <h1 class="mt-6 text-h1 font-semibold text-balance lg:col-span-10">{title}</h1>
        <p class="mt-7 text-base leading-7 text-on-dark-muted md:text-lg lg:col-span-7">{description}</p>
        {hasFilter && <div class="mt-10 lg:col-span-12"><FilterBar categories={categories} allLabel={allLabel} label={filterLabel} /></div>}
      </header>
      <div data-filter-skeleton hidden class="mt-12" aria-hidden="true">
        <PSkeletonList count={3} tone="dark" variant="project" />
      </div>
      <div data-filter-results class="mt-12 grid gap-lg" aria-live="polite" aria-busy="false">
        {projects.map((project) => <ProjectArchiveCard project={project} />)}
      </div>
      <p data-filter-empty hidden class="py-3xl text-center text-on-dark-muted">{emptyLabel}</p>
    </Container>
  </main>
  <Footer />
</BaseLayout>
