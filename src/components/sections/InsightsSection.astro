---
import { insights } from '../../data/site';
import { insightsContent } from '../../data/content';
import Container from '../ui/Container.astro';
import InsightCard from '../ui/InsightCard.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<Section id="insights" theme="light" spacing>
  <Container>
    <SectionHeading {...insightsContent.heading} dark={false} />

    <div class="mt-4xl grid gap-2xl lg:grid-cols-12">
      <InsightCard insight={insights[0]} variant="featured" featuredLabel={insightsContent.featuredLabel} featuredImageAlt={insightsContent.featuredImageAlt} />
      <div class="lg:col-span-5">
        {insights.slice(1).map((insight) => (
          <InsightCard insight={insight} variant="compact" />
        ))}
      </div>
    </div>
  </Container>
</Section>
