---
import { qaContent } from '../../data/content';
import { faqs } from '../../data/site';
import Container from '../ui/Container.astro';
import FaqItem from '../ui/FaqItem.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<Section id="qa" theme="dark" spacing>
  <Container>
    <SectionHeading {...qaContent.heading} />

    <div class="mt-3xl lg:ml-quarter">
      {faqs.map((item, index) => <FaqItem item={item} index={index} />)}
    </div>
  </Container>
</Section>
