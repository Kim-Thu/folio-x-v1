---
import { worksContent } from '../../data/content';
import { projects } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import ProjectListItem from '../ui/ProjectListItem.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const visibleProjects = projects.slice(0, worksContent.previewLimit);
const featuredProject = visibleProjects[0];
const compactProjects = visibleProjects.slice(1);
---

<Section id="work" theme="dark" spacing>
  <Container>
    <SectionHeading {...worksContent.heading} />

    <div class="mt-4xl">
      {featuredProject && <ProjectCard project={featuredProject} linkLabel={worksContent.linkLabel} outcomeLabel={worksContent.outcomeLabel} />}

      {compactProjects.length > 0 && (
        <div class="mt-5">
          {compactProjects.map((project) => (
            <ProjectListItem project={project} linkLabel={worksContent.linkLabel} outcomeLabel={worksContent.outcomeLabel} />
          ))}
        </div>
      )}

      <div class="mt-10 flex justify-center">
        <Button
          href="/projects"
          label={worksContent.archiveLabel}
          icon="arrowRight"
          variant="text"
          class="gap-xs text-sm font-medium text-on-dark "
        />
      </div>
    </div>
  </Container>
</Section>
