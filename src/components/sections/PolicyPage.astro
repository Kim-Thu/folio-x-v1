---
import { site } from '../../data/site';
import type { PolicyPageProps } from '../../types/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../layout/Footer.astro';
import Header from '../layout/Header.astro';
import Container from '../ui/Container.astro';
import MetaLabel from '../ui/MetaLabel.astro';

type Props = PolicyPageProps;

const { content } = Astro.props;
---

<BaseLayout title={`${content.title} — ${site.name}`} description={content.description}>
  <Header solid />
  <main class="bg-surface-light pb-3xl pt-6xl text-on-light md:pb-5xl lg:pb-6xl">
    <Container>
      <header class="grid border-b-hairline border-line-light pb-12 lg:grid-cols-12">
        <MetaLabel variant="eyebrow" class="text-on-light-muted lg:col-span-12">{content.eyebrow}</MetaLabel>
        <h1 class="mt-6 text-h1 font-semibold text-balance lg:col-span-10">{content.title}</h1>
        <p class="mt-7 text-base leading-7 text-on-light-muted md:text-lg lg:col-span-7">{content.description}</p>
        <p class="mt-7 font-mono text-caption uppercase tracking-meta text-on-light-subtle lg:col-span-12">{content.lastUpdatedLabel} {content.lastUpdated}</p>
      </header>

      <div class="grid gap-2xl pt-12 lg:grid-cols-12">
        <div class="space-y-12 lg:col-span-8 lg:col-start-4">
          {content.sections.map((section) => (
            <section>
              <h2 class="text-h3 font-semibold">{section.title}</h2>
              <div class="mt-5 space-y-4 text-base leading-7 text-on-light-muted">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </section>
          ))}
        </div>
      </div>
    </Container>
  </main>
  <Footer />
</BaseLayout>
