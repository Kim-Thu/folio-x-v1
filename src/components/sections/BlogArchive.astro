---
import { site } from '../../data/site';
import type { BlogArchiveProps } from '../../types/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../layout/Footer.astro';
import Header from '../layout/Header.astro';
import FilterBar from '../navigation/FilterBar.astro';
import BlogArchiveCard from '../ui/BlogArchiveCard.astro';
import Container from '../ui/Container.astro';
import MetaLabel from '../ui/MetaLabel.astro';
import PSkeletonList from '../object/project/skeleton/PSkeletonList.astro';

type Props = BlogArchiveProps;

const { eyebrow, title, description, posts, categories = [], filterLabel = '', allLabel = '', emptyLabel } = Astro.props;
const hasFilter = categories.length > 0;
---

<BaseLayout title={`${title} — ${site.name}`} description={description}>
  <Header solid />
  <main class="min-h-viewport bg-surface-light pb-3xl pt-6xl text-on-light md:pb-5xl lg:pb-6xl" data-filter-root>
    <Container>
      <header class="grid border-b-hairline border-line-light pb-12 lg:grid-cols-12">
        <MetaLabel variant="eyebrow" class="text-on-light-muted lg:col-span-12">{eyebrow}</MetaLabel>
        <h1 class="mt-6 text-h1 font-semibold text-balance lg:col-span-10">{title}</h1>
        <p class="mt-7 text-base leading-7 text-on-light-muted md:text-lg lg:col-span-7">{description}</p>
        {hasFilter && <div class="mt-10 lg:col-span-12"><FilterBar categories={categories} allLabel={allLabel} label={filterLabel} theme="light" /></div>}
      </header>
      <div data-filter-skeleton hidden class="mt-8" aria-hidden="true">
        <PSkeletonList count={4} tone="light" variant="blog" />
      </div>
      <div data-filter-results class="mt-8" aria-live="polite" aria-busy="false">
        {posts.map((post) => <BlogArchiveCard post={post} />)}
      </div>
      <p data-filter-empty hidden class="py-3xl text-center text-on-light-muted">{emptyLabel}</p>
    </Container>
  </main>
  <Footer />
</BaseLayout>
