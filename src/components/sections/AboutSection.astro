---
import Container from '../ui/Container.astro';
import { aboutContent } from '../../data/content';
import PrincipleCard from '../ui/PrincipleCard.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<Section id="about" theme="light" spacing>
  <Container>
    <SectionHeading {...aboutContent.heading} dark={false} />

    <div class="mt-4xl grid gap-md md:grid-cols-12">
      {aboutContent.principles.map((principle) => <PrincipleCard {...principle} />)}
    </div>

    <div class="mt-3xl grid gap-lg pt-6 text-sm leading-6 md:grid-cols-3">
      <p class="font-mono text-label uppercase tracking-meta text-on-light-subtle">{aboutContent.capability.label}</p>
      <p>{aboutContent.capability.primary}</p>
      <p class="text-on-light-muted">{aboutContent.capability.secondary}</p>
    </div>
  </Container>
</Section>
