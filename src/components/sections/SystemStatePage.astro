---
import type { SystemStatePageProps } from '../../types/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../layout/Footer.astro';
import Header from '../layout/Header.astro';
import Container from '../ui/Container.astro';
import EmptyState from '../ui/EmptyState.astro';

type Props = SystemStatePageProps;

const { content } = Astro.props;
---

<BaseLayout title={content.metadataTitle} description={content.metadataDescription}>
  <Header solid />
  <main class="bg-surface-light pt-20 text-on-light">
    <Container class="grid min-h-viewport items-center">
      <EmptyState content={content} />
    </Container>
  </main>
  <Footer />
</BaseLayout>
