---
import { interfaceContent } from '@/data/content';
import type { ProjectCardProps } from '@/types/ui';
import { getProjectCardClasses } from '@/components/features/projects/ProjectCard/variants/getProjectCardClasses';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Icon from '@/components/primitives/Icon/Icon.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Image from '@/components/primitives/Image/Image.astro';

type Props = ProjectCardProps;

const { project, reverse = false, linkLabel, outcomeLabel } = Astro.props;
const cardClass = getProjectCardClasses(reverse);
---

<CardItem href={project.href} linkClass={cardClass} ariaLabel={project.title}>
    <figure class="project-visual relative aspect-editorial overflow-hidden lg:col-span-7">
      <Image class="absolute inset-0 h-full w-full object-cover transition duration-(--duration-reveal) group-hover:scale-media" src={project.image} alt={project.alt} />
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent" aria-hidden="true"></div>
      <figcaption class="absolute bottom-6 left-6 text-5xl font-semibold text-on-dark md:text-7xl">
        <span class="sr-only">{outcomeLabel} </span>{project.outcome}
      </figcaption>
    </figure>
    <div class="flex flex-col p-7 lg:col-span-5 lg:p-10">
      <Text variant="meta" class="flex items-center justify-between text-label tracking-meta text-on-dark-faint">
        <span>{project.number} {interfaceContent.separators.slash} {project.category}</span><span>{project.year}</span>
      </Text>
      <div class="my-auto py-2xl">
        <Text size="sm" class="mb-4 text-brand">{project.client}</Text>
        <Text as="h3" variant="heading" size="h3">{project.title}</Text>
        <Text size="sm" class="mt-7 leading-7 text-on-dark-muted md:text-base">{project.summary}</Text>
      </div>
      <span class="flex items-center justify-between border-t-hairline border-line-dark pt-5 text-sm font-medium">
        {linkLabel}<Icon name="arrowUpRight" />
      </span>
    </div>
</CardItem>
