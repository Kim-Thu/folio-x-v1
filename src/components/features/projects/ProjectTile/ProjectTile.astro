---
import type { ProjectTileProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Image from '@/components/primitives/Image/Image.astro';
import Link from '@/components/primitives/Link/Link.astro';
import Button from '@/components/primitives/Button/Button.astro';

type Props = ProjectTileProps;

const { project, linkLabel, outcomeLabel } = Astro.props;
---

<div
  class="h-full"
  data-work-card
  data-project-category={project.categorySlug}
>
  <CardItem
    class="group/card flex h-full flex-col overflow-hidden"
  >
    <Link href={project.href} ariaLabel={project.title} class="block">
      <figure class="aspect-editorial overflow-hidden">
        <Image
          class="size-full object-cover transition-transform duration-(--duration-reveal) group-hover/card:scale-media"
          src={project.image}
          alt={project.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </Link>

    <div class="flex flex-1 flex-col p-lg">
      <Text variant="meta" size="caption" class="flex items-center justify-between gap-sm tracking-meta text-on-dark-subtle">
        <Link href={`/projects/category/${project.categorySlug}`} class="transition-colors hover:text-on-dark">{project.category}</Link>
        <span>{project.year}</span>
      </Text>

      <div class="flex flex-1 flex-col pt-xl">
        <Text as="h3" variant="heading" size="h3"><Link href={project.href}>{project.title}</Link></Text>
        <Text size="sm" class="mt-sm text-on-dark-muted">{project.summary}</Text>

        <div class="mt-auto flex items-center justify-between gap-md border-t-hairline border-line-dark pt-md">
          <Text variant="meta" size="caption" class="rounded-full border-hairline border-button-outline bg-button-surface px-sm py-xs text-on-dark-muted">
            <span class="sr-only">{outcomeLabel} </span>{project.outcome}
          </Text>
          <Button href={project.href} label={linkLabel} icon="arrowUpRight" variant="text" size="sm" />
        </div>
      </div>
    </div>
  </CardItem>
</div>
