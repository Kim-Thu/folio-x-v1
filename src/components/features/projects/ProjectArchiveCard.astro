---
import { interfaceContent } from '@/data/content';
import type { ProjectArchiveCardProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Image from '@/components/primitives/Image/Image.astro';
import Link from '@/components/primitives/Link/Link.astro';
import Text from '@/components/primitives/Text/Text.astro';

type Props = ProjectArchiveCardProps;

const { project } = Astro.props;
---

<div data-filter-category={project.categorySlug}>
  <CardItem class="group grid h-full md:grid-cols-2" reveal={false}>
    <Link href={project.href} ariaLabel={project.title} class="block">
      <figure class="relative aspect-editorial overflow-hidden">
        <Image src={project.image} alt={project.alt} variant="interactiveFillCover" />
      </figure>
    </Link>
    <div class="flex flex-col p-7 md:p-9">
      <Text variant="meta" class="flex justify-between text-on-dark-faint">
        <span>
          {project.number} {interfaceContent.separators.slash}
          <Link href={`/projects/category/${project.categorySlug}`} class="transition-colors hover:text-on-dark">{project.category}</Link>
        </span>
        <span>{project.year}</span>
      </Text>
      <div class="my-auto py-8">
        <Text size="sm" class="text-brand">{project.client}</Text>
        <Text as="h2" variant="heading" size="h3" class="mt-4"><Link href={project.href}>{project.title}</Link></Text>
        <Text size="sm" class="mt-5 leading-7 text-on-dark-muted">{project.summary}</Text>
      </div>
      <Text size="sm" class="border-t-hairline border-line-dark pt-5 text-on-dark-muted">{project.outcome}</Text>
    </div>
  </CardItem>
</div>
