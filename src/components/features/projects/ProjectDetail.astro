---
import { archiveContent } from '@/data/archive';
import { interfaceContent } from '@/data/content';
import { site } from '@/data/site';
import type { ProjectDetailProps } from '@/types/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layouts/Footer.astro';
import Header from '@/components/layouts/Header/Header.astro';
import Button from '@/components/primitives/Button/Button.astro';
import Container from '@/components/layouts/Container.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Image from '@/components/primitives/Image/Image.astro';
import Link from '@/components/primitives/Link/Link.astro';
import ContentSections from '@/components/patterns/Content/ContentSections/ContentSections.astro';
import TaxonomyLinks from '@/components/patterns/Navigation/TaxonomyLinks/TaxonomyLinks.astro';

type Props = ProjectDetailProps;

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} — ${site.name}`} description={project.summary}>
  <Header solid />
  <main class="bg-surface-dark pb-3xl pt-6xl text-on-dark md:pb-5xl lg:pb-6xl">
    <Container>
      <Button href="/projects" label={archiveContent.projects.backLabel} icon="arrowLeft" iconPosition="start" variant="text" class="gap-xs text-sm text-on-dark-muted" />
      <header class="mt-12 grid gap-10 border-b-hairline border-line-dark pb-12 lg:grid-cols-12">
        <div class="grid lg:col-span-9 lg:grid-cols-9">
          <Text variant="eyebrow" class="text-brand lg:col-span-9"><Link href={`/projects/category/${project.categorySlug}`}>{project.category}</Link> {interfaceContent.separators.slash} {project.number}</Text>
          <Text as="h1" variant="heading" size="h1" class="mt-6 lg:col-span-9">{project.title}</Text>
          <Text size="base" class="mt-7 leading-7 text-on-dark-muted md:text-lg lg:col-span-7">{project.summary}</Text>
        </div>
        <dl class="grid gap-lg text-sm lg:col-span-3 lg:content-end">
          <div><dt class="text-on-dark-faint">{project.category}</dt><dd class="mt-1 text-on-dark">{project.client}</dd></div>
          <div><dt class="text-on-dark-faint">{archiveContent.detail.projectResultLabel}</dt><dd class="mt-1 text-on-dark">{project.outcome}</dd></div>
        </dl>
      </header>

      <figure class="mt-12 overflow-hidden rounded-card">
        <Image src={project.image} alt={project.alt} variant="editorial" />
      </figure>

      <div class="grid gap-2xl py-3xl md:py-5xl lg:grid-cols-12 lg:py-6xl">
        <div class="lg:col-span-3">
          <TaxonomyLinks terms={project.tags} basePath="/projects/tag" label={archiveContent.detail.tagsLabel} tone="dark" />
        </div>
        <div class="space-y-14 lg:col-span-8 lg:col-start-5">
          <ContentSections sections={project.sections} tone="dark" variant="article" />
        </div>
      </div>
    </Container>
  </main>
  <Footer />
</BaseLayout>
