---
import { archiveContent } from '@/data/archive';
import { interfaceContent } from '@/data/content';
import { site } from '@/data/site';
import type { ProjectDetailProps } from '@/types/ui';
import DetailPageLayout from '@/components/layouts/DetailPage/DetailPageLayout.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Link from '@/components/primitives/Link/Link.astro';
import ContentSections from '@/components/patterns/Content/ContentSections/ContentSections.astro';

type Props = ProjectDetailProps;

const { project } = Astro.props;
---

<DetailPageLayout
  title={`${project.title} — ${site.name}`}
  description={project.summary}
  backHref="/projects"
  backLabel={archiveContent.projects.backLabel}
  tone="dark"
  image={{ src: project.image, alt: project.alt }}
  taxonomyTerms={project.tags}
  taxonomyBasePath="/projects/tag"
  taxonomyLabel={archiveContent.detail.tagsLabel}
>
  <header slot="header" class="mt-12 grid gap-10 border-b-hairline border-line-dark pb-12 lg:grid-cols-12">
    <div class="grid lg:col-span-9 lg:grid-cols-9">
      <Text variant="eyebrow" class="text-brand lg:col-span-9">
        <Link href={`/projects/category/${project.categorySlug}`}>{project.category}</Link>
        {interfaceContent.separators.slash}
        {project.number}
      </Text>
      <Text as="h1" variant="heading" size="h1" class="mt-6 lg:col-span-9">{project.title}</Text>
      <Text size="base" class="mt-7 leading-7 text-on-dark-muted md:text-lg lg:col-span-7">{project.summary}</Text>
    </div>
    <dl class="grid gap-lg text-sm lg:col-span-3 lg:content-end">
      <div>
        <dt class="text-on-dark-faint">{project.category}</dt>
        <dd class="mt-1 text-on-dark">{project.client}</dd>
      </div>
      <div>
        <dt class="text-on-dark-faint">{archiveContent.detail.projectResultLabel}</dt>
        <dd class="mt-1 text-on-dark">{project.outcome}</dd>
      </div>
    </dl>
  </header>
  <ContentSections sections={project.sections} tone="dark" variant="article" idPrefix={project.slug} />
</DetailPageLayout>
