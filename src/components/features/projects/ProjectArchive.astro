---
import type { ProjectArchiveProps } from '@/types/ui';
import ArchivePage from '@/components/layouts/ArchivePage/ArchivePage.astro';
import ProjectArchiveCard from '@/components/features/projects/ProjectArchiveCard.astro';

type Props = ProjectArchiveProps;

const { eyebrow, title, description, projects, categories = [], filterLabel = '', allLabel = '', emptyLabel } = Astro.props;
---

<ArchivePage {eyebrow} {title} {description} {categories} {filterLabel} {allLabel} {emptyLabel} theme="dark" listVariant="stack">
  {projects.map((project) => <ProjectArchiveCard project={project} />)}
</ArchivePage>
