---
import type { ProjectListItemProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Icon from '@/components/primitives/Icon/Icon.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Image from '@/components/primitives/Image/Image.astro';

type Props = ProjectListItemProps;

const { project, linkLabel, outcomeLabel } = Astro.props;
---

<CardItem href={project.href} ariaLabel={project.title} variant="plain" class="border-t-hairline border-line-dark last:border-b-hairline" linkClass="group grid gap-lg py-7 transition-colors hover:bg-surface-hover lg:grid-cols-12 lg:items-center lg:px-4">
    <Text variant="meta" class="text-on-dark-faint lg:col-span-1">{project.number}</Text>

    <figure class="aspect-editorial overflow-hidden rounded-card lg:col-span-3">
      <Image variant="interactiveCover" src={project.image} alt={project.alt} />
    </figure>

    <div class="lg:col-span-5">
      <Text variant="meta" class="text-brand">{project.client} {project.year}</Text>
      <Text as="h3" variant="heading" size="h3" class="mt-3">{project.title}</Text>
      <Text size="sm" class="mt-4 leading-6 text-on-dark-muted">{project.summary}</Text>
    </div>

    <div class="flex items-end justify-between gap-md lg:col-span-3 lg:flex-col lg:items-end">
      <Text size="sm" class="text-right text-on-dark-muted"><span class="sr-only">{outcomeLabel} </span>{project.outcome}</Text>
      <span class="inline-flex items-center gap-xs text-sm font-medium">{linkLabel}<Icon name="arrowUpRight" /></span>
    </div>
</CardItem>
