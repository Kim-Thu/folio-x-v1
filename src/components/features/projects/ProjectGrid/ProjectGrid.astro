---
import type { ProjectGridProps } from '@/types/ui';
import ProjectTile from '@/components/features/projects/ProjectTile/ProjectTile.astro';
import Cards from '@/components/patterns/Cards/Cards.astro';

type Props = ProjectGridProps;

const { id, projects, linkLabel, outcomeLabel } = Astro.props;
---

<Cards
  id={id}
  role="tabpanel"
  aria-labelledby={`${id}-tab-all`}
  data-work-panel
  class="mt-xl grid grid-cols-1 items-stretch gap-md md:grid-cols-2 lg:grid-cols-3"
>
  {projects.map((project) => (
    <ProjectTile
      project={project}
      linkLabel={linkLabel}
      outcomeLabel={outcomeLabel}
    />
  ))}
</Cards>
