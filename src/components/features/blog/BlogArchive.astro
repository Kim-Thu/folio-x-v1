---
import type { BlogArchiveProps } from '@/types/ui';
import ArchivePage from '@/components/layouts/ArchivePage/ArchivePage.astro';
import BlogArchiveCard from '@/components/features/blog/BlogArchiveCard.astro';

type Props = BlogArchiveProps;

const { eyebrow, title, description, posts, categories = [], filterLabel = '', allLabel = '', emptyLabel } = Astro.props;
---

<ArchivePage {eyebrow} {title} {description} {categories} {filterLabel} {allLabel} {emptyLabel} theme="light" listVariant="grid">
  {posts.map((post) => <BlogArchiveCard post={post} />)}
</ArchivePage>
