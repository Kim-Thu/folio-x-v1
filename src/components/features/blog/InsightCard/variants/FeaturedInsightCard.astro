---
import type { InsightCardProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Image from '@/components/primitives/Image/Image.astro';
import Link from '@/components/primitives/Link/Link.astro';
import ArticleMeta from '@/components/patterns/Content/ArticleMeta/ArticleMeta.astro';

type Props = Omit<InsightCardProps, 'variant'>;

const { insight }: Props = Astro.props;
---

<CardItem variant="plain" class="lg:col-span-7">
  <Link href={insight.href} ariaLabel={insight.title} class="group block">
    <figure class="aspect-editorial overflow-hidden rounded-card bg-surface-dark">
      {insight.image && <Image variant="interactiveCover" class="grayscale group-hover:grayscale-0" src={insight.image} alt={insight.imageAlt} />}
    </figure>
  </Link>
  <ArticleMeta category={insight.category} categoryHref={`/blog/category/${insight.categorySlug}`} detail={insight.readTime} size="label" class="mt-5" />
  <Text as="h3" variant="heading" size="h3" class="mt-4"><Link href={insight.href}>{insight.title}</Link></Text>
  <Text size="base" class="mt-5 leading-7 text-on-light-muted">{insight.excerpt}</Text>
</CardItem>
