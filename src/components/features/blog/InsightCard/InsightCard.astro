---
import type { InsightCardProps } from '@/types/ui';
import FeaturedInsightCard from '@/components/features/blog/InsightCard/variants/FeaturedInsightCard.astro';
import CompactInsightCard from '@/components/features/blog/InsightCard/variants/CompactInsightCard.astro';

type Props = InsightCardProps;

const { variant = 'compact', ...props }: Props = Astro.props;
---

{variant === 'featured' ? <FeaturedInsightCard {...props} /> : <CompactInsightCard insight={props.insight} />}
