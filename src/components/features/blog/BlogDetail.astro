---
import { archiveContent } from '@/data/archive';
import type { BlogDetailProps } from '@/types/ui';
import DetailPageLayout from '@/components/layouts/DetailPage/DetailPageLayout.astro';
import Text from '@/components/primitives/Text/Text.astro';
import ContentSections from '@/components/patterns/Content/ContentSections/ContentSections.astro';
import ArticleMeta from '@/components/patterns/Content/ArticleMeta/ArticleMeta.astro';

type Props = BlogDetailProps;

const { post } = Astro.props;
---

<DetailPageLayout
  title={post.title}
  description={post.excerpt}
  backHref="/blog"
  backLabel={archiveContent.blog.backLabel}
  tone="light"
  image={post.image ? { src: post.image, alt: post.imageAlt } : undefined}
  taxonomyTerms={post.tags}
  taxonomyBasePath="/blog/tag"
  taxonomyLabel={archiveContent.detail.tagsLabel}
>
  <header slot="header" class="mt-12 grid text-center lg:grid-cols-12">
    <div class="lg:col-span-8 lg:col-start-3">
      <ArticleMeta category={post.category} categoryHref={`/blog/category/${post.categorySlug}`} detail={post.readTime} class="justify-center text-on-light-muted" />
      <Text as="h1" variant="heading" size="h1" class="mt-6">{post.title}</Text>
      <Text size="base" class="mt-7 leading-7 text-on-light-muted md:text-lg">{post.excerpt}</Text>
      <div class="mt-8 flex flex-wrap justify-center gap-5 font-mono text-caption uppercase tracking-meta text-on-light-subtle">
        <span>{archiveContent.detail.articleByLabel} {post.author}</span>
        <time datetime={post.publishedAt}>{archiveContent.detail.articlePublishedLabel} {post.publishedLabel}</time>
      </div>
    </div>
  </header>
  <ContentSections sections={post.sections} tone="light" variant="article" idPrefix={post.slug} />
</DetailPageLayout>
