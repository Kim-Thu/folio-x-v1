---
import type { BlogArchiveCardProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Link from '@/components/primitives/Link/Link.astro';
import Text from '@/components/primitives/Text/Text.astro';
import ArticleMeta from '@/components/patterns/Content/ArticleMeta/ArticleMeta.astro';

type Props = BlogArchiveCardProps;

const { post } = Astro.props;
---

<div data-filter-category={post.categorySlug}>
  <CardItem variant="plain" class="grid h-full gap-lg border-t-hairline border-line-light py-7 lg:grid-cols-12" reveal={false}>
    <Text variant="meta" class="text-on-light-subtle lg:col-span-2">{post.index}</Text>
    <div class="lg:col-span-7">
      <ArticleMeta category={post.category} categoryHref={`/blog/category/${post.categorySlug}`} detail={post.publishedLabel} dateTime={post.publishedAt} />
      <Text as="h2" variant="heading" size="h3" class="mt-3"><Link href={post.href}>{post.title}</Link></Text>
      <Text size="sm" class="mt-4 leading-7 text-on-light-muted">{post.excerpt}</Text>
    </div>
    <div class="flex items-end lg:col-span-3 lg:justify-end">
      <Text variant="meta" size="caption" class="tracking-meta text-on-light-subtle">{post.readTime}</Text>
    </div>
  </CardItem>
</div>
