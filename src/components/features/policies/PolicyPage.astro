---
import { site } from '@/data/site';
import type { PolicyPageProps } from '@/types/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/layouts/Footer.astro';
import Header from '@/components/layouts/Header/Header.astro';
import Container from '@/components/layouts/Container.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Section from '@/components/layouts/Section/Section.astro';

type Props = PolicyPageProps;

const { content } = Astro.props;
---

<BaseLayout title={`${content.title} — ${site.name}`} description={content.description}>
  <Header solid />
  <main class="bg-surface-light pb-3xl pt-6xl text-on-light md:pb-5xl lg:pb-6xl">
    <Container>
      <header class="grid border-b-hairline border-line-light pb-12 lg:grid-cols-12">
        <Text variant="eyebrow" class="text-on-light-muted lg:col-span-12">{content.eyebrow}</Text>
        <Text as="h1" variant="heading" size="h1" class="mt-6 lg:col-span-10">{content.title}</Text>
        <Text size="base" class="mt-7 leading-7 text-on-light-muted md:text-lg lg:col-span-7">{content.description}</Text>
        <p class="mt-7 font-mono text-caption uppercase tracking-meta text-on-light-subtle lg:col-span-12">{content.lastUpdatedLabel} {content.lastUpdated}</p>
      </header>

      <div class="grid gap-2xl pt-12 lg:grid-cols-12">
        <div class="space-y-12 lg:col-span-8 lg:col-start-4">
          {content.sections.map((section) => (
            <Section>
              <Text as="h2" variant="heading" size="h3">{section.title}</Text>
              <div class="mt-5 space-y-4 text-base leading-7 text-on-light-muted">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </Section>
          ))}
        </div>
      </div>
    </Container>
  </main>
  <Footer />
</BaseLayout>
