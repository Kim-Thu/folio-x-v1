---
import { worksContent } from '@/data/content';
import { projects } from '@/data/site';
import { archiveContent } from '@/data/archive';
import { getCategories } from '@/utils/taxonomy';
import Button from '@/components/primitives/Button/Button.astro';
import Container from '@/components/layouts/Container.astro';
import TaxonomyFilter from '@/components/patterns/Navigation/TaxonomyFilter/TaxonomyFilter.astro';
import ProjectGrid from '@/components/features/projects/ProjectGrid/ProjectGrid.astro';
import Section from '@/components/layouts/Section/Section.astro';
import SectionHeading from '@/components/patterns/SectionHeading/SectionHeading.astro';

const visibleProjects = projects.slice(0, worksContent.previewLimit);
const categories = getCategories(visibleProjects);
const panelId = 'selected-work-panel';
---

<Section id={worksContent.heading.id} theme="dark">
  <Container>
    <SectionHeading {...worksContent.heading} />

    <div class="mt-4xl" data-selected-work>
      <TaxonomyFilter
        categories={categories}
        allLabel={archiveContent.projects.allLabel}
        label={archiveContent.projects.filterLabel}
        panelId={panelId}
        variant="tabs"
      />

      <ProjectGrid
        id={panelId}
        projects={visibleProjects}
        linkLabel={worksContent.linkLabel}
        outcomeLabel={worksContent.outcomeLabel}
      />

      <div class="mt-10 flex justify-center">
        <Button
          href="/projects"
          label={worksContent.archiveLabel}
          icon="arrowRight"
          variant="text"
        />
      </div>
    </div>
  </Container>
</Section>
