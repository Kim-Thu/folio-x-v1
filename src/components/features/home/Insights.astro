---
import { insights } from '@/data/site';
import { insightsContent } from '@/data/content';
import Container from '@/components/layouts/Container.astro';
import InsightCard from '@/components/features/blog/InsightCard/InsightCard.astro';
import Section from '@/components/layouts/Section/Section.astro';
import SectionHeading from '@/components/patterns/SectionHeading/SectionHeading.astro';
import Cards from '@/components/patterns/Cards/Cards.astro';
---

<Section id="insights" theme="light" spacing>
  <Container>
    <SectionHeading {...insightsContent.heading} dark={false} />

    <Cards class="mt-4xl grid gap-2xl lg:grid-cols-12">
      <InsightCard insight={insights[0]} variant="featured" />
      <div class="lg:col-span-5">
        {insights.slice(1).map((insight) => (
          <InsightCard insight={insight} variant="compact" />
        ))}
      </div>
    </Cards>
  </Container>
</Section>
