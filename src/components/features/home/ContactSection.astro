---
import Container from '@/components/layouts/Container.astro';
import Section from '@/components/layouts/Section/Section.astro';
import Button from '@/components/primitives/Button/Button.astro';
import Image from '@/components/primitives/Image/Image.astro';
import Text from '@/components/primitives/Text/Text.astro';
import { ctaContent } from '@/data/content';
import { site } from '@/data/site';
---

<Section id={ctaContent.id} variant="callout">
  <Container>
    <div class="grid overflow-hidden rounded-card border-hairline border-line-dark bg-surface-dark text-on-dark lg:grid-cols-12 lg:items-stretch">
      <header class="p-xl md:p-2xl lg:col-span-5 lg:self-center">
        <Text id={`${ctaContent.id}-title`} as="h2" variant="heading" size="h2">{ctaContent.title}</Text>
        <Text size="sm" class="mt-xs text-on-dark-muted">{ctaContent.description}</Text>
        <div class="mt-lg">
          <Button
            href={`mailto:${site.email}`}
            label={ctaContent.actionLabel}
            icon="arrowUpRight"
            variant="outline"
            tone="dark"
            size="lg"
          />
        </div>
      </header>

      <figure class="lg:col-span-7">
        <Image
          src={ctaContent.image.src}
          alt={ctaContent.image.alt}
          width={ctaContent.image.width}
          height={ctaContent.image.height}
          variant="natural"
          class="h-full object-cover object-center"
        />
      </figure>
    </div>
  </Container>
</Section>
