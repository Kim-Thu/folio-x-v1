---
import { heroContent } from '@/data/content';
import { site } from '@/data/site';
import Button from '@/components/primitives/Button/Button.astro';
import Container from '@/components/layouts/Container.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Section from '@/components/layouts/Section/Section.astro';
import Image from '@/components/primitives/Image/Image.astro';
---

<Section id="top" theme="dark" class="relative overflow-hidden">
  <Image variant="hero" src={heroContent.image.src} alt={heroContent.image.alt} loading="eager" decoding="sync" fetchpriority="high" />
  <div class="absolute inset-0 bg-hero-side" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-hero-floor" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-grid-dots bg-grid-size opacity-20" aria-hidden="true"></div>

  <Container class="relative z-10 grid gap-2xl pb-8 pt-6xl md:gap-3xl md:pb-10">
    <div class="flex items-start justify-between pt-6 text-on-dark-muted">
      <Text variant="eyebrow">{heroContent.identityLines[0]}<br />{heroContent.identityLines[1]}</Text>
      <Text variant="eyebrow" class="hidden text-right sm:block">{heroContent.locationLines[0]}<br /><span class="text-brand-soft">{heroContent.statusSymbol}</span> {heroContent.locationLines[1]}</Text>
    </div>

    <div>
      <Text size="sm" class="mb-5 leading-6 text-on-dark-muted md:ml-1/2 md:text-base">
        {heroContent.summary}
      </Text>
      <Text as="h1" variant="heading" size="display" class="uppercase">
        <span class="block">{heroContent.titleLines[0]}</span>
        <span class="block text-on-dark-faint">{heroContent.titleLines[1]}</span>
      </Text>
      <div class="mt-7 flex items-end justify-between border-t-hairline border-line-dark pt-8">
        <Text variant="eyebrow" class="text-on-dark-subtle">{heroContent.scrollLabel}</Text>
        <Button href={`mailto:${site.email}`} label={heroContent.contactLabel} icon="arrowUpRight" variant="text" class="gap-md text-sm font-medium" />
      </div>
    </div>
  </Container>
</Section>
