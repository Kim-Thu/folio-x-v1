---
import { ctaContent } from '@/data/content';
import { site } from '@/data/site';
import Button from '@/components/primitives/Button/Button.astro';
import Container from '@/components/layouts/Container.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Section from '@/components/layouts/Section/Section.astro';
---

<Section id="contact" theme="accent" class="relative overflow-hidden py-3xl md:py-5xl lg:py-6xl">
  <div class="pointer-events-none absolute inset-0 bg-grid-dots bg-grid-size opacity-25" aria-hidden="true"></div>

  <Container class="relative z-10">
    <div class="rounded-card bg-surface-light p-xl text-on-light md:p-2xl lg:p-4xl">
      <div class="grid items-center gap-2xl lg:grid-cols-12">
        <header class="lg:col-span-12 text-center">
          <Text variant="eyebrow" class="text-on-light-muted">{ctaContent.eyebrow}</Text>
          <Text as="h2" variant="heading" size="h2" class="mt-10 uppercase">{ctaContent.title}</Text>
        </header>
      </div>
      <div class="mt-4 grid gap-10 pt-4 lg:grid-cols-12">
        <Text size="sm" class="leading-7 text-on-light-muted lg:col-span-5">{ctaContent.description}</Text>
        <address class="min-w-0 not-italic lg:col-span-7 lg:text-right">
          <Button href={`mailto:${site.email}`} label={site.email} icon="arrowUpRight" variant="text" tone="light" class="gap-sm break-all border-b-hairline border-line-light pb-2 text-xl font-semibold md:text-3xl lg:text-4xl" />
          <Text variant="meta" class="mt-5 text-caption tracking-meta text-on-light-subtle">{ctaContent.availability}</Text>
        </address>
      </div>
    </div>
  </Container>
</Section>
