---
import type { PrincipleCardVariantProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Text from '@/components/primitives/Text/Text.astro';
import Image from '@/components/primitives/Image/Image.astro';

type Props = PrincipleCardVariantProps;

const { index, href, label, titleLines, image, imageAlt = '' }: Props = Astro.props;
---

<CardItem href={href} ariaLabel={titleLines.join(' ')} variant="plain" class="grid min-w-0 md:col-span-6 lg:col-span-4" linkClass="relative flex h-full min-w-0 w-full aspect-editorial flex-col justify-between gap-2xl overflow-hidden rounded-card p-7 lg:aspect-auto md:p-9">
  {image && <Image class="absolute inset-0 h-full w-full object-cover grayscale" src={image} alt={imageAlt} />}
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20" aria-hidden="true"></div>
  <Text as="span" variant="meta" size="label" class="relative tracking-eyebrow text-on-dark">{index} / {label}</Text>
  <Text as="h3" variant="heading" size="h3" class="relative text-on-dark">
    {titleLines.map((line, lineIndex) => <>{lineIndex > 0 && <br />}{line}</>)}
  </Text>
</CardItem>
