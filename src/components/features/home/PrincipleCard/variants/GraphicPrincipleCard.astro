---
import type { PrincipleCardVariantProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Text from '@/components/primitives/Text/Text.astro';

type Props = PrincipleCardVariantProps;

const { index, href, label, titleLines }: Props = Astro.props;
---

<CardItem href={href} ariaLabel={titleLines.join(' ')} variant="plain" class="grid min-w-0 md:col-span-6 lg:col-span-3" linkClass="relative flex h-full min-w-0 w-full aspect-editorial flex-col justify-between gap-2xl overflow-hidden rounded-card bg-brand p-7 text-on-brand lg:aspect-auto md:p-9">
  <div class="absolute -right-16 -top-16 size-72 rounded-full border-principle-orbit border-surface-dark/90" aria-hidden="true"></div>
  <div class="absolute right-10 top-10 size-24 rounded-full bg-brand-soft blur-2xl" aria-hidden="true"></div>
  <Text as="span" variant="meta" size="label" class="relative tracking-eyebrow">{index} / {label}</Text>
  <Text as="h3" variant="heading" size="h3" class="relative">
    {titleLines.map((line, lineIndex) => <>{lineIndex > 0 && <br />}{line}</>)}
  </Text>
</CardItem>
