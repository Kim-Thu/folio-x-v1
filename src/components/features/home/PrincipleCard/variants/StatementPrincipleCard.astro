---
import type { PrincipleCardVariantProps } from '@/types/ui';
import CardItem from '@/components/patterns/Cards/CardItem.astro';
import Text from '@/components/primitives/Text/Text.astro';

type Props = PrincipleCardVariantProps;

const { index, href, label, titleLines, description }: Props = Astro.props;
---

<CardItem href={href} ariaLabel={titleLines.join(' ')} variant="plain" class="grid min-w-0 md:col-span-12 lg:col-span-5" linkClass="flex h-full min-w-0 w-full flex-col justify-between gap-2xl rounded-card bg-surface-dark p-7 text-on-dark md:p-9">
  <Text as="span" variant="meta" size="label" class="tracking-eyebrow text-brand-soft">{index} / {label}</Text>
  <div>
    <Text as="h3" variant="heading" size="h3">
      {titleLines.map((line, lineIndex) => <>{lineIndex > 0 && <br />}{line}</>)}
    </Text>
    {description && <Text size="sm" class="mt-6 leading-6 text-on-dark-muted">{description}</Text>}
  </div>
</CardItem>
