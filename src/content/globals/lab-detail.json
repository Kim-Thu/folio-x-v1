  "resources": {
    "id": "resources",
    "title": "Resources",
    "actionIcon": "arrowUpRight",
    "settings": {
      "theme": "canvas",
      "spacing": "compact",
      "container": "wide"
    },
    "stack": {
      "columns": "one",
      "gap": "md"
    },
    "header": {
      "appearance": "compact",
      "headingLevel": 2
    }
  },
  "related": {
    "id": "related-labs",
    "title": "Related labs",
    "actionLabel": "View all Labs",
    "actionIcon": "arrowRight",
    "metricIcon": "star",
    "settings": {
      "theme": "canvas",
      "spacing": "compact",
      "container": "wide"
    },
    "stack": {
      "columns": "one",
      "gap": "md"
    },
    "header": {
      "appearance": "compact",
      "headingLevel": 2
    }
