{
  "page": {
    "template": "lead-navigation-content"
  },
  "header": {
    "id": "lab-summary",
    "template": "media-aside",
    "settings": {
      "theme": "canvas",
      "spacing": "compact",
      "container": "wide"
    },
    "labels": {
      "breadcrumb": "Breadcrumb",
      "collection": "Labs",
      "actionsTemplate": "{title} actions",
      "live": "Live demo",
      "source": "Source code"
    },
    "routes": {
      "base": "/labs",
      "categoryBase": "/labs/category",
      "technologyBase": "/labs/technology"
    },
    "metrics": [
      {
        "icon": "star",
        "source": "stars"
      },
      {
        "icon": "github",
        "source": "forks"
      },
      {
        "icon": "clock01",
        "source": "updatedLabel"
      }
    ],
    "actions": {
      "live": {
        "icon": "arrowUpRight",
        "variant": "primary"
      },
      "source": {
        "icon": "github",
        "variant": "outline"
      }
    }
  },
  "navigation": {
    "labelTemplate": "{title} navigation",
    "settings": {
      "theme": "canvas",
      "spacing": "none",
      "container": "wide"
    },
    "appearance": "underline",
    "tone": "light"
  },
  "content": {
    "id": "lab-content",
    "settings": {
      "theme": "canvas",
      "spacing": "body",
      "container": "wide"
    },
    "article": {
      "template": "flow"
    }
  },
  "sidebar": {
    "labelTemplate": "{title} project information",
    "position": "end",
    "sticky": true,
    "stack": {
      "columns": "one",
      "gap": "md"
    },
    "panel": {
      "surface": "glass",
      "radius": "md",
      "spacing": "md",
      "stack": {
        "columns": "one",
        "gap": "md"
      }
    },
    "labels": {
      "projectInformation": "Project information",
      "technologyTemplate": "{title} technology stack"
    },
    "header": {
      "appearance": "compact",
      "headingLevel": 2
    }
  },
  "gallery": {
    "id": "gallery",
    "title": "Gallery",
    "openImageLabelTemplate": "Open gallery image {index}",
    "imageTitleLabelTemplate": "Gallery image {index}",
    "settings": {
      "theme": "canvas",
      "spacing": "compact",
      "container": "wide"
    },
    "stack": {
      "columns": "one",
      "gap": "md"
    },
    "header": {
      "appearance": "compact",
      "headingLevel": 2
    },
    "mediaRatio": "editorial",
    "imageVariant": "fill",
    "captionVariant": "caption",
    "captionTone": "muted"
