{
  "page": {
    "template": "lead-content"
  },
  "section": {
    "id": "article-detail",
    "settings": {
      "theme": "canvas",
      "spacing": "lead",
      "container": "site"
    }
  },
  "header": {
    "template": "editorial",
    "breadcrumbLabel": "Breadcrumb",
    "collectionLabel": "Stories",
    "routes": {
      "base": "/blog",
      "categoryBase": "/blog/category/",
      "tagBase": "/blog/tag/"
    },
    "imageWidth": 1400,
    "imageHeight": 900,
    "authorImage": {
      "src": "/uploads/avatar.webp",
      "width": 512,
      "height": 512
    },
    "share": {
      "label": "Share article",
      "twitterLabel": "Share on Twitter",
      "linkedinLabel": "Share on LinkedIn",
      "copyLabel": "Copy article link"
    }
  },
  "sidebar": {
    "label": "Article supporting information",
    "position": "end",
    "sticky": true,
    "columns": {
      "columns": "one",
      "gap": "md"
    },
    "author": {
      "label": "Author",
      "role": "Writer at NKT Studio",
      "bio": "Writing about product thinking, engineering, and practical systems.",
      "actionLabel": "View all articles"
    },
    "toc": {
      "label": "Article contents",
      "appearance": "panel"
    },
    "relatedTitle": "Related articles",
    "relatedLimit": 4,
    "relatedCards": {
      "separator": "dot",
      "metadataDisplay": "text",
      "imageWidth": 640,
      "imageHeight": 420,
      "box": {
        "surface": "glass",
        "radius": "md",
        "spacing": "md"
      },
      "columns": {
        "columns": "one",
        "gap": "sm"
      },
      "heading": {
        "appearance": "compact",
        "level": 2
      },
      "card": {
        "template": "compact-media",
        "layout": "list",
        "columns": 1,
        "gap": "sm",
        "slots": {
          "excerpt": false,
          "tags": false,
          "metrics": false,
          "action": false
        }
      }
    },
    "newsletter": {
      "template": "form-first",
      "title": "Get new articles by email",
      "description": "Receive new writing about design, engineering, and product thinking.",
      "image": {
        "src": "/uploads/library-newsletter-book.webp",
        "alt": "Newsletter envelope and reading illustration",
        "width": 1448,
        "height": 1086
      },
      "action": {
        "href": "/blog",
        "label": "Subscribe",
        "icon": "arrowRight"
      },
      "form": {
        "formName": "article-newsletter",
        "inputId": "article-newsletter-email",
        "inputLabel": "Email address",
        "placeholder": "Your email address...",
        "submitLabel": "Subscribe"
      }
    }
  },
  "content": {
    "template": "flow",
    "columns": {
      "columns": "one",
      "gap": "lg"
    }
  }
}
