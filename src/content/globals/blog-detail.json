{
  "page": { "template": "fluid" },
  "section": {
    "id": "article-detail",
    "settings": { "theme": "canvas", "spacing": "lead", "container": "site" }
  },
  "header": {
    "template": "editorial",
    "breadcrumbLabel": "Breadcrumb",
    "collectionLabel": "Stories",
    "routes": {
      "base": "/blog",
      "categoryBase": "/blog/category/",
      "tagBase": "/blog/tag/"
    },
    "imageWidth": 1400,
    "imageHeight": 900,
    "authorImage": {
      "src": "/uploads/avatar.webp",
      "width": 512,
      "height": 512
    },
    "share": {
      "label": "Share article",
      "twitterLabel": "Share on Twitter",
      "linkedinLabel": "Share on LinkedIn",
      "copyLabel": "Copy article link"
    }
  },
  "sidebar": {
    "label": "Article supporting information",
    "author": {
      "label": "Author",
      "role": "Writer at NKT Studio",
