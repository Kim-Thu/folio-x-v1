      "actionLabel": "View all articles"
    },
    "tocLabel": "Article contents",
    "relatedTitle": "Related articles",
    "relatedLimit": 4,
    "relatedCards": {
      "separator": "dot",
      "metadataDisplay": "text",
      "imageWidth": 640,
      "imageHeight": 420
