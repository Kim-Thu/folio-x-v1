    "labels": {
      "breadcrumb": "Breadcrumb",
      "tags": "Genres",
      "author": "Author",
      "rating": "Rating",
      "reads": "Reads",
      "chapters": "Chapters",
      "followers": "Followers",
      "actions": "Publication actions",
      "primaryAction": "Read from start",
      "factsTitle": "Information",
      "language": "Language",
      "status": "Status",
      "updated": "Updated",
      "views": "Views",
      "ongoing": "Ongoing",
      "complete": "Complete"
