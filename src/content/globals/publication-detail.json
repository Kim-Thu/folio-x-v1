      "published": {
        "icon": "calendar03",
        "display": "icon-text"
      },
      "readTime": {
        "icon": "clock01",
        "display": "icon-text"
      }
    },
    "controls": {
      "chapterList": {
        "icon": "listView",
        "variant": "outline",
        "size": "md"
      },
      "previous": {
        "icon": "arrowLeft",
        "variant": "outline",
        "size": "md"
      },
      "next": {
        "icon": "arrowRight",
        "iconPosition": "end",
        "variant": "primary",
        "size": "md"
      }
    }
