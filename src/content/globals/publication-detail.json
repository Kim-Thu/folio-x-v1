      "aside": "Supporting information",
      "introduction": "Introduction",
      "tags": "Tags",
      "index": "Chapter index",
      "title": "Chapter list",
      "listView": "List view",
      "numberPrefix": "#",
      "chapter": "Chapter",
      "showAllTemplate": "View all chapters ({count})"
    },
    "overviewLayout": {
      "columns": "one",
      "gap": "md"
    },
    "sort": {
      "id": "chapter-sort",
      "label": "Sort chapters",
      "value": "newest",
      "options": [
        {
          "label": "Newest",
          "value": "newest"
        },
        {
          "label": "Oldest",
          "value": "oldest"
        }
      ]
    },
