{
  "slug": "/comics",
  "meta": {
    "title": "Comics",
    "description": "Illustrated series and graphic stories."
  },
  "content": {
    "sections": [
      {
        "id": "comics-hero",
        "type": "page-header",
        "template": "immersive",
        "settings": { "theme": "canvas", "spacing": "none", "container": "none" },
        "content": {
          "id": "comics-hero",
          "eyebrow": "Comics",
          "title": "Worlds drawn into",
          "accent": "motion.",
          "description": "Discover illustrated series, graphic stories, and original comics built panel by panel.",
          "actionsLabel": "Comics actions",
          "actions": [
            { "label": "Browse comics", "href": "/comics#catalog", "icon": "arrowRight", "iconPosition": "end", "variant": "primary", "tone": "light", "size": "md" },
            { "label": "Creator guide", "href": "/comics#catalog", "icon": "archiveBox", "iconPosition": "end", "variant": "outline", "tone": "light", "size": "md" }
          ],
          "image": { "src": "/uploads/library-hero-drawing.webp", "alt": "An illustrator creating a fantasy comic at night", "width": 1672, "height": 941 },
          "quote": "Every panel opens another world.",
          "quoteCredit": "NKT Studio",
          "metrics": [
            { "label": "Series", "value": "96+", "icon": "archiveBox" },
            { "label": "Episodes", "value": "8.4K+", "icon": "folder01" },
            { "label": "Views", "value": "1.8M+", "icon": "globeAlt" },
            { "label": "Rating", "value": "4.8", "icon": "star" }
          ]
        }
      },
      {
        "id": "catalog",
        "type": "collection",
        "template": "cards",
        "settings": { "theme": "canvas", "spacing": "body", "container": "site" },
        "content": {
          "heading": {
            "label": "Library",
            "title": ["Explore", "Comics"],
            "description": "Browse illustrated series, graphic stories, and original comics.",
            "action": { "label": "View all", "href": "/comics", "icon": "arrowRight" }
          },
          "source": { "collection": "comics", "limit": 24 },
          "cards": {
            "template": "media-metrics",
            "layout": "grid",
            "columns": 4,
            "gap": "sm",
            "mediaRatio": "portrait",
            "headingLevel": 3,
            "slots": { "excerpt": true, "tags": true, "metrics": true, "action": false }
          }
        }
      },
      {
        "id": "comics-newsletter",
        "type": "cta",
        "template": "subscription",
        "settings": { "theme": "canvas", "spacing": "closing", "container": "site" },
        "content": {
          "id": "comics-newsletter",
          "title": "New episodes, right on time",
          "description": "Subscribe for updates whenever your favorite illustrated series continues.",
          "image": { "src": "/uploads/library-newsletter-book.webp", "alt": "An open illustrated book with floating pages", "width": 1448, "height": 1086 },
          "form": {
            "formName": "comics-newsletter",
            "inputId": "comics-newsletter-email",
            "inputLabel": "Email address",
            "placeholder": "Your email address...",
            "submitLabel": "Subscribe"
          }
        }
      }
    ]
  }
