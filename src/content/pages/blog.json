{
  "slug": "/blog",
  "meta": {
    "title": "Insights",
    "description": "Ideas, insights, and practical notes about design, engineering, and product systems."
  },
  "content": {
    "layout": {
      "template": "lead-content-closing"
    },
    "sections": [
      {
        "id": "insights-hero",
        "type": "page-header",
        "template": "split-benefits",
        "settings": {
          "theme": "canvas",
          "spacing": "lead",
          "container": "site"
        },
        "content": {
          "id": "insights-hero",
          "breadcrumb": {
            "label": "Breadcrumb",
            "items": [
              {
                "label": "Home",
                "href": "/"
              }
            ],
            "current": "Insights"
          },
          "eyebrow": "Stories & Insights",
          "title": "Ideas. Insights. Inspiration",
          "accent": ".",
          "description": "Ideas, insights, and practical notes about design, engineering, and product systems.",
          "source": {
            "collection": "blog"
          },
          "benefits": {
            "articleLabel": "articles",
            "topicLabel": "topics",
            "minuteLabel": "min"
          },
          "image": {
            "src": "/uploads/page-header-insight.png",
            "alt": "Editorial interface and modular content blocks",
            "width": 1536,
            "height": 1024
          }
        }
      },
      {
        "id": "insights",
        "type": "archive",
        "template": "faceted",
        "settings": {
          "theme": "canvas",
          "spacing": "body",
          "container": "site"
        },
        "content": {
          "source": {
            "collection": "blog"
          },
          "toolbar": {
            "search": {
              "id": "insights-search",
              "label": "Search articles",
              "name": "search",
              "placeholder": "Search articles..."
            },
            "category": {
              "control": "category",
              "id": "insights-category",
              "label": "All topics",
              "allLabel": "All topics",
              "allValue": "all"
            },
            "sort": {
              "label": "Newest",
              "value": "newest",
              "options": [
                {
                  "label": "Newest",
                  "value": "newest"
                },
                {
                  "label": "Oldest",
                  "value": "oldest"
                }
              ]
            },
            "view": {
              "label": "Article view",
              "gridLabel": "Grid view",
              "listLabel": "List view"
            }
          },
          "sidebar": {
            "label": "Insight navigation",
            "filter": {
              "appearance": "navigation",
              "control": "category",
              "legend": "Topics",
              "name": "insight-category",
              "type": "radio",
              "allLabel": "All"
            },
            "featured": {
              "title": "Featured articles",
              "limit": 4,
              "header": {
                "appearance": "compact",
                "headingLevel": 2
              },
              "cards": {
                "template": "compact-media",
                "layout": "list",
                "columns": 1,
                "gap": "sm",
                "slots": {
                  "excerpt": false,
                  "tags": false
                }
              }
            },
            "newsletter": {
              "template": "form-first",
              "title": "Never miss a new article",
              "description": "Join the newsletter for practical ideas and behind-the-scenes notes.",
              "image": {
                "src": "/uploads/ads-1.png",
                "alt": "",
                "width": 1402,
                "height": 1122
              },
              "action": {
                "label": "Subscribe",
                "href": "mailto:thunk.work.91@gmail.com"
              },
              "form": {
                "formName": "insights-sidebar-newsletter",
                "inputId": "insights-sidebar-email",
                "inputLabel": "Email address",
                "placeholder": "Your email...",
                "submitLabel": "Subscribe",
                "tone": "dark"
              }
            }
          },
          "itemPresentation": {
            "routes": {
              "base": "/blog",
              "categoryBase": "/blog/category/",
              "tagBase": "/blog/tag/"
            },
            "separator": "·",
            "metadataDisplay": "text",
            "tagsLabelSuffix": " tags",
            "imageWidth": 1536,
            "imageHeight": 1536
          },
          "result": {
            "title": "All articles",
            "header": {
              "appearance": "compact",
              "headingLevel": 2
            }
          },
          "cards": {
            "template": "editorial",
            "layout": "grid",
            "columns": 3,
            "gap": "sm",
            "slots": {
              "tags": false,
              "action": false
            }
          },
          "emptyLabel": "No articles match your filters.",
          "pagination": {
            "label": "Article pages",
            "previousLabel": "Previous page",
            "nextLabel": "Next page",
            "pageSize": 9
          }
        }
      },
      {
        "id": "insights-closing",
        "type": "cta",
        "template": "callout",
        "settings": {
          "theme": "canvas",
          "spacing": "closing",
          "container": "site"
        },
        "content": {
          "id": "contact",
          "title": "Bạn có ý tưởng dự án?",
          "description": "Hãy cùng tạo ra một sản phẩm rõ ràng, hữu ích và đáng nhớ.",
          "action": {
            "href": "mailto:hello@nvt.studio",
            "label": "Liên hệ tôi"
          },
          "image": {
            "src": "/uploads/cta-banner.webp",
            "alt": "Nhân vật 3D đang làm việc tại bàn máy tính",
            "width": 1536,
            "height": 720
          }
        }
      }
    ]
  }
}
