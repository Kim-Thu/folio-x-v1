---
import '@/styles/global.css';
import googleSansLatinUrl from '@fontsource-variable/google-sans-flex/files/google-sans-flex-latin-wght-normal.woff2?url';
import googleSansVietnameseUrl from '@fontsource-variable/google-sans-flex/files/google-sans-flex-vietnamese-wght-normal.woff2?url';
import { interfaceContent, metadata } from '@/data/content';
import type { BaseLayoutProps } from '@/types/layout';
import LoadingScreen from '@/components/patterns/Feedback/LoadingScreen.astro';

type Props = BaseLayoutProps;

const {
  title = metadata.title,
  description = metadata.description,
} = Astro.props;
---

<!doctype html>
<html lang={metadata.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href={googleSansLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={googleSansVietnameseUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <title>{title}</title>
  </head>
  <body>
    <LoadingScreen label={interfaceContent.loadingScreen.label} status={interfaceContent.loadingScreen.status} />
    <slot />
    <script src="@/scripts/main.ts"></script>
  </body>
</html>
